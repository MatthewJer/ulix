% Ulix ARM64 -- noweb root chunks that reuse the chunks of ../ulix-book.nw.
% notangle -Rulix-decl.h ../ulix-book.nw ulix-arm64.nw   (both files are needed)
%
% The book assembles ulix.c from a fixed sequence of chunks (constants, macros, types,
% prototypes, global variables, function implementations).  The ARM64 port takes the
% declarations unchanged, so that every function taken from the book sees exactly the
% same types and constants as on x86, and picks single function implementations from
% the implementation chunks (see tools/port.py and port.manifest).

<<ulix-decl.h>>=
<<constants>>  <<public constants>>
<<macro definitions>>  <<public macro definitions>>
<<public elementary type definitions>>
<<type definitions>>  <<public type definitions>>
<<function prototypes>>  <<public function prototypes>>
<<ARM64 additional prototypes>>
@

The kernel shell of the book calls a few functions that are specific to the x86 hardware (VGA status
line, 2-level page tables, the x86 frame table).  The book prototypes them only in the files that
define them, so the ARM64 build declares its replacements (see [[glue.c]]) here:

<<ARM64 additional prototypes>>=
void ksh_command_test (void);
void ksh_command_div0 (void);
void ksh_command_mem (void);
void ksh_command_hexdump (void);
void ksh_print_page_table (void);
void vt_clrscr (void);
void statusline_red (void);
void statusline_blue (void);
void set_statusline (char *text);
uint request_new_frame (void);
void release_page_range (uint first, uint last);
@

<<ulix-globals.c>>=
<<global variables>>
@

<<ulix-functions.c>>=
<<function implementations>>  <<public function implementations>>
@

The initialization code that the x86 [[main()]] runs is also written in chunks of the book; the parts
that do not touch the hardware are reused as they are:

<<ulix-init.c>>=
void arch_setup_keyboard (void) {
  <<setup keyboard>>
}
@
