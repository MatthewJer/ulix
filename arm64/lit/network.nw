extern int  dhcp_run (int timeout_ms, void (*idle) (void));
extern unsigned long long net_now_ms (void);
extern unsigned net_my_ip, net_gateway;
extern void ip6_solicit (void);
extern void ip6_format (char *out, const unsigned char *address);
extern unsigned char ip6_global[16], ip6_router[16];
extern int  ip6_have_global, ip6_have_router;
extern int  telnet_start (void);
extern int  telnet_step (void);
extern int  ssh_start (void) __attribute__ ((weak));         // sshd.c (only when the system is built with TLS=1)
extern int  ssh_step (void) __attribute__ ((weak));
