the addresses of a socket (host byte order); 0, or minus an error number

<<sockets.c>>=
// the addresses of a socket (host byte order); 0, or minus an error number
int sock_name (int gfd, int peer, u32 *ip, u16 *port) {
  struct sock *s = sock_of (gfd);
  if (!s) return -E_NOTSOCK;
  if (s->local) { *ip = 0;  *port = 0;  return 0; }                    // a socketpair has no address (Python's ssl asks getpeername whether it is connected)
  if (peer) {
    if (s->type == SOCK_STREAM_ ? !s->c : !s->connected) return -E_NOTCONN;
    *ip = s->peer_ip;  *port = s->peer_port;
  } else {
    *ip = net_my_ip;  *port = s->local_port;
  }
  return 0;
}

