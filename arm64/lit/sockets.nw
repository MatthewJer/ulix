extern int  tcp_established (tcp_conn *c), tcp_closed (tcp_conn *c), tcp_readable (tcp_conn *c), tcp_writable (tcp_conn *c);
extern int  tcp_read (tcp_conn *c, u8 *buf, int max), tcp_write (tcp_conn *c, const u8 *data, int len);
