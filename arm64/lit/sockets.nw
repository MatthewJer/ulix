// the addresses of a socket (host byte order); 0, or minus an error number
int sock_name (int gfd, int peer, struct saddr *a) {
  struct sock *s = sock_of (gfd);
  if (!s) return -E_NOTSOCK;
  a->v6 = s->v6;  a->ip = 0;  a->port = 0;
  for (int k = 0; k < 16; k++) a->ip6[k] = 0;
  if (s->local) return 0;                                              // a socketpair has no address (Python's ssl asks getpeername whether it is connected)
  if (peer) {
    if (s->type == SOCK_STREAM_ ? !s->c : !s->connected) return -E_NOTCONN;
    a->ip = s->peer_ip;  a->port = s->peer_port;
    for (int k = 0; k < 16; k++) a->ip6[k] = s->peer6[k];
  } else {
    a->port = s->local_port;
    if (!s->v6) a->ip = net_my_ip;
    else {                                                             // the address that the kernel would use: the global one, if a router has given a prefix
      const u8 *mine = ip6_have_global ? ip6_global : ip6_link_local;
      for (int k = 0; k < 16; k++) a->ip6[k] = mine[k];
    }
  }
  return 0;
}

