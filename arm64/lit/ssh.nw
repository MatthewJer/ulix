\subsection{helpers for strings and numbers}

<<userland/sshd.c: helpers>>=
static int put_string (u8 *out, const void *s, int len) {          // a string: length and bytes; returns how many bytes it took
  put32 (out, len);
  for (int i = 0; i < len; i++) out[4 + i] = ((const u8 *)s)[i];
  return 4 + len;
}

static int text_length (const char *s) { int n = 0; while (s[n]) n++; return n; }
static int put_text (u8 *out, const char *s) { return put_string (out, s, text_length (s)); }

static int put_mpint (u8 *out, const u8 *be, int len) {              // a number given as bytes, most significant first
  while (len > 0 && be[0] == 0) { be++; len--; }
  int extra = (len > 0 && (be[0] & 0x80)) ? 1 : 0;                  // a zero byte in front keeps it positive
  put32 (out, len + extra);
  if (extra) out[4] = 0;
  for (int i = 0; i < len; i++) out[4 + extra + i] = be[i];
  return 4 + extra + len;
}

// a string in a received message at offset *off: its place and length; 0 = the message is too short
static int get_string (const u8 *msg, int n, int *off, const u8 **s, int *len) {
  if (*off + 4 > n) return 0;
  u32 l = get32 (msg + *off);
  if (l > (u32)(n - *off - 4)) return 0;
  *s = msg + *off + 4;  *len = (int)l;  *off += 4 + (int)l;
  return 1;
}

static int same_text (const u8 *s, int len, const char *t) {
  int i = 0;
  while (i < len && t[i] && s[i] == (u8)t[i]) i++;
  return i == len && t[i] == 0;
}

// does the comma separated list contain the name?
static int list_has (const u8 *list, int len, const char *name) {
  int n = text_length (name), start = 0;
  for (int i = 0; i <= len; i++) {
    if (i == len || list[i] == ',') {
      if (i - start == n) { int k = 0; while (k < n && list[start + k] == (u8)name[k]) k++; if (k == n) return 1; }
      start = i + 1;
    }
  }
  return 0;
}

@
\subsection{sending}

[[send_packet]] puts the payload into a packet as described above and appends it to the queue [[tx]]; the network thread hands the queue to TCP ([[flush]]).
The padding is random. The MAC is made over the packet before it is encrypted, with the number of the packet.

<<userland/sshd.c: sending>>=
static u8 tx[16384];  static int tx_len = 0;           // what has been prepared and not yet been accepted by TCP
static u32 seq_out = 0, seq_in = 0;                    // numbers of the packets (RFC 4253: they count from the first packet on)
static int enc_out = 0, enc_in = 0;                    // the keys are in use
static u8 mac_key_out[32], mac_key_in[32];
static int broken = 0;                                 // something went wrong that ends the session (the queue is full, a MAC is wrong)

static void send_packet (const u8 *payload, int plen) {
  static u8 pkt[MAX_PACKET + 64];
  int pad = 16 - (5 + plen) % 16;
  if (pad < 4) pad += 16;
  int total = 4 + 1 + plen + pad;
  put32 (pkt, 1 + plen + pad);  pkt[4] = pad;
  for (int i = 0; i < plen; i++) pkt[5 + i] = payload[i];
  sshc_random (pkt + 5 + plen, pad);
  u8 seq[4];
  put32 (seq, seq_out++);
  int mac = enc_out ? 32 : 0;
  if (tx_len + total + mac > (int)sizeof tx) { broken = 1; return; }
  u8 *dest = tx + tx_len;
  if (enc_out) {
    u8 tag[32];
    sshc_hmac (mac_key_out, seq, 4, pkt, total, tag);
    sshc_aes_crypt (1, pkt, total);
    for (int i = 0; i < total; i++) dest[i] = pkt[i];
    for (int i = 0; i < 32; i++) dest[total + i] = tag[i];
  } else {
    for (int i = 0; i < total; i++) dest[i] = pkt[i];
  }
  tx_len += total + mac;
}

static void flush (void) {                             // everything that is queued goes out (tcp_send waits until TCP has taken it)
  if (sock < 0 || tx_len == 0) return;
  struct tcp_msg m;
  m.handle = sock;  m.buf = tx;  m.len = tx_len;  m.timeout_ms = 10000;
  if (tcp_send (&m) != tx_len) broken = 3;             // the connection is gone, or the client does not read
  tx_len = 0;
}

@
\subsection{receiving}

Bytes that arrive are collected in [[rx]]. [[get_packet]] says whether a complete packet is there. Before the keys are in use it only needs the length. Afterwards it
decrypts the first block to learn the length (and remembers that it has done so: the counter has moved on), waits for the whole packet and the MAC, decrypts the rest,
and compares the MAC with the one it calculates. A packet with a wrong MAC ends the connection; so does a length that makes no sense.

<<userland/sshd.c: receiving>>=
static u8 rx[2 * MAX_PACKET];  static int rx_len = 0;
static int first_block_decrypted = 0;
static const u8 *pkt_payload;  static int pkt_payload_len, pkt_total;          // the packet that get_packet () has found

static int get_packet (void) {                          // 1 = a packet is ready, 0 = more bytes needed, -1 = error
  if (!enc_in) {
    if (rx_len < 5) return 0;
  } else {
    if (rx_len < 16) return 0;
    if (!first_block_decrypted) { sshc_aes_crypt (0, rx, 16);  first_block_decrypted = 1; }
  }
  u32 length = get32 (rx);
  if (length < 12 || length > MAX_PACKET) return -1;
  int total = 4 + (int)length;
  if (enc_in && total % 16 != 0) return -1;
  if (rx_len < total + (enc_in ? 32 : 0)) return 0;
  if (enc_in) {
    u8 seq[4], tag[32];
    sshc_aes_crypt (0, rx + 16, total - 16);
    put32 (seq, seq_in);
    sshc_hmac (mac_key_in, seq, 4, rx, total, tag);
    if (!sshc_equal (tag, rx + total, 32)) return -1;
  }
  int pad = rx[4];
  if (pad < 4 || 1 + pad >= (int)length) return -1;
  pkt_payload = rx + 5;  pkt_payload_len = (int)length - 1 - pad;  pkt_total = total + (enc_in ? 32 : 0);
  return 1;
}

static void consume (int n) {                           // the packet has been handled: remove it from rx
  for (int i = n; i < rx_len; i++) rx[i - n] = rx[i];
  rx_len -= n;
  first_block_decrypted = 0;
  seq_in++;
}

@
\subsection{the key exchange}

What has been said is kept for the hash: the banner of the client ([[client_version]]), our banner, the two KEXINIT messages (as payloads: the message number and all) and later the
rest. The lists in our own KEXINIT are the table at the beginning of the chapter. [[kex_init_ok]] checks that the client's lists contain our algorithms.

<<userland/sshd.c: key exchange>>=
static u8 client_version[256];  static int client_version_len;
static u8 kexinit_c[3072];  static int kexinit_c_len;
static u8 kexinit_s[512];   static int kexinit_s_len;
static u8 session_id[32];

static void send_kexinit (void) {
  u8 *p = kexinit_s;
  *p++ = MSG_KEXINIT;
  sshc_random (p, 16);  p += 16;                                    // the "cookie"
  p += put_text (p, "curve25519-sha256,curve25519-sha256@libssh.org");
  p += put_text (p, "ecdsa-sha2-nistp256");
  p += put_text (p, "aes128-ctr");  p += put_text (p, "aes128-ctr");
  p += put_text (p, "hmac-sha2-256");  p += put_text (p, "hmac-sha2-256");
  p += put_text (p, "none");  p += put_text (p, "none");
  p += put_text (p, "");  p += put_text (p, "");                    // languages
  *p++ = 0;                                                         // no guessed key exchange packet follows
  put32 (p, 0);  p += 4;
  kexinit_s_len = (int)(p - kexinit_s);
  send_packet (kexinit_s, kexinit_s_len);
}

static int kex_init_ok (const u8 *m, int n) {
  int off = 17;                                                     // message number and cookie
  const u8 *l[10];  int len[10];
  for (int i = 0; i < 10; i++) if (!get_string (m, n, &off, &l[i], &len[i])) return 0;
  return (list_has (l[0], len[0], "curve25519-sha256") || list_has (l[0], len[0], "curve25519-sha256@libssh.org"))
      && list_has (l[1], len[1], "ecdsa-sha2-nistp256")
      && list_has (l[2], len[2], "aes128-ctr") && list_has (l[3], len[3], "aes128-ctr")
      && list_has (l[4], len[4], "hmac-sha2-256") && list_has (l[5], len[5], "hmac-sha2-256")
      && list_has (l[6], len[6], "none") && list_has (l[7], len[7], "none");
}

@
The reply to the client's public key. Every piece is built into one buffer in the order of the hash: $H$ = SHA-256 of the strings
[[V_C]], [[V_S]], [[I_C]], [[I_S]], [[K_S]], [[Q_C]], [[Q_S]] and the mpint $K$. The signature is ECDSA over the SHA-256 of $H$ (the algorithm
hashes the data it signs; the data here is $H$) and is sent as a string that contains the name and a string with the mpints $r$ and $s$.
Then the keys are derived: SHA-256 of $K$ (as mpint), $H$, the letter and the session id.

<<userland/sshd.c: key exchange>>=
static void derive (u8 letter, const u8 *k_mpint, int k_len, const u8 *h, u8 *out) {
  u8 buf[4 + 33 + 32 + 1 + 32];
  int n = 0;
  for (int i = 0; i < k_len; i++) buf[n++] = k_mpint[i];
  for (int i = 0; i < 32; i++) buf[n++] = h[i];
  buf[n++] = letter;
  for (int i = 0; i < 32; i++) buf[n++] = session_id[i];
  sshc_sha256 (buf, n, out);
}

static int kex_reply (const u8 *m, int n) {
  int off = 1;
  const u8 *q_c;  int q_c_len;
  static u8 k_s[160], hbuf[6144], reply[512];
  u8 priv[32], q_s[32], shared[32], h[32], hh[32], rs[64];
  if (!get_string (m, n, &off, &q_c, &q_c_len) || q_c_len != 32) return -1;
  sshc_x25519_generate (priv, q_s);
  if (sshc_x25519_shared (q_c, priv, shared) != 0) return -1;

  int ks = 0;                                                       // the host key as a blob: "ecdsa-sha2-nistp256", "nistp256", the point
  ks += put_text (k_s + ks, "ecdsa-sha2-nistp256");  ks += put_text (k_s + ks, "nistp256");  ks += put_string (k_s + ks, hostkey_public, 65);
  u8 k_mpint[40];
  int k_len = put_mpint (k_mpint, shared, 32);

  int hn = 0;
  hn += put_string (hbuf + hn, client_version, client_version_len);
  hn += put_text (hbuf + hn, version_line);
  hn += put_string (hbuf + hn, kexinit_c, kexinit_c_len);
  hn += put_string (hbuf + hn, kexinit_s, kexinit_s_len);
  hn += put_string (hbuf + hn, k_s, ks);
  hn += put_string (hbuf + hn, q_c, 32);
  hn += put_string (hbuf + hn, q_s, 32);
  for (int i = 0; i < k_len; i++) hbuf[hn++] = k_mpint[i];
  sshc_sha256 (hbuf, hn, h);
  for (int i = 0; i < 32; i++) session_id[i] = h[i];                // (the first exchange: H is the session id)

  sshc_sha256 (h, 32, hh);
  if (sshc_sign (hh, rs) != 0) return -1;
  u8 sig_inner[80], sig[120];
  int si = put_mpint (sig_inner, rs, 32);  si += put_mpint (sig_inner + si, rs + 32, 32);
  int sn = put_text (sig, "ecdsa-sha2-nistp256");  sn += put_string (sig + sn, sig_inner, si);

  int rn = 0;
  reply[rn++] = MSG_KEX_ECDH_REPLY;
  rn += put_string (reply + rn, k_s, ks);  rn += put_string (reply + rn, q_s, 32);  rn += put_string (reply + rn, sig, sn);
  send_packet (reply, rn);
  u8 newkeys = MSG_NEWKEYS;
  send_packet (&newkeys, 1);

  u8 iv_c[32], iv_s[32], key_c[32], key_s[32];
  derive ('A', k_mpint, k_len, h, iv_c);   derive ('B', k_mpint, k_len, h, iv_s);
  derive ('C', k_mpint, k_len, h, key_c);  derive ('D', k_mpint, k_len, h, key_s);
  derive ('E', k_mpint, k_len, h, mac_key_in);  derive ('F', k_mpint, k_len, h, mac_key_out);
  sshc_aes_start (0, key_c, iv_c);  sshc_aes_start (1, key_s, iv_s);
  enc_out = 1;                                                      // what we send from now on is encrypted
  for (int i = 0; i < 32; i++) { priv[i] = 0;  shared[i] = 0; }
  return 0;
}

@
\subsection{the messages of the session}

The terminal. What the client types goes into the keyboard buffer of terminal 5 ([[pty_input]]); Enter arrives as CR (a terminal) or LF
(a program that pipes lines), and CR LF counts once. What the programs print is collected by the pseudo terminal ([[pty.c]]); [[pty_get]]
takes it out, and it is sent as [[CHANNEL_DATA]] as far as the client's window allows.

