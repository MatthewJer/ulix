<<userland/sshcrypto.c: random>>=
static br_hmac_drbg_context drbg;

void sshc_seed (const unsigned char *seed, int len) { br_hmac_drbg_init (&drbg, &br_sha256_vtable, seed, len); }
void sshc_random (unsigned char *out, int len)      { br_hmac_drbg_generate (&drbg, out, len); }

@
\emph{Curve25519}: the private key is 32 random bytes, the public key is the point that these bytes (``clamped'': a few bits are fixed) multiply
the base point to. The shared secret is the peer's public key multiplied by our private key: both sides get the same 32 bytes. BearSSL
does the clamping itself. If the peer sends a point of small order the result is all zero, and the exchange must be refused.

<<userland/sshcrypto.c: curve25519>>=
void sshc_x25519_generate (unsigned char *priv, unsigned char *pub) {
  sshc_random (priv, 32);
  br_ec_c25519_m31.mulgen (pub, priv, 32, BR_EC_curve25519);
}

int sshc_x25519_shared (const unsigned char *peer, const unsigned char *priv, unsigned char *out) {
  unsigned char zero = 0;
  memcpy (out, peer, 32);
  if (br_ec_c25519_m31.mul (out, 32, priv, 32, BR_EC_curve25519) != 1) return -1;
  for (int i = 0; i < 32; i++) zero |= out[i];
  return zero ? 0 : -1;
}

@
The host key: the file holds the private scalar of the curve P-256 (secp256r1). The public key is the point in its uncompressed
form (65 bytes: 0x04, x, y), which is what goes into the key blob of the protocol. A signature is two numbers $r$ and $s$ of 32 bytes (64
bytes); BearSSL calculates the nonce of ECDSA from the message and the key (RFC 6979), so no random number is needed for it.

<<userland/sshcrypto.c: host key>>=
static br_ec_private_key host_sk;
static unsigned char host_x[32];

int sshc_hostkey (const unsigned char *private_key, unsigned char *public_key) {
  unsigned char buf[BR_EC_KBUF_PUB_MAX_SIZE];
  br_ec_public_key pk;
  memcpy (host_x, private_key, 32);
  host_sk.curve = BR_EC_secp256r1;  host_sk.x = host_x;  host_sk.xlen = 32;
  if (br_ec_compute_pub (&br_ec_prime_i31, &pk, buf, &host_sk) != 65) return -1;
  memcpy (public_key, pk.q, 65);
  return 0;
}

int sshc_sign (const unsigned char *hash, unsigned char *r_and_s) {
  return br_ecdsa_i31_sign_raw (&br_ec_prime_i31, &br_sha256_vtable, hash, &host_sk, r_and_s) == 64 ? 0 : -1;
}

@
<<userland/sshcrypto.c: hashes>>=
void sshc_sha256 (const void *data, int len, unsigned char *out) {
  br_sha256_context c;
  br_sha256_init (&c);  br_sha256_update (&c, data, len);  br_sha256_out (&c, out);
}

// HMAC-SHA-256 with a 32 byte key over two pieces (the sequence number and the packet)
void sshc_hmac (const unsigned char *key, const void *a, int alen, const void *b, int blen, unsigned char *out) {
  br_hmac_key_context kc;
  br_hmac_context hc;
  br_hmac_key_init (&kc, &br_sha256_vtable, key, 32);
  br_hmac_init (&hc, &kc, 0);
  br_hmac_update (&hc, a, alen);  br_hmac_update (&hc, b, blen);
  br_hmac_out (&hc, out);
}

// a comparison that takes the same time wherever the first difference is (so that nobody can find a valid MAC byte by byte)
int sshc_equal (const unsigned char *a, const unsigned char *b, int n) {
  unsigned char d = 0;
  for (int i = 0; i < n; i++) d |= a[i] ^ b[i];
  return d == 0;
}

@
\emph{AES in counter mode}: the stream of the connection is made by encrypting a counter, one block of 16 bytes at a time, and
adding (XOR) it to the data; decrypting is the same operation. The counter is a 128 bit number that starts with the IV
and counts up for every block, over all packets of the connection. BearSSL's function takes the first 12 bytes as a fixed IV
and counts a 32 bit number in the last four; [[sshc_aes_crypt]] carries over into the IV if that number wraps around (very rare, but it
must be right). Two streams: 0 decrypts what the client sends, 1 encrypts what we send.

<<userland/sshcrypto.c: aes>>=
static struct { br_aes_ct_ctr_keys keys; unsigned char iv[12]; uint32_t counter; } stream[2];

void sshc_aes_start (int which, const unsigned char *key16, const unsigned char *iv16) {
  br_aes_ct_ctr_init (&stream[which].keys, key16, 16);
  memcpy (stream[which].iv, iv16, 12);
  stream[which].counter = ((uint32_t)iv16[12] << 24) | ((uint32_t)iv16[13] << 16) | ((uint32_t)iv16[14] << 8) | iv16[15];
}

void sshc_aes_crypt (int which, unsigned char *data, int len) {            // len is a multiple of 16
  while (len > 0) {
    uint64_t room = (0x100000000ULL - stream[which].counter) * 16;       // bytes until the 32 bit counter wraps
    int part = (uint64_t)len < room ? len : (int)room;
    stream[which].counter = stream[which].keys.vtable->run (&stream[which].keys.vtable, stream[which].iv, stream[which].counter, data, part);
    data += part;  len -= part;
    if (stream[which].counter == 0)                                       // wrapped: add one to the IV (as a number, most significant byte first)
      for (int i = 11; i >= 0; i--) if (++stream[which].iv[i] != 0) break;
  }
}

