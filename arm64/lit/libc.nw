\section{Locale, wide characters and regular expressions: \texttt{localetest}}
\label{src:libc/localetest.c}

There is nothing to port here (issue \#39): musl has all of it in its own source (\texttt{src/locale}, \texttt{src/multibyte}, \texttt{src/regex}, which is TRE, and
the Unicode tables for \texttt{towupper} and friends), and none of it needs a system call. What musl does \emph{not} have is a locale database: there are exactly two
locales, \texttt{C} (bytes above 127 are not characters) and \texttt{C.UTF-8} (UTF-8, a character is one to four bytes); any other name is accepted and behaves like \texttt{C.UTF-8}, musl only keeps the name (so \texttt{setlocale (LC\_ALL, ``de\_DE.UTF-8'')} succeeds and the month names stay English).
There is no \texttt{iconv} for most legacy encodings and no translated messages (\texttt{gettext} finds no files). A program for this system must not rely on more; the
test says what is there. (The kernel's terminal is a text terminal with one byte per character: the program never prints the non-ASCII text, it only works with it.)

<<libc/localetest.c>>=
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <errno.h>
#include <locale.h>
#include <langinfo.h>
#include <wchar.h>
#include <wctype.h>
#include <regex.h>
#include <time.h>

static int fails = 0;
#define CHECK(c, msg) do { if (c) printf ("  user ok:   %s\n", msg); \
                           else { printf ("  user FAIL: %s\n", msg); fails++; } } while (0)

int main (void) {
  const char *text = "Gr\xc3\xbc\xc3\x9f" "e, \xe2\x82\xac";                       // "Grüße, €" in UTF-8: 8 characters, 12 bytes
  wchar_t w[20];

  CHECK (setlocale (LC_ALL, "C.UTF-8") != 0 && !strcmp (nl_langinfo (CODESET), "UTF-8"), "setlocale (LC_ALL, \"C.UTF-8\") works, the code set is UTF-8");
  CHECK (setlocale (LC_ALL, "de_DE.UTF-8") != 0 && !strcmp (nl_langinfo (CODESET), "UTF-8"), "setlocale (LC_ALL, \"de_DE.UTF-8\") is accepted, but it is only C.UTF-8 under another name (musl keeps the name, there is no data)");
  CHECK (!strcmp (nl_langinfo (MON_1), "January") && !strcmp (nl_langinfo (DAY_1), "Sunday"), "so the month and day names are still English");
  setlocale (LC_ALL, "C.UTF-8");

  CHECK (strlen (text) == 12 && mbstowcs (w, text, 20) == 8 && wcslen (w) == 8, "mbstowcs: 12 bytes of UTF-8 are 8 characters; wcslen is 8");
  CHECK (w[2] == 0xfc && w[3] == 0xdf && w[7] == 0x20ac, "the characters are the code points: u-umlaut 0xfc, sharp s 0xdf, euro 0x20ac");
  char back[32];
  CHECK (wcstombs (back, w, sizeof back) == 12 && !strcmp (back, text), "wcstombs turns them back into the same 12 bytes");

  mbstate_t st;  memset (&st, 0, sizeof st);
  wchar_t one;
  CHECK (mbrtowc (&one, "\xe2\x82", 2, &st) == (size_t) -2 && mbrtowc (&one, "\xac", 1, &st) == 1 && one == 0x20ac, "mbrtowc: a character that arrives in two pieces (-2, then 1)");
  memset (&st, 0, sizeof st);
  errno = 0;
  CHECK (mbrtowc (&one, "\xff", 1, &st) == (size_t) -1, "mbrtowc: the byte 0xff is not UTF-8 (-1)");

  CHECK (towupper (0xfc) == 0xdc && towlower (0xc4) == 0xe4 && iswalpha (0xe9) && !iswalpha (0x20ac) && iswupper (0xc9), "towupper, towlower, iswalpha, iswupper work for non-ASCII letters");

  wchar_t line[40];
  swprintf (line, 40, L"%ls|%5.2f|%lc", L"wä", 3.14159, (wint_t) 0x20ac);
  CHECK (!wcscmp (line, L"wä| 3.14|€"), "swprintf with %ls, %f and %lc");

  regex_t re;
  regmatch_t m[3];
  CHECK (regcomp (&re, "^([a-z]+)@([a-z]+)\\.org$", REG_EXTENDED) == 0 && regexec (&re, "ulix@example.org", 3, m, 0) == 0 &&
         m[1].rm_so == 0 && m[1].rm_eo == 4 && m[2].rm_so == 5 && m[2].rm_eo == 12, "regcomp and regexec (extended): the groups of an e-mail address are found");
  CHECK (regexec (&re, "ulix@example.com", 0, 0, 0) == REG_NOMATCH, "regexec: no match for a .com address");
  regfree (&re);
  CHECK (regcomp (&re, "gr.\\{1,2\\}e", REG_ICASE) == 0 && regexec (&re, text, 0, 0, 0) == 0, "a basic regular expression with REG_ICASE matches \"Gr\xc3\xbc\xc3\x9f" "e\" (the dot is one character, two bytes)");
  regfree (&re);

  struct tm t;
  memset (&t, 0, sizeof t);
  t.tm_year = 126;  t.tm_mon = 10;  t.tm_mday = 13;  t.tm_hour = 9;  t.tm_min = 5;  t.tm_sec = 7;  t.tm_wday = 5;
  char date[64];
  CHECK (strftime (date, sizeof date, "%Y-%m-%d %H:%M:%S %a %b", &t) == 27 && !strcmp (date, "2026-11-13 09:05:07 Fri Nov"), "strftime: ISO date and the English day and month names");

  CHECK (strcoll ("apple", "banana") < 0 && strtod ("3.5", 0) == 3.5, "strcoll (bytewise) and strtod (decimal point) in the C.UTF-8 locale");
  return fails;
}
