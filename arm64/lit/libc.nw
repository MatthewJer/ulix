extern struct mx_filestat mx_status[];
#define FS_PIPE_NR 4                                            // the file system number of pipes (pipes.c)

struct kstat {                                                  // struct stat of Linux/AArch64, 128 bytes
  u64 st_dev, st_ino;
  unsigned st_mode, st_nlink, st_uid, st_gid;
  u64 st_rdev, pad1;
  long st_size;
  int st_blksize, pad2;
  long st_blocks;
  long atime, atime_ns, mtime, mtime_ns, ctime, ctime_ns;
  unsigned unused[2];
};

static void kstat_clear (struct kstat *k) { memset (k, 0, sizeof *k); k->st_blksize = 1024; k->st_nlink = 1; }

static void kstat_from_book (struct kstat *k, struct stat *s) {
  kstat_clear (k);
  k->st_dev = s->st_dev;  k->st_ino = s->st_ino;  k->st_mode = s->st_mode;  k->st_nlink = s->st_nlink;
  k->st_uid = s->st_uid;  k->st_gid = s->st_gid;  k->st_rdev = s->st_rdev;  k->st_size = s->st_size;
  k->st_blocks = (s->st_size + 511) / 512;
  k->atime = s->st_atime;  k->mtime = s->st_mtime;  k->ctime = s->st_ctime;
}

static long linux_fstat (int fd, struct kstat *k) {
  if (!user_ok ((u64) k, sizeof *k, 1)) return -LE_EFAULT;
  int gfd = pfd2gfd (fd);
  if (fd < 0 || gfd == -1) return -LE_EBADF;
  kstat_clear (k);
  if (gfd < 0 || (gfd >> 8) == FS_DEV || (gfd >> 8) == 5) { k->st_mode = S_IFCHR | 0620; return 0; }    // the terminal (negative numbers) and the devices
  if ((gfd >> 8) == FS_PIPE_NR)        { k->st_mode = S_IFIFO | 0600; return 0; }
  if ((gfd >> 8) != FS_MINIX) return -LE_EBADF;
  struct int_minix2_inode *in = mx_status[gfd & 0xff].int_inode;
  if (!in) return -LE_EBADF;
  k->st_dev = in->device;  k->st_ino = in->ino;  k->st_mode = in->i_mode;  k->st_nlink = in->i_nlinks;
  k->st_uid = in->i_uid;   k->st_gid = in->i_gid;  k->st_size = in->i_size;  k->st_blocks = (in->i_size + 511) / 512;
  k->atime = in->i_atime;  k->mtime = in->i_mtime;  k->ctime = in->i_ctime;
  return 0;
}

#define AT_EMPTY_PATH 0x1000

// stat, lstat and fstat: musl's stat () is newfstatat (AT_FDCWD, path); the file system does not follow links in stat
static long linux_newfstatat (int dirfd, const char *path, struct kstat *k, int flags) {
  if (!user_string_ok ((u64) path) || !user_ok ((u64) k, sizeof *k, 1)) return -LE_EFAULT;
  if (path[0] == 0) return (flags & AT_EMPTY_PATH) ? linux_fstat (dirfd, k) : -LE_ENOENT;
  char nbuf[FD_PATH];  long err = 0;
  if (!(path = at_name (dirfd, path, nbuf, &err))) return err;
  struct stat st = { 0 };
  if (u_stat (path, &st) != 0) return -LE_ENOENT;
  kstat_from_book (k, &st);
  return 0;
}

@
\paragraph{Directories.} A program reads a directory with \texttt{getdents64}: the descriptor is a directory that was opened with
\texttt{open}, and the call fills a buffer with as many variable-length records as fit. The Minix directory is an array of entries of 32 bytes (a 2-byte inode number and a 30-byte name; version 2) or 64 bytes (4 and 60; version 3), and the position of the open file, in bytes, is the position in that array,
so that \texttt{lseek (fd, 0, SEEK\_SET)} (\texttt{rewinddir}) works without any new code. Free entries (inode 0) are skipped. The
type of each entry is read from its inode (musl's \texttt{readdir} passes it on as \texttt{d\_type}).

<<linux_abi.c: file status, directories and descriptors>>=
#define DT_DIR_ 4
#define DT_REG_ 8

static long linux_getdents64 (int fd, char *buf, u64 size) {
  int gfd = pfd2gfd (fd);
  if (fd < 0 || gfd < 0 || (gfd >> 8) != FS_MINIX || !mx_status[gfd & 0xff].int_inode) return -LE_EBADF;
  struct mx_filestat *f = &mx_status[gfd & 0xff];
  struct int_minix2_inode *dir = f->int_inode;
  if ((dir->i_mode & S_IFMT) != S_IFDIR) return -LE_ENOTDIR;
  if (!user_ok ((u64) buf, size, 1)) return -LE_EFAULT;
  u64 used = 0;
  while (f->pos < (int) dir->i_size) {
    struct minix_dir_entry d;
    int esize = mx_dirent_size (dir->device);                   // 32 bytes (version 2) or 64 bytes (version 3)
    if (mx_read_dir_entry (dir->device, dir->ino, f->pos / esize, &d) == -1) break;
    if (d.inode == 0) { f->pos += esize; continue; }             // a free slot
    int n = 0;
    while (n < MX_MAX_NAME && d.name[n]) n++;
    u64 reclen = (19 + n + 1 + 7) & ~7UL;                        // d_ino, d_off, d_reclen, d_type, the name with its zero, padded to 8
    if (used + reclen > size) return used ? (long) used : -LE_EINVAL;   // the buffer is too small for even one entry
    struct minix2_inode ino;
    int type = 0;
    if (mx_read_inode (dir->device, d.inode, &ino)) type = (ino.i_mode & S_IFMT) == S_IFDIR ? DT_DIR_ : (ino.i_mode & S_IFMT) == S_IFREG ? DT_REG_ : 0;
    char *e = buf + used;
    f->pos += esize;
    *(u64 *) e = d.inode;                                        // d_ino
    *(long *) (e + 8) = f->pos;                                  // d_off: where the next call goes on
    *(unsigned short *) (e + 16) = reclen;
    e[18] = type;
    memcpy (e + 19, d.name, n);
    e[19 + n] = 0;
    used += reclen;
  }
  return used;
}

@
\paragraph{Descriptors.} \texttt{dup}, \texttt{dup3} and \texttt{fcntl (F\_DUPFD)} copy an entry of the process's descriptor table with
\texttt{u\_share}, the function that \texttt{fork} uses (chapter~\ref{ch:pipes}). For a file that gives a second descriptor of the \emph{same} open file,
so both share the read/write position as in Unix (the book's \texttt{u\_reopen} made a copy with its own position); for a pipe end it is one more user of
the same end. The table has 16 entries (\texttt{MAX\_PFD} of the book; the Makefile variable \texttt{PORT\_PFD} can change it, see section~50 of \texttt{ARM64-PORT.md}
for why it is not larger), so \texttt{EMFILE} comes early; \texttt{open} now gives the file back when there is no free entry. \texttt{pipe2} and \texttt{dup3} use the
book's calls from \texttt{pipes.c}; the flags \texttt{O\_CLOEXEC} and \texttt{O\_NONBLOCK} are accepted and ignored (a descriptor
is never closed by \texttt{exec} yet, and reads on pipes always block).

<<linux_abi.c: file status, directories and descriptors>>=
extern void syscall_pipe (context_t *r), syscall_dup2 (context_t *r);

static long linux_dup_from (int old, int from) {
  TCB *t = &thread_table[thread_table[current_task].pid];
  int gfd = pfd2gfd (old);
  if (old < 0 || old >= MAX_PFD || gfd == -1) return -LE_EBADF;
  if (from < 0 || from >= MAX_PFD) return -LE_EINVAL;
  for (int pfd = from; pfd < MAX_PFD; pfd++)
    if (t->files[pfd] == -1) { t->files[pfd] = gfd >= 0 ? u_share (gfd) : gfd;  copy_fd_path (gfd, t->files[pfd]);  return pfd; }
  return -LE_EMFILE;
}

static long linux_dup3 (context_t *r, int old, int new, int flags) {
  if (old == new) return -LE_EINVAL;                             // (dup2 allows it, dup3 does not)
  if (flags & ~02000000) return -LE_EINVAL;
  int k = ulix_call (r, syscall_dup2, old, new, 0, 0, 0);
  if (k >= 0) copy_fd_path (pfd2gfd (old), pfd2gfd (k));
  return k < 0 ? -LE_EBADF : k;
}

static long linux_pipe2 (context_t *r, int *fds, int flags) {
  if (!user_ok ((u64) fds, 8, 1)) return -LE_EFAULT;
  int k = ulix_call (r, syscall_pipe, (long) fds, 0, 0, 0, 0);
  return k < 0 ? -LE_EMFILE : 0;
}

#define F_DUPFD 0
#define F_GETFD 1
#define F_SETFD 2
#define F_GETFL 3
#define F_SETFL 4
#define F_DUPFD_CLOEXEC 1030

static long linux_fcntl (int fd, int cmd, long arg) {
  int gfd = pfd2gfd (fd);
  if (fd < 0 || gfd == -1) return -LE_EBADF;
  switch (cmd) {
    case F_DUPFD: case F_DUPFD_CLOEXEC: return linux_dup_from (fd, arg);
    case F_GETFD: case F_SETFD: return 0;                        // no close-on-exec yet
    case F_SETFL: if (is_sock (gfd)) sock_set_nonblock (gfd, (arg & LO_NONBLOCK) != 0);  return 0;      // (only sockets can be non-blocking)
    case F_GETFL: {                                              // the access mode (and append) that the file was opened with
      if (is_sock (gfd)) return 2 | (sock_is_nonblock (gfd) ? LO_NONBLOCK : 0);
      if (gfd < 0 || (gfd >> 8) != FS_MINIX) return gfd >= 0 && (gfd >> 8) == FS_PIPE_NR ? ((gfd & 1) ? 1 : 0) : 2;
      int m = mx_status[gfd & 0xff].mode;
      return (m & 3) | ((m & O_APPEND) ? LO_APPEND : 0);
    }
    // record locks (SQLite and others ask): the kernel has no lock table, so a lock is always granted and nobody else is ever found holding one
    case 5: if (!user_ok ((u64) arg, 32, 1)) return -LE_EFAULT;  *(short *) arg = 2;  return 0;          // F_GETLK: struct flock, l_type = F_UNLCK
    case 6: case 7: return 0;                                    // F_SETLK, F_SETLKW
  }
  return -LE_EINVAL;
}

// the limits of a process: nothing is limited except the number of open files (the table of descriptors) and the stack
struct rlim { unsigned long cur, max; };
static void rlimit_of (int res, struct rlim *r) {
  r->cur = r->max = ~0UL;                                      // RLIM_INFINITY
  if (res == 7) r->cur = r->max = MAX_PFD;                     // RLIMIT_NOFILE
  if (res == 3) r->cur = r->max = 64UL << 20;                  // RLIMIT_STACK: the stack grows by itself up to 64 MByte
}

static long linux_getrlimit (int res, struct rlim *r) {
  if (res < 0 || res > 15) return -LE_EINVAL;
  if (!user_ok ((u64) r, sizeof *r, 1)) return -LE_EFAULT;
  rlimit_of (res, r);
  return 0;
}

static long linux_prlimit64 (int pid, int res, const struct rlim *new, struct rlim *old) {
  if (pid != 0 && pid != thread_table[current_task].pid) return -LE_ESRCH;
  if (res < 0 || res > 15) return -LE_EINVAL;
  if (new) return -LE_EPERM;                                   // nothing can be changed
  if (old) {
    if (!user_ok ((u64) old, sizeof *old, 1)) return -LE_EFAULT;
    rlimit_of (res, old);
  }
  return 0;
}

#define LE_EFBIG_ 27
extern int u_lseek (int gfd, int offset, int whence), u_write (int gfd, void *buf, int n);
static long linux_ftruncate (int fd, long length) {
  int gfd = pfd2gfd (fd);
  if (fd < 0 || gfd < 0 || (gfd >> 8) != FS_MINIX) return -LE_EBADF;
  struct int_minix2_inode *in = mx_status[gfd & 0xff].int_inode;
  if (in && (long) in->i_size == length) return 0;             // nothing to cut off (the book refuses that: open (..., O_CREAT | O_TRUNC) of a new file failed)
  if (in && length > (long) in->i_size) {                      // growing: the book's ftruncate only cuts, so the new part is written as zeros
    static char zeros[1024];
    long here = u_lseek (gfd, 0, 1), at = in->i_size;
    u_lseek (gfd, at, 0);
    while (at < length) { int n = length - at < 1024 ? (int) (length - at) : 1024;  if (u_write (gfd, zeros, n) != n) { u_lseek (gfd, here, 0);  return -LE_EFBIG_; }  at += n; }
    u_lseek (gfd, here, 0);
    return 0;
  }
  return u_ftruncate (gfd, length) < 0 ? -LE_EACCES : 0;
}

static long linux_readlinkat (int dirfd, const char *path, char *buf, u64 size) {
  if (!user_string_ok ((u64) path) || !user_ok ((u64) buf, size, 1)) return -LE_EFAULT;
  char nbuf[FD_PATH];  long err = 0;
  if (!(path = at_name (dirfd, path, nbuf, &err))) return err;
  struct stat st = { 0 };
  if (u_stat (path, &st) != 0) return -LE_ENOENT;
  if ((st.st_mode & S_IFMT) != S_IFLNK) return -LE_EINVAL;
  int n = u_readlink ((char *) path, buf, size);
  return n < 0 ? -LE_EINVAL : n;
}

@
\paragraph{Rename.} The book has no \texttt{rename}. A file gets its new name by a hard link and loses the old one (\texttt{u\_link}, then
\texttt{u\_unlink}), and an existing target is removed first, as \texttt{rename} replaces it. That is not atomic (a crash between the two steps
leaves both names), and directories cannot be renamed this way (the link count of \texttt{..} would be wrong), so they are refused
with \texttt{EPERM}. CPython writes its compiled modules under a temporary name and renames them; without this call it would only
say nothing and go on.

<<linux_abi.c: file status, directories and descriptors>>=
static long linux_renameat (int olddir, const char *old, int newdir, const char *new) {
  if (!user_string_ok ((u64) old) || !user_string_ok ((u64) new)) return -LE_EFAULT;
  char obuf[FD_PATH], nbuf[FD_PATH];  long err = 0;
  if (!(old = at_name (olddir, old, obuf, &err)) || !(new = at_name (newdir, new, nbuf, &err))) return err;
  struct stat st = { 0 }, st2 = { 0 };
  if (u_stat (old, &st) != 0) return -LE_ENOENT;
  if ((st.st_mode & S_IFMT) == S_IFDIR) return -LE_EPERM;
  if (u_stat (new, &st2) == 0) {
    if ((st2.st_mode & S_IFMT) == S_IFDIR) return -LE_EISDIR;
    if (st2.st_ino == st.st_ino && st2.st_dev == st.st_dev) return 0;       // the same file: nothing to do
    if (u_unlink (new) != 0) return -LE_EACCES;
  }
  if (u_link (old, new) != 0) return -LE_EACCES;
  return u_unlink (old) == 0 ? 0 : -LE_EACCES;
}

@
\paragraph{Random numbers.} \texttt{getrandom} (issue \#45) gives what the hardware generator gave (\texttt{random\_get}, chapter
\ref{ch:tls}); the flags only say how to wait or which pool to use, and there is no pool, so they are accepted and ignored. Without a
generator the call fails with \texttt{EIO}, and a program such as the Python interpreter, which wants random numbers for its hash
tables, then says so instead of running with numbers an attacker could guess.

<<linux_abi.c: file status, directories and descriptors>>=
extern int random_get (void *buf, int n);

static long linux_getrandom (char *buf, u64 n, unsigned flags) {
  if (flags & ~7u) return -LE_EINVAL;                            // GRND_NONBLOCK, GRND_RANDOM, GRND_INSECURE
  if (!user_ok ((u64) buf, n, 1)) return -LE_EFAULT;
  char tmp[256];
  u64 done = 0;
  while (done < n) {
    u64 part = n - done < sizeof tmp ? n - done : sizeof tmp;
    if (random_get (tmp, part) < 0) return done ? (long) done : -5;      // EIO
    memcpy (buf + done, tmp, part);
    done += part;
  }
  return done;
}

@
\subsection{Sockets and \texttt{poll}}
\label{sec:libc:sockets}

The sockets themselves are chapter \ref{ch:sockets}; this is the translation. A socket address of Linux is a \texttt{struct sockaddr\_in}: the family
(2 for IPv4) and then port and address in \emph{network} byte order, the network stack of the kernel keeps host order. IPv6 addresses (\texttt{sockaddr\_in6}) are translated, too, but only datagram sockets can be IPv6 (the family of a socket decides which addresses it takes). Every other family is
refused with \texttt{EAFNOSUPPORT} (which is what the resolver of musl expects when it tries IPv6 first). \texttt{sendmsg}/\texttt{recvmsg} (without ancillary data), \texttt{MSG\_PEEK}, and the socket options \texttt{SO\_ERROR} and \texttt{SO\_RCVTIMEO} are here and in chapter \ref{ch:sockets}. \texttt{listen} and \texttt{accept} (\texttt{accept4}) are translated, too (chapter \ref{ch:sockets}: a server socket). \texttt{ppoll} and \texttt{pselect6} look at every descriptor in the list: a socket or a pipe knows whether it can be
read or written; a file or a device is always ready (a read on it may take time but does not wait for somebody else), and so is the terminal for input
(a read waits, but there is no call that asks the terminal driver for a key without taking it). If nothing is ready the call waits in a loop like the others do,
until the time is up or a signal arrives.

<<linux_abi.c: sockets and poll>>=
struct saddr { int v6; unsigned ip; unsigned char ip6[16]; unsigned short port; };      // an address of a socket, host byte order (as in sockets.c)
extern int  sock_new (int family, int type, int nonblock), sock_close (int gfd), sock_bind (int gfd, const struct saddr *a);
extern int  sock_connect (int gfd, const struct saddr *a), sock_shutdown (int gfd, int how), sock_ready (int gfd), is_sock (int gfd);
extern int  sock_name (int gfd, int peer, struct saddr *a), sock_type (int gfd), sock_is_nonblock (int gfd), sock_error (int gfd);
extern long sock_send (int gfd, const void *buf, u64 n, const struct saddr *to);
extern long sock_recv (int gfd, void *buf, u64 n, struct saddr *from, int flags);
extern void sock_set_nonblock (int gfd, int on), sock_set_rcvtimeo (int gfd, long ms);
extern long sock_get_rcvtimeo (int gfd);
extern int  pipe_ready (int gfd);
extern int  net_poll_once (void);
extern int  gfd2pfd (int gfd);

#define LE_EAFNOSUPPORT 97
#define LE_ENOTSOCK     88
#define SOCK_NONBLOCK_  04000
#define MSG_DONTWAIT    0x40
#define MSG_PEEK        0x02
#define LE_EMSGSIZE     90

struct sockaddr_in_  { unsigned short family; unsigned char port[2], addr[4], zero[8]; };
struct sockaddr_in6_ { unsigned short family; unsigned char port[2]; unsigned flowinfo; unsigned char addr[16]; unsigned scope_id; };

// the address of a program (family 2 or 10) as a struct saddr; any other family is EAFNOSUPPORT
static int get_sockaddr (const void *p, u64 len, struct saddr *a) {
  if (!p || len < 2 || !user_ok ((u64) p, len < 28 ? len : 28, 0)) return -LE_EFAULT;
  unsigned short family = *(const unsigned short *) p;
  memset (a, 0, sizeof *a);
  if (family == 2 && len >= sizeof (struct sockaddr_in_)) {
    const struct sockaddr_in_ *in = p;
    a->port = (in->port[0] << 8) | in->port[1];
    a->ip = ((unsigned) in->addr[0] << 24) | (in->addr[1] << 16) | (in->addr[2] << 8) | in->addr[3];
    return 0;
  }
  if (family == 10 && len >= sizeof (struct sockaddr_in6_)) {
    const struct sockaddr_in6_ *in6 = p;
    a->v6 = 1;  a->port = (in6->port[0] << 8) | in6->port[1];
    memcpy (a->ip6, in6->addr, 16);
    return 0;
  }
  return (family == 2 || family == 10) ? -LE_EINVAL : -LE_EAFNOSUPPORT;
}

// writes the address (and its length, if the program asked for it): the caller has checked that the pointers are good
static void put_sockaddr (void *p, unsigned *len, const struct saddr *s) {
  union { struct sockaddr_in_ in;  struct sockaddr_in6_ in6; } a;
  unsigned size;
  memset (&a, 0, sizeof a);
  if (s->v6) {
    a.in6.family = 10;  a.in6.port[0] = s->port >> 8;  a.in6.port[1] = s->port & 255;  memcpy (a.in6.addr, s->ip6, 16);
    size = sizeof a.in6;
  } else {
    a.in.family = 2;  a.in.port[0] = s->port >> 8;  a.in.port[1] = s->port & 255;
    a.in.addr[0] = s->ip >> 24;  a.in.addr[1] = s->ip >> 16;  a.in.addr[2] = s->ip >> 8;  a.in.addr[3] = s->ip;
    size = sizeof a.in;
  }
  if (!p) return;
  unsigned room = len ? *len : size;
  memcpy (p, &a, room < size ? room : size);
  if (len) *len = size;
}

static int sock_arg (int fd, long *err) {                 // the global descriptor of a socket, or -1 and the error
  int gfd = pfd2gfd (fd);
  if (fd < 0 || gfd == -1) { *err = -LE_EBADF;  return -1; }
  if (!is_sock (gfd)) { *err = -LE_ENOTSOCK;  return -1; }
  return gfd;
}

static long linux_socket (int domain, int type, int protocol) {
  if (domain != 2 && domain != 10) return -LE_EAFNOSUPPORT;
  int gfd = sock_new (domain, type & 0xf, (type & SOCK_NONBLOCK_) != 0);
  if (gfd < 0) return linux_error (LE_EMFILE);
  int pfd = gfd2pfd (gfd);
  if (pfd < 0) { sock_close (gfd);  return -LE_EMFILE; }
  return pfd;
}

// socketpair (AF_UNIX, SOCK_STREAM): two connected sockets for the program's own use (chapter \ref{ch:sockets})
static long linux_socketpair (context_t *r, int domain, int type, int protocol, int *sv) {
  if (domain != 1) return -LE_EAFNOSUPPORT;
  if ((type & 0xf) != 1) return -LE_EINVAL;
  if (!user_ok ((u64) sv, 8, 1)) return -LE_EFAULT;
  int g0, g1;
  if (sock_pair (&g0, &g1, (type & SOCK_NONBLOCK_) != 0) < 0) return linux_error (LE_EMFILE);
  int p0 = gfd2pfd (g0), p1 = p0 < 0 ? -1 : gfd2pfd (g1);
  if (p1 < 0) { if (p0 >= 0) ulix_call (r, syscall_close, p0, 0, 0, 0, 0);  sock_close (g0);  sock_close (g1);  return -LE_EMFILE; }
  sv[0] = p0;  sv[1] = p1;
  return 0;
}

static long linux_connect_or_bind (int fd, const void *addr, u64 len, int connect) {
  long e;  int gfd = sock_arg (fd, &e);
  struct saddr a;
  if (gfd < 0) return e;
  if ((e = get_sockaddr (addr, len, &a)) != 0) return e;
  return connect ? sock_connect (gfd, &a) : sock_bind (gfd, &a);
}

static long linux_sendto (int fd, const void *buf, u64 n, int flags, const void *addr, u64 alen) {
  long e;  int gfd = sock_arg (fd, &e);
  struct saddr a;
  if (gfd < 0) return e;
  if (!user_ok ((u64) buf, n, 0)) return -LE_EFAULT;
  if (addr && (e = get_sockaddr (addr, alen, &a)) != 0) return e;
  return sock_send (gfd, buf, n, addr ? &a : 0);
}

static long linux_recvfrom (int fd, void *buf, u64 n, int flags, void *addr, unsigned *alen) {
  long e;  int gfd = sock_arg (fd, &e);
  struct saddr a;
  if (gfd < 0) return e;
  if (!user_ok ((u64) buf, n, 1) || (addr && (!alen || !user_ok ((u64) alen, 4, 1) || !user_ok ((u64) addr, *alen, 1)))) return -LE_EFAULT;
  long k = sock_recv (gfd, buf, n, &a, flags & (MSG_DONTWAIT | MSG_PEEK));
  if (k >= 0) put_sockaddr (addr, alen, &a);
  return k;
}

// listen and accept (accept4 adds SOCK_NONBLOCK for the new socket)
static long linux_listen (int fd, int backlog) {
  long e;  int gfd = sock_arg (fd, &e);
  return gfd < 0 ? e : sock_listen (gfd, backlog);
}

static long linux_accept (int fd, void *addr, unsigned *alen, int flags) {
  long e;  int gfd = sock_arg (fd, &e);
  if (gfd < 0) return e;
  if (addr && (!alen || !user_ok ((u64) alen, 4, 1) || !user_ok ((u64) addr, *alen, 1))) return -LE_EFAULT;
  int ng;  unsigned ip;  unsigned short port;
  if ((e = sock_accept (gfd, &ng, &ip, &port, (flags & SOCK_NONBLOCK_) != 0)) != 0) return e;
  int pfd = gfd2pfd (ng);
  if (pfd < 0) { sock_close (ng);  return -LE_EMFILE; }
  struct saddr a = { 0, ip, { 0 }, port };
  put_sockaddr (addr, alen, &a);
  return pfd;
}

static long linux_getname (int fd, void *addr, unsigned *alen, int peer) {
  long e;  int gfd = sock_arg (fd, &e);
  struct saddr a;
  if (gfd < 0) return e;
  if (!alen || !user_ok ((u64) alen, 4, 1) || !user_ok ((u64) addr, *alen, 1)) return -LE_EFAULT;
  if ((e = sock_name (gfd, peer, &a)) != 0) return e;
  put_sockaddr (addr, alen, &a);
  return 0;
}

#define SOL_SOCKET  1
#define SO_TYPE     3
#define SO_ERROR    4
#define SO_RCVTIMEO 20                 // (the one with a 64-bit struct timeval, which is what musl uses on AArch64)

struct timeval_ { long sec, usec; };

// options are accepted and ignored, except three: SO_TYPE, SO_ERROR (the failed connect of a non-blocking socket; reading it clears it) and
// SO_RCVTIMEO (how long a receive call waits, as a struct timeval; 0 is for ever)
static long linux_getsockopt (int fd, int level, int opt, void *val, unsigned *len) {
  long e;  int gfd = sock_arg (fd, &e);
  if (gfd < 0) return e;
  if (!val || !len || !user_ok ((u64) len, 4, 1) || !user_ok ((u64) val, *len, 1)) return -LE_EFAULT;
  if (level == SOL_SOCKET && opt == SO_RCVTIMEO) {
    long ms = sock_get_rcvtimeo (gfd);
    struct timeval_ tv = { ms / 1000, ms % 1000 * 1000 };
    if (*len < sizeof tv) return -LE_EINVAL;
    memcpy (val, &tv, sizeof tv);  *len = sizeof tv;
    return 0;
  }
  if (*len < 4) return -LE_EINVAL;
  int v = 0;
  if (level == SOL_SOCKET && opt == SO_TYPE) v = sock_type (gfd);
  if (level == SOL_SOCKET && opt == SO_ERROR) v = sock_error (gfd);
  memcpy (val, &v, 4);  *len = 4;
  return 0;
}

static long linux_setsockopt (int fd, int level, int opt, const void *val, unsigned len) {
  long e;  int gfd = sock_arg (fd, &e);
  if (gfd < 0) return e;
  if (level == SOL_SOCKET && opt == SO_RCVTIMEO) {
    if (!val || len < sizeof (struct timeval_) || !user_ok ((u64) val, sizeof (struct timeval_), 0)) return -LE_EINVAL;
    const struct timeval_ *tv = val;
    if (tv->sec < 0 || tv->usec < 0 || tv->usec >= 1000000) return -LE_EINVAL;
    sock_set_rcvtimeo (gfd, tv->sec * 1000 + (tv->usec + 999) / 1000);              // (a tiny time is rounded up: 0 would mean for ever)
  }
  return 0;
}

// sendmsg and recvmsg: the same as sendto and recvfrom, with the data in several pieces (iov) and the address in a struct. A datagram is put together in
// (or taken apart from) a buffer on the stack, as it is only one frame long. The ancillary data (msg_control) is not supported: none is ever received
// and none is sent (it is ignored), msg_controllen is set to 0 and msg_flags to 0 (a datagram that is too long is cut without MSG_TRUNC).
struct msghdr_ { void *name; unsigned namelen, pad1; struct iovec *iov; long iovlen; void *control; long controllen; int flags, pad2; };

static long msg_check (struct msghdr_ *m, int write, u64 *total) {
  if (!user_ok ((u64) m, sizeof *m, 1)) return -LE_EFAULT;
  if (m->iovlen < 0 || m->iovlen > 1024 || !user_ok ((u64) m->iov, m->iovlen * sizeof (struct iovec), 0)) return -LE_EFAULT;
  *total = 0;
  for (long i = 0; i < m->iovlen; i++) {
    if (!user_ok ((u64) m->iov[i].base, m->iov[i].len, write)) return -LE_EFAULT;
    *total += m->iov[i].len;
  }
  return 0;
}

static long linux_sendmsg (int fd, struct msghdr_ *m, int flags) {
  long e;  int gfd = sock_arg (fd, &e);
  u64 total;
  struct saddr a;
  if (gfd < 0) return e;
  if ((e = msg_check (m, 0, &total)) != 0) return e;
  if (m->name && (e = get_sockaddr (m->name, m->namelen, &a)) != 0) return e;
  if (sock_type (gfd) == 2) {                                          // a datagram: all pieces in one buffer
    unsigned char buf[1472];
    if (total > sizeof buf) return -LE_EMSGSIZE;
    u64 at = 0;
    for (long i = 0; i < m->iovlen; i++) { memcpy (buf + at, m->iov[i].base, m->iov[i].len);  at += m->iov[i].len; }
    return sock_send (gfd, buf, total, m->name ? &a : 0);
  }
  long sent = 0;                                                       // a stream: one piece after the other
  for (long i = 0; i < m->iovlen; i++) {
    if (!m->iov[i].len) continue;
    long k = sock_send (gfd, m->iov[i].base, m->iov[i].len, 0);
    if (k < 0) return sent ? sent : k;
    sent += k;
    if ((u64) k < m->iov[i].len) break;
  }
  return sent;
}

static long linux_recvmsg (int fd, struct msghdr_ *m, int flags) {
  long e;  int gfd = sock_arg (fd, &e);
  u64 total;
  struct saddr a;
  if (gfd < 0) return e;
  if ((e = msg_check (m, 1, &total)) != 0) return e;
  if (m->name && !user_ok ((u64) m->name, m->namelen, 1)) return -LE_EFAULT;
  unsigned char buf[1472];                                             // (a stream gives what fits here: a short read is allowed)
  long k = sock_recv (gfd, buf, total < sizeof buf ? total : sizeof buf, &a, flags & (MSG_DONTWAIT | MSG_PEEK));
  if (k < 0) return k;
  u64 at = 0;
  for (long i = 0; i < m->iovlen && at < (u64) k; i++) {
    u64 part = m->iov[i].len < (u64) k - at ? m->iov[i].len : (u64) k - at;
    memcpy (m->iov[i].base, buf + at, part);  at += part;
  }
  if (m->name) put_sockaddr (m->name, &m->namelen, &a);
  m->controllen = 0;  m->flags = 0;
  return k;
}

static long linux_shutdown (int fd, int how) { long e;  int gfd = sock_arg (fd, &e);  return gfd < 0 ? e : sock_shutdown (gfd, how); }

