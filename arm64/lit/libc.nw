\section{Existing programs on musl: \texttt{cat}, \texttt{ls} and a test of the file calls}
\label{src:libc/filetest.c}

The 59 tools of the book are written for the book's own library and the tiny \texttt{ulib}; moving them all to musl is a long
road (issue \#35). The first step is the file system calls that every tool needs --- \texttt{fstat}, \texttt{getdents64},
\texttt{dup3}, \texttt{pipe2}, \texttt{fcntl}, \texttt{O\_TRUNC} --- and two programs that show they work: \texttt{cat} and
\texttt{ls}, written the way a Unix textbook writes them (with \texttt{read}/\texttt{write} and \texttt{opendir}/\texttt{readdir}).
The old versions stay in \texttt{/bin}; the musl versions live in the directory \texttt{/musl} on the disk, so that the old
tests keep their numbers (the directory \texttt{/bin} would change the count of its entries).

<<libc/cat.c>>=
#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>

// cat [file ...]: copies the files (or the standard input) to the standard output
static int copy (int fd) {
  char buf[512];
  long n;
  while ((n = read (fd, buf, sizeof buf)) > 0)
    if (write (1, buf, n) != n) return 1;
  return n < 0;
}

int main (int argc, char **argv) {
  int status = 0;
  if (argc == 1) return copy (0);
  for (int i = 1; i < argc; i++) {
    int fd = open (argv[i], O_RDONLY);
    if (fd < 0) { perror (argv[i]); status = 1; continue; }
    status |= copy (fd);
    close (fd);
  }
  return status;
}
@
<<libc/ls.c>>=
#include <stdio.h>
#include <string.h>
#include <dirent.h>
#include <sys/stat.h>

// ls [-l] [dir ...]: the names in a directory, one per line; -l adds type, size and link count (from stat)
static int list (const char *dir, int longform) {
  DIR *d = opendir (dir);
  if (!d) { perror (dir); return 1; }
  struct dirent *e;
  while ((e = readdir (d)) != 0) {
    if (!strcmp (e->d_name, ".") || !strcmp (e->d_name, "..")) continue;
    if (!longform) { printf ("%s\n", e->d_name); continue; }
    char path[300];
    struct stat st;
    snprintf (path, sizeof path, "%s/%s", dir, e->d_name);
    if (stat (path, &st) != 0) { perror (path); continue; }
    printf ("%c %2d %8ld %s\n", S_ISDIR (st.st_mode) ? 'd' : S_ISLNK (st.st_mode) ? 'l' : '-', (int) st.st_nlink, (long) st.st_size, e->d_name);
  }
  closedir (d);
  return 0;
}

int main (int argc, char **argv) {
  int longform = argc > 1 && !strcmp (argv[1], "-l"), first = 1 + longform, status = 0;
  if (first >= argc) return list (".", longform);
  for (int i = first; i < argc; i++) status |= list (argv[i], longform);
  return status;
}
@
The test program checks one call after the other and prints a line \texttt{user ok:} or \texttt{user FAIL:} for each, like the
program of the previous section; it makes a file in the root directory, uses it and removes it again.

<<libc/filetest.c>>=
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <errno.h>
#include <fcntl.h>
#include <unistd.h>
#include <dirent.h>
#include <sys/stat.h>
#include <sys/random.h>

static int fails = 0;
#define CHECK(c, msg) do { if (c) printf ("  user ok:   %s\n", msg); \
                           else { printf ("  user FAIL: %s\n", msg); fails++; } } while (0)

int main (int argc, char **argv) {
  int norandom = argc > 1 && !strcmp (argv[1], "-n");      // -n: this machine has no random number generator (the kernel test asks)
  struct stat st, st2;
  char buf[64];

  // stat and fstat
  CHECK (stat ("/etc/rc.conf", &st) == 0 && S_ISREG (st.st_mode) && st.st_size > 0, "stat: /etc/rc.conf is a regular file with a size");
  int fd = open ("/etc/rc.conf", O_RDONLY);
  CHECK (fd >= 0 && fstat (fd, &st2) == 0 && st2.st_size == st.st_size && st2.st_ino == st.st_ino, "fstat on an open file: same size and inode as stat");
  CHECK (stat ("/bin", &st) == 0 && S_ISDIR (st.st_mode), "stat: /bin is a directory");
  errno = 0;
  CHECK (stat ("/no/such/file", &st) == -1 && errno == ENOENT, "stat of a missing file fails with ENOENT");
  CHECK (fstat (1, &st) == 0 && S_ISCHR (st.st_mode), "fstat (1): the terminal is a character device");
  errno = 0;
  CHECK (fstat (99, &st) == -1 && errno == EBADF, "fstat of a descriptor that is not open: EBADF");

  // directories
  DIR *d = opendir ("/bin");
  int count = 0, found = 0, regular = 0;
  struct dirent *e;
  while (d && (e = readdir (d)) != 0) { count++; if (!strcmp (e->d_name, "cat")) { found = 1; regular = e->d_type == DT_REG; } }
  CHECK (d && count > 50 && found && regular, "opendir/readdir: /bin has more than 50 entries, among them cat (d_type DT_REG)");
  if (d) { rewinddir (d); int again = 0; while (readdir (d)) again++; CHECK (again == count, "rewinddir: the second round has as many entries"); closedir (d); }
  errno = 0;
  CHECK (opendir ("/etc/rc.conf") == 0 && errno == ENOTDIR, "opendir of a file fails with ENOTDIR");

  // writing: O_TRUNC, O_EXCL, ftruncate, lseek, unlink
  const char *name = "/filetest.tmp";
  unlink (name);
  int w = open (name, O_WRONLY | O_CREAT | O_EXCL, 0644);
  CHECK (w >= 0 && write (w, "0123456789", 10) == 10, "open (O_CREAT | O_EXCL) and write");
  errno = 0;
  CHECK (open (name, O_WRONLY | O_CREAT | O_EXCL, 0644) == -1 && errno == EEXIST, "O_CREAT | O_EXCL on an existing file fails with EEXIST");
  close (w);
  w = open (name, O_RDWR | O_TRUNC);
  CHECK (w >= 0 && fstat (w, &st) == 0 && st.st_size == 0, "O_TRUNC: the file is empty after open");
  write (w, "abcdef", 6);
  CHECK (ftruncate (w, 3) == 0 && fstat (w, &st) == 0 && st.st_size == 3, "ftruncate (3)");
  CHECK (lseek (w, 0, SEEK_SET) == 0 && read (w, buf, 10) == 3 && !memcmp (buf, "abc", 3), "lseek and read back what is left");
  close (w);

  // descriptors: dup, dup3, fcntl, pipe2
  int p[2];
  CHECK (pipe2 (p, 0) == 0 && p[0] != p[1], "pipe2");
  int copy = dup (p[1]);
  CHECK (copy > p[1] && write (copy, "xy", 2) == 2 && read (p[0], buf, 2) == 2 && !memcmp (buf, "xy", 2), "dup: a write through the copy arrives at the read end");
  CHECK (dup3 (p[1], 12, 0) == 12 && write (12, "z", 1) == 1 && read (p[0], buf, 1) == 1 && buf[0] == 'z', "dup3 to descriptor 12");
  errno = 0;
  CHECK (dup3 (p[1], p[1], 0) == -1 && errno == EINVAL, "dup3 with the same number twice fails with EINVAL");
  CHECK (fcntl (p[0], F_DUPFD, 14) == 14, "fcntl (F_DUPFD, 14) returns descriptor 14");
  CHECK ((fcntl (p[1], F_GETFL) & O_ACCMODE) == O_WRONLY, "fcntl (F_GETFL) on the write end of a pipe: write only");
  CHECK (fstat (p[0], &st) == 0 && S_ISFIFO (st.st_mode), "fstat on a pipe: FIFO");
  close (12); close (14); close (copy); close (p[0]); close (p[1]);
  CHECK (unlink (name) == 0 && stat (name, &st) == -1, "unlink removes the test file");

  // random numbers and the files that the kernel makes up (issue #45)
  unsigned char r1[32], r2[32];
  int u = open ("/dev/urandom", O_RDONLY), z = open ("/dev/zero", O_RDONLY), n = open ("/dev/null", O_RDWR);
  if (norandom) {
    errno = 0;
    CHECK (u >= 0 && read (u, r1, 32) == -1 && errno == EIO, "no generator: /dev/urandom can be opened, but reading fails with EIO (no made-up numbers)");
    CHECK (getrandom (r2, 32, 0) == -1 && errno == EIO, "no generator: getrandom fails with EIO");
  } else {
    CHECK (u >= 0 && read (u, r1, 32) == 32 && read (u, r2, 32) == 32 && memcmp (r1, r2, 32) != 0, "/dev/urandom: two reads of 32 bytes differ");
    memset (r2, 0, 32);
    CHECK (getrandom (r2, 32, 0) == 32 && memcmp (r1, r2, 32) != 0 && memcmp (r2, "\0\0\0\0\0\0\0\0", 8) != 0, "getrandom (32 bytes) gives other numbers than /dev/urandom");
    char big[1000];
    CHECK (getrandom (big, sizeof big, 0) == sizeof big, "getrandom of 1000 bytes (more than the kernel asks the generator for at once)");
  }
  CHECK (z >= 0 && read (z, r1, 32) == 32 && r1[0] == 0 && r1[31] == 0, "/dev/zero reads zero bytes");
  CHECK (n >= 0, "open (\"/dev/null\", O_RDWR)");
  CHECK (write (n, "gone", 4) == 4, "/dev/null swallows a write of 4 bytes");
  CHECK (read (n, r1, 4) == 0, "/dev/null reads as empty");
  return fails;
}
