extern sighandler_t u_signal (int sig, sighandler_t func);
#define SA_ONSTACK_ 0x08000000

struct k_sigaction { sighandler_t handler; unsigned long flags; void (*restorer) (void); unsigned mask[2]; };   // as musl passes it

static long linux_sigaction (int sig, struct k_sigaction *act, struct k_sigaction *old, u64 size) {
  signal_tables ();
  if (sig < 1 || sig > 31 || !to_ulix[sig] || sig == 9 || sig == 19 || sig == 18) return -LE_EINVAL;   // SIGKILL, SIGSTOP, SIGCONT
  if (size != 8) return -LE_EINVAL;
  int us = to_ulix[sig];
  TCB *t = &thread_table[current_task];
  if (old) {
    if (!user_ok ((u64) old, sizeof *old, 1)) return -LE_EFAULT;
    old->handler = t->sighandlers[us];
    old->flags = (sa_onstack[current_as] >> us) & 1 ? SA_ONSTACK_ : 0; old->restorer = (void (*) (void)) linux_sig_restorer[current_as]; old->mask[0] = old->mask[1] = 0;
  }
  if (act) {
    if (!user_ok ((u64) act, sizeof *act, 0)) return -LE_EFAULT;
    if (act->restorer) linux_sig_restorer[current_as] = (u64) act->restorer;
    t->sighandlers[us] = act->handler;
    if (act->flags & SA_ONSTACK_) sa_onstack[current_as] |= 1U @<< us;  else sa_onstack[current_as] &= ~(1U @<< us);
  }
  return 0;
}

// the stack for signal handlers (sigaltstack): stack_t of Linux/AArch64 is {pointer, int flags, size}
struct stack_t_ { u64 sp; int flags; u64 size; };
#define SS_ONSTACK_ 1
#define SS_DISABLE_ 2
static struct { u64 sp, size; int as; } altstack[MAX_THREADS];

static int on_altstack (u64 sp) {
  int me = current_task;
  return altstack[me].size && altstack[me].as == current_as && sp > altstack[me].sp && sp <= altstack[me].sp + altstack[me].size;
}

static long linux_sigaltstack (struct stack_t_ *ss, struct stack_t_ *old, u64 sp) {
  int me = current_task;
  int valid = altstack[me].size && altstack[me].as == current_as;
  if (old) {
    if (!user_ok ((u64) old, sizeof *old, 1)) return -LE_EFAULT;
    old->sp = valid ? altstack[me].sp : 0;  old->size = valid ? altstack[me].size : 0;
    old->flags = !valid ? SS_DISABLE_ : on_altstack (sp) ? SS_ONSTACK_ : 0;
  }
  if (ss) {
    if (!user_ok ((u64) ss, sizeof *ss, 0)) return -LE_EFAULT;
    if (on_altstack (sp)) return -LE_EPERM;                       // not while a handler runs on it
    if (ss->flags & SS_DISABLE_) { altstack[me].size = 0;  return 0; }
    if (ss->size < 2048) return -LE_ENOMEM;                       // MINSIGSTKSZ
    altstack[me].sp = ss->sp;  altstack[me].size = ss->size;  altstack[me].as = current_as;
  }
  return 0;
}

// where arch_signal_check builds the frame: on the alternate stack if the handler asked for it (SA_ONSTACK) and the thread is not on it already
u64 linux_signal_altstack (int signo, u64 sp) {
  int me = current_task;
  if (!(sa_onstack[current_as] & (1U @<< signo)) || !altstack[me].size || altstack[me].as != current_as || on_altstack (sp)) return sp;
  return altstack[me].sp + altstack[me].size;
}

// the Linux mask (bit n-1 is signal n) from the book's mask (bit n is signal n), and back
static u64 mask_to_linux (unsigned long um) {
  signal_tables ();
  u64 m = 0;
  for (int u = 1; u < 32; u++) if ((um >> u) & 1 && to_linux[u]) m |= 1UL @<< (to_linux[u] - 1);
  return m;
}

static unsigned long mask_to_ulix (u64 lm) {
  unsigned long m = 0;
  for (int l = 1; l < 32; l++) if ((lm >> (l - 1)) & 1 && to_ulix[l]) m |= 1UL @<< to_ulix[l];
  return m & ~((1UL @<< 9) | (1UL @<< 17));                     // SIGKILL and SIGSTOP cannot be blocked
}

static long linux_sigprocmask (int how, u64 *set, u64 *old, u64 size) {
  TCB *t = &thread_table[current_task];
  if (size != 8) return -LE_EINVAL;
  if (old) { if (!user_ok ((u64) old, 8, 1)) return -LE_EFAULT; *old = mask_to_linux (t->sig_blocked); }
  if (set) {
    if (!user_ok ((u64) set, 8, 0)) return -LE_EFAULT;
    unsigned long m = mask_to_ulix (*set);
    switch (how) {
      case 0: t->sig_blocked |= m; break;                     // SIG_BLOCK
      case 1: t->sig_blocked &= ~m; break;                    // SIG_UNBLOCK
      case 2: t->sig_blocked = m; break;                      // SIG_SETMASK
      default: return -LE_EINVAL;
    }
  }
  return 0;
}

// kill, tkill and tgkill: musl's raise () sends the signal to its own thread
static long linux_kill (int pid, int sig) {
  signal_tables ();
  if (sig < 0 || sig > 31 || (sig && !to_ulix[sig])) return -LE_EINVAL;
  if (pid < 1 || pid >= MAX_THREADS || !thread_table[pid].used) return -LE_ESRCH;
  if (thread_table[current_task].euid != 0 && thread_table[pid].euid != thread_table[current_task].euid)
    return -LE_EPERM;                                         // the rule of the book's syscall_kill: root, or the same owner (the programs of the book run on musl now)
  if (sig == 0) return 0;                                     // only asks whether the process exists
  TCB *t = &thread_table[pid];
  int us = to_ulix[sig];
  if (((t->sig_blocked >> us) & 1) && t->sighandlers[us] != SIG_DFL && t->sighandlers[us] != SIG_IGN) {
    t->sig_pending |= 1UL @<< us;                             // blocked: it stays pending until it is unblocked (musl's raise () relies on it)
    return 0;
  }
  return u_kill (pid, to_ulix[sig]) == 0 ? 0 : linux_error (LE_EPERM);
}

