\subsection{Time: \texttt{clock\_gettime}, \texttt{gettimeofday}, \texttt{nanosleep}}

The monotonic clock is the counter of the generic timer (it counts at \texttt{cntfrq\_el0} Hertz from the start of the machine).
The real-time clock is the time that \texttt{arch\_clock\_init} read at start-up (from the real-time clock chip, or a fixed date on
the Raspberry Pi, which has none) plus the time that has passed on the monotonic clock since; setting it from the network is
a later step (SNTP). \texttt{nanosleep} lets the process give up the CPU until the time has passed (the same polling as the
book's \texttt{sleep}: simple first), and it ends early when a signal arrives.

<<linux_abi.c: time>>=
extern unsigned long long clock_start_count;            // arch_clock.c

struct ts { long sec, nsec; };

static unsigned long long counter_ns (void) {           // nanoseconds on the counter, without overflow
  unsigned long long freq, count;
  __asm__ volatile ("mrs %0, cntfrq_el0" : "=r" (freq));
  __asm__ volatile ("mrs %0, cntpct_el0" : "=r" (count));
  return (count / freq) * 1000000000ULL + (count % freq) * 1000000000ULL / freq;
}

static unsigned long long mono_ns (void) { return counter_ns (); }
static unsigned long long real_ns (void) {
  unsigned long long freq;
  __asm__ volatile ("mrs %0, cntfrq_el0" : "=r" (freq));
  unsigned long long start_ns = (clock_start_count / freq) * 1000000000ULL + (clock_start_count % freq) * 1000000000ULL / freq;
  return system_start_time * 1000000000ULL + (counter_ns () - start_ns);
}

#define CLOCK_REALTIME  0
#define CLOCK_MONOTONIC 1

static long linux_clock_gettime (int clk, struct ts *t) {
  if (!user_ok ((u64) t, sizeof *t, 1)) return -LE_EFAULT;
  unsigned long long ns;
  switch (clk) {
    case CLOCK_REALTIME:  ns = real_ns (); break;
    case CLOCK_MONOTONIC: case 4: case 7: ns = mono_ns (); break;      // 4 = MONOTONIC_RAW, 7 = BOOTTIME
    default: return -LE_EINVAL;
  }
  t->sec = ns / 1000000000ULL;
  t->nsec = ns % 1000000000ULL;
  return 0;
}

static long linux_gettimeofday (long *tv, void *tz) {
  if (tv) {
    if (!user_ok ((u64) tv, 16, 1)) return -LE_EFAULT;
    unsigned long long ns = real_ns ();
    tv[0] = ns / 1000000000ULL;
    tv[1] = ns % 1000000000ULL / 1000;
  }
  return 0;
}

// sleep until the clock has reached the time: 0, or -EINTR when a signal arrived (rem gets the time that is left)
static long sleep_until (unsigned long long deadline, int absolute_clock, struct ts *rem) {
  for (;;) {
    unsigned long long now = absolute_clock == CLOCK_REALTIME ? real_ns () : mono_ns ();
    if (now >= deadline) return 0;
    if (thread_table[current_task].sig_pending) {
      if (rem && user_ok ((u64) rem, sizeof *rem, 1)) { rem->sec = (deadline - now) / 1000000000ULL; rem->nsec = (deadline - now) % 1000000000ULL; }
      return -LE_EINTR;
    }
    arch_resign ();
  }
}

static long linux_nanosleep (struct ts *req, struct ts *rem) {
  if (!user_ok ((u64) req, sizeof *req, 0)) return -LE_EFAULT;
  if (req->sec < 0 || req->nsec < 0 || req->nsec >= 1000000000L) return -LE_EINVAL;
  return sleep_until (mono_ns () + req->sec * 1000000000ULL + req->nsec, CLOCK_MONOTONIC, rem);
}

static long linux_clock_nanosleep (int clk, int flags, struct ts *req, struct ts *rem) {
  if (clk != CLOCK_REALTIME && clk != CLOCK_MONOTONIC) return -LE_EINVAL;
  if (!user_ok ((u64) req, sizeof *req, 0)) return -LE_EFAULT;
  if (req->sec < 0 || req->nsec < 0 || req->nsec >= 1000000000L) return -LE_EINVAL;
  unsigned long long t = req->sec * 1000000000ULL + req->nsec;
  if (flags & 1) return sleep_until (t, clk, 0);                  // TIMER_ABSTIME
  return sleep_until ((clk == CLOCK_REALTIME ? real_ns () : mono_ns ()) + t, clk, rem);
}

