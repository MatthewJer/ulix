\section{Test of threads: \texttt{threadtest}}
\label{src:libc/threadtest.c}

The test uses what a program with threads uses: \texttt{pthread\_create} and \texttt{pthread\_join}, a mutex, a condition variable,
a semaphore, a variable per thread (\texttt{\_Thread\_local}, which needs the \texttt{PT\_TLS} segment of the linker script), the error number
of each thread, a timed wait, and the end of a process with threads that still run.

<<libc/threadtest.c>>=
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <errno.h>
#include <pthread.h>
#include <semaphore.h>
#include <time.h>
#include <unistd.h>
#include <sys/wait.h>

static int fails = 0;
#define CHECK(c, msg) do { if (c) printf ("  user ok:   %s\n", msg); \
                           else { printf ("  user FAIL: %s\n", msg); fails++; } } while (0)

static void *return_arg (void *arg) { return (char *) arg + 1; }

static pthread_mutex_t lock = PTHREAD_MUTEX_INITIALIZER;
static long counter;
static void *count_up (void *arg) {
  for (int i = 0; i < 5000; i++) { pthread_mutex_lock (&lock); counter++; pthread_mutex_unlock (&lock); }
  return 0;
}

static pthread_cond_t cond = PTHREAD_COND_INITIALIZER;
static int ready, answer;
static void *producer (void *arg) {
  struct timespec nap = { 0, 20 * 1000000 };
  nanosleep (&nap, 0);
  pthread_mutex_lock (&lock);
  answer = 42;  ready = 1;
  pthread_cond_signal (&cond);
  pthread_mutex_unlock (&lock);
  return 0;
}

static _Thread_local int mine = 7;
static void *set_mine (void *arg) { mine = (long) arg; errno = 99; return (void *) (long) mine; }

static sem_t sem;
static void *post_later (void *arg) { sem_post (&sem); return 0; }

static void *forever (void *arg) { for (;;) ; }

int main (void) {
  pthread_t t, ts[4];
  void *result = 0;

  CHECK (pthread_create (&t, 0, return_arg, (void *) 100) == 0 && pthread_join (t, &result) == 0 && result == (void *) 101, "pthread_create and pthread_join: the thread's return value arrives");

  int ok = 1;
  for (int i = 0; i < 4; i++) if (pthread_create (&ts[i], 0, count_up, 0)) ok = 0;
  for (int i = 0; i < 4; i++) if (ok) pthread_join (ts[i], 0);
  CHECK (ok && counter == 20000, "4 threads count 5000 times each under a mutex: 20000");

  pthread_mutex_lock (&lock);
  pthread_create (&t, 0, producer, 0);
  while (!ready) pthread_cond_wait (&cond, &lock);
  pthread_mutex_unlock (&lock);
  pthread_join (t, 0);
  CHECK (answer == 42, "condition variable: the waiting thread wakes up when the other signals");

  mine = 5;  errno = 3;
  pthread_create (&t, 0, set_mine, (void *) 9);
  pthread_join (t, &result);
  CHECK (result == (void *) 9 && mine == 5, "_Thread_local: the thread has its own copy (9), main keeps its own (5)");
  CHECK (errno == 3, "errno is per thread: the thread's 99 did not reach main");

  sem_init (&sem, 0, 0);
  pthread_create (&t, 0, post_later, 0);
  CHECK (sem_wait (&sem) == 0, "sem_wait returns after the other thread's sem_post");
  pthread_join (t, 0);

  struct timespec soon;
  clock_gettime (CLOCK_REALTIME, &soon);
  soon.tv_nsec += 30 * 1000000;
  if (soon.tv_nsec >= 1000000000) { soon.tv_sec++; soon.tv_nsec -= 1000000000; }
  pthread_mutex_lock (&lock);
  ready = 0;
  CHECK (pthread_cond_timedwait (&cond, &lock, &soon) == ETIMEDOUT, "pthread_cond_timedwait with nobody to signal: ETIMEDOUT after 30 ms");
  pthread_mutex_unlock (&lock);

  pthread_t me = pthread_self ();
  pthread_create (&t, 0, return_arg, 0);
  CHECK (!pthread_equal (me, t), "pthread_self differs between the threads");
  pthread_join (t, 0);

  // exit () while another thread still runs: the process ends with the status, in a child so that this program goes on
  int pid = fork ();
  if (pid == 0) {
    pthread_create (&t, 0, forever, 0);
    struct timespec nap = { 0, 50 * 1000000 };
    nanosleep (&nap, 0);
    exit (7);
  }
  int status = 0;
  CHECK (waitpid (pid, &status, 0) == pid && WIFEXITED (status) && WEXITSTATUS (status) == 7, "exit (7) while a second thread loops: the process ends, waitpid sees 7");
  return fails;
}
