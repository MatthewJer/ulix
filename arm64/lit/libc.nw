\subsection{Threads: \texttt{futex}}
\label{sec:libc:futex}

A \emph{futex} is how a library puts a thread to sleep without the kernel knowing what a lock is: \texttt{FUTEX\_WAIT (address, value)} sleeps
if the word at \texttt{address} still has the \texttt{value} (so a wake-up that came between the program's look and the call is not lost) and
\texttt{FUTEX\_WAKE (address, n)} wakes up to $n$ sleepers on that address. musl's mutexes, condition variables, \texttt{pthread\_join}
and the lock around its own thread list are built from these two calls; the kernel never sees a mutex.

\paragraph{Simple version first.} The table of sleepers has 64 entries (address space, address, a flag \texttt{woken}). A sleeper does not leave the
ready queue: it checks the flag and calls \texttt{arch\_resign} in a loop, like \texttt{nanosleep} does with the clock. It costs CPU time
while it waits, and it needs no new thread state and no change of the scheduler. (The better version, a blocked queue per address like the one
for pipes, is a replacement for the loop and for the flag; the table stays.) Wake-ups cannot get lost because all of this runs under the
kernel lock: the value is compared and the entry made without a thread switch in between. A signal or the end of the process
(\texttt{exit\_group} in another thread) ends the wait with \texttt{EINTR}; the timeout of a timed wait is relative (\texttt{FUTEX\_WAIT}) or
absolute on the real-time clock (\texttt{FUTEX\_WAIT\_BITSET} with \texttt{FUTEX\_CLOCK\_REALTIME}, which is what \texttt{pthread\_cond\_timedwait} uses). The calls
that move waiters from one address to another (\texttt{FUTEX\_REQUEUE}) and the priority-inheritance locks are not implemented: musl does not need them.

<<linux_abi.c: futex>>=
#define FUTEX_WAIT          0
#define FUTEX_WAKE          1
#define FUTEX_WAIT_BITSET   9
#define FUTEX_WAKE_BITSET  10
#define FUTEX_CLOCK_REALTIME 256
#define LE_ETIMEDOUT 110

struct futex_waiter { int used, as, woken; u64 addr; };
static struct futex_waiter futex_waiters[64];

// wake up to n sleepers on this address of the current address space; returns how many
static int futex_wake (u64 addr, int n) {
  int woken = 0;
  for (int i = 0; i < 64 && woken < n; i++)
    if (futex_waiters[i].used && futex_waiters[i].as == current_as && futex_waiters[i].addr == addr && !futex_waiters[i].woken) {
      futex_waiters[i].woken = 1;
      woken++;
    }
  return woken;
}

void futex_wake_address (u64 addr, int n) { futex_wake (addr, n); }       // (the end of a thread: arch_thread.c)

extern int arch_as_dying (void);

static long futex_wait (int *addr, int val, struct ts *timeout, int absolute, int realtime) {
  if (!user_ok ((u64) addr, 4, 0) || ((u64) addr & 3)) return -LE_EFAULT;
  if (*addr != val) return -LE_EAGAIN;                           // the value changed: do not sleep
  unsigned long long deadline = 0;
  if (timeout) {
    if (!user_ok ((u64) timeout, sizeof *timeout, 0)) return -LE_EFAULT;
    unsigned long long t = timeout->sec * 1000000000ULL + timeout->nsec;
    deadline = absolute ? t : (realtime ? real_ns () : mono_ns ()) + t;
  }
  int slot = 0;
  while (slot < 64 && futex_waiters[slot].used) slot++;
  if (slot == 64) return -LE_ENOMEM;
  futex_waiters[slot].used = 1;  futex_waiters[slot].as = current_as;  futex_waiters[slot].addr = (u64) addr;  futex_waiters[slot].woken = 0;
  long result = 0;
  for (;;) {
    if (futex_waiters[slot].woken) break;
    if (thread_table[current_task].sig_pending || arch_as_dying ()) { result = -LE_EINTR; break; }
    if (deadline && (realtime || absolute ? real_ns () : mono_ns ()) >= deadline) { result = -LE_ETIMEDOUT; break; }
    arch_resign ();
    arch_poll_pause ();
  }
  futex_waiters[slot].used = 0;
  return result;
}

static long linux_futex (int *addr, int op, int val, struct ts *timeout, int val3) {
  switch (op & 127) {                                            // (bit 7 is FUTEX_PRIVATE_FLAG: every futex is private to its address space here)
    case FUTEX_WAIT:        return futex_wait (addr, val, timeout, 0, 0);
    case FUTEX_WAIT_BITSET: return futex_wait (addr, val, timeout, 1, (op & FUTEX_CLOCK_REALTIME) != 0);
    case FUTEX_WAKE: case FUTEX_WAKE_BITSET: return futex_wake ((u64) addr, val < 0 ? 0 : val);
  }
  return -LE_ENOSYS;
}

@
\subsection{Signals: \texttt{sigaction}, \texttt{sigprocmask}, \texttt{kill}}

The book's signals are the base (handlers per process, a pending set, a blocked set, delivery before the return to user mode, see
\texttt{arch\_signal\_check}). What musl needs on top of that:
\begin{itemize}
\item The numbers differ (see above), so every number is translated, in both directions.
\item \texttt{sigaction} hands over a \emph{restorer}: the function a handler returns to, which calls \texttt{rt\_sigreturn}. On Ulix the
  trampoline page of the kernel does that for the old programs; for musl's programs the restorer of musl is used instead (its
  \texttt{svc} has to be a Linux call). The register frame that \texttt{sigreturn} restores is Ulix's own layout, not Linux's
  \texttt{ucontext}; a handler receives the signal number and, in \texttt{x1}, a \texttt{siginfo} that only has \texttt{si\_signo} filled in.
  That is enough for \texttt{signal}, \texttt{raise}, \texttt{abort} and handlers that do not inspect the interrupted registers.
\item \texttt{sigprocmask} changes the set of blocked signals of the process. The book discards a signal that is blocked when it
  is sent (it does not stay pending); musl's \texttt{raise} blocks all signals around its \texttt{tkill} and needs the signal to be
  delivered when the mask is restored. So \texttt{linux\_kill} lets a signal that has a handler stay pending when it is blocked,
  and the delivery code skips blocked signals until they are unblocked. (A blocked signal without a handler is still discarded.)
\item \texttt{SA\_RESTART}, \texttt{SA\_RESETHAND}, \texttt{SA\_NODEFER} and the signal stack are not supported; the flags are ignored.
\end{itemize}

<<linux_abi.c: signals>>=
extern sighandler_t u_signal (int sig, sighandler_t func);

struct k_sigaction { sighandler_t handler; unsigned long flags; void (*restorer) (void); unsigned mask[2]; };   // as musl passes it

static long linux_sigaction (int sig, struct k_sigaction *act, struct k_sigaction *old, u64 size) {
  signal_tables ();
  if (sig < 1 || sig > 31 || !to_ulix[sig] || sig == 9 || sig == 19 || sig == 18) return -LE_EINVAL;   // SIGKILL, SIGSTOP, SIGCONT
  if (size != 8) return -LE_EINVAL;
  int us = to_ulix[sig];
  TCB *t = &thread_table[current_task];
  if (old) {
    if (!user_ok ((u64) old, sizeof *old, 1)) return -LE_EFAULT;
    old->handler = t->sighandlers[us];
    old->flags = 0; old->restorer = (void (*) (void)) linux_sig_restorer[current_as]; old->mask[0] = old->mask[1] = 0;
  }
  if (act) {
    if (!user_ok ((u64) act, sizeof *act, 0)) return -LE_EFAULT;
    if (act->restorer) linux_sig_restorer[current_as] = (u64) act->restorer;
    t->sighandlers[us] = act->handler;
  }
  return 0;
}

// the Linux mask (bit n-1 is signal n) from the book's mask (bit n is signal n), and back
static u64 mask_to_linux (unsigned long um) {
  signal_tables ();
  u64 m = 0;
  for (int u = 1; u < 32; u++) if ((um >> u) & 1 && to_linux[u]) m |= 1UL @<< (to_linux[u] - 1);
  return m;
}

static unsigned long mask_to_ulix (u64 lm) {
  unsigned long m = 0;
  for (int l = 1; l < 32; l++) if ((lm >> (l - 1)) & 1 && to_ulix[l]) m |= 1UL @<< to_ulix[l];
  return m & ~((1UL @<< 9) | (1UL @<< 17));                     // SIGKILL and SIGSTOP cannot be blocked
}

static long linux_sigprocmask (int how, u64 *set, u64 *old, u64 size) {
  TCB *t = &thread_table[current_task];
  if (size != 8) return -LE_EINVAL;
  if (old) { if (!user_ok ((u64) old, 8, 1)) return -LE_EFAULT; *old = mask_to_linux (t->sig_blocked); }
  if (set) {
    if (!user_ok ((u64) set, 8, 0)) return -LE_EFAULT;
    unsigned long m = mask_to_ulix (*set);
    switch (how) {
      case 0: t->sig_blocked |= m; break;                     // SIG_BLOCK
      case 1: t->sig_blocked &= ~m; break;                    // SIG_UNBLOCK
      case 2: t->sig_blocked = m; break;                      // SIG_SETMASK
      default: return -LE_EINVAL;
    }
  }
  return 0;
}

// kill, tkill and tgkill: musl's raise () sends the signal to its own thread
static long linux_kill (int pid, int sig) {
  signal_tables ();
  if (sig < 0 || sig > 31 || (sig && !to_ulix[sig])) return -LE_EINVAL;
  if (pid < 1 || pid >= MAX_THREADS || !thread_table[pid].used) return -LE_ESRCH;
  if (sig == 0) return 0;                                     // only asks whether the process exists
  TCB *t = &thread_table[pid];
  int us = to_ulix[sig];
  if (((t->sig_blocked >> us) & 1) && t->sighandlers[us] != SIG_DFL && t->sighandlers[us] != SIG_IGN) {
    t->sig_pending |= 1UL @<< us;                             // blocked: it stays pending until it is unblocked (musl's raise () relies on it)
    return 0;
  }
  return u_kill (pid, to_ulix[sig]) == 0 ? 0 : linux_error (LE_EPERM);
}

