\section{Test of message channels and shared futexes: \texttt{chantest}}
\label{src:libc/chantest.c}

The test uses the channels of the section ``Message channels between processes'' the way two programs would: with a name, across \texttt{fork}, with waiting on both sides.
The last two checks are about \emph{shared} futexes: the word is in memory that was mapped with \texttt{MAP\_SHARED}, the two processes wait and wake without the
\texttt{PRIVATE} flag, and the sleeper must really sleep (the clock says how long) and wake up when the other process wakes it.

<<libc/chantest.c>>=
#include <stdio.h>
#include <string.h>
#include <errno.h>
#include <fcntl.h>
#include <time.h>
#include <unistd.h>
#include <sys/mman.h>
#include <sys/syscall.h>
#include <sys/wait.h>

#define UCHAN_OPEN   646
#define UCHAN_SEND   647
#define UCHAN_RECV   648
#define UCHAN_CLOSE  649
#define UCHAN_UNLINK 650
#define FUTEX_WAIT_ 0
#define FUTEX_WAKE_ 1                                   // (no PRIVATE flag: shared futexes)

static int fails = 0;
#define CHECK(c, msg) do { if (c) printf ("  user ok:   %s\n", msg); \
                           else { printf ("  user FAIL: %s\n", msg); fails++; } } while (0)

static long long now_ms (void) { struct timespec t; clock_gettime (CLOCK_MONOTONIC, &t); return t.tv_sec * 1000LL + t.tv_nsec / 1000000; }
static void nap (int ms) { struct timespec t = { 0, ms * 1000000L }; nanosleep (&t, 0); }

static long copen (const char *name, int flags) { return syscall (UCHAN_OPEN, name, flags); }
static long csend (long id, const char *s, int mode, long long ns) { return syscall (UCHAN_SEND, id, s, strlen (s), mode, ns); }
static long crecv (long id, char *buf, int size, int mode, long long ns) { return syscall (UCHAN_RECV, id, buf, size, mode, ns); }

int main (void) {
  char buf[300];
  long id = copen ("/chan/test", O_CREAT);
  long reply_id = copen ("/chan/reply", O_CREAT);
  CHECK (id >= 0, "uchan_open creates a channel");

  CHECK (csend (id, "hello", 0, 0) == 5 && csend (id, "abc", 0, 0) == 3, "two messages are sent");
  int a = crecv (id, buf, sizeof buf, 0, 0);  int a_ok = a == 5 && memcmp (buf, "hello", 5) == 0;
  int b = crecv (id, buf, sizeof buf, 0, 0);
  CHECK (a_ok && b == 3 && memcmp (buf, "abc", 3) == 0, "they come out in the same order and with the same boundaries (5 and 3 bytes)");

  CHECK (crecv (id, buf, sizeof buf, 1, 0) == -1 && errno == EAGAIN, "recv on an empty channel without waiting: EAGAIN");
  long long t0 = now_ms ();
  long r = crecv (id, buf, sizeof buf, 2, 50 * 1000000LL);
  long long waited = now_ms () - t0;
  CHECK (r == -1 && errno == ETIMEDOUT && waited >= 40 && waited < 400, "recv with a time limit of 50 ms: ETIMEDOUT after about 50 ms");

  csend (id, "0123456789", 0, 0);
  CHECK (crecv (id, buf, 4, 0, 0) == -1 && errno == EMSGSIZE && crecv (id, buf, sizeof buf, 0, 0) == 10, "a message that does not fit is refused with EMSGSIZE and stays");

  int pid = fork ();
  if (pid == 0) {                                       // another process finds the channel by its name
    long c = copen ("/chan/test", 0);
    nap (30);
    csend (c, "ping from the child", 0, 0);
    char reply[300];
    long r2 = copen ("/chan/reply", 0);                 // (the answer comes on a second channel: on the first one the child would find its own message)
    int n = crecv (r2, reply, sizeof reply, 0, 0);      // and waits for the answer
    _exit (n == 4 && memcmp (reply, "pong", 4) == 0 ? 0 : 1);
  }
  int n = crecv (id, buf, sizeof buf - 1, 0, 0);        // the parent sleeps until the child has sent
  buf[n > 0 ? n : 0] = 0;
  CHECK (n == 19 && strcmp (buf, "ping from the child") == 0, "a process that waits in recv gets the message of another process (sent 30 ms later)");
  csend (reply_id, "pong", 0, 0);
  int status = 0;
  CHECK (waitpid (pid, &status, 0) == pid && WIFEXITED (status) && WEXITSTATUS (status) == 0, "the child received the answer");

  int sent = 0;
  while (csend (id, "x", 1, 0) == 1) sent++;
  CHECK (sent == 16 && errno == EAGAIN, "a channel holds 16 messages, the 17th send without waiting: EAGAIN");
  pid = fork ();
  if (pid == 0) { nap (30); crecv (id, buf, sizeof buf, 0, 0); _exit (0); }
  t0 = now_ms ();
  r = csend (id, "last", 0, 0);                         // the sender sleeps until the child has made room
  waited = now_ms () - t0;
  CHECK (r == 4 && waited >= 20, "a sender that finds the channel full sleeps until the other process has read one message");
  waitpid (pid, 0, 0);
  while (crecv (id, buf, sizeof buf, 1, 0) >= 0) ;

  CHECK (syscall (UCHAN_CLOSE, id) == 0 && syscall (UCHAN_UNLINK, "/chan/test") == 0 && copen ("/chan/test", 0) == -1 && errno == ENOENT, "close and unlink: the name is gone");

  // shared futex: one word in shared memory, two processes
  volatile int *word = mmap (0, 4096, PROT_READ | PROT_WRITE, MAP_SHARED | MAP_ANONYMOUS, -1, 0);
  *word = 0;
  pid = fork ();
  if (pid == 0) {
    long long s = now_ms ();
    while (*word == 0) syscall (SYS_futex, word, FUTEX_WAIT_, 0, 0, 0, 0);
    _exit (now_ms () - s >= 20 ? 0 : 1);                // it must have slept until the parent woke it
  }
  nap (40);
  *word = 1;
  long woken = syscall (SYS_futex, word, FUTEX_WAKE_, 1, 0, 0, 0);
  CHECK (waitpid (pid, &status, 0) == pid && WIFEXITED (status) && WEXITSTATUS (status) == 0, "shared futex: a process sleeps on a word in shared memory and the other process wakes it");
  CHECK (woken == 1, "FUTEX_WAKE of a shared futex says that it woke one sleeper");
  return fails;
}
