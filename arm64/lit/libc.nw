\section{Descriptors: \texttt{fdtest}}
\label{src:libc/fdtest.c}

A program for issue \#138. In Unix, \texttt{dup}, \texttt{dup2} and \texttt{fork} make a second descriptor for the \emph{same} open file, so both share the
read/write position; the book's \texttt{u\_reopen} gave the copy its own position. The kernel's \texttt{u\_share} (chapter~\ref{ch:pipes})
puts that right. The test reads \texttt{/test.txt} (1680 bytes) in small pieces and looks where the position is after each copy; it also opens the
file again and again until the table is full, which must end with \texttt{EMFILE} and must not leave anything behind (the same number of
descriptors is possible a second time).

<<libc/fdtest.c>>=
#include <stdio.h>
#include <string.h>
#include <errno.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/wait.h>

static int fails = 0;
#define CHECK(c, msg) do { if (c) printf ("  user ok:   %s\n", msg); \
                           else { printf ("  user FAIL: %s\n", msg); fails++; } } while (0)

static int fill_table (int *fds, int max) {                    // open /test.txt until it fails; returns how many were opened
  int n = 0;
  while (n < max && (fds[n] = open ("/test.txt", O_RDONLY)) >= 0) n++;
  return n;
}

int main (void) {
  char buf[64];
  int fd = open ("/test.txt", O_RDONLY);
  CHECK (fd >= 3 && read (fd, buf, 10) == 10, "open /test.txt, read 10 bytes");

  int d = dup (fd);
  CHECK (d > fd && lseek (d, 0, SEEK_CUR) == 10, "dup: the copy is at the position of the original (10)");
  CHECK (read (d, buf, 5) == 5 && lseek (fd, 0, SEEK_CUR) == 15, "a read through the copy moves the position of the original (15)");
  CHECK (lseek (fd, 100, SEEK_SET) == 100 && lseek (d, 0, SEEK_CUR) == 100, "lseek on the original moves the copy (100)");

  int e = dup2 (fd, 12);
  CHECK (e == 12 && read (e, buf, 4) == 4 && lseek (fd, 0, SEEK_CUR) == 104 && lseek (d, 0, SEEK_CUR) == 104, "dup2: three descriptors, one position (104)");

  close (fd);
  CHECK (read (d, buf, 6) == 6 && lseek (e, 0, SEEK_CUR) == 110, "close of one descriptor leaves the others open and in step (110)");
  close (d);
  CHECK (read (e, buf, 1) == 1 && lseek (e, 0, SEEK_CUR) == 111, "still open after the second close (111)");

  pid_t pid = fork ();
  if (pid == 0) { char c[8];  _exit (read (e, c, 7) == 7 ? 0 : 1); }
  int st = 0;
  CHECK (pid > 0 && waitpid (pid, &st, 0) == pid && WIFEXITED (st) && WEXITSTATUS (st) == 0, "fork: the child read 7 bytes through its copy");
  CHECK (lseek (e, 0, SEEK_CUR) == 118, "fork: the parent's position moved with the child's read (118)");
  CHECK (read (e, buf, 2) == 2, "the parent can still read after the child has exited (its exit closed only its copy)");
  close (e);
  errno = 0;
  CHECK (read (e, buf, 1) == -1 && errno == EBADF, "after the last close the descriptor is gone");

  int fds[1100];
  int n = fill_table (fds, 1100), err = errno;
  printf ("  info: %d descriptors of /test.txt opened before the table was full\n", n);
  CHECK (n >= 10 && n < 1100 && err == EMFILE, "a full table ends with EMFILE (the limit is MAX_PFD minus the 3 standard descriptors)");
  for (int i = 0; i < n; i++) close (fds[i]);
  int m = fill_table (fds, 1100);
  CHECK (m == n, "after closing them all, the same number can be opened again (nothing leaked)");
  for (int i = 0; i < m; i++) close (fds[i]);
  return fails;
}
