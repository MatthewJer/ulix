\paragraph{Directory descriptors.} Programs such as \texttt{tar} (libarchive) and Python's \texttt{shutil.rmtree} walk a directory tree with
\texttt{openat}, \texttt{fstatat}, \texttt{unlinkat}: a name relative to a directory that is \emph{open}, given as a descriptor. The book's open file has no
name (only an inode), so the translation keeps one: \texttt{linux\_openat} writes the absolute name that it opened into \texttt{fd\_path}, in the slot of the
global table of open files, and \texttt{at\_name} puts a relative name behind it. The slot is overwritten by the next \texttt{openat} that gets it; an
open file that did not come through \texttt{linux\_openat} has an empty name and is refused as a base (\texttt{ENOTDIR}), as is a name that does not fit.

<<linux_abi.c: file status, directories and descriptors>>=
#define FD_PATH 256
static char fd_path[256][FD_PATH];                           // (the book's table of open files has MX_MAX_FILES = 256 entries)

// a duplicate (dup, fcntl F_DUPFD) is a new open file in the book's table: it keeps the name
static void copy_fd_path (int from_gfd, int to_gfd) {
  if (from_gfd >= 0 && to_gfd >= 0 && (from_gfd >> 8) == FS_MINIX && (to_gfd >> 8) == FS_MINIX) strcpy (fd_path[to_gfd & 0xff], fd_path[from_gfd & 0xff]);
}

// the name to use for an *at call: the path itself if it is absolute or relative to the working directory, else the name of the directory and the path
static const char *at_name (int dirfd, const char *path, char *buf, long *err) {
  // Linux programs keep shared memory in /dev/shm (Python's multiprocessing makes its heap there). There is no such directory here, and /dev/ names are devices, so
  // /dev/shm is /tmp: the name is changed on the way in.
  if (strncmp (path, "/dev/shm", 8) == 0 && (path[8] == 0 || path[8] == '/') && strlen (path + 8) + 5 <= FD_PATH) { memcpy (buf, "/tmp", 4);  strcpy (buf + 4, path + 8);  return buf; }
  if (dirfd == AT_FDCWD || path[0] == '/') return path;
  int gfd = pfd2gfd (dirfd);
  if (dirfd < 0 || gfd == -1) { *err = -LE_EBADF;  return 0; }
  if ((gfd >> 8) != FS_MINIX || !fd_path[gfd & 0xff][0]) { *err = -LE_ENOTDIR;  return 0; }
  const char *d = fd_path[gfd & 0xff];
  unsigned n = strlen (d), m = strlen (path);
  if (n + 1 + m + 1 > FD_PATH) { *err = -LE_EINVAL;  return 0; }
  memcpy (buf, d, n);
  if (n && d[n - 1] != '/') buf[n++] = '/';
  memcpy (buf + n, path, m + 1);
  return buf;
}

