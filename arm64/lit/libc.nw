\section{Test of threads: \texttt{threadtest}}
\label{src:libc/threadtest.c}

The test uses what a program with threads uses: \texttt{pthread\_create} and \texttt{pthread\_join}, a mutex, a condition variable,
a semaphore, a variable per thread (\texttt{\_Thread\_local}, which needs the \texttt{PT\_TLS} segment of the linker script), the error number
of each thread, a timed wait, and the end of a process with threads that still run.

<<libc/threadtest.c>>=
#define _GNU_SOURCE
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <errno.h>
#include <pthread.h>
#include <semaphore.h>
#include <time.h>
#include <unistd.h>
#include <sys/wait.h>
#include <sys/syscall.h>
#include <signal.h>
#include <sched.h>

static int fails = 0;
#define CHECK(c, msg) do { if (c) printf ("  user ok:   %s\n", msg); \
                           else { printf ("  user FAIL: %s\n", msg); fails++; } } while (0)

static void *return_arg (void *arg) { return (char *) arg + 1; }

static pthread_mutex_t lock = PTHREAD_MUTEX_INITIALIZER;
static long counter;
static void *count_up (void *arg) {
  for (int i = 0; i < 5000; i++) { pthread_mutex_lock (&lock); counter++; pthread_mutex_unlock (&lock); }
  return 0;
}

static pthread_cond_t cond = PTHREAD_COND_INITIALIZER;
static int ready, answer;
static void *producer (void *arg) {
  struct timespec nap = { 0, 20 * 1000000 };
  nanosleep (&nap, 0);
  pthread_mutex_lock (&lock);
  answer = 42;  ready = 1;
  pthread_cond_signal (&cond);
  pthread_mutex_unlock (&lock);
  return 0;
}

static _Thread_local int mine = 7;
static void *set_mine (void *arg) { mine = (long) arg; errno = 99; return (void *) (long) mine; }

static sem_t sem;
static void *post_later (void *arg) { sem_post (&sem); return 0; }

static void *forever (void *arg) { for (;;) ; }

// ---- the futex without polling (issue 135), requeue, detached threads, pthread_kill, robust mutexes, the signal stack (issue 136)
static long long now_ms (void) { struct timespec t; clock_gettime (CLOCK_MONOTONIC, &t); return t.tv_sec * 1000LL + t.tv_nsec / 1000000; }
static void nap (int ms) { struct timespec t = { 0, ms * 1000000L }; nanosleep (&t, 0); }

static volatile int sleeper_go;
static void *sleeper (void *arg) { pthread_mutex_lock (&lock);  while (!sleeper_go) pthread_cond_wait (&cond, &lock);  pthread_mutex_unlock (&lock);  return 0; }
static long busy_work (void) {                              // how much computing fits into 150 ms?
  long long t0 = now_ms ();
  volatile unsigned long x = 0;
  long rounds = 0;
  while (now_ms () - t0 < 150) { for (int i = 0; i < 1000; i++) x += i;  rounds++; }
  return rounds;
}

static int futex_a, futex_b;
static volatile int woke;
static void *requeue_waiter (void *arg) { syscall (SYS_futex, &futex_a, 128, 0, 0, 0, 0);  __atomic_add_fetch (&woke, 1, __ATOMIC_SEQ_CST);  return 0; }   // FUTEX_WAIT | PRIVATE, once

static volatile int detached_done;
static void *detached_body (void *arg) { __atomic_add_fetch (&detached_done, 1, __ATOMIC_SEQ_CST);  return 0; }

static volatile int got_usr1;
static void on_usr1 (int sig) { got_usr1 = sig; }
static volatile int usr1_ready;
static void *wait_for_signal (void *arg) { usr1_ready = 1;  for (int i = 0; i < 300 && !got_usr1; i++) nap (10);  return 0; }

static pthread_mutex_t robust_lock;
static void *die_holding_lock (void *arg) { pthread_mutex_lock (&robust_lock);  return 0; }

static char *handler_local;
static void on_usr2 (int sig) { char here; handler_local = &here; }

int main (void) {
  pthread_t t, ts[4];
  void *result = 0;

  CHECK (pthread_create (&t, 0, return_arg, (void *) 100) == 0 && pthread_join (t, &result) == 0 && result == (void *) 101, "pthread_create and pthread_join: the thread's return value arrives");

  int ok = 1;
  for (int i = 0; i < 4; i++) if (pthread_create (&ts[i], 0, count_up, 0)) ok = 0;
  for (int i = 0; i < 4; i++) if (ok) pthread_join (ts[i], 0);
  CHECK (ok && counter == 20000, "4 threads count 5000 times each under a mutex: 20000");

  pthread_mutex_lock (&lock);
  pthread_create (&t, 0, producer, 0);
  while (!ready) pthread_cond_wait (&cond, &lock);
  pthread_mutex_unlock (&lock);
  pthread_join (t, 0);
  CHECK (answer == 42, "condition variable: the waiting thread wakes up when the other signals");

  mine = 5;  errno = 3;
  pthread_create (&t, 0, set_mine, (void *) 9);
  pthread_join (t, &result);
  CHECK (result == (void *) 9 && mine == 5, "_Thread_local: the thread has its own copy (9), main keeps its own (5)");
  CHECK (errno == 3, "errno is per thread: the thread's 99 did not reach main");

  sem_init (&sem, 0, 0);
  pthread_create (&t, 0, post_later, 0);
  CHECK (sem_wait (&sem) == 0, "sem_wait returns after the other thread's sem_post");
  pthread_join (t, 0);

  struct timespec soon;
  clock_gettime (CLOCK_REALTIME, &soon);
  soon.tv_nsec += 30 * 1000000;
  if (soon.tv_nsec >= 1000000000) { soon.tv_sec++; soon.tv_nsec -= 1000000000; }
  pthread_mutex_lock (&lock);
  ready = 0;
  CHECK (pthread_cond_timedwait (&cond, &lock, &soon) == ETIMEDOUT, "pthread_cond_timedwait with nobody to signal: ETIMEDOUT after 30 ms");
  pthread_mutex_unlock (&lock);

  pthread_t me = pthread_self ();
  pthread_create (&t, 0, return_arg, 0);
  CHECK (!pthread_equal (me, t), "pthread_self differs between the threads");
  pthread_join (t, 0);

  // a thread that waits in the futex does not use the CPU: the same work takes about as long with a sleeper as without
  long alone = busy_work ();
  pthread_create (&t, 0, sleeper, 0);
  nap (20);
  long with_sleeper = busy_work ();
  pthread_mutex_lock (&lock);  sleeper_go = 1;  pthread_cond_broadcast (&cond);  pthread_mutex_unlock (&lock);
  pthread_join (t, 0);
  printf ("  info: work done in 150 ms: %ld rounds alone, %ld rounds next to a sleeping thread\n", alone, with_sleeper);
  CHECK (with_sleeper * 4 > alone * 3, "a thread blocked in pthread_cond_wait takes no CPU time: in the same 150 ms the work next to it gets at least 75 percent (a spinning waiter on one CPU would halve it)");

  // FUTEX_CMP_REQUEUE: wake one of two sleepers, move the other to a second word
  pthread_t rq[2];
  pthread_create (&rq[0], 0, requeue_waiter, 0);  pthread_create (&rq[1], 0, requeue_waiter, 0);
  nap (40);
  long moved = syscall (SYS_futex, &futex_a, 4 | 128, 1, (void *) 1L, &futex_b, 0);     // wake 1, requeue 1, expected value 0
  nap (30);
  int first = woke;
  long again = syscall (SYS_futex, &futex_a, 1 | 128, 1, 0, 0, 0);                      // nobody is left on the first word
  long second = syscall (SYS_futex, &futex_b, 1 | 128, 1, 0, 0, 0);                     // the moved sleeper is here
  pthread_join (rq[0], 0);  pthread_join (rq[1], 0);
  CHECK (moved == 2 && first == 1 && again == 0 && second == 1 && woke == 2, "FUTEX_CMP_REQUEUE: one sleeper woken, one moved to the other word and woken there");
  CHECK (syscall (SYS_futex, &futex_a, 4 | 128, 1, (void *) 1L, &futex_b, 5) == -1 && errno == EAGAIN, "FUTEX_CMP_REQUEUE with a wrong expected value: EAGAIN, nothing moved");

  // detached threads: 100 of them, one after the other in two rounds (the resources of an ended thread must be given back)
  pthread_attr_t attr;
  pthread_attr_init (&attr);  pthread_attr_setdetachstate (&attr, PTHREAD_CREATE_DETACHED);
  int created = 0;
  for (int i = 0; i < 100; i++) {
    int rc = pthread_create (&t, &attr, detached_body, 0);
    if (rc == 0) created++;  else if (created == i) printf ("  info: pthread_create failed at thread %d: error %d\n", i, rc);
    for (int w = 0; w < 200 && detached_done < created; w++) nap (2);
  }
  for (int w = 0; w < 200 && detached_done < created; w++) nap (5);
  printf ("  info: detached threads: %d created, %d ran\n", created, detached_done);
  CHECK (created == 100 && detached_done == 100, "100 detached threads, one after the other: all ran and went away (the thread unmaps its own stack)");

  // pthread_kill: a signal for one thread
  signal (SIGUSR1, on_usr1);
  pthread_create (&t, 0, wait_for_signal, 0);
  while (!usr1_ready) nap (5);
  pthread_kill (t, SIGUSR1);
  pthread_join (t, 0);
  CHECK (got_usr1 == SIGUSR1, "pthread_kill: the handler of the other thread ran");

  // a robust mutex whose owner ended
  pthread_mutexattr_t ma;
  pthread_mutexattr_init (&ma);  pthread_mutexattr_setrobust (&ma, PTHREAD_MUTEX_ROBUST);
  pthread_mutex_init (&robust_lock, &ma);
  pthread_create (&t, 0, die_holding_lock, 0);
  pthread_join (t, 0);
  int rl = pthread_mutex_lock (&robust_lock);
  CHECK (rl == EOWNERDEAD, "robust mutex: the owner ended while holding it, the next lock says EOWNERDEAD");
  if (rl == EOWNERDEAD) { pthread_mutex_consistent (&robust_lock);  pthread_mutex_unlock (&robust_lock); }

  // the signal stack
  static char altmem[16384];
  stack_t ss = { altmem, 0, sizeof altmem };
  struct sigaction sa;
  memset (&sa, 0, sizeof sa);
  sa.sa_handler = on_usr2;  sa.sa_flags = SA_ONSTACK;
  sigaction (SIGUSR2, &sa, 0);
  int ok_alt = sigaltstack (&ss, 0) == 0;
  raise (SIGUSR2);
  CHECK (ok_alt && handler_local >= altmem && handler_local < altmem + sizeof altmem, "sigaltstack: a handler with SA_ONSTACK runs on the alternate stack");

  // the processors
  cpu_set_t set;
  CPU_ZERO (&set);
  int n_aff = sched_getaffinity (0, sizeof set, &set) == 0 ? CPU_COUNT (&set) : 0;
  CHECK (n_aff >= 1 && n_aff == sysconf (_SC_NPROCESSORS_ONLN), "sched_getaffinity: one bit per online CPU, the same number as sysconf");

  // exit () while another thread still runs: the process ends with the status, in a child so that this program goes on
  int pid = fork ();
  if (pid == 0) {
    pthread_create (&t, 0, forever, 0);
    struct timespec nap = { 0, 50 * 1000000 };
    nanosleep (&nap, 0);
    exit (7);
  }
  int status = 0;
  CHECK (waitpid (pid, &status, 0) == pid && WIFEXITED (status) && WEXITSTATUS (status) == 7, "exit (7) while a second thread loops: the process ends, waitpid sees 7");
  return fails;
}
