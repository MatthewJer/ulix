\paragraph{Waiting for several descriptors.} \texttt{poll\_bits} says what a descriptor is ready for, in the bits of \texttt{poll} (\texttt{POLLIN} 1,
\texttt{POLLOUT} 4, \texttt{POLLERR} 8, \texttt{POLLHUP} 16, \texttt{POLLNVAL} 32).

<<linux_abi.c: sockets and poll>>=
static int poll_bits (int fd) {
  int gfd = pfd2gfd (fd);
  if (gfd == -1) return 32;
  if (is_sock (gfd)) return sock_ready (gfd);
  if (gfd >= 0 && (gfd >> 8) == FS_PIPE_NR) return pipe_ready (gfd);
  return 1 | 4;                                                // a file, a device or the terminal: ready
}

// wait until count () is not 0, the time is up (timeout: 0 for ever) or a signal comes; the result of count () or minus an error
static long poll_wait (long (*count) (void *), void *arg, struct ts *timeout) {
  unsigned long long deadline = 0;
  if (timeout) {
    if (!user_ok ((u64) timeout, sizeof *timeout, 0)) return -LE_EFAULT;
    deadline = mono_ns () + timeout->sec * 1000000000ULL + timeout->nsec;
  }
  for (;;) {
    long n = count (arg);
    if (n != 0) return n;
    if (timeout && mono_ns () >= deadline) return 0;
    if (thread_table[current_task].sig_pending) return -LE_EINTR;
    if (!net_poll_once ())                                     // a frame came: look at once; otherwise sleep one tick (no CPU time, the wake-up may be 10 ms late)
      if (futex_nap () == -LE_EINTR) return -LE_EINTR;
  }
}

struct pollfd_ { int fd; short events, revents; };
struct poll_args { struct pollfd_ *fds; unsigned n; };

static long poll_count (void *p) {
  struct poll_args *a = p;
  long ready = 0;
  for (unsigned i = 0; i < a->n; i++) {
    struct pollfd_ *f = &a->fds[i];
    f->revents = f->fd < 0 ? 0 : poll_bits (f->fd) & (f->events | 8 | 16 | 32);
    if (f->revents) ready++;
  }
  return ready;
}

static long linux_ppoll (struct pollfd_ *fds, unsigned n, struct ts *timeout) {
  if (n > 64 || !user_ok ((u64) fds, n * sizeof *fds, 1)) return -LE_EINVAL;
  struct poll_args a = { fds, n };
  return poll_wait (poll_count, &a, timeout ? timeout : 0);
}

@
\texttt{pselect6} takes three bit sets (descriptors to read, to write, with errors) and changes them to the ones that are ready; the last argument of musl's
\texttt{select} is a timeout in a structure, and there is a signal mask that is ignored.

<<linux_abi.c: sockets and poll>>=
struct select_args { int n; unsigned long *r, *w; unsigned long saved_r[16], saved_w[16]; };

static long select_count (void *p) {
  struct select_args *a = p;
  long ready = 0;
  for (int fd = 0; fd < a->n; fd++) {
    unsigned long bit = 1UL << (fd % 64);
    int word = fd / 64, want_r = a->r && (a->saved_r[word] & bit), want_w = a->w && (a->saved_w[word] & bit);
    if (!want_r && !want_w) continue;
    int bits = poll_bits (fd);
    if (a->r) { if (want_r && (bits & (1 | 16 | 32))) { a->r[word] |= bit;  ready++; } else a->r[word] &= ~bit; }
    if (a->w) { if (want_w && (bits & (4 | 8 | 32))) { a->w[word] |= bit;  ready++; } else a->w[word] &= ~bit; }
  }
  return ready;
}

static long linux_pselect6 (int n, unsigned long *r, unsigned long *w, unsigned long *x, struct ts *timeout) {
  if (n < 0 || n > 1024) return -LE_EINVAL;
  int words = (n + 63) / 64;
  struct select_args a = { n, r, w };
  if ((r && !user_ok ((u64) r, words * 8, 1)) || (w && !user_ok ((u64) w, words * 8, 1)) || (x && !user_ok ((u64) x, words * 8, 1))) return -LE_EFAULT;
  for (int i = 0; i < words; i++) { a.saved_r[i] = r ? r[i] : 0;  a.saved_w[i] = w ? w[i] : 0; }
  if (x) for (int i = 0; i < words; i++) x[i] = 0;                   // no exceptional conditions
  return poll_wait (select_count, &a, timeout);
}

@
\subsection{Semaphores that processes share (for \texttt{multiprocessing})}
\label{sec:libc:sem}

Python's \texttt{multiprocessing} makes locks, events and queues for several \emph{processes} out of POSIX named semaphores (\texttt{sem\_open}). musl builds
them on a file in \texttt{/dev/shm} that all processes map into memory, and Ulix has neither shared memory nor file mappings. So the kernel keeps the
semaphores: a table of 32, each with a name, a value and a count of the processes that have it open. These are system calls of Ulix's own (numbers
640 to 645, outside the numbers of Linux), and \texttt{libc/semshim.c} turns \texttt{sem\_open}, \texttt{sem\_wait}, \texttt{sem\_post} and the others into
calls to them. A semaphore is identified by its slot number, which stays valid in a child after \texttt{fork}.

The value is changed with an atomic compare-and-swap, because two CPUs may wait for the same semaphore. Waiting sleeps in the queue of the futexes (key: the semaphore, \texttt{usem\_post} wakes one sleeper), with the time limit of mode 2, and stops when a signal is pending. \texttt{usem\_wait} takes a mode: 0 waits for ever, 1 only tries, 2 waits at most
the given number of nanoseconds.

<<linux_abi.c: semaphores>>=
#define MAX_USEM 32
struct usem { char name[32];  int used, unlinked, refs;  int value; };
static struct usem usems[MAX_USEM];

static struct usem *usem_of (long id) { return (id >= 0 && id < MAX_USEM && usems[id].used) ? &usems[id] : 0; }

// sem_open: the slot of the semaphore called name (made with this value if LO_CREAT is in flags and there is none), or minus an error
static long linux_usem_open (const char *name, int flags, int value) {
  if (!user_string_ok ((u64) name)) return -LE_EFAULT;
  if (strlen (name) >= 32 || value < 0) return -LE_EINVAL;
  for (int i = 0; i < MAX_USEM; i++)
    if (usems[i].used && !usems[i].unlinked && strcmp (usems[i].name, name) == 0) {
      if ((flags & LO_CREAT) && (flags & LO_EXCL)) return -LE_EEXIST;
      usems[i].refs++;
      return i;
    }
  if (!(flags & LO_CREAT)) return -LE_ENOENT;
  for (int i = 0; i < MAX_USEM; i++)
    if (!usems[i].used) {
      memset (&usems[i], 0, sizeof usems[i]);
      strcpy (usems[i].name, name);
      usems[i].used = 1;  usems[i].refs = 1;  usems[i].value = value;
      return i;
    }
  return -LE_ENOMEM;
}

static long linux_usem_wait (long id, int mode, long long timeout_ns) {
  struct usem *u = usem_of (id);
  if (!u) return -LE_EINVAL;
  unsigned long long deadline = mono_ns () + (timeout_ns > 0 ? timeout_ns : 0);
  for (;;) {
    int v = __atomic_load_n (&u->value, __ATOMIC_ACQUIRE);
    if (v > 0) { if (__atomic_compare_exchange_n (&u->value, &v, v - 1, 0, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) return 0;  continue; }
    if (mode == 1) return -LE_EAGAIN;
    if (mode == 2 && mono_ns () >= deadline) return -LE_ETIMEDOUT;
    if (futex_sleep ((u64) u, -1, mode == 2 ? deadline : 0) == -LE_EINTR) return -LE_EINTR;   // (sleeps in the futex queue, the key is the semaphore: usem_post wakes it)
  }
}

static long linux_usem_post (long id) {
  struct usem *u = usem_of (id);
  if (!u) return -LE_EINVAL;
  __atomic_fetch_add (&u->value, 1, __ATOMIC_ACQ_REL);
  futex_wake_key ((u64) u, -1, 1);
  return 0;
}

static long linux_usem_value (long id) { struct usem *u = usem_of (id);  return u ? __atomic_load_n (&u->value, __ATOMIC_ACQUIRE) : -LE_EINVAL; }

// the slot goes back to the table when the last user has closed it and it has been unlinked (sem_unlink only takes the name away)
static long linux_usem_close (long id) {
  struct usem *u = usem_of (id);
  if (!u) return -LE_EINVAL;
  if (--u->refs <= 0 && u->unlinked) u->used = 0;
  return 0;
}

static long linux_usem_unlink (const char *name) {
  if (!user_string_ok ((u64) name)) return -LE_EFAULT;
  for (int i = 0; i < MAX_USEM; i++)
    if (usems[i].used && !usems[i].unlinked && strcmp (usems[i].name, name) == 0) {
      usems[i].unlinked = 1;
      if (usems[i].refs <= 0) usems[i].used = 0;
      return 0;
    }
  return -LE_ENOENT;
}

