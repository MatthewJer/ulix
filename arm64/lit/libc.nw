// statfs and fstatfs (musl's statvfs, which tar asks for): the numbers of a Minix file system with 1 KByte blocks and 30-character names;
// the counts of free blocks are not known here, so the file system is reported as half full
static long linux_statfs (const char *path, void *buf) {      // path is 0 for fstatfs
  if (!user_ok ((u64) buf, 120, 1)) return -LE_EFAULT;
  if (path) { struct stat st;  if (!user_string_ok ((u64) path)) return -LE_EFAULT;  char nb[FD_PATH];  long er = 0;  const char *name = at_name (AT_FDCWD, path, nb, &er);  if (!name || u_stat (name, &st) != 0 || strncmp (name, "/dev/", 5) == 0) return -LE_ENOENT; }   // (a name that does not exist: Python probes /dev/shm)
  long *f = buf;
  memset (buf, 0, 120);
  f[0] = 0x2478;  f[1] = 1024;  f[2] = 32768;  f[3] = f[4] = 16384;  f[5] = 2048;  f[6] = 1024;   // type, bsize, blocks, bfree, bavail, files, ffree
  f[8] = 30;  f[9] = 1024;                                    // (f[7] is the fsid) namelen, frsize
  return 0;
}

static long linux_openat (context_t *r, int dirfd, const char *path, int flags) {
  if (!user_string_ok ((u64) path)) return -LE_EFAULT;
  char nbuf[FD_PATH];  long err = 0;
  const char *name = at_name (dirfd, path, nbuf, &err);
  if (!name) return err;
  path = name;
  int uflags = flags & 3;                                     // O_RDONLY, O_WRONLY, O_RDWR have the same values
  struct stat st = { 0 };
  int exists = strncmp (path, "/dev/", 5) != 0 && u_stat (path, &st) == 0;   // (a device is no file and no directory: the file system calls do not apply)
  if (flags & LO_CREAT)  uflags |= O_CREAT;
  if (flags & LO_APPEND) uflags |= O_APPEND;
  if ((flags & LO_CREAT) && (flags & LO_EXCL) && exists) return -LE_EEXIST;
  if ((flags & LO_DIRECTORY) && exists && (st.st_mode & S_IFMT) != S_IFDIR) return -LE_ENOTDIR;
  if ((flags & 3) != 0 && exists && (st.st_mode & S_IFMT) == S_IFDIR) return -LE_EISDIR;
  if (!exists && !(flags & LO_CREAT) && strncmp (path, "/dev/", 5) != 0) return -LE_ENOENT;   // (the book's open says only -1)
  // (syscall_open of the book turns the file into a descriptor of the process at once and leaves the open file behind when the table is full: ask for the
  // file first, then for a place in the table, and give the file back if there is none)
  int gfd0 = u_open ((char *) path, uflags, 0);
  if (gfd0 < 0) return linux_error (LE_ENOENT);
  long fd = gfd2pfd (gfd0);
  if (fd < 0) { u_close (gfd0);  return -LE_EMFILE; }
  if ((flags & LO_TRUNC) && (flags & 3) != 0 && linux_ftruncate (fd, 0) < 0) {   // the book has no O_TRUNC: shorten the file now
    ulix_call (r, syscall_close, fd, 0, 0, 0, 0);
    return -LE_EACCES;
  }
  {                                                           // remember the absolute name for later *at calls with this descriptor
    int gfd = pfd2gfd (fd);
    if (gfd >= 0 && (gfd >> 8) == FS_MINIX) {
      char *dst = fd_path[gfd & 0xff];
      unsigned n = 0;
      if (path[0] != '/') {                                   // relative to the working directory: put that in front
        if (u_getcwd (dst, FD_PATH)) n = strlen (dst);
        if (n && dst[n - 1] != '/') dst[n++] = '/';
      }
      if (n + strlen (path) + 1 <= FD_PATH) strcpy (dst + n, path); else dst[0] = 0;
    }
  }
  return fd;
}

