\subsection{Memory: \texttt{brk}, \texttt{mmap}, \texttt{munmap}, \texttt{mprotect}}
\label{sec:libc:memory}

musl's \texttt{malloc} takes small blocks from the heap that \texttt{brk} moves and big ones from \texttt{mmap}. The kernel already has
the heap (\texttt{u\_sbrk} takes frames and maps them; the book's \texttt{sbrk} call takes an increment), so Linux's
\texttt{brk(address)} is a small wrapper that turns the new end into an increment and answers with the current end if that fails.
The heap cannot shrink yet.

<<linux_abi.c: memory>>=
extern void *u_sbrk (int incr);

static long linux_brk (u64 want) {
  u64 cur = (u64) u_sbrk (0);
  if (want <= cur) return cur;
  if (u_sbrk (want - cur) == (void *) -1) return cur;     // no memory: Linux answers with the old break
  return want;
}

@
Anonymous memory for \texttt{mmap} comes from a region of the address space between the heap (which grows up from the program)
and the stack (which grows down): \texttt{MMAP\_LO} to \texttt{MMAP\_HI}. A mapping is placed at the highest free address of that
region (top-down, like Linux), found by looking at the page table, so there is no separate list of mappings to keep consistent
with \texttt{fork}, swapping and \texttt{munmap}: the page table is the list. The frames come zeroed, as the standard demands, and are
taken immediately (there is no demand paging in the kernel yet). Mapping a file is not supported yet (\texttt{ENODEV}).

\paragraph{W\textasciicircum{}X.} A page is writable or executable, never both, as in the program loader. \texttt{mmap} and
\texttt{mprotect} refuse \texttt{PROT\_WRITE|PROT\_EXEC} with \texttt{EACCES}. A program that generates code (a JIT compiler, issue \#110) maps
the memory writable, writes the code, and then calls \texttt{mprotect} to make it executable; the kernel cleans the caches for the
new code at that moment. \texttt{PROT\_NONE} removes the access of the program; the page stays in the table, so the address stays
reserved. (A system call that reads or writes such a page for the program does not notice the missing permission yet.)

<<linux_abi.c: memory>>=
extern u64 *pte_of (u64 l0_pa, u64 va);
extern u64 arch_as_l0 (addr_space_id id);
extern u64 alloc_frame_try (void);
extern void free_frame (u64 pa);
extern int  map_page_in (u64 l0_pa, u64 va, u64 pa, u64 flags);
extern void release_page (unsigned int pageno);
extern int  page_in (int as, int pageno);
extern void sync_icache (void *p, u64 len);
extern long frames_in_use;
#define KVA(pa)  ((void *)(0xFFFF000000000000UL + (u64)(pa)))

#define MMAP_LO  0x40000000UL
#define MMAP_HI  0x7B000000UL

#define PROT_READ   1
#define PROT_WRITE  2
#define PROT_EXEC   4
#define MAP_FIXED   0x10
#define MAP_ANONYMOUS 0x20
#define PAGE_UNONE  (PAGE_URW & ~PTE_AP_USER)           // PROT_NONE: no access from user mode

// the page table entry bits for a protection, 0 if the combination is not allowed
static u64 prot_flags (int prot) {
  if ((prot & PROT_WRITE) && (prot & PROT_EXEC)) return 0;          // W^X
  if (prot & PROT_WRITE) return PAGE_URW;
  if (prot & PROT_EXEC)  return PAGE_URX;
  if (prot & PROT_READ)  return PAGE_URO;
  return PAGE_UNONE;
}

static void flush_tlb_all (void) { __asm__ volatile ("dsb ishst; tlbi vmalle1is; dsb ish; isb" ::: "memory"); }

static int page_is_free (u64 l0, u64 va) {
  u64 *e = pte_of (l0, va);
  return !e || !(*e & (PTE_VALID | PTE_SWAPPED));
}

// the lowest address of the highest run of n free pages in a row (the search goes downwards), 0 if there is none
static u64 find_free (u64 l0, u64 n) {
  u64 run = 0;
  for (u64 va = MMAP_HI - 4096; va >= MMAP_LO; va -= 4096) {
    run = page_is_free (l0, va) ? run + 1 : 0;
    if (run == n) return va;
  }
  return 0;
}

static void unmap_range (u64 va, u64 len) {
  for (u64 p = va; p < va + len; p += 4096) release_page (p >> 12);
  flush_tlb_all ();
}

@
\paragraph{Shared mappings and files.} \texttt{mmap} used to know only anonymous memory. Python's \texttt{mmap} module and \texttt{multiprocessing}'s shared heap
(\texttt{Value}, \texttt{Array}) need two more things, and the kernel has neither file mappings nor shared memory, so both are made out of what there is:

\begin{itemize}
\item \emph{A mapping that is shared} (\texttt{MAP\_SHARED}) marks its page table entries with \texttt{PTE\_SHARED}. \texttt{fork} (the copy of the tables, chapter \ref{ch:processes}) gives
  the child the same \emph{writable} frames for those entries, without copy-on-write, so that parent and child see each other's writes. That is all that
  \texttt{multiprocessing} needs, because the children of a pool are forked from the process that made the mapping. Unrelated processes do not share anything.
\item \emph{A file mapping} reads the file into fresh pages when the mapping is made (copy in), as \texttt{MAP\_PRIVATE} does on every system. For a shared mapping that may be written,
  the kernel remembers the file (a table of 16 entries: address range, a duplicate of the file descriptor, offset, size); \texttt{msync} and \texttt{munmap} write the
  pages back, nothing else does, and a program that ends without \texttt{munmap} loses its changes. So a file is not a way for two programs to talk to each other here.
\end{itemize}

<<linux_abi.c: memory>>=
extern int u_lseek (int gfd, int offset, int whence), u_read (int gfd, void *buf, int n), u_write (int gfd, void *buf, int n), u_close (int gfd), u_reopen (int gfd), u_share (int gfd);
extern int pfd2gfd (int pfd);
#define MAP_SHARED_  0x01

struct fmap { int used, gfd, as;  u64 base, len;  long off, size; };      // a shared, writable file mapping that msync and munmap write back
static struct fmap fmaps[16];

// write the part of the file mapping f that lies in [lo, hi) back to the file
static void fmap_writeback (struct fmap *f, u64 lo, u64 hi) {
  if (lo < f->base) lo = f->base;
  if (hi > f->base + f->len) hi = f->base + f->len;
  for (u64 va = lo & ~4095UL; va < hi; va += 4096) {
    long pos = f->off + (long) (va - f->base);
    if (pos >= f->size || !user_ok (va, 4096, 0)) continue;
    long n = f->size - pos < 4096 ? f->size - pos : 4096;
    u_lseek (f->gfd, pos, 0);
    u_write (f->gfd, (void *) va, n);
  }
}

static long linux_mprotect (u64 addr, u64 len, int prot);

static long linux_mmap (u64 addr, u64 len, int prot, int flags, int fd, long off) {
  u64 l0 = arch_as_l0 (current_as), flagbits = prot_flags (prot);
  if (!len) return -LE_EINVAL;
  if (len > MMAP_HI - MMAP_LO) return -LE_ENOMEM;                 // more than the whole range: Linux says ENOMEM (malloc of a huge size relies on it)
  len = (len + 4095) & ~4095UL;
  if (!flagbits) return -LE_EACCES;
  int gfd = -1;
  if (!(flags & MAP_ANONYMOUS)) {                                 // a file: read it into the new pages below
    gfd = pfd2gfd (fd);
    if (fd < 0 || gfd < 0) return -LE_EBADF;
    if (off & 4095) return -LE_EINVAL;
  }
  u64 base;
  if (flags & MAP_FIXED) {
    if ((addr & 4095) || addr < MMAP_LO || addr + len > MMAP_HI) return -LE_EINVAL;
    base = addr;
    unmap_range (base, len);                                      // MAP_FIXED replaces what was there
  } else {
    base = find_free (l0, len >> 12);
    if (!base) { printf ("[kernel] mmap: no free address range of %lu pages\n", len >> 12); return -LE_ENOMEM; }
  }
  u64 pageflags = (gfd >= 0 ? PAGE_URW : flagbits) | ((flags & MAP_SHARED_) ? PTE_SHARED : 0);   // (a file is read in first: writable for now)
  for (u64 va = base; va < base + len; va += 4096) {
    u64 pa = alloc_frame_try ();                                  // zeroed; swaps a page out if the RAM is full
    if (!pa || map_page_in (l0, va, pa, pageflags) != 0) {
      printf ("[kernel] mmap: %s at page %lu of %lu (frames in use: %ld)\n", pa ? "cannot map" : "no free frame", (va - base) >> 12, len >> 12, frames_in_use);
      if (pa) free_frame (pa);
      unmap_range (base, va - base);                              // all or nothing
      return -LE_ENOMEM;
    }
  }
  if (gfd >= 0) {
    long here = u_lseek (gfd, 0, 1), size = u_lseek (gfd, 0, 2);   // (the position of the file belongs to the program: put it back)
    for (u64 va = base; va < base + len && (long) (off + (va - base)) < size; va += 4096) {
      long n = size - (off + (long) (va - base)); if (n > 4096) n = 4096;
      u_lseek (gfd, off + (long) (va - base), 0);
      if (!user_ok (va, 4096, 1) || u_read (gfd, (void *) va, n) < 0) { u_lseek (gfd, here, 0);  unmap_range (base, len);  return -LE_EIO; }
    }
    u_lseek (gfd, here, 0);
    if (!(prot & PROT_WRITE) || (prot & PROT_EXEC)) linux_mprotect (base, len, prot);       // now the protection that was asked for
    if ((flags & MAP_SHARED_) && (prot & PROT_WRITE))
      for (int i = 0; i < 16; i++)
        if (!fmaps[i].used) { fmaps[i] = (struct fmap) { 1, u_reopen (gfd), current_as, base, len, off, size };  break; }
  }
  return base;
}

static long linux_msync (u64 addr, u64 len) {
  for (int i = 0; i < 16; i++)
    if (fmaps[i].used && fmaps[i].as == current_as && addr < fmaps[i].base + fmaps[i].len && addr + len > fmaps[i].base) fmap_writeback (&fmaps[i], addr, addr + len);
  return 0;
}

static long linux_munmap (u64 addr, u64 len) {
  if ((addr & 4095) || !len || addr < MMAP_LO || addr + len > MMAP_HI) return -LE_EINVAL;
  len = (len + 4095) & ~4095UL;
  for (int i = 0; i < 16; i++)
    if (fmaps[i].used && fmaps[i].as == current_as && addr < fmaps[i].base + fmaps[i].len && addr + len > fmaps[i].base) {
      fmap_writeback (&fmaps[i], addr, addr + len);
      if (addr <= fmaps[i].base && addr + len >= fmaps[i].base + fmaps[i].len) { u_close (fmaps[i].gfd);  fmaps[i].used = 0; }     // (all of it: the entry goes)
    }
  unmap_range (addr, len);
  return 0;
}

static long linux_mprotect (u64 addr, u64 len, int prot) {
  u64 l0 = arch_as_l0 (current_as), flagbits = prot_flags (prot);
  if ((addr & 4095) || !flagbits) return flagbits ? -LE_EINVAL : -LE_EACCES;
  len = (len + 4095) & ~4095UL;
  for (u64 va = addr; va < addr + len; va += 4096) {              // first: is everything mapped?
    u64 *e = pte_of (l0, va);
    if (!e || !(*e & (PTE_VALID | PTE_SWAPPED))) return -LE_ENOMEM;
  }
  for (u64 va = addr; va < addr + len; va += 4096) {
    u64 *e = pte_of (l0, va);
    if (!(*e & PTE_VALID) && page_in (current_as, va >> 12) != 0) return -LE_ENOMEM;
    e = pte_of (l0, va);
    u64 old = *e, pa = old & PTE_ADDR, ne = pa | flagbits | (old & PTE_SHARED);
    if ((old & PTE_COW) && (ne & PTE_RO) == 0) ne |= PTE_RO | PTE_COW;   // a shared page stays shared until it is written
    else if (old & PTE_COW) ne |= PTE_COW;
    *e = ne;
    if (prot & PROT_EXEC) sync_icache (KVA (pa), 4096);          // the new code must be seen by the instruction fetch
  }
  flush_tlb_all ();
  return 0;
}

