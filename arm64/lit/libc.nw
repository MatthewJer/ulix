    case L_fchdir: {                                           // the name that linux_openat remembered
      int gfd = pfd2gfd (a0);
      if (a0 < 0 || gfd == -1) { ret = -LE_EBADF; break; }
      if ((gfd >> 8) != FS_MINIX || !fd_path[gfd & 0xff][0]) { ret = -LE_ENOTDIR; break; }
      ret = ulix_call (r, syscall_chdir, (long) fd_path[gfd & 0xff], 0, 0, 0, 0) < 0 ? -LE_ENOENT : 0;
      break;
    }
    case L_statfs:  ret = linux_statfs ((const char *) a0, (void *) a1); break;
    case L_fstatfs: ret = linux_statfs (0, (void *) a1); break;
    case L_usem_open:   ret = linux_usem_open ((const char *) a0, a1, a2); break;
    case L_usem_wait:   ret = linux_usem_wait (a0, a1, a2); break;
    case L_usem_post:   ret = linux_usem_post (a0); break;
    case L_usem_value:  ret = linux_usem_value (a0); break;
    case L_usem_close:  ret = linux_usem_close (a0); break;
    case L_usem_unlink: ret = linux_usem_unlink ((const char *) a0); break;
    case L_uchan_open:   ret = linux_uchan_open ((const char *) a0, a1); break;
    case L_uchan_send:   ret = linux_uchan_send (a0, (const char *) a1, a2, a3, a4); break;
    case L_uchan_recv:   ret = linux_uchan_recv (a0, (char *) a1, a2, a3, a4); break;
    case L_uchan_close:  ret = linux_uchan_close (a0); break;
    case L_uchan_unlink: ret = linux_uchan_unlink ((const char *) a0); break;
    case L_socket:      ret = linux_socket (a0, a1, a2); break;
    case L_socketpair:  ret = linux_socketpair (r, a0, a1, a2, (int *) a3); break;
    case L_connect:     ret = linux_connect_or_bind (a0, (const void *) a1, a2, 1); break;
    case L_listen:      ret = linux_listen (a0, a1); break;
    case L_accept:      ret = linux_accept (a0, (void *) a1, (unsigned *) a2, 0); break;
    case L_accept4:     ret = linux_accept (a0, (void *) a1, (unsigned *) a2, a3); break;
    case L_bind:        ret = linux_connect_or_bind (a0, (const void *) a1, a2, 0); break;
    case L_sendto:      ret = linux_sendto (a0, (const void *) a1, a2, a3, (const void *) a4, a5); break;
    case L_recvfrom:    ret = linux_recvfrom (a0, (void *) a1, a2, a3, (void *) a4, (unsigned *) a5); break;
    case L_getsockname: ret = linux_getname (a0, (void *) a1, (unsigned *) a2, 0); break;
    case L_getpeername: ret = linux_getname (a0, (void *) a1, (unsigned *) a2, 1); break;
    case L_setsockopt:  ret = linux_setsockopt (a0, a1, a2, (const void *) a3, a4); break;
    case L_getsockopt:  ret = linux_getsockopt (a0, a1, a2, (void *) a3, (unsigned *) a4); break;
    case L_sendmsg:     ret = linux_sendmsg (a0, (struct msghdr_ *) a1, a2); break;
    case L_recvmsg:     ret = linux_recvmsg (a0, (struct msghdr_ *) a1, a2); break;
    case L_shutdown:    ret = linux_shutdown (a0, a1); break;
    case L_ppoll:       ret = linux_ppoll ((struct pollfd_ *) a0, a1, (struct ts *) a2); break;
    case L_pselect6:    ret = linux_pselect6 (a0, (unsigned long *) a1, (unsigned long *) a2, (unsigned long *) a3, (struct ts *) a4); break;
    case L_renameat: case L_renameat2: ret = linux_renameat (a0, (const char *) a1, a2, (const char *) a3); break;
    case L_getrandom: ret = linux_getrandom ((char *) a0, a1, a2); break;
    case L_getcwd: ret = linux_getcwd ((char *) a0, a1); break;
    case L_chdir: {                                            // (the book's chdir only says -1: ask stat for the reason)
      struct stat st;
      if (!user_string_ok (a0)) { ret = -LE_EFAULT; break; }
      if (u_stat ((const char *) a0, &st) != 0) ret = -LE_ENOENT;
      else if ((st.st_mode & S_IFMT) != S_IFDIR) ret = -LE_ENOTDIR;
      else ret = ulix_call (r, syscall_chdir, a0, 0, 0, 0, 0) < 0 ? -LE_ENOENT : 0;
      break;
    }
    case L_mkdirat: case L_unlinkat: case L_faccessat: {      // (the name may be relative to an open directory: at_name)
      char nbuf[FD_PATH];  long err = 0;
      if (!user_string_ok (a1)) { ret = -LE_EFAULT; break; }
      const char *name = at_name (a0, (const char *) a1, nbuf, &err);
      if (!name) { ret = err; break; }
      struct stat have;
      if (nr == L_mkdirat && u_stat (name, &have) == 0) ret = -LE_EEXIST;
      else if (nr == L_mkdirat) ret = ulix_call (r, syscall_mkdir, (long) name, a2, 0, 0, 0) < 0 ? linux_error (LE_EACCES) : 0;
      else if (nr == L_unlinkat && u_stat (name, &have) != 0) ret = -LE_ENOENT;
      else if (nr == L_unlinkat) ret = ulix_call (r, (a2 & 0x200) ? syscall_rmdir : syscall_unlink, (long) name, 0, 0, 0, 0) < 0 ? linux_error (LE_ENOENT) : 0;
      else { struct stat st; ret = u_stat (name, &st) == 0 ? 0 : -LE_ENOENT; }
      break;
    }

    // memory
    case L_brk:      ret = linux_brk (a0); break;
    case L_mmap:     ret = linux_mmap (a0, a1, a2, a3, a4, a5); break;
    case L_munmap:   ret = linux_munmap (a0, a1); break;
    case L_msync:    ret = linux_msync (a0, a1); break;
    case L_mprotect: ret = linux_mprotect (a0, a1, a2); break;
    case L_clock_getres: ret = linux_clock_getres (a0, (struct ts *) a1); break;
    case L_getrlimit: ret = linux_getrlimit (a0, (struct rlim *) a1); break;
    case L_prlimit64: ret = linux_prlimit64 (a0, a1, (const struct rlim *) a2, (struct rlim *) a3); break;
    case L_mremap:   ret = -LE_ENOMEM; break;                 // musl then allocates, copies and frees
    case L_madvise:  ret = 0; break;                          // advice only

    // time
    case L_clock_gettime:   ret = linux_clock_gettime (a0, (struct ts *) a1); break;
    case L_gettimeofday:    ret = linux_gettimeofday ((long *) a0, (void *) a1); break;
    case L_nanosleep:       ret = linux_nanosleep ((struct ts *) a0, (struct ts *) a1); break;
    case L_clock_nanosleep: ret = linux_clock_nanosleep (a0, a1, (struct ts *) a2, (struct ts *) a3); break;

    // signals
    case L_rt_sigaction:   ret = linux_sigaction (a0, (struct k_sigaction *) a1, (struct k_sigaction *) a2, a3); break;
    case L_rt_sigprocmask: ret = linux_sigprocmask (a0, (u64 *) a1, (u64 *) a2, a3); break;
    case L_kill:           ret = linux_kill (a0, a1); break;
    case L_tkill:          ret = linux_kill (a0, a1); break;
    case L_tgkill:         ret = linux_kill (a1, a2); break;

    // processes
    case L_exit: case L_exit_group:
      arch_linux_exit (r, (int) a0, nr == L_exit_group);      // the end of a thread, or of the process (does not return)
      return;
    case L_sched_yield: syscall_resign (r); ret = 0; break;
    case L_sched_getaffinity: ret = linux_sched_getaffinity (a0, a1, (u64 *) a2); break;
    case L_sched_setaffinity: ret = 0; break;                  // (the threads run wherever the scheduler puts them)
    case L_sigaltstack: ret = linux_sigaltstack ((struct stack_t_ *) a0, (struct stack_t_ *) a1, r->sp_el0); break;
    case L_getpid:  ret = thread_table[current_task].pid; break;
    case L_gettid:  ret = current_task; break;
    case L_set_tid_address: arch_set_clear_tid (current_task, a0); ret = current_task; break;
    case L_get_robust_list: ret = linux_get_robust_list (a0, (u64 *) a1, (u64 *) a2); break;
    case L_set_robust_list: ret = linux_set_robust_list (a0, a1); break;    // robust mutexes: see the futex section
    case L_futex:   ret = linux_futex ((int *) a0, a1, a2, (struct ts *) a3, (int *) a4, a5); break;
    case L_getppid: ret = thread_table[current_task].ppid; break;
    case L_getuid: case L_geteuid: case L_getgid: case L_getegid: ret = 0; break;
    case L_clone: ret = linux_clone (r, a0, a1, (int *) a2, a3, (int *) a4); break;
    case L_wait4: ret = linux_wait4 (r, a0, (int *) a1, a2); break;
    case L_uname: ret = linux_uname ((char *) a0); break;

    default:
      if (nr >= L_ULIX && nr < L_ULIX + 1024) {                // a call of the book that Linux does not have: see "The book's own calls"
        r->eax = nr - L_ULIX;  r->ebx = a0;  r->ecx = a1;  r->edx = a2;  r->esi = a3;  r->edi = a4;
        syscall_handler (r);
        ret = (int) r->eax;                                    // (-1 and the error number in the process, as for a program of the book)
        break;
      }
      if (nr >= 0 && nr < 512 && !unknown_reported[nr]) {
        unknown_reported[nr] = 1;
        printf ("[kernel] process %d: Linux system call %ld is not implemented\n", thread_table[current_task].pid, nr);
      }
      ret = -LE_ENOSYS;
  }
  if (ret == -LE_ENOMEM && nr != L_mremap && enomem_reported++ < 20)    // (a program that runs out of memory: say which call and how much; mremap always says no, by design: musl then copies)
    printf ("[kernel] process %d: Linux system call %ld (%lx, %lx, %lx) failed: out of memory\n", thread_table[current_task].pid, nr, a0, a1, a2);
  r->x1 = saved.x1; r->x2 = saved.x2; r->x3 = saved.x3; r->x4 = saved.x4; r->x5 = saved.x5;
  r->x8 = saved.x8;
  r->x0 = ret;
}

