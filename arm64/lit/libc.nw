\subsection{Message channels between processes}
\label{sec:libc:uchan}

Threads share memory, processes do not (except in a \texttt{MAP\_SHARED} mapping, see below), and pipes are a stream of bytes between relatives. Two programs that
want to exchange \emph{messages} --- a window server and its clients, a sound mixer and the programs that play --- need a channel that

\begin{itemize}
\item has a name, so that unrelated processes can find it (like the named semaphores above and like \texttt{mq\_open} of POSIX),
\item keeps the boundaries of the messages (one \texttt{send} is one \texttt{recv}),
\item makes the sender wait when it is full and the receiver wait when it is empty.
\end{itemize}

The kernel therefore keeps a small table of channels, each a ring of 16 messages of up to 256 bytes. The calls are Ulix's own (646 to 650, outside the numbers of Linux, like the
semaphores): \texttt{uchan\_open (name, flags)}, \texttt{uchan\_send (id, buf, len, mode, timeout\_ns)}, \texttt{uchan\_recv (id, buf, size, mode, timeout\_ns)},
\texttt{uchan\_close (id)} and \texttt{uchan\_unlink (name)}; \texttt{mode} is 0 (wait), 1 (do not wait: \texttt{EAGAIN}) or 2 (wait at most \texttt{timeout\_ns}).
A message that is longer than the buffer of \texttt{recv} is not cut: the call fails with \texttt{EMSGSIZE} and the message stays.

\paragraph{Waiting.} Both sides sleep in the queue of the futexes (see above), the key is the address of the channel for the receivers and the next byte for the senders. A
\texttt{send} wakes one receiver, a \texttt{recv} wakes one sender. Nothing is copied twice: the kernel copies the message into the ring and out of it, under the kernel lock.

\paragraph{Simple version first, and what it leaves out.} Eight channels, no priorities, no access rights (the name is the only protection; a window server would check who
it talks to), no notification (the signal when a message arrives: a program that wants to wait for a channel \emph{and} a socket must make rounds with a time limit, as the servers
of section 30 do). A channel stays in the table as long as it is open or its name exists, like a semaphore.

<<linux_abi.c: message channels>>=
#define MAX_UCHAN    8
#define UCHAN_SLOTS 16
#define UCHAN_SIZE 256
#define LE_EMSGSIZE 90
struct uchan {
  char name[32];  int used, unlinked, refs;
  int head, count;                                          // the oldest message is slot head, count of them
  unsigned short len[UCHAN_SLOTS];
  char data[UCHAN_SLOTS][UCHAN_SIZE];
};
static struct uchan uchans[MAX_UCHAN];

static struct uchan *uchan_of (long id) { return (id >= 0 && id < MAX_UCHAN && uchans[id].used) ? &uchans[id] : 0; }

static long linux_uchan_open (const char *name, int flags) {
  if (!user_string_ok ((u64) name)) return -LE_EFAULT;
  if (strlen (name) >= 32) return -LE_EINVAL;
  for (int i = 0; i < MAX_UCHAN; i++)
    if (uchans[i].used && !uchans[i].unlinked && strcmp (uchans[i].name, name) == 0) {
      if ((flags & LO_CREAT) && (flags & LO_EXCL)) return -LE_EEXIST;
      uchans[i].refs++;
      return i;
    }
  if (!(flags & LO_CREAT)) return -LE_ENOENT;
  for (int i = 0; i < MAX_UCHAN; i++)
    if (!uchans[i].used) {
      memset (&uchans[i], 0, sizeof uchans[i]);
      strcpy (uchans[i].name, name);
      uchans[i].used = 1;  uchans[i].refs = 1;
      return i;
    }
  return -LE_ENOMEM;
}

// wait for the channel to have room (sender) or a message (receiver): 0, or minus an error; mode as described above
static long uchan_wait (struct uchan *c, int sender, int mode, long long timeout_ns) {
  int ready = sender ? c->count < UCHAN_SLOTS : c->count > 0;
  if (ready) return 0;
  if (mode == 1) return -LE_EAGAIN;
  unsigned long long deadline = mode == 2 ? mono_ns () + (timeout_ns > 0 ? timeout_ns : 0) : 0;
  while (!(sender ? c->count < UCHAN_SLOTS : c->count > 0)) {
    if (mode == 2 && mono_ns () >= deadline) return -LE_ETIMEDOUT;
    if (futex_sleep ((u64) c + sender, -1, deadline) == -LE_EINTR) return -LE_EINTR;
  }
  return 0;
}

static long linux_uchan_send (long id, const char *buf, u64 len, int mode, long long timeout_ns) {
  struct uchan *c = uchan_of (id);
  if (!c) return -LE_EINVAL;
  if (len > UCHAN_SIZE) return -LE_EMSGSIZE;
  if (len && !user_ok ((u64) buf, len, 0)) return -LE_EFAULT;
  long r = uchan_wait (c, 1, mode, timeout_ns);
  if (r < 0) return r;
  int slot = (c->head + c->count) % UCHAN_SLOTS;
  memcpy (c->data[slot], buf, len);
  c->len[slot] = len;
  c->count++;
  futex_wake_key ((u64) c, -1, 1);                          // a receiver
  return len;
}

static long linux_uchan_recv (long id, char *buf, u64 size, int mode, long long timeout_ns) {
  struct uchan *c = uchan_of (id);
  if (!c) return -LE_EINVAL;
  if (!user_ok ((u64) buf, size, 1)) return -LE_EFAULT;
  long r = uchan_wait (c, 0, mode, timeout_ns);
  if (r < 0) return r;
  int len = c->len[c->head];
  if (len > size) return -LE_EMSGSIZE;                      // the message stays
  memcpy (buf, c->data[c->head], len);
  c->head = (c->head + 1) % UCHAN_SLOTS;
  c->count--;
  futex_wake_key ((u64) c + 1, -1, 1);                      // a sender
  return len;
}

static long linux_uchan_close (long id) {
  struct uchan *c = uchan_of (id);
  if (!c) return -LE_EINVAL;
  if (--c->refs <= 0 && c->unlinked) c->used = 0;
  return 0;
}

static long linux_uchan_unlink (const char *name) {
  if (!user_string_ok ((u64) name)) return -LE_EFAULT;
  for (int i = 0; i < MAX_UCHAN; i++)
    if (uchans[i].used && !uchans[i].unlinked && strcmp (uchans[i].name, name) == 0) {
      uchans[i].unlinked = 1;
      if (uchans[i].refs <= 0) uchans[i].used = 0;
      return 0;
    }
  return -LE_ENOENT;
}

