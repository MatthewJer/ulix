\subsection{File status, directories and descriptors}
\label{sec:libc:files}

\paragraph{\texttt{stat}.} The book's \texttt{struct stat} is a small, 32-bit version of the one in the Linux manual. musl wants the
128-byte Linux/AArch64 layout (64-bit sizes and inode numbers, nanoseconds, \texttt{st\_blksize}), so every status is copied field by
field. \texttt{fstat} looks at what the descriptor is: a file of the Minix file system has an inode in the kernel's table of open
files (\texttt{mx\_status}); a pipe is a FIFO of size 0; the terminal and the devices are character special files. The dates have
no nanoseconds (the file system stores whole seconds).

<<linux_abi.c: file status, directories and descriptors>>=
extern struct mx_filestat mx_status[];
#define FS_PIPE_NR 4                                            // the file system number of pipes (pipes.c)

struct kstat {                                                  // struct stat of Linux/AArch64, 128 bytes
  u64 st_dev, st_ino;
  unsigned st_mode, st_nlink, st_uid, st_gid;
  u64 st_rdev, pad1;
  long st_size;
  int st_blksize, pad2;
  long st_blocks;
  long atime, atime_ns, mtime, mtime_ns, ctime, ctime_ns;
  unsigned unused[2];
};

static void kstat_clear (struct kstat *k) { memset (k, 0, sizeof *k); k->st_blksize = 1024; k->st_nlink = 1; }

static void kstat_from_book (struct kstat *k, struct stat *s) {
  kstat_clear (k);
  k->st_dev = s->st_dev;  k->st_ino = s->st_ino;  k->st_mode = s->st_mode;  k->st_nlink = s->st_nlink;
  k->st_uid = s->st_uid;  k->st_gid = s->st_gid;  k->st_rdev = s->st_rdev;  k->st_size = s->st_size;
  k->st_blocks = (s->st_size + 511) / 512;
  k->atime = s->st_atime;  k->mtime = s->st_mtime;  k->ctime = s->st_ctime;
}

static long linux_fstat (int fd, struct kstat *k) {
  if (!user_ok ((u64) k, sizeof *k, 1)) return -LE_EFAULT;
  int gfd = pfd2gfd (fd);
  if (fd < 0 || gfd == -1) return -LE_EBADF;
  kstat_clear (k);
  if (gfd < 0 || (gfd >> 8) == FS_DEV || (gfd >> 8) == 5) { k->st_mode = S_IFCHR | 0620; return 0; }    // the terminal (negative numbers) and the devices
  if ((gfd >> 8) == FS_PIPE_NR)        { k->st_mode = S_IFIFO | 0600; return 0; }
  if ((gfd >> 8) != FS_MINIX) return -LE_EBADF;
  struct int_minix2_inode *in = mx_status[gfd & 0xff].int_inode;
  if (!in) return -LE_EBADF;
  k->st_dev = in->device;  k->st_ino = in->ino;  k->st_mode = in->i_mode;  k->st_nlink = in->i_nlinks;
  k->st_uid = in->i_uid;   k->st_gid = in->i_gid;  k->st_size = in->i_size;  k->st_blocks = (in->i_size + 511) / 512;
  k->atime = in->i_atime;  k->mtime = in->i_mtime;  k->ctime = in->i_ctime;
  return 0;
}

#define AT_EMPTY_PATH 0x1000

// stat, lstat and fstat: musl's stat () is newfstatat (AT_FDCWD, path); the file system does not follow links in stat
static long linux_newfstatat (int dirfd, const char *path, struct kstat *k, int flags) {
  if (!user_string_ok ((u64) path) || !user_ok ((u64) k, sizeof *k, 1)) return -LE_EFAULT;
  if (path[0] == 0) return (flags & AT_EMPTY_PATH) ? linux_fstat (dirfd, k) : -LE_ENOENT;
  if (dirfd != AT_FDCWD && path[0] != '/') return -LE_ENOSYS;
  struct stat st = { 0 };
  if (u_stat (path, &st) != 0) return -LE_ENOENT;
  kstat_from_book (k, &st);
  return 0;
}

@
\paragraph{Directories.} A program reads a directory with \texttt{getdents64}: the descriptor is a directory that was opened with
\texttt{open}, and the call fills a buffer with as many variable-length records as fit. The Minix directory is an array of 32-byte
entries (a 2-byte inode number and a 30-byte name), and the position of the open file, in bytes, is the position in that array,
so that \texttt{lseek (fd, 0, SEEK\_SET)} (\texttt{rewinddir}) works without any new code. Free entries (inode 0) are skipped. The
type of each entry is read from its inode (musl's \texttt{readdir} passes it on as \texttt{d\_type}).

<<linux_abi.c: file status, directories and descriptors>>=
#define DT_DIR_ 4
#define DT_REG_ 8

static long linux_getdents64 (int fd, char *buf, u64 size) {
  int gfd = pfd2gfd (fd);
  if (fd < 0 || gfd < 0 || (gfd >> 8) != FS_MINIX || !mx_status[gfd & 0xff].int_inode) return -LE_EBADF;
  struct mx_filestat *f = &mx_status[gfd & 0xff];
  struct int_minix2_inode *dir = f->int_inode;
  if ((dir->i_mode & S_IFMT) != S_IFDIR) return -LE_ENOTDIR;
  if (!user_ok ((u64) buf, size, 1)) return -LE_EFAULT;
  u64 used = 0;
  while (f->pos < (int) dir->i_size) {
    struct minix_dir_entry d;
    if (mx_read_dir_entry (dir->device, dir->ino, f->pos / 32, &d) == -1) break;
    if (d.inode == 0) { f->pos += 32; continue; }                // a free slot
    int n = 0;
    while (n < 30 && d.name[n]) n++;
    u64 reclen = (19 + n + 1 + 7) & ~7UL;                        // d_ino, d_off, d_reclen, d_type, the name with its zero, padded to 8
    if (used + reclen > size) return used ? (long) used : -LE_EINVAL;   // the buffer is too small for even one entry
    struct minix2_inode ino;
    int type = 0;
    if (mx_read_inode (dir->device, d.inode, &ino)) type = (ino.i_mode & S_IFMT) == S_IFDIR ? DT_DIR_ : (ino.i_mode & S_IFMT) == S_IFREG ? DT_REG_ : 0;
    char *e = buf + used;
    f->pos += 32;
    *(u64 *) e = d.inode;                                        // d_ino
    *(long *) (e + 8) = f->pos;                                  // d_off: where the next call goes on
    *(unsigned short *) (e + 16) = reclen;
    e[18] = type;
    memcpy (e + 19, d.name, n);
    e[19 + n] = 0;
    used += reclen;
  }
  return used;
}

@
\paragraph{Descriptors.} \texttt{dup}, \texttt{dup3} and \texttt{fcntl (F\_DUPFD)} copy an entry of the process's descriptor table with
\texttt{u\_reopen}, the function that \texttt{fork} uses. For a file that gives the copy \emph{its own} read/write position, which
is a difference from Unix (there both descriptors share the position); for a pipe end it is one more user of the same end. The
table has 16 entries (\texttt{MAX\_PFD} of the book), so \texttt{EMFILE} comes early. \texttt{pipe2} and \texttt{dup3} use the
book's calls from \texttt{pipes.c}; the flags \texttt{O\_CLOEXEC} and \texttt{O\_NONBLOCK} are accepted and ignored (a descriptor
is never closed by \texttt{exec} yet, and reads on pipes always block).

<<linux_abi.c: file status, directories and descriptors>>=
extern void syscall_pipe (context_t *r), syscall_dup2 (context_t *r);

static long linux_dup_from (int old, int from) {
  TCB *t = &thread_table[thread_table[current_task].pid];
  int gfd = pfd2gfd (old);
  if (old < 0 || old >= MAX_PFD || gfd == -1) return -LE_EBADF;
  if (from < 0 || from >= MAX_PFD) return -LE_EINVAL;
  for (int pfd = from; pfd < MAX_PFD; pfd++)
    if (t->files[pfd] == -1) { t->files[pfd] = gfd >= 0 ? u_reopen (gfd) : gfd;  return pfd; }
  return -LE_EMFILE;
}

static long linux_dup3 (context_t *r, int old, int new, int flags) {
  if (old == new) return -LE_EINVAL;                             // (dup2 allows it, dup3 does not)
  if (flags & ~02000000) return -LE_EINVAL;
  int k = ulix_call (r, syscall_dup2, old, new, 0, 0, 0);
  return k < 0 ? -LE_EBADF : k;
}

static long linux_pipe2 (context_t *r, int *fds, int flags) {
  if (!user_ok ((u64) fds, 8, 1)) return -LE_EFAULT;
  int k = ulix_call (r, syscall_pipe, (long) fds, 0, 0, 0, 0);
  return k < 0 ? -LE_EMFILE : 0;
}

#define F_DUPFD 0
#define F_GETFD 1
#define F_SETFD 2
#define F_GETFL 3
#define F_SETFL 4
#define F_DUPFD_CLOEXEC 1030

static long linux_fcntl (int fd, int cmd, long arg) {
  int gfd = pfd2gfd (fd);
  if (fd < 0 || gfd == -1) return -LE_EBADF;
  switch (cmd) {
    case F_DUPFD: case F_DUPFD_CLOEXEC: return linux_dup_from (fd, arg);
    case F_GETFD: case F_SETFD: return 0;                        // no close-on-exec yet
    case F_SETFL: if (is_sock (gfd)) sock_set_nonblock (gfd, (arg & LO_NONBLOCK) != 0);  return 0;      // (only sockets can be non-blocking)
    case F_GETFL: {                                              // the access mode (and append) that the file was opened with
      if (is_sock (gfd)) return 2 | (sock_is_nonblock (gfd) ? LO_NONBLOCK : 0);
      if (gfd < 0 || (gfd >> 8) != FS_MINIX) return gfd >= 0 && (gfd >> 8) == FS_PIPE_NR ? ((gfd & 1) ? 1 : 0) : 2;
      int m = mx_status[gfd & 0xff].mode;
      return (m & 3) | ((m & O_APPEND) ? LO_APPEND : 0);
    }
  }
  return -LE_EINVAL;
}

static long linux_ftruncate (int fd, long length) {
  int gfd = pfd2gfd (fd);
  if (fd < 0 || gfd < 0 || (gfd >> 8) != FS_MINIX) return -LE_EBADF;
  return u_ftruncate (gfd, length) < 0 ? -LE_EACCES : 0;
}

static long linux_readlinkat (int dirfd, const char *path, char *buf, u64 size) {
  if (!user_string_ok ((u64) path) || !user_ok ((u64) buf, size, 1)) return -LE_EFAULT;
  if (dirfd != AT_FDCWD && path[0] != '/') return -LE_ENOSYS;
  struct stat st = { 0 };
  if (u_stat (path, &st) != 0) return -LE_ENOENT;
  if ((st.st_mode & S_IFMT) != S_IFLNK) return -LE_EINVAL;
  int n = u_readlink ((char *) path, buf, size);
  return n < 0 ? -LE_EINVAL : n;
}

@
\paragraph{Rename.} The book has no \texttt{rename}. A file gets its new name by a hard link and loses the old one (\texttt{u\_link}, then
\texttt{u\_unlink}), and an existing target is removed first, as \texttt{rename} replaces it. That is not atomic (a crash between the two steps
leaves both names), and directories cannot be renamed this way (the link count of \texttt{..} would be wrong), so they are refused
with \texttt{EPERM}. CPython writes its compiled modules under a temporary name and renames them; without this call it would only
say nothing and go on.

<<linux_abi.c: file status, directories and descriptors>>=
static long linux_renameat (int olddir, const char *old, int newdir, const char *new) {
  if (!user_string_ok ((u64) old) || !user_string_ok ((u64) new)) return -LE_EFAULT;
  if ((olddir != AT_FDCWD && old[0] != '/') || (newdir != AT_FDCWD && new[0] != '/')) return -LE_ENOSYS;
  struct stat st = { 0 }, st2 = { 0 };
  if (u_stat (old, &st) != 0) return -LE_ENOENT;
  if ((st.st_mode & S_IFMT) == S_IFDIR) return -LE_EPERM;
  if (u_stat (new, &st2) == 0) {
    if ((st2.st_mode & S_IFMT) == S_IFDIR) return -LE_EISDIR;
    if (st2.st_ino == st.st_ino && st2.st_dev == st.st_dev) return 0;       // the same file: nothing to do
    if (u_unlink (new) != 0) return -LE_EACCES;
  }
  if (u_link (old, new) != 0) return -LE_EACCES;
  return u_unlink (old) == 0 ? 0 : -LE_EACCES;
}

@
\paragraph{Random numbers.} \texttt{getrandom} (issue \#45) gives what the hardware generator gave (\texttt{random\_get}, chapter
\ref{ch:tls}); the flags only say how to wait or which pool to use, and there is no pool, so they are accepted and ignored. Without a
generator the call fails with \texttt{EIO}, and a program such as the Python interpreter, which wants random numbers for its hash
tables, then says so instead of running with numbers an attacker could guess.

<<linux_abi.c: file status, directories and descriptors>>=
extern int random_get (void *buf, int n);

static long linux_getrandom (char *buf, u64 n, unsigned flags) {
  if (flags & ~7u) return -LE_EINVAL;                            // GRND_NONBLOCK, GRND_RANDOM, GRND_INSECURE
  if (!user_ok ((u64) buf, n, 1)) return -LE_EFAULT;
  char tmp[256];
  u64 done = 0;
  while (done < n) {
    u64 part = n - done < sizeof tmp ? n - done : sizeof tmp;
    if (random_get (tmp, part) < 0) return done ? (long) done : -5;      // EIO
    memcpy (buf + done, tmp, part);
    done += part;
  }
  return done;
}

@
\subsection{Sockets and \texttt{poll}}
\label{sec:libc:sockets}

The sockets themselves are chapter \ref{ch:sockets}; this is the translation. A socket address of Linux is a \texttt{struct sockaddr\_in}: the family
(2 for IPv4) and then port and address in \emph{network} byte order, the network stack of the kernel keeps host order. Everything that is not IPv4 is
refused with \texttt{EAFNOSUPPORT} (which is what the resolver of musl expects when it tries IPv6 first). \texttt{listen} and \texttt{accept} are not translated
here (issue \#124 has them as calls of their own). \texttt{ppoll} and \texttt{pselect6} look at every descriptor in the list: a socket or a pipe knows whether it can be
read or written; a file or a device is always ready (a read on it may take time but does not wait for somebody else), and so is the terminal for input
(a read waits, but there is no call that asks the terminal driver for a key without taking it). If nothing is ready the call waits in a loop like the others do,
until the time is up or a signal arrives.

<<linux_abi.c: sockets and poll>>=
extern int  sock_new (int type, int nonblock), sock_close (int gfd), sock_bind (int gfd, unsigned ip, unsigned short port);
extern int  sock_connect (int gfd, unsigned ip, unsigned short port), sock_shutdown (int gfd, int how), sock_ready (int gfd), is_sock (int gfd);
extern int  sock_name (int gfd, int peer, unsigned *ip, unsigned short *port), sock_type (int gfd), sock_is_nonblock (int gfd);
extern long sock_send (int gfd, const void *buf, u64 n, unsigned ip, unsigned short port, int has_addr);
extern long sock_recv (int gfd, void *buf, u64 n, unsigned *ip, unsigned short *port);
extern void sock_set_nonblock (int gfd, int on);
extern int  pipe_ready (int gfd);
extern int  net_poll_once (void);
extern int  gfd2pfd (int gfd);

#define LE_EAFNOSUPPORT 97
#define LE_ENOTSOCK     88
#define SOCK_NONBLOCK_  04000
#define MSG_DONTWAIT    0x40

struct sockaddr_in_ { unsigned short family; unsigned char port[2], addr[4], zero[8]; };

static int get_sockaddr (const void *p, u64 len, unsigned *ip, unsigned short *port) {
  const struct sockaddr_in_ *a = p;
  if (!p || len < sizeof *a || !user_ok ((u64) p, sizeof *a, 0)) return -LE_EFAULT;
  if (a->family != 2) return -LE_EAFNOSUPPORT;
  *port = (a->port[0] << 8) | a->port[1];
  *ip = ((unsigned) a->addr[0] << 24) | (a->addr[1] << 16) | (a->addr[2] << 8) | a->addr[3];
  return 0;
}

// writes the address (and its length, if the program asked for it): the caller has checked that the pointers are good
static void put_sockaddr (void *p, unsigned *len, unsigned ip, unsigned short port) {
  struct sockaddr_in_ a = { 2, { port >> 8, port & 255 }, { ip >> 24, (ip >> 16) & 255, (ip >> 8) & 255, ip & 255 }, { 0 } };
  if (!p) return;
  unsigned room = len ? *len : sizeof a;
  memcpy (p, &a, room < sizeof a ? room : sizeof a);
  if (len) *len = sizeof a;
}

static int sock_arg (int fd, long *err) {                 // the global descriptor of a socket, or -1 and the error
  int gfd = pfd2gfd (fd);
  if (fd < 0 || gfd == -1) { *err = -LE_EBADF;  return -1; }
  if (!is_sock (gfd)) { *err = -LE_ENOTSOCK;  return -1; }
  return gfd;
}

static long linux_socket (int domain, int type, int protocol) {
  if (domain != 2) return -LE_EAFNOSUPPORT;
  int gfd = sock_new (type & 0xf, (type & SOCK_NONBLOCK_) != 0);
  if (gfd < 0) return linux_error (LE_EMFILE);
  int pfd = gfd2pfd (gfd);
  if (pfd < 0) { sock_close (gfd);  return -LE_EMFILE; }
  return pfd;
}

static long linux_connect_or_bind (int fd, const void *addr, u64 len, int connect) {
  long e;  int gfd = sock_arg (fd, &e);
  unsigned ip;  unsigned short port;
  if (gfd < 0) return e;
  if ((e = get_sockaddr (addr, len, &ip, &port)) != 0) return e;
  return connect ? sock_connect (gfd, ip, port) : sock_bind (gfd, ip, port);
}

static long linux_sendto (int fd, const void *buf, u64 n, int flags, const void *addr, u64 alen) {
  long e;  int gfd = sock_arg (fd, &e);
  unsigned ip = 0;  unsigned short port = 0;
  if (gfd < 0) return e;
  if (!user_ok ((u64) buf, n, 0)) return -LE_EFAULT;
  if (addr && (e = get_sockaddr (addr, alen, &ip, &port)) != 0) return e;
  return sock_send (gfd, buf, n, ip, port, addr != 0);
}

static long linux_recvfrom (int fd, void *buf, u64 n, int flags, void *addr, unsigned *alen) {
  long e;  int gfd = sock_arg (fd, &e);
  unsigned ip = 0;  unsigned short port = 0;
  if (gfd < 0) return e;
  if (!user_ok ((u64) buf, n, 1) || (addr && (!alen || !user_ok ((u64) alen, 4, 1) || !user_ok ((u64) addr, *alen, 1)))) return -LE_EFAULT;
  int was = sock_is_nonblock (gfd);
  if (flags & MSG_DONTWAIT) sock_set_nonblock (gfd, 1);
  long k = sock_recv (gfd, buf, n, &ip, &port);
  if (flags & MSG_DONTWAIT) sock_set_nonblock (gfd, was);
  if (k >= 0) put_sockaddr (addr, alen, ip, port);
  return k;
}

static long linux_getname (int fd, void *addr, unsigned *alen, int peer) {
  long e;  int gfd = sock_arg (fd, &e);
  unsigned ip;  unsigned short port;
  if (gfd < 0) return e;
  if (!alen || !user_ok ((u64) alen, 4, 1) || !user_ok ((u64) addr, *alen, 1)) return -LE_EFAULT;
  if ((e = sock_name (gfd, peer, &ip, &port)) != 0) return e;
  put_sockaddr (addr, alen, ip, port);
  return 0;
}

#define SOL_SOCKET 1
#define SO_TYPE    3
#define SO_ERROR   4

// options are accepted and ignored; the two that a program reads back have an answer
static long linux_getsockopt (int fd, int level, int opt, int *val, unsigned *len) {
  long e;  int gfd = sock_arg (fd, &e);
  if (gfd < 0) return e;
  if (!val || !len || !user_ok ((u64) val, 4, 1) || !user_ok ((u64) len, 4, 1)) return -LE_EFAULT;
  *val = (level == SOL_SOCKET && opt == SO_TYPE) ? sock_type (gfd) : 0;                     // (SO_ERROR: no error is ever kept)
  *len = 4;
  return 0;
}

static long linux_setsockopt (int fd) { long e;  return sock_arg (fd, &e) < 0 ? e : 0; }

static long linux_shutdown (int fd, int how) { long e;  int gfd = sock_arg (fd, &e);  return gfd < 0 ? e : sock_shutdown (gfd, how); }

@
\paragraph{Waiting for several descriptors.} \texttt{poll\_bits} says what a descriptor is ready for, in the bits of \texttt{poll} (\texttt{POLLIN} 1,
\texttt{POLLOUT} 4, \texttt{POLLERR} 8, \texttt{POLLHUP} 16, \texttt{POLLNVAL} 32).

<<linux_abi.c: sockets and poll>>=
static int poll_bits (int fd) {
  int gfd = pfd2gfd (fd);
  if (gfd == -1) return 32;
  if (is_sock (gfd)) return sock_ready (gfd);
  if (gfd >= 0 && (gfd >> 8) == FS_PIPE_NR) return pipe_ready (gfd);
  return 1 | 4;                                                // a file, a device or the terminal: ready
}

// wait until count () is not 0, the time is up (timeout: 0 for ever) or a signal comes; the result of count () or minus an error
static long poll_wait (long (*count) (void *), void *arg, struct ts *timeout) {
  unsigned long long deadline = 0;
  if (timeout) {
    if (!user_ok ((u64) timeout, sizeof *timeout, 0)) return -LE_EFAULT;
    deadline = mono_ns () + timeout->sec * 1000000000ULL + timeout->nsec;
  }
  for (;;) {
    long n = count (arg);
    if (n != 0) return n;
    if (timeout && mono_ns () >= deadline) return 0;
    if (thread_table[current_task].sig_pending) return -LE_EINTR;
    net_poll_once ();
    arch_resign ();
    arch_poll_pause ();
  }
}

struct pollfd_ { int fd; short events, revents; };
struct poll_args { struct pollfd_ *fds; unsigned n; };

static long poll_count (void *p) {
  struct poll_args *a = p;
  long ready = 0;
  for (unsigned i = 0; i < a->n; i++) {
    struct pollfd_ *f = &a->fds[i];
    f->revents = f->fd < 0 ? 0 : poll_bits (f->fd) & (f->events | 8 | 16 | 32);
    if (f->revents) ready++;
  }
  return ready;
}

static long linux_ppoll (struct pollfd_ *fds, unsigned n, struct ts *timeout) {
  if (n > 64 || !user_ok ((u64) fds, n * sizeof *fds, 1)) return -LE_EINVAL;
  struct poll_args a = { fds, n };
  return poll_wait (poll_count, &a, timeout ? timeout : 0);
}

@
\texttt{pselect6} takes three bit sets (descriptors to read, to write, with errors) and changes them to the ones that are ready; the last argument of musl's
\texttt{select} is a timeout in a structure, and there is a signal mask that is ignored.

<<linux_abi.c: sockets and poll>>=
struct select_args { int n; unsigned long *r, *w; unsigned long saved_r[16], saved_w[16]; };

static long select_count (void *p) {
  struct select_args *a = p;
  long ready = 0;
  for (int fd = 0; fd < a->n; fd++) {
    unsigned long bit = 1UL << (fd % 64);
    int word = fd / 64, want_r = a->r && (a->saved_r[word] & bit), want_w = a->w && (a->saved_w[word] & bit);
    if (!want_r && !want_w) continue;
    int bits = poll_bits (fd);
    if (a->r) { if (want_r && (bits & (1 | 16 | 32))) { a->r[word] |= bit;  ready++; } else a->r[word] &= ~bit; }
    if (a->w) { if (want_w && (bits & (4 | 8 | 32))) { a->w[word] |= bit;  ready++; } else a->w[word] &= ~bit; }
  }
  return ready;
}

static long linux_pselect6 (int n, unsigned long *r, unsigned long *w, unsigned long *x, struct ts *timeout) {
  if (n < 0 || n > 1024) return -LE_EINVAL;
  int words = (n + 63) / 64;
  struct select_args a = { n, r, w };
  if ((r && !user_ok ((u64) r, words * 8, 1)) || (w && !user_ok ((u64) w, words * 8, 1)) || (x && !user_ok ((u64) x, words * 8, 1))) return -LE_EFAULT;
  for (int i = 0; i < words; i++) { a.saved_r[i] = r ? r[i] : 0;  a.saved_w[i] = w ? w[i] : 0; }
  if (x) for (int i = 0; i < words; i++) x[i] = 0;                   // no exceptional conditions
  return poll_wait (select_count, &a, timeout);
}

@
\subsection{The translation: \texttt{linux\_syscall}}

Called by \texttt{book\_syscall} instead of the book's dispatcher for a program that has \texttt{ELFOSABI\_LINUX}. A Linux program expects
that a system call changes nothing but \texttt{x0}, and musl's inline assembler relies on it (it does not declare \texttt{x1} to
\texttt{x5} as changed), so the registers that the translation used are put back. The exceptions are the calls that change the
frame on purpose: \texttt{execve} (new program counter and stack) and \texttt{rt\_sigreturn} (the whole frame).

<<linux_abi.c: linux_syscall>>=
static int unknown_reported[512], enomem_reported;

void linux_syscall (context_t *r) {
  long nr = r->x8, a0 = r->x0, a1 = r->x1, a2 = r->x2, a3 = r->x3, a4 = r->x4, a5 = r->x5;
  context_t saved = *r;
  long ret;
  set_errno (0);

  switch (nr) {
    case L_rt_sigreturn: syscall_sigreturn (r); return;
    case L_execve:
      if (!user_ok (a0, 1, 0) || !a1 || !user_ok (a1, 8, 0)) { r->x0 = -LE_EFAULT; return; }
      r->ebx = a0; r->ecx = a1;
      syscall_execv (r);                                      // on success it has set the new program counter and stack
      if (r->eip != saved.eip) return;                        // the new program starts
      *r = saved;
      r->x0 = -LE_ENOENT;
      return;

    // files
    case L_read:   ret = ulix_call (r, syscall_read,  a0, a1, a2, 0, 0); if (ret < 0) ret = linux_error (LE_EBADF); break;
    case L_write:  ret = ulix_call (r, syscall_write, a0, a1, a2, 0, 0); if (ret < 0) ret = linux_error (LE_EBADF); break;
    case L_readv:  ret = linux_iov (r, 0, a0, (struct iovec *) a1, a2); break;
    case L_writev: ret = linux_iov (r, 1, a0, (struct iovec *) a1, a2); break;
    case L_openat: ret = linux_openat (r, a0, (const char *) a1, a2); break;
    case L_close:  ret = ulix_call (r, syscall_close, a0, 0, 0, 0, 0) < 0 ? -LE_EBADF : 0; break;
    case L_lseek:  ret = ulix_call (r, syscall_lseek, a0, a1, a2, 0, 0); if (ret < 0) ret = linux_error (LE_EINVAL); break;
    case L_ioctl:  ret = linux_ioctl (a0, a1, (unsigned short *) a2); break;
    case L_fcntl:  ret = linux_fcntl (a0, a1, a2); break;
    case L_dup:    ret = linux_dup_from (a0, 0); break;
    case L_dup3:   ret = linux_dup3 (r, a0, a1, a2); break;
    case L_pipe2:  ret = linux_pipe2 (r, (int *) a0, a1); break;
    case L_fstat:  ret = linux_fstat (a0, (struct kstat *) a1); break;
    case L_newfstatat: ret = linux_newfstatat (a0, (const char *) a1, (struct kstat *) a2, a3); break;
    case L_getdents64: ret = linux_getdents64 (a0, (char *) a1, a2); break;
    case L_ftruncate:  ret = linux_ftruncate (a0, a1); break;
    case L_readlinkat: ret = linux_readlinkat (a0, (const char *) a1, (char *) a2, a3); break;
    case L_fsync: case L_fdatasync: ret = 0; break;            // every write goes to the disk through the buffer cache that the book flushes
    case L_umask:  ret = 022; break;
    case L_socket:      ret = linux_socket (a0, a1, a2); break;
    case L_connect:     ret = linux_connect_or_bind (a0, (const void *) a1, a2, 1); break;
    case L_bind:        ret = linux_connect_or_bind (a0, (const void *) a1, a2, 0); break;
    case L_sendto:      ret = linux_sendto (a0, (const void *) a1, a2, a3, (const void *) a4, a5); break;
    case L_recvfrom:    ret = linux_recvfrom (a0, (void *) a1, a2, a3, (void *) a4, (unsigned *) a5); break;
    case L_getsockname: ret = linux_getname (a0, (void *) a1, (unsigned *) a2, 0); break;
    case L_getpeername: ret = linux_getname (a0, (void *) a1, (unsigned *) a2, 1); break;
    case L_setsockopt:  ret = linux_setsockopt (a0); break;
    case L_getsockopt:  ret = linux_getsockopt (a0, a1, a2, (int *) a3, (unsigned *) a4); break;
    case L_shutdown:    ret = linux_shutdown (a0, a1); break;
    case L_ppoll:       ret = linux_ppoll ((struct pollfd_ *) a0, a1, (struct ts *) a2); break;
    case L_pselect6:    ret = linux_pselect6 (a0, (unsigned long *) a1, (unsigned long *) a2, (unsigned long *) a3, (struct ts *) a4); break;
    case L_renameat: case L_renameat2: ret = linux_renameat (a0, (const char *) a1, a2, (const char *) a3); break;
    case L_getrandom: ret = linux_getrandom ((char *) a0, a1, a2); break;
    case L_getcwd: ret = linux_getcwd ((char *) a0, a1); break;
    case L_chdir:  ret = ulix_call (r, syscall_chdir, a0, 0, 0, 0, 0) < 0 ? -LE_ENOENT : 0; break;
    case L_mkdirat:
