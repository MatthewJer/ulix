#define CLONE_VM             0x00000100
#define CLONE_FS             0x00000200
#define CLONE_FILES          0x00000400
#define CLONE_SIGHAND        0x00000800
#define CLONE_THREAD         0x00010000
#define CLONE_SETTLS         0x00080000
#define CLONE_PARENT_SETTID  0x00100000
#define CLONE_CHILD_CLEARTID 0x00200000
#define CLONE_CHILD_SETTID   0x01000000

extern int  arch_clone_thread (context_t *r, u64 stack, u64 tls, int set_tls);
extern void arch_set_clear_tid (thread_id t, u64 addr);
extern void arch_linux_exit (context_t *r, int code, int group);

// clone: either what musl's fork () asks for (only SIGCHLD in the flags: a copy of the process), or a thread (the flags of pthread_create)
// sched_getaffinity: every CPU that is online may run the thread (bit n = CPU n). os.cpu_count () and musl's sysconf (_SC_NPROCESSORS_ONLN) count these bits.
extern int smp_online_cpus (void);
static long linux_sched_getaffinity (int pid, u64 size, u64 *mask) {
  if (size < 8 || (size & 7)) return -LE_EINVAL;
  if (!user_ok ((u64) mask, size, 1)) return -LE_EFAULT;
  int n = smp_online_cpus ();
  for (u64 i = 0; i < size / 8; i++) mask[i] = 0;
  mask[0] = n >= 64 ? ~0UL : (1UL @<< n) - 1;
  return 8;                                                         // (the number of bytes the kernel wrote)
}

static long linux_clone (context_t *r, u64 flags, u64 stack, int *ptid, u64 tls, int *ctid) {
  if ((flags & 0xff) == 17 && !(flags & ~0xffUL)) {
    int pid = u_fork (r);
    return pid < 0 ? -LE_EAGAIN : pid;
  }
  u64 thread_flags = CLONE_VM | CLONE_FS | CLONE_FILES | CLONE_SIGHAND | CLONE_THREAD;
  if ((flags & thread_flags) != thread_flags) return -LE_ENOSYS;
  if (!stack) return -LE_EINVAL;
  if (((flags & CLONE_PARENT_SETTID) && !user_ok ((u64) ptid, 4, 1)) || ((flags & (CLONE_CHILD_SETTID | CLONE_CHILD_CLEARTID)) && !user_ok ((u64) ctid, 4, 1)))
    return -LE_EFAULT;
  int tid = arch_clone_thread (r, stack & ~15UL, tls, (flags & CLONE_SETTLS) != 0);
  if (tid < 0) return -LE_EAGAIN;
  if (flags & CLONE_PARENT_SETTID) *ptid = tid;
  if (flags & CLONE_CHILD_SETTID)  *ctid = tid;
  if (flags & CLONE_CHILD_CLEARTID) arch_set_clear_tid (tid, (u64) ctid);
  altstack[tid].size = 0;                                           // (a new thread has no alternate signal stack)
  return tid;
}

// Which child to wait for. The book's waitpid waits for one named child and for ever; Linux programs also ask for "any child" (pid -1) and for
// WNOHANG (options bit 1: do not wait, say 0 if the child is still running). Python's multiprocessing does the second one all the time
// (Process.start looks at the other children first), and with the book's behaviour it waited for a worker that was never going to end: the
// Pool hung. So the answer is decided here, before the book's call: a child that is a zombie is reaped by the book's waitpid (which then does
// not wait), a child that is not is waited for only if the program wants that.
#define LW_NOHANG 1
static long linux_wait4 (context_t *r, int pid, int *status, int options) {
  if (status && !user_ok ((u64) status, 4, 1)) return -LE_EFAULT;
  int me = thread_table[current_task].pid;
  for (;;) {
    int zombie = 0, children = 0;
    for (int t = 2; t < MAX_THREADS; t++) {                  // (the children of this process: the main threads whose parent we are)
      if (!thread_table[t].used || thread_table[t].ppid != me || thread_table[t].pid != t) continue;
      if (pid > 0 && t != pid) continue;
      children++;
      if (thread_table[t].state == TSTATE_ZOMBIE && !zombie) zombie = t;
    }
    if (!children) return -LE_ECHILD;
    if (zombie || !(options & LW_NOHANG)) {
      int c = zombie ? zombie : pid;                         // (a named child that still runs: the book waits for it)
      if (c < 1) { if (futex_nap () == -LE_EINTR) return -LE_EINTR;  continue; }   // "any child": look again after a tick of sleep
      long k = ulix_call (r, syscall_waitpid, c, 0, options & ~LW_NOHANG, 0, 0);
      if (k < 0) return -LE_ECHILD;
      if (status) *status = (thread_table[c].exitcode & 0xff) @<< 8;   // (the table entry is free but still holds the value)
      return k;
    }
    return 0;                                                // WNOHANG and nobody has ended yet
  }
}

