\subsection{A test program: \texttt{ptytest}}
\label{src:userland:ptytest.c}

\texttt{ptytest} is a miniature telnet server without the network: it holds terminal 5 (\texttt{tty4}) and talks to \texttt{login} that waits there, as a person
would. It looks for what \texttt{login} prints (\texttt{pty\_read}), types the user name and the password (\texttt{pty\_write}), runs \texttt{ps} in the shell to
see that the shell has the terminal \texttt{tty4}, and checks the rules: a second attach is refused, only the holder may read, and after \texttt{pty\_hangup} the programs of the
session are gone and \texttt{login} asks for a name again. The test session of the console starts it (\texttt{tools/shell\_test.py}).

<<userland/ptytest.c>>=
#include "../ulixlib.h"
#include "../arm64-extra.h"

static int fails = 0;
#define CHECK(c, msg) do { if (c) printf ("  pty ok:   %s\n", msg); \
                           else { printf ("  pty FAIL: %s\n", msg); fails++; } } while (0)

static char screen[4096];  static int screen_len = 0;           // what the terminal has printed since the last wait_for

static void collect (int ms) {                                  // read what the terminal prints, for up to ms milliseconds
  struct pty_msg m;
  m.buf = (unsigned char *)screen + screen_len;  m.len = sizeof screen - 1 - screen_len;  m.timeout_ms = ms;
  int n = pty_read (&m);
  if (n > 0) screen_len += n;
  screen[screen_len] = 0;
}

static int contains (const char *text) {
  for (int i = 0; i + (int)strlen (text) <= screen_len; i++) if (strncmp (screen + i, text, strlen (text)) == 0) return 1;
  return 0;
}

// wait until the text appears (at most 10 seconds), then forget everything that was printed
static int wait_for (const char *text) {
  for (int i = 0; i < 100 && !contains (text); i++) collect (100);
  int found = contains (text);
  screen_len = 0;  screen[0] = 0;
  return found;
}

static void type (const char *s) {
  struct pty_msg m;
  m.buf = (unsigned char *)s;  m.len = strlen (s);  m.timeout_ms = 0;
  pty_write (&m);
}

int main (int argc, char **argv) {
  struct pty_msg m;
  unsigned char tmp[8];

  CHECK (pty_attach (9) == -3, "pty_attach (9): only the first five terminals can be held");
  m.buf = tmp;  m.len = 1;  m.timeout_ms = 0;
  CHECK (pty_read (&m) == -1 && pty_write (&m) == -1, "without holding a terminal, pty_read and pty_write say -1");
  CHECK (pty_attach (4) == 0, "pty_attach (4) takes terminal 5 (tty4)");
  CHECK (pty_attach (4) == -1, "a second attach is refused: the terminal is in use");
  CHECK (wait_for ("ulix login: "), "the screen of the terminal is painted into the ring: login waits for a user name");

  type ("root\r");
  CHECK (wait_for ("Password: "), "the keys typed with pty_write reach login (it asks for the password)");
  type ("xyz\r");
  CHECK (wait_for ("root@ulix"), "the password is accepted: a root shell runs on the terminal");
  type ("ps\r");
  CHECK (wait_for ("tty4"), "ps run in that shell shows processes on tty4, the terminal that was taken");
  m.buf = tmp;  m.len = 8;  m.timeout_ms = 300;
  CHECK (pty_read (&m) >= 0, "pty_read with a time limit returns when nothing is printed");

  pty_hangup ();
  CHECK (pty_read (&m) == -1, "after pty_hangup the terminal is not ours any more");
  for (int i = 0; i < 50; i++) resign ();
  CHECK (pty_attach (4) == 0, "after the hang up the terminal can be taken again");
  CHECK (wait_for ("ulix login: "), "login was started again: its prompt is on the screen (the shell of the session is gone)");
  pty_hangup ();
  printf ("ptytest: %d check(s) failed\n", fails);
  return fails;
}
@

\section{A test server: \texttt{echod}}
\label{src:userland:echod.c}

The smallest server that is not a toy answers every byte with the same byte (RFC 862, \emph{echo}). \texttt{echod PORT} listens, accepts one client
at a time, sends back what it receives until the client hangs up, and goes back to \texttt{accept}. It is a service as well, with
\texttt{/etc/rc.d/echod}: switched off unless \texttt{rc.conf} says \texttt{echod\_enable="YES"}.

Two things show how a server is written. The main loop waits for a client with a time limit of one second, not for ever, and looks at
a flag after every wait, because \texttt{SIGTERM} (what \texttt{service stop} sends) only makes the handler run when the system call
returns. And a client that has gone must not leave the server stuck: \texttt{tcp\_recv} says $-1$ and the server closes its end.

<<userland/echod.c>>=
#include "../ulixlib.h"
#include "../arm64-extra.h"

static volatile int stop = 0;
static void on_term (int signo) { stop = 1; }              // SIGTERM: end after the current wait

static void echo (int sock) {                              // everything that arrives goes back, until the client hangs up
  unsigned char buf[512];
  struct tcp_msg m;
  while (!stop) {
    m.handle = sock;  m.buf = buf;  m.len = sizeof buf;  m.timeout_ms = 1000;
    int n = tcp_recv (&m);
    if (n < 0) return;                                     // closed
    if (n == 0) continue;                                  // nothing for a second: look at the flag
    m.len = n;  m.timeout_ms = 10000;
    if (tcp_send (&m) < 0) return;
  }
}

int main (int argc, char **argv) {
  int port = argc > 1 ? atoi (argv[1]) : 7007;
  signal (SIGTERM, on_term);
  if (tcp_listen (port) != 0) { printf ("echod: cannot listen on port %d\n", port);  return 1; }
  while (!stop) {
    int sock = tcp_accept (port, 1000);                    // sleeps until a client comes (at most a second)
    if (sock == -1) { waitkey (100);  continue; }          // no room for a socket: try again soon
    if (sock < 0) continue;                                // time over
    echo (sock);
    tcp_close (sock);
  }
  return 0;
}
@

<<etc/rc.d/echod>>=
# echod: the echo server (a test and an example of a server written as a program); listens on port 7007
command="/bin/echod 7007"
rcvar="echod_enable"
default="NO"
pidfile="/var/run/echod.pid"
@

\section{The test}

\texttt{make listen-test} (\texttt{tools/listen\_test.py}) boots the shell kernel with a network card, on a copy of the disk whose
\texttt{rc.conf} switches \texttt{echod} on. The boot starts the service before the login appears, and qemu forwards a port of the host
to port 7007 of the kernel. The test then behaves like clients: one that sends text and gets it back, a second one that comes while the
first one is still connected (it has to wait: the server serves one client at a time, and the queue of connections is the one of TCP), one
that connects and leaves without a word, and one that sends 20000 bytes (more than the buffers of TCP hold). A boot with the default
(\texttt{echod} off) must not answer on the port.
