<<pci.c: configuration space>>=
static volatile u32 *cfg_word (int bus, int dev, int fn, int reg) {          // generic host: the configuration space is a piece of memory
  return (volatile u32 *) (KERNEL_VA + plat.pci_cfg + ((u64) bus << 20 | (u64) dev << 15 | (u64) fn << 12 | (reg & 0xffc)));
}

u32 pci_read (int bus, int dev, int fn, int reg) {
  if (plat.pci_type == 2) return brcm_read (bus, dev, fn, reg);
  return *cfg_word (bus, dev, fn, reg);
}

void pci_write (int bus, int dev, int fn, int reg, u32 v) {
  if (plat.pci_type == 2) { brcm_write (bus, dev, fn, reg, v);  return; }
  *cfg_word (bus, dev, fn, reg) = v;
}
