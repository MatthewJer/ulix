\subsection{The PCI Express controller of the Raspberry Pi 4B}
The BCM2711 has its own PCIe root complex. It differs from the generic host in three ways:

\begin{itemize}
\item \textbf{It must be started.} A bit in the bridge control register ([[0x9210]]) holds it in reset; the kernel resets it, tells it the DMA window and the address window for the devices, and waits until
  the link to the device is up (the status register [[0x4068]] shows ``physical link up'' and ``data link active'', and the link status [[0xbc]] a speed). \emph{Inbound} is the direction device to RAM (DMA): the controller maps PCI address 0 to RAM address 0, so a device uses
  physical addresses, as on qemu. \emph{Outbound} is core to device: a window of the core's address space (here [[0x600000000]]) shows the PCI addresses [[0xc0000000]] and up, which is where the BARs go. Both addresses come from the device tree.
\item \textbf{The configuration space is behind an index register.} The registers of the root port itself (bus 0) lie directly at the start of the controller; for every other device the kernel writes
  its address (bus, device, function) into the index register ([[0x9000]]) and then reads or writes through a window ([[0x8000]]). Only device 0 exists on a bus; looking for others blocks the memory controller.
\item \textbf{The VL805 gets its program from the VideoCore.} The USB chip behind the root port has no flash of its own: its program is loaded by the graphics processor, which the ARM cores ask (mailbox tag [[0x00030058]]) with the PCI address of the device. The kernel does it
  after the BAR is assigned and before the device is switched on.
\end{itemize}
The values and the order of the steps follow the FreeBSD driver [[bcm2838_pci.c]] (ISC licence, Copyright (c) 2020 Dr Robert Harvey Crowston; see [[third_party/LICENCE-CHECK-freebsd-bcm2838-pci.md]]); the firmware tag is the one the Raspberry Pi firmware documents for this purpose.
\textbf{This code has not run on a board yet.}

<<pci.c: the Raspberry Pi 4 host>>=
/* The register values and the order of the steps follow FreeBSD's sys/arm/broadcom/bcm2835/bcm2838_pci.c:
 *   SPDX-License-Identifier: ISC, Copyright (c) 2020 Dr Robert Harvey Crowston <crowston@protonmail.com>
 * (the licence text is in third_party/LICENCE-CHECK-freebsd-bcm2838-pci.md) */
#define RC(off)  (*(volatile u32 *) (KERNEL_VA + plat.pci_cfg + (off)))
#define RC_BRIDGE_CTRL    0x9210                               // bit 0: bridge disabled, bit 1: bridge in reset
#define RC_HARD_DEBUG     0x4204                               // bit 1: clock request enable
#define RC_DMA_CONFIG     0x4008
#define RC_DMA_WINDOW_LO  0x4034
#define RC_DMA_WINDOW_HI  0x4038
#define RC_GISB_WINDOW    0x402c
#define RC_DMA_WINDOW_1   0x403c
#define RC_STATE          0x4068                               // bits 4 and 5: physical link up, data link active
#define RC_LINK_STATE     0x00bc                               // link status of the root port: the speed is in bits 16..19, 0 = no link
#define RC_BUS_WINDOW_LO  0x400c                               // the outbound window: PCI address,
#define RC_BUS_WINDOW_HI  0x4010
#define RC_CPU_WINDOW_LO  0x4070                               // ... and the addresses of the cores (bits 16..31 of start and end),
#define RC_CPU_WINDOW_STARTHI 0x4080                           // ... their upper bits
#define RC_CPU_WINDOW_ENDHI   0x4084
#define RC_INDEX          0x9000                               // configuration space of the devices: index (bus, device, function) ...
#define RC_DATA           0x8000                               // ... and window
#define RC_CLASS          0x043c                               // class code of the root port (it starts as an endpoint)

static u32 brcm_read (int bus, int dev, int fn, int reg) {
  if (bus == 0) return (dev == 0 && fn == 0) ? RC (reg & 0xffc) : 0xffffffff;       // the root port: at the start of the controller
  if (dev != 0 || fn != 0) return 0xffffffff;
  RC (RC_INDEX) = (u32) bus << 20 | (u32) dev << 15 | (u32) fn << 12;
  return RC (RC_DATA + (reg & 0xffc));
}

static void brcm_write (int bus, int dev, int fn, int reg, u32 v) {
  if (bus == 0) { if (dev == 0 && fn == 0) RC (reg & 0xffc) = v;  return; }
  if (dev != 0 || fn != 0) return;
  RC (RC_INDEX) = (u32) bus << 20 | (u32) dev << 15 | (u32) fn << 12;
  RC (RC_DATA + (reg & 0xffc)) = v;
}

static int brcm_init (void) {
  arch_map_device (plat.pci_cfg);
  arch_map_device (plat.pci_mem_cpu);
  RC (RC_BRIDGE_CTRL) |= 3;   delay_us (100);                   // hold the bridge in reset (and disabled), then let the reset go
  RC (RC_BRIDGE_CTRL) &= ~2u; delay_us (100);
  RC (RC_HARD_DEBUG) = 0;     delay_us (100);
  RC (RC_DMA_WINDOW_LO) = 0x12;  RC (RC_DMA_WINDOW_HI) = 0;      // inbound: PCI address 0 -> RAM address 0, a window of 8 GByte (log2 33 - 15 = 0x12)
  RC (RC_DMA_CONFIG) = 0x90003000;                               // (the size again in bits 27..31, and "window enable")
  RC (RC_GISB_WINDOW) = 0;  RC (RC_DMA_WINDOW_1) = 0;
  RC (RC_BRIDGE_CTRL) &= ~1u; delay_us (100);                    // enable the bridge
  int ready = 0;
  for (int t = 0; t < 100 && !ready; t++) { if ((RC (RC_STATE) & 0x30) == 0x30) ready = 1; else delay_us (1000); }
  if (!ready) { printf ("pcie: the link to the USB chip does not come up (state 0x%x)\n", RC (RC_STATE)); return -1; }
  if ((RC (RC_LINK_STATE) >> 16) == 0) { printf ("pcie: no link\n"); return -1; }
  u64 pci = plat.pci_mem_pci, cpu = plat.pci_mem_cpu, end = cpu + plat.pci_mem_size - 1;
  RC (RC_BUS_WINDOW_LO) = (u32) pci;  RC (RC_BUS_WINDOW_HI) = (u32) (pci >> 32);
  RC (RC_CPU_WINDOW_LO) = (u32) (((cpu >> 16) & 0xfff0) | (end & 0xfff00000));
  RC (RC_CPU_WINDOW_STARTHI) = (cpu >> 32) & 0xff;
  RC (RC_CPU_WINDOW_ENDHI) = (end >> 32) & 0xff;
  RC (RC_CLASS) = (6 << 16) | (4 << 8);                          // the root port is a PCI-to-PCI bridge (class 6, sub class 4)
  RC (RC_HARD_DEBUG) |= 2;    delay_us (100);                    // clock request
  RC (0x20) = (u32) (((pci >> 16) & 0xfff0) | ((pci + plat.pci_mem_size - 1) & 0xfff00000));    // the window of the root port's bridge for the devices behind it
  return 0;
}
