\subsection{Rings}
A ring needs: where it is, how many entries, the next free one, and the cycle bit of the producer. [[ring_put]] fills the next TRB and, at the link TRB, flips the cycle bit; the cycle bit of a TRB
is written last, because the controller may be looking: here that is not an issue, since it only looks after the doorbell.

<<xhci.c: rings>>=
struct ring { struct trb *trb; int n, enq, cycle; };

static void ring_init (struct ring *r, struct trb *t, int n) {
  r->trb = t;  r->n = n;  r->enq = 0;  r->cycle = 1;
  for (int i = 0; i < n; i++) { t[i].param = 0; t[i].status = 0; t[i].control = 0; }
  t[n - 1].param = PA (t);                                    // the link TRB: back to the start,
  t[n - 1].control = (TRB_LINK << 10) | (1 << 1) | 1;         // toggle cycle, cycle bit
  cache_clean (t, n * sizeof *t);
}

static u64 ring_put (struct ring *r, u64 param, u32 status, u32 control) {      // returns the physical address of the TRB
  struct trb *t = &r->trb[r->enq];
  t->param = param;  t->status = status;
  t->control = control | r->cycle;
  cache_clean (t, sizeof *t);
  u64 pa = PA (t);
  if (++r->enq == r->n - 1) {                                  // the link TRB is next: hand it to the controller and start again
    r->trb[r->n - 1].control = (TRB_LINK << 10) | (1 << 1) | r->cycle;
    cache_clean (&r->trb[r->n - 1], sizeof (struct trb));
    r->cycle ^= 1;  r->enq = 0;
  }
  return pa;
}

static struct trb cmd_trbs[64]  __attribute__ ((aligned (1024)));
static struct trb ev_trbs[256]  __attribute__ ((aligned (4096)));
static u64 erst[2]              __attribute__ ((aligned (64)));       // event ring segment table: base, size
static u64 dcbaa[256]           __attribute__ ((aligned (64)));       // device context base address array: slot -> its device context
static u8  scratch_page[16][4096] __attribute__ ((aligned (4096)));   // the controller may ask for scratchpad pages
static u64 scratch_array[16]    __attribute__ ((aligned (64)));
static struct ring cmd_ring;
static int ev_deq = 0, ev_cycle = 1;                           // the consumer side of the event ring
@

\subsection{Commands and events}
A command is a TRB in the command ring; when it is done the controller writes a \emph{command completion event} that contains the address of the command and a
\emph{completion code} (1 = success). The driver polls the event ring until it sees it. Events that arrive meanwhile (a transfer finished) are handled, too, so nothing gets lost: [[ev_poll]] hands every
transfer event to [[transfer_event]] and returns the completion event that [[cmd]] is waiting for. Having read events, we tell the controller where we are: the \emph{event ring dequeue pointer}.

<<xhci.c: commands>>=
static void transfer_event (int slot, int dci, int code, u32 residual);       // below

static struct trb last_cmd_event;                              // the last command completion event
static int cmd_event_seen;

static void ev_poll (void) {                                   // handles every event that is there
  int any = 0;
  for (;;) {
    struct trb *e = &ev_trbs[ev_deq];
    cache_flush_inval (e, sizeof *e);
    if ((e->control & 1) != ev_cycle) break;                   // not written yet
    int type = TRB_TYPE (e->control);
    if (type == TRB_EV_COMMAND) { last_cmd_event = *e;  cmd_event_seen = 1; }
    else if (type == TRB_EV_TRANSFER) transfer_event ((e->control >> 24) & 255, (e->control >> 16) & 31, (e->status >> 24) & 255, e->status & 0xffffff);
    if (++ev_deq == 256) { ev_deq = 0; ev_cycle ^= 1; }
    any = 1;
  }
  if (any) wr64 (rt, 0x20 + 0x18, (PA (&ev_trbs[ev_deq])) | (1 << 3));      // ERDP: new dequeue pointer, and clear "event handler busy"
}

static int cmd (u64 param, u32 status, u32 control, int *slot_out) {         // a command: returns the completion code (1: success), -1: timed out
  cmd_event_seen = 0;
  ring_put (&cmd_ring, param, status, control);
  wr32 (db, 0, 0);                                             // doorbell 0: the command ring
  for (int t = 0; t < 500000; t++) {                           // 500 ms
    ev_poll ();
    if (cmd_event_seen) {
      if (slot_out) *slot_out = (last_cmd_event.control >> 24) & 255;
      return (last_cmd_event.status >> 24) & 255;
    }
    delay_us (1);
  }
  return -1;
}
@

\subsection{Devices, contexts and control transfers}
For every device that the controller manages there is a \emph{slot}. Its state lives in two structures: the \emph{device context} (written by the controller: it holds the slot state and one
context per endpoint) and the \emph{input context} that we fill in and give to the controller with a command ([[Address Device]], [[Configure Endpoint]]): a header that says which contexts are valid, then the contexts.
An endpoint number plus direction becomes a \emph{device context index} (DCI): endpoint 0 is index 1, endpoint 1 OUT is 2, endpoint 1 IN is 3, and so on ($2n$ for OUT, $2n+1$ for IN).

Setting up a device takes these steps (see [[enumerate]]):
\begin{enumerate}
\item reset the port; the speed is in the port register;
\item [[Enable Slot]]: the controller answers with a slot number;
\item [[Address Device]]: input context with the slot context (speed, root port) and the context of endpoint 0 (the transfer ring); the controller gives the device an USB address;
\item control transfers on endpoint 0: read the descriptors (device, configuration with its interfaces and endpoints), [[SET_CONFIGURATION]], and for HID [[SET_PROTOCOL]] (boot) and [[SET_IDLE]];
\item [[Configure Endpoint]] for the interrupt-in endpoint of the HID interface, then put a transfer TRB on its ring: the controller completes it when the device has something to say (a key, a movement).
\end{enumerate}

A \emph{control transfer} is three TRBs on the endpoint 0 ring: [[Setup]] (the 8 bytes of the request, immediate data), [[Data]] (the buffer, if there is one), [[Status]] (the handshake in the opposite direction,
with ``interrupt on completion''). Then the doorbell of the slot, target 1.

<<xhci.c: control transfers>>=
struct hid_ep {                                                // an interrupt-in endpoint that delivers keyboard or mouse reports
  int used, dci, proto, iface, mps, interval;                  // proto: 1 keyboard, 2 mouse; the interface number, max packet size and bInterval of the endpoint
  struct ring ring;
  u8 *buf;
};

struct slot {
  int used, port, speed, id;
  struct ring ep0;
  struct hid_ep hid[2];
  volatile int ep0_done, ep0_code;                             // set by the event handler when a control transfer has ended
};

static struct slot slots[MAXDEV];
static u8  in_ctx[MAXDEV][2176]  __attribute__ ((aligned (64)));        // input context: 33 contexts of up to 64 bytes
static u8  out_ctx[MAXDEV][2048] __attribute__ ((aligned (64)));        // device context: 32 contexts of up to 64 bytes
static struct trb ep0_trbs[MAXDEV][EP_RING]      __attribute__ ((aligned (256)));
static struct trb hid_trbs[MAXDEV][2][EP_RING]   __attribute__ ((aligned (256)));
static u8  hid_buf[MAXDEV][2][64]                __attribute__ ((aligned (64)));
static u8  xfer_buf[512]                         __attribute__ ((aligned (64)));  // descriptors and the like

static void transfer_event (int slot, int dci, int code, u32 residual) {
  struct slot *s = 0;
  for (int i = 0; i < MAXDEV; i++) if (slots[i].used && slots[i].id == slot) s = &slots[i];
  if (!s) return;
  if (dci == 1) { s->ep0_code = code;  s->ep0_done = 1;  return; }
  for (int i = 0; i < 2; i++) {
    struct hid_ep *h = &s->hid[i];
    if (!h->used || h->dci != dci) continue;
    if (code == 1 || code == 13) {                             // success or short packet: a report
      cache_flush_inval (h->buf, 64);
      if (h->proto == 1) usb_keyboard_report (h->buf, h->mps - residual); else usb_mouse_report (h->buf, h->mps - residual);
    }
    if (code == 1 || code == 13) {                             // ask for the next one
      ring_put (&h->ring, PA (h->buf), h->mps, (TRB_NORMAL << 10) | (1 << 5) | (1 << 2));      // interrupt on completion, short packets are fine
      wr32 (db, 4 * slot, dci);
    } else DBG ("usb: transfer error %d on slot %d\n", code, slot);
  }
}

static int control (struct slot *s, int type, int req, int value, int index, int len, int dir_in) {     // returns the completion code; data in xfer_buf
  u64 setup = (u64) (type & 255) | ((u64) (req & 255) << 8) | ((u64) (value & 0xffff) << 16) | ((u64) (index & 0xffff) << 32) | ((u64) (len & 0xffff) << 48);
  int trt = len == 0 ? 0 : (dir_in ? 3 : 2);
  s->ep0_done = 0;
  if (len && dir_in) { for (int i = 0; i < len; i++) xfer_buf[i] = 0;  cache_clean (xfer_buf, len); }
  ring_put (&s->ep0, setup, 8, (TRB_SETUP << 10) | (1 << 6) | (trt << 16));                 // immediate data
  if (len) ring_put (&s->ep0, PA (xfer_buf), len, (TRB_DATA << 10) | ((dir_in ? 1 : 0) << 16));
  ring_put (&s->ep0, 0, 0, (TRB_STATUS << 10) | (1 << 5) | ((len && dir_in) ? 0 : (1 << 16)));  // interrupt on completion; the direction is the opposite one
  wr32 (db, 4 * s->id, 1);                                    // doorbell of the slot, endpoint 0
  for (int t = 0; t < 1000000 && !s->ep0_done; t++) { ev_poll ();  delay_us (1); }
  if (!s->ep0_done) return -1;
  if (len && dir_in) cache_flush_inval (xfer_buf, len);
  return s->ep0_code;
}
