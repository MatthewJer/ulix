static u32 *ctx_at (u8 *ctx, int i) { return (u32 *) (ctx + i * ctx_size); }              // context i of an input context (0: control, 1: slot, 2: endpoint 0, ...)

static int mps_of_speed (int speed) { return speed == 4 ? 512 : speed == 3 ? 64 : 8; }     // the first guess for endpoint 0 (full speed: read it from the device)

static void fill_slot (struct slot *s, u32 *c, int entries) {  // the slot context: where the device is (route string, root port), what it is (speed, hub), which transaction translator serves it
  c[0] = s->route | (s->speed << 20) | ((s->hub && s->mtt) ? 1u << 25 : 0) | (s->hub ? 1u << 26 : 0) | ((u32) entries << 27);
  c[1] = (s->rootport << 16) | (s->hub ? (u32) s->nports << 24 : 0);
  c[2] = s->tt_slot | (s->tt_port << 8) | (s->hub ? (u32) s->think << 16 : 0);
}

static int address_device (struct slot *s) {
  int n = s - slots;
  u8 *in = in_ctx[n];
  for (int i = 0; i < (int) sizeof in_ctx[n]; i++) in[i] = 0;
  for (int i = 0; i < (int) sizeof out_ctx[n]; i++) out_ctx[n][i] = 0;
  ctx_at (in, 0)[1] = 3;                                       // add flags: slot context and endpoint 0
  fill_slot (s, ctx_at (in, 1), 1);                            // context entries: 1
  u32 *ep = ctx_at (in, 2);
  ep[1] = (3 << 1) | (4 << 3) | (mps_of_speed (s->speed) << 16);        // error count 3, type control, max packet size
  u64 deq = PA (s->ep0.trb) | 1;
  ep[2] = (u32) deq;  ep[3] = (u32) (deq >> 32);
  ep[4] = 8;                                                   // average TRB length
  dcbaa[s->id] = PA (out_ctx[n]);
  cache_clean (&dcbaa[s->id], 8);  cache_clean (in, sizeof in_ctx[n]);  cache_clean (out_ctx[n], sizeof out_ctx[n]);
  return cmd (PA (in), 0, (TRB_ADDRESS_DEV << 10) | (s->id << 24), 0);
}

static void set_mps (struct slot *s, int mps) {                // a full speed device may have another maximum packet size on endpoint 0
  int n = s - slots;
  u8 *in = in_ctx[n];
  for (int i = 0; i < (int) sizeof in_ctx[n]; i++) in[i] = 0;
  ctx_at (in, 0)[1] = 2;                                       // endpoint 0 only
  ctx_at (in, 2)[1] = (3 << 1) | (4 << 3) | (mps << 16);
  cache_clean (in, sizeof in_ctx[n]);
  cmd (PA (in), 0, (TRB_EVAL_CONTEXT << 10) | (s->id << 24), 0);
}

static int interval_of (int speed, int binterval) {            // xHCI wants an exponent of 125 microsecond units
  if (speed >= 3) return binterval > 0 ? binterval - 1 : 0;    // high and super speed: 2^(bInterval-1) microframes
  int frames = binterval ? binterval : 1, e = 3;               // low and full speed: bInterval milliseconds = 8 * bInterval microframes
  while ((1 << e) < frames * 8 && e < 10) e++;
  return e;
}

static int configure_endpoints (struct slot *s) {
  int n = s - slots, maxdci = 1;
  u8 *in = in_ctx[n];
  for (int i = 0; i < (int) sizeof in_ctx[n]; i++) in[i] = 0;
  u32 add = 1;                                                 // the slot context
  for (int i = 0; i < 2; i++) {
    struct hid_ep *h = &s->hid[i];
    if (!h->used) continue;
    add |= 1u << h->dci;
    if (h->dci > maxdci) maxdci = h->dci;
    u32 *ep = ctx_at (in, 1 + h->dci);
    ep[0] = interval_of (s->speed, h->interval) << 16;
    ep[1] = (3 << 1) | (7 << 3) | (h->mps << 16);               // error count 3, type interrupt in, max packet size
    u64 deq = PA (h->ring.trb) | 1;
    ep[2] = (u32) deq;  ep[3] = (u32) (deq >> 32);
    ep[4] = h->mps | (h->mps << 16);                            // average TRB length, max ESIT payload
  }
  if (s->msc.used) {                                           // the two bulk endpoints: type 6 (bulk in) and 2 (bulk out)
    struct msc *m = &s->msc;
    for (int k = 0; k < 2; k++) {
      int dci = k == 0 ? m->in_dci : m->out_dci, mps = k == 0 ? m->in_mps : m->out_mps, burst = k == 0 ? m->in_burst : m->out_burst;
      struct ring *r = k == 0 ? &m->in : &m->out;
      add |= 1u << dci;
      if (dci > maxdci) maxdci = dci;
      u32 *ep = ctx_at (in, 1 + dci);
      ep[0] = 0;
      ep[1] = (3 << 1) | ((k == 0 ? 6 : 2) << 3) | (burst << 8) | (mps << 16);
      u64 deq = PA (r->trb) | 1;
      ep[2] = (u32) deq;  ep[3] = (u32) (deq >> 32);
      ep[4] = mps;
    }
  }
  ctx_at (in, 0)[1] = add;
  fill_slot (s, ctx_at (in, 1), maxdci);
  cache_clean (in, sizeof in_ctx[n]);
  return cmd (PA (in), 0, (TRB_CONFIGURE_EP << 10) | (s->id << 24), 0);
}

static void hid_setup (struct slot *s, int idx, int proto, int iface, int ep_addr, int mps, int binterval) {
  int n = s - slots;
  struct hid_ep *h = &s->hid[idx];
  h->used = 1;  h->proto = proto;  h->iface = iface;
  h->dci = (ep_addr & 15) * 2 + 1;                             // an IN endpoint
  h->mps = mps & 0x7ff;  if (h->mps > 64) h->mps = 64;         // (the buffers are 64 bytes; boot reports have 8)
  h->interval = binterval;
  ring_init (&h->ring, hid_trbs[n][idx], EP_RING);
  h->buf = hid_buf[n][idx];
}

static int clear_stall (struct slot *s, int in) {              // an endpoint that stalled: Reset Endpoint, move the dequeue pointer past the failed TRB, CLEAR_FEATURE(ENDPOINT_HALT)
  struct msc *m = &s->msc;
  int dci = in ? m->in_dci : m->out_dci;
  struct ring *r = in ? &m->in : &m->out;
  cmd (0, 0, (14 << 10) | (dci << 16) | (s->id << 24), 0);     // Reset Endpoint
  cmd (PA (&r->trb[r->enq]) | r->cycle, 0, (16 << 10) | (dci << 16) | (s->id << 24), 0);   // Set TR Dequeue Pointer: the next TRB we will write
  control (s, 0x02, 1, 0, (in ? 0x80 : 0) | (dci / 2), 0, 0);  // CLEAR_FEATURE, feature 0 (halt), the endpoint address
  return 0;
}

static int bulk (struct slot *s, int in, u64 pa, u32 len) {    // one bulk transfer, waits for it; 0: done, a negative completion code: error (-1: timed out)
  struct msc *m = &s->msc;
  int k = in ? 0 : 1;
  s->bulk_done[k] = 0;
  DBG ("usb: bulk %s %u bytes\n", in ? "in" : "out", len);
  ring_put (in ? &m->in : &m->out, pa, len, (TRB_NORMAL << 10) | (1 << 5));      // interrupt on completion
  wr32 (db, 4 * s->id, in ? m->in_dci : m->out_dci);
  u64 freq, t0, now;                                           // two seconds, measured with the counter of the timer
  __asm__ volatile ("mrs %0, cntfrq_el0" : "=r" (freq));
  __asm__ volatile ("mrs %0, cntpct_el0" : "=r" (t0));
  do { ev_poll ();  __asm__ volatile ("mrs %0, cntpct_el0" : "=r" (now)); } while (!s->bulk_done[k] && now - t0 < 2 * freq);
  if (!s->bulk_done[k]) { printf ("usb: bulk %s transfer of %u bytes timed out\n", in ? "in" : "out", len);  return -1; }
  int c = s->bulk_code[k];
  if (c == 1 || c == 13) return 0;                             // success or a short packet
  printf ("usb: bulk %s transfer of %u bytes failed with code %d\n", in ? "in" : "out", len, c);
  return -c;
}

static u8 msc_buf[65536] __attribute__ ((aligned (65536)));     // the data of a command (a transfer must not cross a 64 KByte boundary)
static u8 cbw[64] __attribute__ ((aligned (64))), csw[64] __attribute__ ((aligned (64)));

static void put32 (u8 *p, u32 v) { p[0] = v; p[1] = v >> 8; p[2] = v >> 16; p[3] = v >> 24; }          // little endian
static u32  get32 (const u8 *p) { return p[0] | p[1] << 8 | p[2] << 16 | (u32) p[3] << 24; }
static u32  be32v (const u8 *p) { return (u32) p[0] << 24 | p[1] << 16 | p[2] << 8 | p[3]; }

static int scsi (struct slot *s, const u8 *cdb, int cdblen, u8 *data, u32 len, int in) {     // the bulk-only transport: command block, data, status; 0: good
  struct msc *m = &s->msc;
  for (int i = 0; i < 31; i++) cbw[i] = 0;
  put32 (cbw, 0x43425355);  put32 (cbw + 4, ++m->tag);  put32 (cbw + 8, len);         // "USBC", tag, the length of the data
  cbw[12] = in ? 0x80 : 0;  cbw[14] = cdblen;
  for (int i = 0; i < cdblen; i++) cbw[15 + i] = cdb[i];
  cache_clean (cbw, 31);
  if (bulk (s, 0, PA (cbw), 31) < 0) return -1;
  if (len) {
    if (!in) { for (u32 i = 0; i < len; i++) msc_buf[i] = data[i];  cache_clean (msc_buf, len); }
    else cache_flush_inval (msc_buf, len);
    int r = bulk (s, in, PA (msc_buf), len);
    if (r < 0 && r != -1) clear_stall (s, in);                 // the device refused the data: see its status
    else if (r == -1) return -1;
    if (in) { cache_flush_inval (msc_buf, len);  for (u32 i = 0; i < len; i++) data[i] = msc_buf[i]; }
  }
  cache_flush_inval (csw, 13);
  int r = bulk (s, 1, PA (csw), 13);
  if (r < 0 && r != -1) { clear_stall (s, 1);  r = bulk (s, 1, PA (csw), 13); }
  if (r < 0) return -1;
  cache_flush_inval (csw, 13);
  if (get32 (csw) != 0x53425355 || get32 (csw + 4) != m->tag) return -1;                // "USBS" and our tag
  return csw[12];                                              // 0: good, 1: command failed, 2: phase error
}

#define MAXUSBDISK 4
static struct { int present, slot; u64 sectors; char name[8]; } udisk[MAXUSBDISK];
static int nudisk = 0;

static void msc_attach (struct slot *s) {
  u8 cdb[16], buf[36];
  for (int i = 0; i < 16; i++) cdb[i] = 0;
  cdb[0] = 0x12;  cdb[4] = 36;                                 // INQUIRY
  char vendor[17] = "";
  if (scsi (s, cdb, 6, buf, 36, 1) == 0) { for (int i = 0; i < 16; i++) vendor[i] = buf[8 + i] >= ' ' && buf[8 + i] < 127 ? buf[8 + i] : ' ';  vendor[16] = 0; }
  for (int i = 0; i < 16; i++) cdb[i] = 0;
  int ready = 0;
  for (int t = 0; t < 30 && !ready; t++) {                     // TEST UNIT READY: a stick needs a moment; REQUEST SENSE clears its complaint
    cdb[0] = 0x00;
    if (scsi (s, cdb, 6, 0, 0, 0) == 0) { ready = 1; break; }
    cdb[0] = 0x03;  cdb[4] = 18;
    scsi (s, cdb, 6, buf, 18, 1);
    for (int i = 0; i < 16; i++) cdb[i] = 0;
    delay_us (100000);
  }
  cdb[0] = 0x25;                                               // READ CAPACITY (10): the last block number and the block size, big endian
  u8 cap[8];
  if (!ready || scsi (s, cdb, 10, cap, 8, 1) != 0) { printf ("usb: the stick does not tell its size\n"); s->msc.used = 0; return; }
  u64 sectors = (u64) be32v (cap) + 1;
  u32 bsize = be32v (cap + 4);
  if (bsize != 512 || nudisk >= MAXUSBDISK) { printf ("usb: block size %u is not supported (512 only)\n", bsize); s->msc.used = 0; return; }
  int n = nudisk++;
  udisk[n].present = 1;  udisk[n].slot = s - slots;  udisk[n].sectors = sectors;
  udisk[n].name[0] = 'u'; udisk[n].name[1] = 's'; udisk[n].name[2] = 'b'; udisk[n].name[3] = '0' + n; udisk[n].name[4] = 0;
  s->msc.disk = n;
  printf ("usb: port %d: disk %s \"%s\", %lu MByte\n", s->port + 1, udisk[n].name, vendor, sectors / 2048);
}

int usb_disks (void) { return nudisk; }
int usb_disk_present (int n) { return n >= 0 && n < nudisk && udisk[n].present; }
u64 usb_disk_sectors (int n) { return usb_disk_present (n) ? udisk[n].sectors : 0; }
const char *usb_disk_name (int n) { return n >= 0 && n < nudisk ? udisk[n].name : ""; }

static volatile int msc_lock = 0;

static int disk_io (int n, u64 lba, void *buf, u32 cnt, int write) {     // 0: done
  if (!usb_disk_present (n) || lba + cnt > udisk[n].sectors) return -1;
  struct slot *s = &slots[udisk[n].slot];
  while (__sync_lock_test_and_set (&msc_lock, 1)) ;
  int r = 0;
  u8 *p = buf;
  while (cnt > 0 && r == 0) {
    u32 k = cnt > 64 ? 64 : cnt;                               // 32 KByte at a time
    u8 cdb[10] = { write ? 0x2a : 0x28, 0, lba >> 24, lba >> 16, lba >> 8, lba, 0, k >> 8, k, 0 };
    r = scsi (s, cdb, 10, p, k * 512, !write);
    p += k * 512;  lba += k;  cnt -= k;
  }
  __sync_lock_release (&msc_lock);
  return r == 0 ? 0 : -1;
}

int usb_disk_read (int n, u64 lba, void *buf, u32 cnt)  { return disk_io (n, lba, buf, cnt, 0); }
int usb_disk_write (int n, u64 lba, void *buf, u32 cnt) { return disk_io (n, lba, buf, cnt, 1); }

void usb_disk_sync (int n) {                                   // SYNCHRONIZE CACHE: the stick writes what it holds in its cache (before it is taken out)
  if (!usb_disk_present (n)) return;
  u8 cdb[10] = { 0x35, 0, 0, 0, 0, 0, 0, 0, 0, 0 };
  while (__sync_lock_test_and_set (&msc_lock, 1)) ;
  scsi (&slots[udisk[n].slot], cdb, 10, 0, 0, 0);
  __sync_lock_release (&msc_lock);
}

static int read_configuration (struct slot *s, int *config) {   // the whole configuration descriptor into xfer_buf: returns its length, 0 if not
  if (control (s, 0x80, 6, 0x0200, 0, 9, 1) != 1) return 0;     // first the length of it,
  int total = xfer_buf[2] | xfer_buf[3] << 8;
  *config = xfer_buf[5];
  if (total > (int) sizeof xfer_buf) total = sizeof xfer_buf;
  return control (s, 0x80, 6, 0x0200, 0, total, 1) == 1 ? total : 0;      // then all of it
}

static u8 hub_failed[MAXDEV][16];                                // ports of hubs where a device did not work (not tried again before the next mount)

static const char *wh (struct slot *s) {                      // "port 2" or "port 1.3" (port 3 of the hub on root port 1), for the messages
  static char text[24];
  int root = s->rootport, n = 0;
  text[n++] = 'p';  text[n++] = 'o';  text[n++] = 'r';  text[n++] = 't';  text[n++] = ' ';
  text[n++] = '0' + root;
  if (s->parent_id) { text[n++] = '.';  text[n++] = s->port >= 10 ? '1' : '0' + s->port;  if (s->port >= 10) text[n++] = '0' + s->port - 10; }
  text[n] = 0;
  return text;
}

static void scan_hub (struct slot *h);
static int hub_attach (struct slot *s, int config, int proto);

static void enumerate (int rootport, struct slot *hub, int hubport, int speed) {       // a device on a root port, or on a port of a hub
  int sl = -1;
  for (int i = 0; i < MAXDEV; i++) if (!slots[i].used) { sl = i; break; }
  if (sl < 0) return;
  struct slot *s = &slots[sl];
  int slot_id = 0;
  if (cmd (0, 0, TRB_ENABLE_SLOT << 10, &slot_id) != 1 || slot_id == 0 || slot_id >= 256) { printf ("usb: no slot for the device on port %d\n", rootport + 1); return; }
  s->used = 1;  s->id = slot_id;  s->speed = speed;
  s->port = hub ? hubport : rootport;  s->rootport = rootport + 1;  s->parent_id = hub ? hub->id : 0;
  s->route = hub ? hub->route | (hubport << (4 * hub->tier)) : 0;  s->tier = hub ? hub->tier + 1 : 0;
  s->hub = s->nports = s->mtt = s->think = s->tt_slot = s->tt_port = 0;
  if (hub && (speed == 1 || speed == 2) && hub->speed == 3) { s->tt_slot = hub->id;  s->tt_port = hubport; }       // a slow device behind a high speed hub: the hub translates
  s->hid[0].used = s->hid[1].used = 0;  s->msc.used = 0;
  ring_init (&s->ep0, ep0_trbs[sl], EP_RING);
  int r = address_device (s);
  if (r != 1) { printf ("usb: %s: the device did not get an address (completion code %d)\n", wh (s), r); s->used = 0; return; }
  if (control (s, 0x80, 6, 0x0100, 0, 8, 1) != 1) { printf ("usb: %s: no device descriptor\n", wh (s)); s->used = 0; return; }   // GET_DESCRIPTOR: device, the first 8 bytes
  if (speed <= 2 && xfer_buf[7] != 8 && xfer_buf[7] >= 8) set_mps (s, xfer_buf[7]);
  if (control (s, 0x80, 6, 0x0100, 0, 18, 1) != 1) { s->used = 0; return; }
  int vendor = xfer_buf[8] | xfer_buf[9] << 8, product = xfer_buf[10] | xfer_buf[11] << 8, dclass = xfer_buf[4], dproto = xfer_buf[6];
  int config = 1, total = read_configuration (s, &config);
  if (!total) { s->used = 0; return; }
  if (dclass == 9) { if (hub_attach (s, config, dproto) != 0) { printf ("usb: %s: the hub (%04x:%04x) does not work\n", wh (s), vendor, product); s->used = 0; } return; }      // a hub: its ports are looked at
  int nhid = 0, iface = -1, iclass = 0, isub = 0, iproto = 0, msc_if = -1, got_in = 0, got_out = 0;
  struct msc *m = &s->msc;
  for (int p = 0; p + 2 <= total && xfer_buf[p] >= 2; p += xfer_buf[p]) {                  // the interfaces and their endpoints
    if (xfer_buf[p + 1] == 4) { iface = xfer_buf[p + 2];  iclass = xfer_buf[p + 5];  isub = xfer_buf[p + 6];  iproto = xfer_buf[p + 7]; }
    else if (xfer_buf[p + 1] == 5 && iclass == 8 && isub == 6 && iproto == 0x50 && (msc_if < 0 || msc_if == iface) && (xfer_buf[p + 3] & 3) == 2) {   // a bulk endpoint of a USB stick (SCSI, bulk-only)
      int addr = xfer_buf[p + 2], mps = xfer_buf[p + 4] | xfer_buf[p + 5] << 8;
      int burst = (p + xfer_buf[p] + 3 <= total && xfer_buf[p + xfer_buf[p] + 1] == 0x30) ? xfer_buf[p + xfer_buf[p] + 2] : 0;    // a super speed endpoint companion follows
      msc_if = iface;
      if (addr & 0x80) { m->in_dci = (addr & 15) * 2 + 1;  m->in_mps = mps;  m->in_burst = burst;  got_in = 1; }
      else             { m->out_dci = (addr & 15) * 2;  m->out_mps = mps;  m->out_burst = burst;  got_out = 1; }
    }
    else if (xfer_buf[p + 1] == 5 && iclass == 3 && isub == 1 && (iproto == 1 || iproto == 2) && nhid < 2) {
      int addr = xfer_buf[p + 2], attr = xfer_buf[p + 3];
      if ((addr & 0x80) && (attr & 3) == 3) {                  // the interrupt-in endpoint of a boot keyboard or mouse
        hid_setup (s, nhid++, iproto, iface, addr, xfer_buf[p + 4] | xfer_buf[p + 5] << 8, xfer_buf[p + 6]);
        iclass = 0;                                            // one endpoint per interface
      }
    }
  }
  if (got_in && got_out) { m->used = 1;  m->iface = msc_if;  ring_init (&m->in, msc_trbs[sl][0], 64);  ring_init (&m->out, msc_trbs[sl][1], 64);  m->tag = 0; }
  if (nhid == 0 && !m->used) { printf ("usb: %s: device %04x:%04x is not a keyboard, a mouse or a stick (not supported)\n", wh (s), vendor, product); s->used = 0; return; }
  if (control (s, 0, 9, config, 0, 0, 0) != 1) { printf ("usb: %s: SET_CONFIGURATION failed\n", wh (s)); s->used = 0; return; }
  for (int i = 0; i < nhid; i++) {
    control (s, 0x21, 0x0b, 0, s->hid[i].iface, 0, 0);         // SET_PROTOCOL: the boot protocol (a device in it already may stall: no matter)
    control (s, 0x21, 0x0a, 0, s->hid[i].iface, 0, 0);         // SET_IDLE: report only when something changes
  }
  if (configure_endpoints (s) != 1) { printf ("usb: %s: Configure Endpoint failed\n", wh (s)); s->used = 0; return; }
  if (m->used) msc_attach (s);
  for (int i = 0; i < nhid; i++) {
    struct hid_ep *h = &s->hid[i];
    ring_put (&h->ring, PA (h->buf), h->mps, (TRB_NORMAL << 10) | (1 << 5) | (1 << 2));    // the first report is asked for
    wr32 (db, 4 * s->id, h->dci);
    printf ("usb: %s: %s (%04x:%04x, %s speed)\n", wh (s), h->proto == 1 ? "keyboard" : "mouse", vendor, product,
            speed == 4 ? "super" : speed == 3 ? "high" : speed == 2 ? "low" : "full");
  }
}
