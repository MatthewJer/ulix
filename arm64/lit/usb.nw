\subsection{Start}
[[usb_init]] looks for a PCI device with the class code of an xHCI controller (0x0c0330: serial bus, USB, interface ``xHCI''), gives its BAR an address and switches the device on, then follows the
sequence of the specification: stop and \emph{reset} the controller, tell it where the three structures are (device context array, command ring, event ring), set the run bit and look at the ports. A port with something
connected is reset (the device then runs at its speed, which the port register tells) and enumerated.

<<xhci.c: init and poll>>=
static int controller_up = 0;

extern void arch_map_device (u64 pa);                          // mmu.c: the 1 GByte block of pa as device memory
extern const char *plat_cmdline (void);

static int wait_for (volatile u8 *regs, int off, u32 mask, u32 want, int ms) {
  for (int t = 0; t < ms * 10; t++) {
    if ((rd32 (regs, off) & mask) == want) return 1;
    delay_us (100);
  }
  return 0;
}

static int has_word (const char *cl, const char *w) {          // is w a word of the kernel command line?
  for (; *cl; cl++) {
    if (cl != plat_cmdline () && cl[-1] != ' ') continue;
    const char *a = cl, *b = w;
    while (*b && *a == *b) { a++; b++; }
    if (!*b && (*a == ' ' || *a == 0)) return 1;
  }
  return 0;
}

static int port_served (int p) {                              // is a device of this root port set up already?
  for (int i = 0; i < MAXDEV; i++) if (slots[i].used && slots[i].parent_id == 0 && slots[i].port == p) return 1;
  return 0;
}

static u8 port_failed[32];                                    // root ports where a device did not work (not tried again before the next mount)

static void scan_ports (void) {
  for (int p = 0; p < nports && p < 32; p++) {
    u32 v = rd32 (op, PORTSC (p));
    int link = (v >> 5) & 15;
    if (!(v & PORT_CONNECTED) && link == 6) {                  // a SuperSpeed port in "inactive": a warm reset starts the link training again
      wr32 (op, PORTSC (p), PORT_KEEP (v) | (1u << 31));
      delay_us (100000);
      v = rd32 (op, PORTSC (p));
    }
    if (!(v & PORT_CONNECTED) || port_served (p) || port_failed[p]) continue;
    printf ("usb: port %d: something is connected (status 0x%08x, link state %d, speed %d)\n", p + 1, v, link, PORT_SPEED (v));
    wr32 (op, PORTSC (p), PORT_KEEP (v) | (0x7f << 17));       // acknowledge the changes (connect, ...)
    if (!(v & PORT_ENABLED)) {                                 // a USB 3 port enables itself; the others are reset
      wr32 (op, PORTSC (p), PORT_KEEP (v) | PORT_RESET);
      if (!wait_for (op, PORTSC (p), PORT_RESET_DONE, PORT_RESET_DONE, 500)) { printf ("usb: port %d: reset did not finish\n", p + 1); port_failed[p] = 1; continue; }
      wr32 (op, PORTSC (p), PORT_KEEP (rd32 (op, PORTSC (p))) | (0x7f << 17));
      delay_us (20000);                                        // the device needs 10 ms to recover
      v = rd32 (op, PORTSC (p));
      if (!(v & PORT_ENABLED)) { printf ("usb: port %d: not enabled after the reset\n", p + 1); port_failed[p] = 1; continue; }
    }
    enumerate (p, 0, 0, PORT_SPEED (rd32 (op, PORTSC (p))));
    if (!port_served (p)) port_failed[p] = 1;                  // (it did not work)
  }
}

int usb_init (void) {
  const char *cl = plat_cmdline ();
  if (has_word (cl, "usb=off")) return -1;
  usb_debug = has_word (cl, "debug=usb");
  DBG ("pci: type %d, registers at 0x%lx, window: PCI 0x%lx, cores 0x%lx, size 0x%lx\n", plat.pci_type, plat.pci_cfg, plat.pci_mem_pci, plat.pci_mem_cpu, plat.pci_mem_size);
  if (!plat.pci_cfg) return -1;
  arch_map_device (plat.pci_cfg);
  arch_map_device (plat.pci_mem_cpu);
  struct pci_dev d;
  if (pci_find (0x0c0330, &d) < 0) { if (plat.pci_type) printf ("usb: no xHCI controller found on the PCI bus\n");  return -1; }      // (silent on a machine without PCI)
  u64 size = 0, bar = pci_assign_bar (&d, 0, &size);
  if (!bar) { printf ("usb: no address for the controller\n"); return -1; }
  pci_vl805_reset (&d);                                        // the Pi: the VideoCore loads the program of the USB chip
  pci_enable (&d);
  arch_map_device (bar);
  base = (volatile u8 *) (KERNEL_VA + bar);
  int caplen = *(volatile u8 *) base;
  op = base + caplen;  rt = base + (rd32 (base, 0x18) & ~0x1fu);  db = base + (rd32 (base, 0x14) & ~3u);
  u32 hcs1 = rd32 (base, 0x04), hcs2 = rd32 (base, 0x08), hcc = rd32 (base, 0x10);
  nslots = hcs1 & 255;  nports = hcs1 >> 24;  ctx_size = (hcc & 4) ? 64 : 32;
  int nscratch = ((hcs2 >> 21) & 31) * 32 + ((hcs2 >> 27) & 31);
  if (nscratch > 64) { printf ("usb: the controller wants %d scratchpad pages (we have 64)\n", nscratch); return -1; }
  printf ("usb: xHCI controller %04x:%04x, %d ports, %d slots\n", d.vendor, d.device, nports, nslots);

  wr32 (op, USBCMD, rd32 (op, USBCMD) & ~CMD_RUN);             // stop, then reset
  if (!wait_for (op, USBSTS, STS_HALTED, STS_HALTED, 100)) { printf ("usb: the controller does not stop\n"); return -1; }
  wr32 (op, USBCMD, CMD_RESET);
  if (!wait_for (op, USBCMD, CMD_RESET, 0, 500) || !wait_for (op, USBSTS, STS_NOTREADY, 0, 500)) { printf ("usb: the controller does not come out of the reset\n"); return -1; }

  if (nslots > 8) nslots = 8;
  wr32 (op, CONFIG, nslots);
  for (int i = 0; i < 256; i++) dcbaa[i] = 0;
  if (nscratch) { for (int i = 0; i < nscratch; i++) scratch_array[i] = PA (scratch_page[i]);  dcbaa[0] = PA (scratch_array);  cache_clean (scratch_array, sizeof scratch_array); }
  cache_clean (dcbaa, sizeof dcbaa);
  wr64 (op, DCBAAP, PA (dcbaa));
  ring_init (&cmd_ring, cmd_trbs, 64);
  wr64 (op, CRCR, PA (cmd_trbs) | 1);                          // bit 0: the cycle bit that the controller expects first
  for (int i = 0; i < 256; i++) { ev_trbs[i].param = 0; ev_trbs[i].status = 0; ev_trbs[i].control = 0; }
  cache_clean (ev_trbs, sizeof ev_trbs);
  erst[0] = PA (ev_trbs);  erst[1] = 256;  cache_clean (erst, sizeof erst);
  wr32 (rt, 0x20 + 0x08, 1);                                   // interrupter 0: one segment,
  wr64 (rt, 0x20 + 0x18, PA (ev_trbs));                        // dequeue pointer,
  wr64 (rt, 0x20 + 0x10, PA (erst));                           // and the table (this last write starts the ring)
  wr32 (op, USBCMD, CMD_RUN);                                  // no interrupts (INTE stays 0): we poll
  if (!wait_for (op, USBSTS, STS_HALTED, 0, 100)) { printf ("usb: the controller does not start\n"); return -1; }
  for (int round = 0; round < 15; round++) {                   // the ports need a moment to see what is plugged in; a SuperSpeed link needs up to a second to train
    delay_us (100000);
    scan_ports ();
  }
  controller_up = 1;
  return 0;
}

static void remove_slot (struct slot *s) {                    // a device that is gone (and, if it is a hub, everything behind it): its slot is disabled, its disk is no more
  for (int i = 0; i < MAXDEV; i++) if (slots[i].used && slots[i].parent_id == s->id && s->hub) remove_slot (&slots[i]);
  if (s->msc.used) { udisk[s->msc.disk].present = 0;  printf ("usb: disk %s removed\n", udisk[s->msc.disk].name); }
  else printf ("usb: %s: device removed\n", wh (s));
  cmd (0, 0, (10 << 10) | (s->id << 24), 0);                   // Disable Slot
  dcbaa[s->id] = 0;  cache_clean (&dcbaa[s->id], 8);
  s->used = 0;  s->hid[0].used = s->hid[1].used = 0;  s->msc.used = 0;
}

void usb_rescan (void) {                                       // from a process (the mount command): devices that came, devices that went
  if (!controller_up) return;
  for (int i = 0; i < 32; i++) port_failed[i] = 0;
  for (int i = 0; i < MAXDEV; i++) for (int p = 0; p < 16; p++) hub_failed[i][p] = 0;
  for (int i = 0; i < MAXDEV; i++) {
    struct slot *s = &slots[i];
    if (s->used && s->parent_id == 0 && !(rd32 (op, PORTSC (s->port)) & PORT_CONNECTED)) remove_slot (s);
  }
  for (int round = 0; round < 4; round++) {                    // (a SuperSpeed link that was just plugged in needs a moment)
    scan_ports ();
    for (int i = 0; i < MAXDEV; i++) if (slots[i].used && slots[i].hub) scan_hub (&slots[i]);
    if (round < 3) delay_us (200000);
  }
}

void usb_tick (void) {                                         // from the timer, 100 times a second
  if (!controller_up) return;
  ev_poll ();
  usb_keys_tick ();
}
@
\section{Keyboard and mouse (see \texttt{usbhid.c})}
\label{src:usbhid.c}

In the boot protocol a keyboard report has 8 bytes: byte 0 has one bit per modifier key (Ctrl, Shift, Alt, GUI, left and right), byte 1 is reserved and bytes 2 to 7 hold the \emph{usage numbers} of up to six keys that
are held down now (0 = none; 1 = too many keys). The usage numbers name keys, not letters: 4 is the key A, 0x28 is Enter. A report is sent whenever the set of keys changes, so what a press is shows up as a number that was not in the
previous report.

The layout turns a usage number into a character: [[us]] and [[de]] (German; AltGr gives \texttt{@ \{ [ ] \} \textbackslash{} \~{} | €}). Characters above 127 go out as UTF-8 (the console of the screen
shows Latin-1 and more). Control keys send the usual codes: Ctrl and a letter the code 1 to 26, Alt an Escape in front, the cursor keys the sequences of the xterm (\texttt{ESC [ A}, or \texttt{ESC O A} when a program has asked for the application mode of the cursor keys, see [[fbcon_app_cursor]]).
A key that is held down repeats after half a second, 30 times a second.
Alt and F1 to F10 switch the virtual terminal (like Ctrl-T and a digit on the serial line). Command line: [[keymap=us]] or [[keymap=de]] (default: German).

<<usbhid.c>>=
#include "ulix.h"
#include "plat.h"
#include "usb.h"

extern void arch_console_input (unsigned char c);             // arch_console.c: a character arrives, from the UART or from here
extern void arch_vt_switch (int n);
extern int fbcon_app_cursor;                                   // video.nw: ESC [ ? 1 h
extern const char *plat_cmdline (void);

static int layout_de = 1;                                      // keymap=us on the command line switches to the US layout
static int layout_checked = 0;
static int caps = 0, numlock = 1;

static void out_cp (unsigned cp) {                             // a character (Unicode) as UTF-8 to the console
  if (cp < 0x80) arch_console_input (cp);
  else if (cp < 0x800) { arch_console_input (0xc0 | (cp >> 6));  arch_console_input (0x80 | (cp & 63)); }
  else { arch_console_input (0xe0 | (cp >> 12));  arch_console_input (0x80 | ((cp >> 6) & 63));  arch_console_input (0x80 | (cp & 63)); }
}

static void out_str (const char *s) { while (*s) arch_console_input (*s++); }

// usage numbers 0x04 .. 0x38: a to z, 1 to 9 and 0, Enter, Esc, Backspace, Tab, Space, - = [ ] \ # ; ' ` , . /
static const char us_plain[] = "abcdefghijklmnopqrstuvwxyz1234567890\r\033\177\t -=[]\\#;'`,./";
static const char us_shift[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZ!@#$%^&*()\r\033\177\t _+{}|~:\"~<>?";

static unsigned us_key (int u, int shift) { return (shift ? us_shift : us_plain)[u - 4]; }

static unsigned de_key (int u, int shift, int altgr) {         // the German layout: y and z swapped, the digits and the symbols are elsewhere
  if (u == 0x1c) u = 0x1d; else if (u == 0x1d) u = 0x1c;       // Y <-> Z
  if (u >= 0x1e && u <= 0x27) {
    static const char sh[] = "!\"\0$%&/()=";                   // 3 is the paragraph sign, below
    int i = u - 0x1e;
    if (altgr) { static const unsigned ag[] = { 0, 0, 0xb2, 0xb3, 0, 0, '{', '[', ']', '}' }; return ag[i]; }
    if (shift) return i == 2 ? 0xa7 : sh[i];
  }
  switch (u) {
    case 0x14: if (altgr) return '@'; break;                   // Q
    case 0x08: if (altgr) return 0x20ac; break;                // E
    case 0x2d: return altgr ? '\\' : shift ? '?' : 0xdf;       // sz
    case 0x2e: return shift ? '`' : '\'';                      // the acute key (no dead keys)
    case 0x2f: return shift ? 0xdc : 0xfc;                     // u umlaut
    case 0x30: return altgr ? '~' : shift ? '*' : '+';
    case 0x31: case 0x32: return shift ? '\'' : '#';
    case 0x33: return shift ? 0xd6 : 0xf6;                     // o umlaut
    case 0x34: return shift ? 0xc4 : 0xe4;                     // a umlaut
    case 0x35: return shift ? 0xb0 : '^';
    case 0x36: return shift ? ';' : ',';
    case 0x37: return shift ? ':' : '.';
    case 0x38: return shift ? '_' : '-';
    case 0x64: return altgr ? '|' : shift ? '>' : '<';         // the key left of Y on an ISO keyboard
    default: break;
  }
  return us_key (u, shift);
}

static void key_down (int u, int mods) {
  int shift = (mods & 0x22) != 0, ctrl = (mods & 0x11) != 0, lalt = (mods & 0x04) != 0, ralt = (mods & 0x40) != 0;
  int altgr = layout_de && ralt, alt = lalt || (ralt && !layout_de);
  if (u == 0x39) { caps ^= 1; return; }                        // Caps Lock
  if (u == 0x53) { numlock ^= 1; return; }                     // Num Lock
  if (alt && u >= 0x3a && u <= 0x43) { arch_vt_switch (u - 0x3a); return; }     // Alt F1 .. F10
  const char *app = fbcon_app_cursor ? "\033O" : "\033[";
  char seq[8];
  const char *special = 0;
  switch (u) {
    case 0x52: seq[0] = app[0]; seq[1] = app[1]; seq[2] = 'A'; seq[3] = 0; special = seq; break;       // up, down, right, left
    case 0x51: seq[0] = app[0]; seq[1] = app[1]; seq[2] = 'B'; seq[3] = 0; special = seq; break;
    case 0x4f: seq[0] = app[0]; seq[1] = app[1]; seq[2] = 'C'; seq[3] = 0; special = seq; break;
    case 0x50: seq[0] = app[0]; seq[1] = app[1]; seq[2] = 'D'; seq[3] = 0; special = seq; break;
    case 0x4a: seq[0] = app[0]; seq[1] = app[1]; seq[2] = 'H'; seq[3] = 0; special = seq; break;       // Home, End
    case 0x4d: seq[0] = app[0]; seq[1] = app[1]; seq[2] = 'F'; seq[3] = 0; special = seq; break;
    case 0x49: special = "\033[2~"; break;                     // Insert, Delete, Page up, Page down
    case 0x4c: special = "\033[3~"; break;
    case 0x4b: special = "\033[5~"; break;
    case 0x4e: special = "\033[6~"; break;
    case 0x3a: special = "\033OP"; break;                      // F1 .. F12
    case 0x3b: special = "\033OQ"; break;
    case 0x3c: special = "\033OR"; break;
    case 0x3d: special = "\033OS"; break;
    case 0x3e: special = "\033[15~"; break;
    case 0x3f: special = "\033[17~"; break;
    case 0x40: special = "\033[18~"; break;
    case 0x41: special = "\033[19~"; break;
    case 0x42: special = "\033[20~"; break;
    case 0x43: special = "\033[21~"; break;
    case 0x44: special = "\033[23~"; break;
    case 0x45: special = "\033[24~"; break;
    default: break;
  }
  if (special) { out_str (special); return; }
  unsigned c = 0;
  if (u >= 0x04 && u <= 0x38) {
    int letter = u <= 0x1d;
    c = layout_de ? de_key (u, shift ^ (caps && letter), altgr) : us_key (u, shift ^ (caps && letter));
  } else if (u == 0x64 && layout_de) c = de_key (u, shift, altgr);
  else if (u >= 0x54 && u <= 0x63) {                           // the keypad
    static const char pad[] = "/*-+\r1234567890.";
    if (u >= 0x59 && u <= 0x62 && !numlock) {                  // without Num Lock the keys move the cursor
      static const char *mv[] = { 0, "\033[F", "\033[B", "\033[6~", "\033[D", 0, "\033[C", "\033[H", "\033[A", "\033[5~", "\033[2~" };
      if (mv[u - 0x59]) { out_str (mv[u - 0x59]); }
      return;
    }
    if (u == 0x63 && !numlock) { out_str ("\033[3~"); return; }
    c = pad[u - 0x54];
  }
  if (!c) return;
  if (ctrl && c >= '@' && c <= '~') c &= 0x1f;                 // Ctrl-A .. Ctrl-Z, Ctrl-[ ...
  else if (ctrl && c == ' ') c = 0;
  if (alt) arch_console_input (27);                            // Alt: the key with an Escape in front (nano's M-keys)
  out_cp (c);
}

static u8 prev[8];
static int rep_key = 0, rep_mods = 0, rep_ticks = 0;

void usb_keyboard_report (const u8 *r, int n) {
  if (n < 8) return;
  if (!layout_checked) {                                       // (the command line is known only after the device tree is read: look when the first key comes)
    const char *p = plat_cmdline ();
    for (; *p; p++) if ((p == plat_cmdline () || p[-1] == ' ') && p[0] == 'k' && p[1] == 'e' && p[2] == 'y' && p[3] == 'm' && p[4] == 'a' && p[5] == 'p' && p[6] == '=') layout_de = !(p[7] == 'u');
    layout_checked = 1;
  }
  int still = 0;
  for (int i = 2; i < 8; i++) {
    int k = r[i];
    if (k < 4) continue;                                       // none (0), roll-over error (1)
    int was = 0;
    for (int j = 2; j < 8; j++) if (prev[j] == k) was = 1;
    if (!was) { key_down (k, r[0]);  rep_key = k;  rep_mods = r[0];  rep_ticks = 0; }
    if (k == rep_key) still = 1;
  }
  if (!still) rep_key = 0;
  for (int i = 0; i < 8; i++) prev[i] = r[i];
}

void usb_keys_tick (void) {                                    // key repeat: after 500 ms, then every 30 ms
  if (!rep_key) return;
  rep_ticks++;
  if (rep_ticks >= 50 && (rep_ticks - 50) % 3 == 0) key_down (rep_key, rep_mods);
}
@

\paragraph{The mouse.} A boot protocol report has the buttons (bit 0: left, 1: right, 2: middle), the movement to the right and downward as signed bytes, and, if the mouse has a wheel, the wheel. We collect
the position and the buttons and put what happened into a small ring of \emph{input events}, which any later user (a window system, for instance) can take: [[input_get]] returns the next one. With [[debug=usb]] they are printed.

<<usbhid.c>>=
struct input_event { int kind, a, b; };                        // kind 1: movement by (a, b); 2: button a (0 left, 1 right, 2 middle) is b (1 down, 0 up); 3: wheel by a
#define NEVENTS 64
static struct input_event events[NEVENTS];
static int ev_head = 0, ev_tail = 0;
int mouse_x = 0, mouse_y = 0, mouse_buttons = 0;
extern int usb_debug;

static void input_put (int kind, int a, int b) {
  int next = (ev_head + 1) % NEVENTS;
  if (next == ev_tail) return;                                 // full: drop it
  events[ev_head].kind = kind;  events[ev_head].a = a;  events[ev_head].b = b;
  ev_head = next;
}

int input_get (int *kind, int *a, int *b) {                    // 0: nothing there
  if (ev_tail == ev_head) return 0;
  *kind = events[ev_tail].kind;  *a = events[ev_tail].a;  *b = events[ev_tail].b;
  ev_tail = (ev_tail + 1) % NEVENTS;
  return 1;
}

void usb_mouse_report (const u8 *r, int n) {
  if (n < 3) return;
  int dx = (signed char) r[1], dy = (signed char) r[2];
  if (dx || dy) { mouse_x += dx;  mouse_y += dy;  input_put (1, dx, dy);  if (usb_debug) printf ("mouse: move %d %d (at %d %d)\n", dx, dy, mouse_x, mouse_y); }
  for (int b = 0; b < 3; b++) {
    int down = (r[0] >> b) & 1, was = (mouse_buttons >> b) & 1;
    if (down != was) { input_put (2, b, down);  if (usb_debug) printf ("mouse: button %d %s\n", b, down ? "down" : "up"); }
  }
  mouse_buttons = r[0] & 7;
  if (n >= 4 && (signed char) r[3]) { input_put (3, (signed char) r[3], 0);  if (usb_debug) printf ("mouse: wheel %d\n", (signed char) r[3]); }
}
@
