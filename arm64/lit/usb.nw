<<xhci.c: devices>>=
static u32 *ctx_at (u8 *ctx, int i) { return (u32 *) (ctx + i * ctx_size); }              // context i of an input context (0: control, 1: slot, 2: endpoint 0, ...)

static int mps_of_speed (int speed) { return speed == 4 ? 512 : speed == 3 ? 64 : 8; }     // the first guess for endpoint 0 (full speed: read it from the device)

static int address_device (struct slot *s) {
  int n = s - slots;
  u8 *in = in_ctx[n];
  for (int i = 0; i < (int) sizeof in_ctx[n]; i++) in[i] = 0;
  for (int i = 0; i < (int) sizeof out_ctx[n]; i++) out_ctx[n][i] = 0;
  ctx_at (in, 0)[1] = 3;                                       // add flags: slot context and endpoint 0
  u32 *slotc = ctx_at (in, 1);
  slotc[0] = (s->speed << 20) | (1u << 27);                    // speed; context entries: 1
  slotc[1] = (s->port + 1) << 16;                              // root hub port number (from 1)
  u32 *ep = ctx_at (in, 2);
  ep[1] = (3 << 1) | (4 << 3) | (mps_of_speed (s->speed) << 16);        // error count 3, type control, max packet size
  u64 deq = PA (s->ep0.trb) | 1;
  ep[2] = (u32) deq;  ep[3] = (u32) (deq >> 32);
  ep[4] = 8;                                                   // average TRB length
  dcbaa[s->id] = PA (out_ctx[n]);
  cache_clean (&dcbaa[s->id], 8);  cache_clean (in, sizeof in_ctx[n]);  cache_clean (out_ctx[n], sizeof out_ctx[n]);
  return cmd (PA (in), 0, (TRB_ADDRESS_DEV << 10) | (s->id << 24), 0);
}

static void set_mps (struct slot *s, int mps) {                // a full speed device may have another maximum packet size on endpoint 0
  int n = s - slots;
  u8 *in = in_ctx[n];
  for (int i = 0; i < (int) sizeof in_ctx[n]; i++) in[i] = 0;
  ctx_at (in, 0)[1] = 2;                                       // endpoint 0 only
  ctx_at (in, 2)[1] = (3 << 1) | (4 << 3) | (mps << 16);
  cache_clean (in, sizeof in_ctx[n]);
  cmd (PA (in), 0, (TRB_EVAL_CONTEXT << 10) | (s->id << 24), 0);
}

static int interval_of (int speed, int binterval) {            // xHCI wants an exponent of 125 microsecond units
  if (speed >= 3) return binterval > 0 ? binterval - 1 : 0;    // high and super speed: 2^(bInterval-1) microframes
  int frames = binterval ? binterval : 1, e = 3;               // low and full speed: bInterval milliseconds = 8 * bInterval microframes
  while ((1 << e) < frames * 8 && e < 10) e++;
  return e;
}

static int configure_endpoints (struct slot *s) {
  int n = s - slots, maxdci = 1;
  u8 *in = in_ctx[n];
  for (int i = 0; i < (int) sizeof in_ctx[n]; i++) in[i] = 0;
  u32 add = 1;                                                 // the slot context
  for (int i = 0; i < 2; i++) {
    struct hid_ep *h = &s->hid[i];
    if (!h->used) continue;
    add |= 1u << h->dci;
    if (h->dci > maxdci) maxdci = h->dci;
    u32 *ep = ctx_at (in, 1 + h->dci);
    ep[0] = interval_of (s->speed, h->interval) << 16;
    ep[1] = (3 << 1) | (7 << 3) | (h->mps << 16);               // error count 3, type interrupt in, max packet size
    u64 deq = PA (h->ring.trb) | 1;
    ep[2] = (u32) deq;  ep[3] = (u32) (deq >> 32);
    ep[4] = h->mps | (h->mps << 16);                            // average TRB length, max ESIT payload
  }
  ctx_at (in, 0)[1] = add;
  u32 *slotc = ctx_at (in, 1);
  slotc[0] = (s->speed << 20) | ((u32) maxdci << 27);
  slotc[1] = (s->port + 1) << 16;
  cache_clean (in, sizeof in_ctx[n]);
  return cmd (PA (in), 0, (TRB_CONFIGURE_EP << 10) | (s->id << 24), 0);
}

static void hid_setup (struct slot *s, int idx, int proto, int iface, int ep_addr, int mps, int binterval) {
  int n = s - slots;
  struct hid_ep *h = &s->hid[idx];
  h->used = 1;  h->proto = proto;  h->iface = iface;
  h->dci = (ep_addr & 15) * 2 + 1;                             // an IN endpoint
  h->mps = mps & 0x7ff;  if (h->mps > 64) h->mps = 64;         // (the buffers are 64 bytes; boot reports have 8)
  h->interval = binterval;
  ring_init (&h->ring, hid_trbs[n][idx], EP_RING);
  h->buf = hid_buf[n][idx];
}

static int read_configuration (struct slot *s, int *config) {   // the whole configuration descriptor into xfer_buf: returns its length, 0 if not
  if (control (s, 0x80, 6, 0x0200, 0, 9, 1) != 1) return 0;     // first the length of it,
  int total = xfer_buf[2] | xfer_buf[3] << 8;
  *config = xfer_buf[5];
  if (total > (int) sizeof xfer_buf) total = sizeof xfer_buf;
  return control (s, 0x80, 6, 0x0200, 0, total, 1) == 1 ? total : 0;      // then all of it
}

static void enumerate (int port) {
  int speed = PORT_SPEED (rd32 (op, PORTSC (port)));
  int sl = -1;
  for (int i = 0; i < MAXDEV; i++) if (!slots[i].used) { sl = i; break; }
  if (sl < 0) return;
  struct slot *s = &slots[sl];
  int slot_id = 0;
  if (cmd (0, 0, TRB_ENABLE_SLOT << 10, &slot_id) != 1 || slot_id == 0 || slot_id >= 256) { printf ("usb: no slot for port %d\n", port + 1); return; }
  s->used = 1;  s->id = slot_id;  s->port = port;  s->speed = speed;
  s->hid[0].used = s->hid[1].used = 0;
  ring_init (&s->ep0, ep0_trbs[sl], EP_RING);
  if (address_device (s) != 1) { printf ("usb: port %d: the device did not get an address\n", port + 1); s->used = 0; return; }
  if (control (s, 0x80, 6, 0x0100, 0, 8, 1) != 1) { printf ("usb: port %d: no device descriptor\n", port + 1); s->used = 0; return; }   // GET_DESCRIPTOR: device, the first 8 bytes
  if (speed <= 2 && xfer_buf[7] != 8 && xfer_buf[7] >= 8) set_mps (s, xfer_buf[7]);
  if (control (s, 0x80, 6, 0x0100, 0, 18, 1) != 1) { s->used = 0; return; }
  int vendor = xfer_buf[8] | xfer_buf[9] << 8, product = xfer_buf[10] | xfer_buf[11] << 8;
  int config = 1, total = read_configuration (s, &config);
  if (!total) { s->used = 0; return; }
  int nhid = 0, iface = -1, iclass = 0, isub = 0, iproto = 0;
  for (int p = 0; p + 2 <= total && xfer_buf[p] >= 2; p += xfer_buf[p]) {                  // the interfaces and their endpoints
    if (xfer_buf[p + 1] == 4) { iface = xfer_buf[p + 2];  iclass = xfer_buf[p + 5];  isub = xfer_buf[p + 6];  iproto = xfer_buf[p + 7]; }
    else if (xfer_buf[p + 1] == 5 && iclass == 3 && isub == 1 && (iproto == 1 || iproto == 2) && nhid < 2) {
      int addr = xfer_buf[p + 2], attr = xfer_buf[p + 3];
      if ((addr & 0x80) && (attr & 3) == 3) {                  // the interrupt-in endpoint of a boot keyboard or mouse
        hid_setup (s, nhid++, iproto, iface, addr, xfer_buf[p + 4] | xfer_buf[p + 5] << 8, xfer_buf[p + 6]);
        iclass = 0;                                            // one endpoint per interface
      }
    }
  }
  if (nhid == 0) { printf ("usb: port %d: device %04x:%04x is not a keyboard or a mouse (not supported)\n", port + 1, vendor, product); s->used = 0; return; }
  if (control (s, 0, 9, config, 0, 0, 0) != 1) { printf ("usb: port %d: SET_CONFIGURATION failed\n", port + 1); s->used = 0; return; }
  for (int i = 0; i < nhid; i++) {
    control (s, 0x21, 0x0b, 0, s->hid[i].iface, 0, 0);         // SET_PROTOCOL: the boot protocol (a device in it already may stall: no matter)
    control (s, 0x21, 0x0a, 0, s->hid[i].iface, 0, 0);         // SET_IDLE: report only when something changes
  }
  if (configure_endpoints (s) != 1) { printf ("usb: port %d: Configure Endpoint failed\n", port + 1); s->used = 0; return; }
  for (int i = 0; i < nhid; i++) {
    struct hid_ep *h = &s->hid[i];
    ring_put (&h->ring, PA (h->buf), h->mps, (TRB_NORMAL << 10) | (1 << 5) | (1 << 2));    // the first report is asked for
    wr32 (db, 4 * s->id, h->dci);
    printf ("usb: port %d: %s (%04x:%04x, %s speed)\n", port + 1, h->proto == 1 ? "keyboard" : "mouse", vendor, product,
            speed == 4 ? "super" : speed == 3 ? "high" : speed == 2 ? "low" : "full");
  }
}
