#include "ulix.h"
#include "plat.h"
#include "cache.h"
#include "delay.h"
#include "usb.h"

int usb_debug = 0;
#define DBG(...) do { if (usb_debug) printf (__VA_ARGS__); } while (0)

struct trb { u64 param; u32 status; u32 control; };            // 16 bytes

// the TRB types (bits 10..15 of the control word)
#define TRB_NORMAL  1
#define TRB_SETUP   2
#define TRB_DATA    3
#define TRB_STATUS  4
#define TRB_LINK    6
#define TRB_ENABLE_SLOT   9
#define TRB_ADDRESS_DEV   11
#define TRB_CONFIGURE_EP  12
#define TRB_EVAL_CONTEXT  13
#define TRB_EV_TRANSFER   32
#define TRB_EV_COMMAND    33
#define TRB_EV_PORT       34
#define TRB_TYPE(c)  (((c) >> 10) & 63)

#define MAXDEV    4                                           // slots that we use (a keyboard, a mouse, ...)
#define EP_RING   16                                          // TRBs of an endpoint ring (the last is the link)

static volatile u8 *base;                                     // BAR 0
static volatile u8 *op, *rt, *db;                             // operational and runtime registers, doorbells
static int ctx_size = 32, nports, nslots;                     // context size (32 or 64 bytes: HCCPARAMS1 bit 2), root ports, slots

static inline u32 rd32 (volatile u8 *p, int off) { return *(volatile u32 *) (p + off); }
static inline void wr32 (volatile u8 *p, int off, u32 v) { *(volatile u32 *) (p + off) = v; }
static inline void wr64 (volatile u8 *p, int off, u64 v) { wr32 (p, off, (u32) v);  wr32 (p, off + 4, (u32) (v >> 32)); }

#define USBCMD   0x00
#define USBSTS   0x04
#define CRCR     0x18
#define DCBAAP   0x30
#define CONFIG   0x38
#define PORTSC(n) (0x400 + 0x10 * (n))                        // n from 0
#define CMD_RUN  1
#define CMD_RESET 2
#define STS_HALTED 1
#define STS_NOTREADY (1 << 11)                                // controller not ready (after a reset)

#define PORT_CONNECTED (1 << 0)
#define PORT_ENABLED   (1 << 1)
#define PORT_RESET     (1 << 4)
#define PORT_RESET_DONE (1 << 21)
#define PORT_SPEED(v)  (((v) >> 10) & 15)                     // 1 full, 2 low, 3 high, 4 super speed
#define PORT_KEEP(v)   ((v) & ~((1u << 1) | (0x7fu << 17) | (1u << 31)))     // PED and the change bits are "write 1 to clear": write them as 0
