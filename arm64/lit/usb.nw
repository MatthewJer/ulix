\subsection{Hubs}
The four sockets of the Raspberry Pi 4B are not connected to the controller one by one: the USB 2 side of all of them goes through a \emph{hub} on the board (VIA Labs 2109:3431), which sits on a port of the controller. Only the extra pairs of wires for SuperSpeed of the blue sockets
go to ports of the controller. So a keyboard or a mouse, which are USB 2 devices, are \emph{behind a hub} in every socket.

A hub is a device with a class of its own. After [[SET_CONFIGURATION]] the driver reads its \emph{hub descriptor} (the number of ports, the time that a port needs to have power, the \emph{think time} of its transaction translators) with a class request, tells the controller that this slot is a hub
(the slot context gets the flag, the number of ports and the think time: Configure Endpoint) and switches the power on at every port (class request [[SET_FEATURE]], feature [[PORT_POWER]]). Then it looks at the ports one after the other with [[GET_STATUS]]: if something is connected, the port is reset
([[SET_FEATURE PORT_RESET]]; the hub says through a change bit that it is done), and the speed (low, full, high) is in the status. The device is then set up like one on a root port, with two additions in its slot context:
the \emph{route string} (20 bits, one nibble for the port on every hub between the controller and the device, the hub next to the controller first) and, for a slow device (low or full speed) behind a high speed hub, the slot and the port of the hub, because
the hub \emph{translates} between the speeds (the transaction translator, TT).

Not done: hubs that report changes through their interrupt endpoint (the ports are looked at by [[mount]]: [[usb_rescan]]), SuperSpeed hubs.

<<xhci.c: hubs>>=
static int hub_attach (struct slot *s, int config, int proto) {
  if (s->speed == 4) { printf ("usb: %s: SuperSpeed hubs are not supported\n", wh (s));  return -1; }
  if (control (s, 0, 9, config, 0, 0, 0) != 1) return -1;                          // SET_CONFIGURATION
  if (control (s, 0xa0, 6, 0x2900, 0, 9, 1) != 1) return -1;                        // GET_DESCRIPTOR: the hub descriptor
  int nports = xfer_buf[2], chars = xfer_buf[3] | xfer_buf[4] << 8, power_good = xfer_buf[5];
  if (nports < 1 || nports > 15 || s->tier > 3) return -1;
  s->hub = 1;  s->nports = nports;  s->mtt = proto == 2;  s->think = (chars >> 5) & 3;
  int n = s - slots;
  u8 *in = in_ctx[n];
  for (int i = 0; i < (int) sizeof in_ctx[n]; i++) in[i] = 0;
  ctx_at (in, 0)[1] = 1;                                                           // add flags: the slot context only
  fill_slot (s, ctx_at (in, 1), 1);
  cache_clean (in, sizeof in_ctx[n]);
  int r = cmd (PA (in), 0, (TRB_CONFIGURE_EP << 10) | (s->id << 24), 0);            // Configure Endpoint: this slot is a hub
  if (r != 1) { printf ("usb: %s: the controller does not accept the hub (completion code %d)\n", wh (s), r);  return -1; }
  for (int p = 1; p <= nports; p++) control (s, 0x23, 3, 8, p, 0, 0);               // SET_FEATURE PORT_POWER
  delay_us ((power_good * 2 + 100) * 1000);
  printf ("usb: %s: hub with %d ports\n", wh (s), nports);
  scan_hub (s);
  return 0;
}

static void hub_port_status (struct slot *h, int p, int *status, int *change) {      // GET_STATUS of port p: four bytes, status and change
  if (control (h, 0xa3, 0, 0, p, 4, 1) != 1) { *status = *change = 0;  return; }
  *status = xfer_buf[0] | xfer_buf[1] << 8;  *change = xfer_buf[2] | xfer_buf[3] << 8;
}

static struct slot *child_of (struct slot *h, int p) {
  for (int i = 0; i < MAXDEV; i++) if (slots[i].used && slots[i].parent_id == h->id && slots[i].port == p) return &slots[i];
  return 0;
}

static void remove_slot (struct slot *s);

static void scan_hub (struct slot *h) {                          // new devices on the ports of a hub are set up, devices that went are removed
  int n = h - slots;
  for (int p = 1; p <= h->nports; p++) {
    int status, change;
    hub_port_status (h, p, &status, &change);
    if (change & 1) control (h, 0x23, 1, 16, p, 0, 0);          // CLEAR_FEATURE C_PORT_CONNECTION
    struct slot *known = child_of (h, p);
    if (!(status & 1)) { if (known) remove_slot (known);  continue; }       // nothing connected: and if there was something, it has gone
    if (known || hub_failed[n][p]) continue;
    control (h, 0x23, 3, 4, p, 0, 0);                            // SET_FEATURE PORT_RESET
    int done = 0;
    for (int t = 0; t < 60 && !done; t++) { delay_us (10000);  hub_port_status (h, p, &status, &change);  if (change & 0x10) done = 1; }
    control (h, 0x23, 1, 20, p, 0, 0);                           // CLEAR_FEATURE C_PORT_RESET
    if (!done || !(status & 2)) { printf ("usb: %s.%d: the hub port does not come up after the reset\n", wh (h), p);  hub_failed[n][p] = 1;  continue; }
    delay_us (20000);
    int speed = (status & 0x200) ? 2 : (status & 0x400) ? 3 : 1;       // low, high, else full speed (the numbers of the controller: 2 low, 3 high, 1 full)
    enumerate (h->rootport - 1, h, p, speed);
    if (!child_of (h, p)) hub_failed[n][p] = 1;                    // (it did not work: do not try again and again)
  }
}
