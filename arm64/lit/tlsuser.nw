\section{\texttt{userland/rand.c}}
\label{src:userland:rand.c}

A program that shows random bytes as hexadecimal digits: [[rand]] gives 16 bytes, [[rand 4]] four. It is the test of the
generator ([[random.c]]), and says so if the machine has none.

<<userland/rand.c>>=
#include "../ulixlib.h"
#include "../arm64-extra.h"

int main (int argc, char *argv[]) {
  unsigned char buf[64];
  int n = argc > 1 ? atoi (argv[1]) : 16;
  if (n < 1 || n > 64) { printf ("usage: rand [bytes, 1 to 64]\n");  return 1; }
  if (getrandom (buf, n) != n) { printf ("rand: this machine has no random number generator (qemu: -device virtio-rng-device)\n");  return 1; }
  for (int i = 0; i < n; i++) printf ("%02x", buf[i]);
  printf ("\n");
  return 0;
}

