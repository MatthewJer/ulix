\subsection{\texttt{userland/tls/tlsglue.c}: everything that touches BearSSL}
\label{src:userland:tlsglue.c}

\paragraph{The trust anchors.}
A \emph{trust anchor} is a certificate authority that we trust without asking: it is what makes a chain of certificates end somewhere.
BearSSL wants an array of them, each with the \emph{name} of the authority (the ``distinguished name'' in the DER form of the
certificate, which is compared byte by byte with the \emph{issuer} of the certificate below it) and its public key.

The file is PEM text: base64 between [[-----BEGIN CERTIFICATE-----]] and [[-----END CERTIFICATE-----]]. [[br_pem_decoder]] cuts it
into objects and hands the decoded bytes of an object to a function we give it; that function is the push function of
[[br_x509_decoder]], which parses the certificate on the fly. So no certificate is ever stored as a whole, only the name and
the key of each one. Their bytes are kept in a memory area of 128 KByte ([[arena]]); the 118 authorities of Mozilla's list need
about 50 KByte of it.

<<userland/tls/tlsglue.c>>=
<<tlsglue.c: includes>>

<<tlsglue.c: anchors>>

<<tlsglue.c: engine>>

<<tlsglue.c: errors>>
@

<<tlsglue.c: includes>>=
#include <stddef.h>
#include <string.h>
#include "bearssl.h"

static int strcmp_certificate (const char *name);

@

<<tlsglue.c: anchors>>=
#define MAX_ANCHORS 400
static br_x509_trust_anchor anchors[MAX_ANCHORS];
static int n_anchors = 0;
static unsigned char arena[128 * 1024];
static unsigned arena_used = 0;

static unsigned char *take (unsigned n) {                        // n bytes of the arena (0: it is full)
  n = (n + 7) & ~7u;
  if (arena_used + n > sizeof arena) return 0;
  unsigned char *p = arena + arena_used;
  arena_used += n;
  return p;
}

static br_x509_decoder_context cert;                             // the certificate that is being decoded
static unsigned char dn[1024];  static size_t dn_len;            // its subject name

static void dn_append (void *ctx, const void *data, size_t len) {
  if (dn_len + len <= sizeof dn) { memcpy (dn + dn_len, data, len);  dn_len += len; }
  else dn_len = sizeof dn + 1;                                   // too long: remembered as an error
}

static void cert_bytes (void *ctx, const void *data, size_t len) { br_x509_decoder_push (&cert, data, len); }

@
When a certificate is complete we keep it if it decoded without error and is a CA (a server certificate in the file would be an
error, not an anchor), copying the name and the key out of the decoder's own memory, which the next certificate overwrites.

<<tlsglue.c: anchors>>=
static int keep_certificate (void) {
  if (br_x509_decoder_last_error (&cert) != 0 || !br_x509_decoder_isCA (&cert)) return 1;       // not usable: skipped, not an error
  br_x509_pkey *key = br_x509_decoder_get_pkey (&cert);
  if (n_anchors == MAX_ANCHORS || dn_len > sizeof dn || !key) return 0;
  br_x509_trust_anchor *ta = &anchors[n_anchors];
  ta->dn.data = take (dn_len);
  if (!ta->dn.data) return 0;
  memcpy (ta->dn.data, dn, dn_len);  ta->dn.len = dn_len;
  ta->flags = BR_X509_TA_CA;
  ta->pkey.key_type = key->key_type;
  if (key->key_type == BR_KEYTYPE_RSA) {
    ta->pkey.key.rsa.n = take (key->key.rsa.nlen);  ta->pkey.key.rsa.nlen = key->key.rsa.nlen;
    ta->pkey.key.rsa.e = take (key->key.rsa.elen);  ta->pkey.key.rsa.elen = key->key.rsa.elen;
    if (!ta->pkey.key.rsa.n || !ta->pkey.key.rsa.e) return 0;
    memcpy (ta->pkey.key.rsa.n, key->key.rsa.n, key->key.rsa.nlen);
    memcpy (ta->pkey.key.rsa.e, key->key.rsa.e, key->key.rsa.elen);
  } else if (key->key_type == BR_KEYTYPE_EC) {
    ta->pkey.key.ec.curve = key->key.ec.curve;
    ta->pkey.key.ec.q = take (key->key.ec.qlen);  ta->pkey.key.ec.qlen = key->key.ec.qlen;
    if (!ta->pkey.key.ec.q) return 0;
    memcpy (ta->pkey.key.ec.q, key->key.ec.q, key->key.ec.qlen);
  } else return 1;                                               // a key type that BearSSL does not know: skipped
  n_anchors++;
  return 1;
}

@
The PEM text comes through the function [[read_bytes]] of the caller, 1 KByte at a time, and is pushed into the PEM decoder. The
decoder says what it found through events: an object begins (then we look at its name: only [[CERTIFICATE]] interests us,
everything else is thrown away by giving the decoder no place to put the data), an object ends (the certificate is complete), or
an error. Returns the number of anchors, or $-1$.

<<tlsglue.c: anchors>>=
int tls_load_anchors (int (*read_bytes) (void *buf, int n)) {
  static br_pem_decoder_context pem;
  static unsigned char buf[1024];
  int in_cert = 0, ok = 1, n;
  br_pem_decoder_init (&pem);
  while (ok && (n = read_bytes (buf, sizeof buf)) > 0) {
    int off = 0;
    while (ok && off < n) {
      off += br_pem_decoder_push (&pem, buf + off, n - off);
      switch (br_pem_decoder_event (&pem)) {
        case BR_PEM_BEGIN_OBJ:
          in_cert = strcmp_certificate (br_pem_decoder_name (&pem));
          if (in_cert) { br_x509_decoder_init (&cert, dn_append, 0);  dn_len = 0;  br_pem_decoder_setdest (&pem, cert_bytes, 0); }
          else br_pem_decoder_setdest (&pem, 0, 0);
          break;
        case BR_PEM_END_OBJ:
          if (in_cert) ok = keep_certificate ();
          in_cert = 0;
          break;
        case BR_PEM_ERROR:
          ok = 0;
          break;
      }
    }
  }
  return ok ? n_anchors : -1;
}

@
(A small helper, because the file does not use [[strcmp]]:)

<<tlsglue.c: anchors>>=
static int strcmp_certificate (const char *name) {
  const char *want = "CERTIFICATE";
  while (*want && *name == *want) { name++;  want++; }
  return *want == 0 && *name == 0;
}

@
\paragraph{The TLS engine.} [[tls_start]] sets up a client: everything BearSSL knows ([[br_ssl_client_init_full]]: the key exchanges,
ciphers and hashes that the Internet uses today), but only version TLS 1.2; its random number generator is seeded with the
bytes from the kernel, and the certificate checker is told today's date. The date is given to BearSSL in days since 1 January of the
year 0 (that is the number 719528 for the Unix epoch) and seconds of the day. No byte has been sent yet: the handshake happens in
the first [[tls_write]].

<<tlsglue.c: engine>>=
static br_ssl_client_context  client;                   // the state of the TLS connection
static br_x509_minimal_context chain_checker;           // checks the certificates of the server
static br_sslio_context        io;                      // the simple read/write interface on top of the engine
static unsigned char iobuf[BR_SSL_BUFSIZE_MONO];        // BearSSL's buffer for records (half duplex: first we write, then we read)
static int (*get_bytes) (unsigned char *buf, int len);
static int (*put_bytes) (const unsigned char *buf, int len);

static int low_read (void *ctx, unsigned char *buf, size_t len)        { return get_bytes (buf, len); }
static int low_write (void *ctx, const unsigned char *buf, size_t len) { return put_bytes (buf, len); }

int tls_start (const char *name, unsigned unix_seconds, const unsigned char *seed,
               int (*in) (unsigned char *, int), int (*out) (const unsigned char *, int)) {
  get_bytes = in;  put_bytes = out;
  br_ssl_client_init_full (&client, &chain_checker, anchors, n_anchors);
  br_ssl_engine_set_versions (&client.eng, BR_TLS12, BR_TLS12);
  br_ssl_engine_set_buffer (&client.eng, iobuf, sizeof iobuf, 0);
  br_ssl_engine_inject_entropy (&client.eng, seed, 32);
  br_x509_minimal_set_time (&chain_checker, 719528 + unix_seconds / 86400, unix_seconds % 86400);
  if (!br_ssl_client_reset (&client, name, 0)) return -1;
  br_sslio_init (&io, &client.eng, low_read, 0, low_write, 0);
  return 0;
}

int tls_write (const void *buf, int len) {
  if (br_sslio_write_all (&io, buf, len) < 0 || br_sslio_flush (&io) < 0) return -1;
  return len;
}

int tls_read (void *buf, int len) { return br_sslio_read (&io, buf, len); }
int tls_error (void) { return br_ssl_engine_last_error (&client.eng); }
void tls_close (void) { br_sslio_close (&io); }

void tls_session (int *version, int *cipher_suite) {
  br_ssl_session_parameters sp;
  br_ssl_engine_get_session_parameters (&client.eng, &sp);
  *version = sp.version;  *cipher_suite = sp.cipher_suite;
}

@
\paragraph{Error messages.} When the handshake fails, the library says why with a number. A few of them have a human meaning that is
worth a sentence: those about the certificate. (The others are shown by their number; the header [[bearssl_ssl.h]] lists them.)

<<tlsglue.c: errors>>=
const char *tls_error_text (int err) {
  switch (err) {
    case BR_ERR_X509_NOT_TRUSTED:     return "the certificate does not lead to a trusted certificate authority";
    case BR_ERR_X509_EXPIRED:         return "the certificate has expired, or is not valid yet (is the clock right? see sntp)";
    case BR_ERR_X509_BAD_SERVER_NAME: return "the certificate is not for this host name";
    case BR_ERR_X509_TIME_UNKNOWN:    return "the time is unknown, the certificate cannot be checked";
    case BR_ERR_X509_BAD_SIGNATURE:   return "a signature in the certificate chain is wrong";
    case BR_ERR_UNSUPPORTED_VERSION:
    case BR_ERR_BAD_VERSION:          return "the server does not speak TLS 1.2 (older versions are switched off)";
    case BR_ERR_IO:                   return "the connection broke during the handshake";
  }
  return err >= 256 ? "the server sent an alert (TLS error 256 and above, see bearssl_ssl.h)" : "TLS error (see bearssl_ssl.h)";
}

