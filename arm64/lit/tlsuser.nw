\section{\texttt{userland/sntp.c}}
\label{src:userland:sntp.c}

The program asks a time server and, if root says so, sets the clock. Without arguments it only shows the time that the system has and
where it got it from.

\begin{quote}\begin{verbatim}
    sntp                        the clock of the system and its source
    sntp pool.ntp.org           ask this server and show its time
    sntp -s pool.ntp.org        ask it and set the clock (root only)
    sntp -s 10.0.2.2:12300      a server on another port (the tests use this)
\end{verbatim}\end{quote}

The program does not choose a server by itself: the Raspberry Pi has no battery clock, so the line
[[sntp -s pool.ntp.org]] belongs into the start-up of every machine without one. The program [[https]] (below) asks a time server
on its own when it finds the clock unset, but it only uses the answer for its own checks and does not set the clock.

<<userland/sntp.c>>=
#include "../ulixlib.h"
#include "../arm64-extra.h"

static char *source_name (int source) { return source == 1 ? "hardware clock" : source == 2 ? "set by sntp" : "not set (a guess)"; }

static void show (unsigned t) {
  int y, mo, d, h, mi, s;
  civil_time (t, &y, &mo, &d, &h, &mi, &s);
  printf ("%d-%02d-%02d %02d:%02d:%02d UTC", y, mo, d, h, mi, s);
}

int main (int argc, char *argv[]) {
  int set = 0, i = 1;
  if (i < argc && strcmp (argv[i], "-s") == 0) { set = 1;  i++; }
  struct time_info t;
  time_info (&t);
  if (i >= argc) {
    printf ("clock: ");  show (t.seconds);  printf (" (%s)\n", source_name (t.source));
    return 0;
  }
  struct sntp_args a;
  a.port = split_port (argv[i], 123);
  if (resolve_host (argv[i], &a.server) != 0) { printf ("sntp: cannot find %s\n", argv[i]);  return 1; }
  a.timeout_ms = 7000;
  if (sntp (&a) != 0) { printf ("sntp: no (usable) answer from %s\n", argv[i]);  return 1; }
  printf ("%s says ", argv[i]);  show (a.seconds);  printf ("\n");
  if (set) {
    if (time_set (a.seconds) != 0) { printf ("sntp: only root can set the clock\n");  return 1; }
    printf ("clock set\n");
  }
  return 0;
}

