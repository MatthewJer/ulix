\subsection{the program}

Order of the steps as in the list above. [[fail]] says what is wrong and ends the program with status 1.

<<userland/https.c: main>>=
static int fail (char *message) { printf ("https: %s\n", message);  return 1; }

static int say_error (int err) { printf ("https: %s (error %d)\n", tls_error_text (err), err);  return 1; }

int main (int argc, char *argv[]) {
  int verbose = 0, headers = 0, i = 1;
  char *ca_file = DEFAULT_CA_FILE, *name = 0, *time_server = DEFAULT_TIME_SERVER;
  for (; i < argc && argv[i][0] == '-'; i++) {
    if (strcmp (argv[i], "-v") == 0) verbose = 1;
    else if (strcmp (argv[i], "-i") == 0) headers = 1;
    else if (strcmp (argv[i], "-c") == 0 && i + 1 < argc) ca_file = argv[++i];
    else if (strcmp (argv[i], "-n") == 0 && i + 1 < argc) name = argv[++i];
    else if (strcmp (argv[i], "-t") == 0 && i + 1 < argc) time_server = argv[++i];
    else i = argc;
  }
  if (i != argc - 1 || strncmp (argv[i], "https://", 8) != 0) {
    printf ("usage: https [-i] [-v] [-c cafile] [-n name] [-t timeserver] https://host[:port]/path\n");
    return 1;
  }

  // 1. is TLS switched on?
  if (!rc_enabled ("tls_enable", 1)) return fail ("TLS is disabled (tls_enable=\"NO\" in /etc/rc.conf)");

  // the URL: host, port and path
  char *host = argv[i] + 8, *slash = host;
  static char path[512];
  strcpy (path, "/");
  while (*slash && *slash != '/') slash++;
  if (*slash) { strncpy (path, slash, 511);  path[511] = 0;  *slash = 0; }
  int port = split_port (host, 443);
  if (!name) name = host;

  // 2. random numbers: the seed of BearSSL's generator
  unsigned char seed[32];
  if (getrandom (seed, sizeof seed) != sizeof seed) return fail ("this machine has no source of random numbers (qemu: -device virtio-rng-device)");

  // 3. the time
  struct time_info now;
  time_info (&now);
  if (now.source == 0) {
    struct sntp_args a;
    a.port = split_port (time_server, 123);
    a.timeout_ms = 7000;
    if (resolve_host (time_server, &a.server) != 0 || sntp (&a) != 0)
      return fail ("the clock is not set and no time server answers; the validity of certificates cannot be checked (see sntp)");
    now.seconds = a.seconds;
    if (verbose) printf ("the clock is not set: using the time of %s\n", time_server);
  }

  // 4. the certificate authorities
  ca_fd = open (ca_file, O_RDONLY);
  int count = ca_fd < 0 ? -1 : tls_load_anchors (read_ca_file);
  if (ca_fd >= 0) close (ca_fd);
  if (count < 0) { printf ("https: cannot read the certificate authorities from %s\n", ca_file);  return 1; }
  if (verbose) printf ("%d certificate authorities from %s\n", count, ca_file);

  // 5. name and connection
  struct tcp_connect_args c;
  if (resolve_host (host, &c.ip) != 0) { printf ("https: cannot find %s\n", host);  return 1; }
  c.port = port;  c.timeout_ms = 10000;
  sock = tcp_connect (&c);
  if (sock < 0) { printf ("https: cannot connect to %s port %d\n", host, port);  return 1; }

  // 6. the TLS engine
  if (tls_start (name, now.seconds, seed, low_read, low_write) != 0) { tcp_close (sock);  return fail ("cannot start TLS"); }

  // 7. the request; the handshake happens inside the first write
  static char request[1024];
  sprintf (request, "GET %s HTTP/1.0\r\nHost: %s\r\nUser-Agent: ulix-https\r\nAccept: */*\r\n\r\n", path, name);
  if (tls_write (request, strlen (request)) < 0) {
    int r = say_error (tls_error ());
    tcp_close (sock);
    return r;
  }
  if (verbose) {
    int version, suite;
    tls_session (&version, &suite);
    printf ("TLS %d.%d, cipher suite 0x%04x, certificate for %s checked\n", (version >> 8) - 2, (version & 255) - 1, suite, name);
  }

  // the answer: the header ends at the first empty line; the status code is in the first line
  static char head[4096], body[2048];
  int head_len = 0, in_body = 0, status = 0, n;
  while ((n = tls_read (body, sizeof body)) > 0) {
    int off = 0;
    while (!in_body && off < n) {
      if (head_len < (int)sizeof head - 1) head[head_len++] = body[off];
      off++;
      if (head_len >= 4 && head[head_len - 4] == '\r' && head[head_len - 3] == '\n' && head[head_len - 2] == '\r' && head[head_len - 1] == '\n') {
        in_body = 1;
        head[head_len] = 0;
        if (head_len > 12 && strncmp (head, "HTTP/1.", 7) == 0) status = atoi (head + 9);
        if (headers) write (1, head, head_len);
      }
    }
    if (in_body && off < n) write (1, body + off, n - off);
  }
  // the server closes the connection when it is done; many servers do not send the TLS close_notify first (the library then
  // reports an I/O error, code 31), so that is no error here
  int err = tls_error ();
  tls_close ();
  tcp_close (sock);
  if (err != 0 && err != 31) return say_error (err);
  if (!in_body) return fail ("no (complete) answer from the server");
  if (status < 200 || status > 299) { printf ("https: the server answered %d\n", status);  return 1; }
  return 0;
}

