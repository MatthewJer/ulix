% This file continues the chapter on TLS (tls.nw): the part that runs in user space.
\section{What programs get: the system calls in \texttt{userland/arm64-extra.h}}
\label{src:tls:extra.h}

The wrappers are added to the header that the network programs already use ([[arm64-extra.h]] includes this chunk). The system call
numbers are those of the table above; structures are passed by address.

<<userland/arm64-extra.h: tls>>=
// random numbers, the time of day, TCP sockets and rc.conf (random.c, sntp.c, net_syscalls.c)
#define __NR_getrandom    615
#define __NR_time_info    616
#define __NR_time_set     617
#define __NR_sntp         618
#define __NR_tcp_connect  619
#define __NR_tcp_send     622
#define __NR_tcp_recv     623
#define __NR_tcp_close    624
#define __NR_rc_enabled   625
struct time_info { unsigned seconds; int source; };                 // source: 0 = a guess (the Pi after the boot), 1 = hardware clock, 2 = set
struct sntp_args { unsigned server; int port, timeout_ms; unsigned seconds; };
struct tcp_connect_args { unsigned ip; int port, timeout_ms; };
struct tcp_msg { int handle; unsigned char *buf; int len; int timeout_ms; };
struct rc_args { char name[48]; int fallback; };
static inline int getrandom (void *buf, int n)          { return syscall3 (__NR_getrandom, (int)(long)buf, n); }          // n, or -1: no generator
static inline int time_info (struct time_info *t)       { return syscall2 (__NR_time_info, (int)(long)t); }
static inline int time_set (unsigned seconds)           { return syscall2 (__NR_time_set, (int)seconds); }                  // -2: only root
static inline int sntp (struct sntp_args *a)            { return syscall2 (__NR_sntp, (int)(long)a); }                      // 0 = ok, -1 no answer
static inline int tcp_connect (struct tcp_connect_args *a) { return syscall2 (__NR_tcp_connect, (int)(long)a); }          // a socket, -1 no room, -2 no connection
static inline int tcp_send (struct tcp_msg *m)          { return syscall2 (__NR_tcp_send, (int)(long)m); }                  // bytes sent, -1 broken
static inline int tcp_recv (struct tcp_msg *m)          { return syscall2 (__NR_tcp_recv, (int)(long)m); }                  // bytes, 0 = time over, -1 = closed
static inline int tcp_close (int handle)                { return syscall2 (__NR_tcp_close, handle); }
static inline int rc_enabled (char *name, int fallback) {          // is name="YES" in /etc/rc.conf? (fallback: if the line is missing)
  struct rc_args a;  int i = 0;
  while (name[i] && i < 47) { a.name[i] = name[i];  i++; }
  a.name[i] = 0;  a.fallback = fallback;
  return syscall2 (__NR_rc_enabled, (int)(long)&a);
}

// "host:port" -> the host and the port (the default if there is no colon); the colon is replaced by a zero
static inline int split_port (char *s, int port) {
  for (; *s; s++) if (*s == ':') { *s = 0;  port = 0;  for (s++; *s >= '0' && *s <= '9'; s++) port = port * 10 + (*s - '0');  break; }
  return port;
}

// Unix seconds -> date and time (the days are counted from 1 March of the year 0, as civil_from_days of H. Hinnant does it)
static inline void civil_time (unsigned t, int *year, int *month, int *day, int *hour, int *minute, int *second) {
  unsigned days = t / 86400, rest = t % 86400;
  unsigned z = days + 719468, era = z / 146097, doe = z - era * 146097;
  unsigned yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365, doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
  unsigned mp = (5 * doy + 2) / 153;
  *day = doy - (153 * mp + 2) / 5 + 1;  *month = mp < 10 ? mp + 3 : mp - 9;
  *year = yoe + era * 400 + (*month <= 2);
  *hour = rest / 3600;  *minute = rest % 3600 / 60;  *second = rest % 60;
}

