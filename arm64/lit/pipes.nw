\section{The test program}

The program \texttt{pipetest} (started by the kernel tests as \texttt{/pipetest64}) checks the four rules and the two system calls with real
processes. It ends with the number of failed checks as its exit status.

<<user/pipetest.c>>=
#include "ulib.h"

static int fails = 0;
#define CHECK(c, msg) do { if (c) printf ("  user ok:   %s\n", msg); \
                           else { printf ("  user FAIL: %s\n", msg); fails++; } } while (0)
#define SIGPIPE 13

static int same (const char *a, const char *b, int n) { for (int i = 0; i < n; i++) if (a[i] != b[i]) return 0; return 1; }
static void wait_a_while (void) { for (int i = 0; i < 30; i++) yield (); }

static char big[20000];

int main (int argc, char **argv) {
  int fds[2], status = -1;
  char buf[64];

  // 1. one process: what goes in comes out, in the same order
  CHECK (pipe (fds) == 0 && fds[0] != fds[1], "pipe () gives two descriptors");
  CHECK (write (fds[1], "hello", 5) == 5, "write 5 bytes");
  CHECK (read (fds[0], buf, 64) == 5 && same (buf, "hello", 5), "read gives the same 5 bytes");
  CHECK (read (fds[1], buf, 4) == -1 && write (fds[0], "x", 1) == -1, "reading the write end and writing the read end are errors");
  close (fds[0]);  close (fds[1]);

  // 2. a reader on an empty pipe sleeps until the writer has something (the child waits, so the parent is the first at the pipe)
  pipe (fds);
  int pid = fork ();
  if (pid == 0) {
    close (fds[0]);
    wait_a_while ();
    write (fds[1], "from the child", 14);
    exit (0);                                    // ends without closing: the kernel closes the write end
  }
  close (fds[1]);
  int n = read (fds[0], buf, 64);
  CHECK (n == 14 && same (buf, "from the child", 14), "the reader slept until the child wrote, then got its 14 bytes");
  CHECK (read (fds[0], buf, 64) == 0, "when the child has ended, read returns 0 (end of file)");
  waitpid (pid, &status, 0);
  close (fds[0]);

  // 3. more than fits into the pipe: the writer sleeps while it is full (20000 > 4096 bytes), the order stays
  for (int i = 0; i < 20000; i++) big[i] = (char)(i * 7 + (i >> 8));
  pipe (fds);
  pid = fork ();
  if (pid == 0) {
    close (fds[0]);
    int sent = 0;
    while (sent < 20000) { int k = write (fds[1], big + sent, 20000 - sent); if (k <= 0) exit (1); sent += k; }
    exit (0);
  }
  close (fds[1]);
  int total = 0, good = 1, k;
  while ((k = read (fds[0], buf, 64)) > 0) {
    for (int i = 0; i < k; i++) if (buf[i] != big[total + i]) good = 0;
    total += k;
  }
  waitpid (pid, &status, 0);
  CHECK (total == 20000 && good, "20000 bytes pass through a 4096 byte pipe, complete and in order");
  CHECK (status == 0, "the writer sent everything and ended normally");
  close (fds[0]);

  // 4. dup2: the child's standard output is the pipe, and so is what printf writes there
  pipe (fds);
  pid = fork ();
  if (pid == 0) {
    close (fds[0]);
    if (dup2 (fds[1], 1) != 1) exit (7);
    close (fds[1]);
    printf ("via stdout");
    exit (0);
  }
  close (fds[1]);
  n = read (fds[0], buf, 64);
  waitpid (pid, &status, 0);
  CHECK (n == 10 && same (buf, "via stdout", 10) && status == 0, "dup2 (pipe, 1): what the child printed arrived through the pipe");
  close (fds[0]);

  // 5. a write without a reader: SIGPIPE ends the writer (it never gets to exit (5)); with SIGPIPE ignored it is an error
  pipe (fds);
  close (fds[0]);
  signal (SIGPIPE, SIG_IGN);
  CHECK (write (fds[1], "x", 1) == -1, "write on a pipe without reader fails when SIGPIPE is ignored");
  signal (SIGPIPE, SIG_DFL);
  pid = fork ();
  if (pid == 0) { write (fds[1], "x", 1); exit (5); }
  close (fds[1]);
  waitpid (pid, &status, 0);
  CHECK (status != 5, "write on a pipe without reader ends a process that does not ignore SIGPIPE");

  // 6. a reader that sleeps in a pipe can be killed, and its end is closed (then the pipe has no reader: write fails)
  pipe (fds);
  pid = fork ();
  if (pid == 0) { close (fds[1]); read (fds[0], buf, 64); exit (0); }
  close (fds[0]);
  wait_a_while ();                               // the child sleeps in read
  kill (pid, SIGKILL);
  waitpid (pid, &status, 0);
  signal (SIGPIPE, SIG_IGN);
  CHECK (write (fds[1], "x", 1) == -1, "after kill -9 of the sleeping reader its end is closed (the write fails)");
  close (fds[1]);

  // 7. nothing leaked: 40 pipes are made one after another, also with sleepers killed (the table has only 16 entries)
  int made = 0;
  for (int i = 0; i < 40; i++) {
    int f[2];
    if (pipe (f) != 0) break;
    if (i % 2) {
      int p = fork ();
      if (p == 0) { close (f[1]); read (f[0], buf, 64); exit (0); }
      wait_a_while ();
      kill (p, SIGKILL);
      waitpid (p, &status, 0);
    }
    close (f[0]);  close (f[1]);
    made++;
  }
  CHECK (made == 40, "40 pipes in a row (killed sleepers and ended processes leaked nothing)");
  return fails;
}
@
