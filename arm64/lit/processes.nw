@
---- block devices: the book's [[readblock()]] calls these two for /dev/hda, /dev/hdb ----
A block is 1 KByte = 2 sectors of 512 bytes ([[HD_SECSIZE]]).  The disks are the virtio disks (up to two).
Like the IDE driver of the book, a process that reads or writes a block takes [[hd_lock]], starts the transfer and goes
to sleep in [[harddisk_queue]]; the interrupt of the device wakes it up ([[hd_interrupt]]).  Without a running scheduler,
for the idle thread (the tests, the boot code) and without a known interrupt the driver polls instead.

The idle thread (thread 1) also runs file system code, at the boot: it starts the first program, and it does so while the network
thread may already be writing its log. Thread 1 must not sleep: if it sat in a blocked queue and the other threads did, too (the
network thread waiting for the disk), no thread would be ready, and the scheduler has nothing to run. So every lock of the book
([[mutex_lock]]: the disk, the buffer cache, \ldots) is taken by thread 1 without sleeping: it tries, and gives the CPU away while the
lock is taken. For this the Makefile renames the book's [[mutex_lock]] to [[book_mutex_lock]] (as it does for [[scheduler]]
and [[u_kill]]), and the wrapper below has the book's name. Before, thread 1 did not take the disk lock at all, and so it could
start a disk request while the request of the network thread was on its way: the answer landed in the wrong buffer (wrong blocks, a crash
in the file system) in about half of the boots with a log, and later, with the lock but without this wrapper, thread 1 slept on the lock of the
buffer cache and the boot hung.

<<glue.c: blk_disks>>=
extern int  blk_submit_n (int n, int type, unsigned long sector, void *buf, unsigned nsectors);
extern int  blk_done_n (int n);
extern int  blk_finish_n (int n);
extern int  blk_disks;
extern unsigned long blk_capacity_of (int n);
extern void blk_irq_ack (void);
extern int  blk_irq, blk_irq_wait;
extern unsigned long blk_capacity (void);
void arch_resign (void);

int hd_sleeps = 0, hd_interrupts = 0;        // statistics, checked by the tests
int hd_requests = 0, hd_sectors = 0;         // requests started and sectors moved (the test of the multi-block read counts them)

extern void book_mutex_lock (lock lockvar);       // the book's mutex_lock (the Makefile renames it)
extern boolean mutex_try_lock (lock lockvar);

void arch_idle (void);                            // smp.c: wait for an interrupt (interrupts are enabled meanwhile)

void mutex_lock (lock lockvar) {                  // the wrapper has the book's name
  if (current_task != 1) { book_mutex_lock (lockvar); return; }
  while (!mutex_try_lock (lockvar)) {              // thread 1 must not sleep: it asks again and again
    arch_resign ();                                // (other threads may run: the holder of the lock, perhaps)
    arch_idle ();                                  // and if nobody can run, the holder waits for the interrupt of the disk: let it in
  }
}

static int hd_transfer (int hd, int type, int blockno, char *buffer, int blocks) {
  int sleep_ok = scheduler_is_active && blk_irq && current_task > 1;       // (thread 1 is the idle thread and must not sleep)
  if (hd_lock == NULL) hd_lock = get_new_lock ("hd");
  mutex_lock (hd_lock);
    hd_direction = (type == 0) ? HD_OP_READ : HD_OP_WRITE;
    blk_irq_wait = sleep_ok;                                      // (an SD card is told how it is waited for)
    hd_requests++;  hd_sectors += 2 * blocks;
    int r = blk_submit_n (hd, type, (unsigned long)blockno * 2, buffer, 2 * blocks);
    if (r == 0) {
      while (!blk_done_n (hd)) {
        if (sleep_ok) { hd_sleeps++; block (&harddisk_queue, TSTATE_WAITHD); arch_resign (); }
      }
      r = blk_finish_n (hd);
    }
    hd_direction = HD_OP_NONE;
  mutex_unlock (hd_lock);
  return r;
}

void readblock_hd (int hd, int blockno, char *buffer) {
  if (hd < 0 || hd >= blk_disks) return;
  hd_transfer (hd, 0, blockno, buffer, 1);
}

void writeblock_hd (int hd, int blockno, char *buffer) {
  if (hd < 0 || hd >= blk_disks) return;
  hd_transfer (hd, 1, blockno, buffer, 1);
}

@
---- many blocks with one request (section ``Reading many blocks with one request'' of the chapter on disks) ----
[[readblocks]] reads [[count]] consecutive blocks of a disk into [[dest]]. The device is asked once ([[hd_transfer]] with
[[count]] blocks: one request, one interrupt, one wake-up of the sleeping process), and the copy goes to a buffer of the
kernel, [[run_buffer]], first: the destination may be a buffer of a user program (its addresses are not the physical
ones the device needs) or a stack, and the device moves its data to {\em physically contiguous} memory only. One buffer
for everybody means that a lock must protect it ([[run_lock]]): the reader sleeps on the disk interrupt, and another
thread that starts a program must not fill the buffer meanwhile (the same bug that once hit the static buffers of the
Minix reader, see section 30 of ARM64-PORT.md).

The buffer cache of the book is bypassed on the way in (a 7 MByte program would push everything else out of its 512 blocks),
but not on the way out: a block that the cache holds may be newer than the disk (a file that was written but not
synced), so every block that [[buffer_contains]] finds is taken from the cache after the transfer.

If the big request fails (the device refuses it), the blocks are read one at a time with [[readblock]], the way
they always were: slower, and correct.

<<glue.c: readblocks>>=
#define RUN_BLOCKS 64                              // at most 64 KByte per request
static char run_buffer[RUN_BLOCKS * BLOCK_SIZE] __attribute__ ((aligned (64)));
static lock run_lock;

int readblocks (int device, int first, int count, char *dest) {
  int r = -1;
  if (count < 1 || count > RUN_BLOCKS) return -1;
  if (devmajor (device) == MAJOR_HD && devminor (device) / 64 < blk_disks) {
    if (run_lock == NULL) run_lock = get_new_lock ("run buffer");
    mutex_lock (run_lock);
      r = hd_transfer (devminor (device) / 64, 0, first, run_buffer, count);
      if (r == 0) {
        memcpy (dest, run_buffer, count * BLOCK_SIZE);
        for (int i = 0; i < count; i++)            // newer than the disk: blocks that the cache holds
          if (buffer_contains (device, first + i)) buffer_read (device, first + i, dest + i * BLOCK_SIZE);
      }
    mutex_unlock (run_lock);
  }
  if (r != 0) {                                    // not a disk, or the request failed: block by block
    for (int i = 0; i < count; i++) readblock (device, first + i, dest + i * BLOCK_SIZE);
    r = 0;
  }
  return r;
}


