@
\subsection{fork}

<<arch_thread.c: u_fork>>=
int arch_threads_reap (void);
int u_fork (context_t *r) {
  arch_threads_reap ();                   // free the kernel stacks of processes that have ended
  thread_id old_tid = current_task;
  addr_space_id old_as = current_as;

  int new_as = as_alloc ();
  if (new_as == -1) return -1;
  u64 nl0 = new_user_l0 ();
  if (!nl0) { destroy_address_space (new_as); return -1; }
  as_l0[new_as] = nl0;
  arch_evict_protect (old_as);                           // (see arch_swap.c)
  int cloned = clone_level (as_l0[old_as], nl0, 0, 0);
  arch_evict_protect (0);
  __asm__ volatile ("dsb ishst; tlbi vmalle1is; dsb ish; isb" ::: "memory");   // the parent's pages are read-only now (on all CPUs)
  if (cloned < 0) { destroy_address_space (new_as); return -1; }
  address_spaces[new_as].stacksize = address_spaces[old_as].stacksize;     // (the stack may have grown)
  address_spaces[new_as].memstart = address_spaces[old_as].memstart;
  address_spaces[new_as].memend   = address_spaces[old_as].memend;

  thread_id new_tid = register_new_tcb (new_as);
  if (new_tid == -1) { destroy_address_space (new_as); return -1; }

  TCB *t_old = &thread_table[old_tid];
  TCB *t_new = &thread_table[new_tid];
  *t_new = *t_old;                        // copy the complete TCB, then fix it up (like the book)
  t_new->used       = true;
  t_new->state      = TSTATE_FORK;
  t_new->tid        = new_tid;
  t_new->addr_space = new_as;
  t_new->pid        = new_tid;
  t_new->ppid       = old_tid;
  for (int pfd = 0; pfd < MAX_PFD; pfd++) {
    int gfd = t_old->files[pfd];
    t_new->files[pfd] = (gfd >= 0) ? u_reopen (gfd) : gfd;
  }

  context_t child = *r;                   // the child continues exactly where the parent is ...
  child.eax = 0;                         // ... but fork() returns 0 there
  if (kstack_for_process (new_tid, &child, 1) != 0) {      // no kernel stack for the child
    thread_table[new_tid].used = false;
    destroy_address_space (new_as);
    return -1;
  }
  linux_abi_fork (old_as, new_as);                       // the child speaks the same system call interface
  kctx_user_state_copy_live (&kctx[new_tid]);            // and starts with the thread pointer and FP registers of the parent
  add_to_ready_queue (new_tid);           // state becomes READY
  return new_tid;                       // in the parent, fork() returns the child's PID
}

@
---- exec: load a new program into a fresh address space and switch to it ----
A process that waits for the disk (see [[glue.c]]) lets others run in the middle of loading a program.  The loader
([[u_execv]], [[elf_load]] and the Minix reader) uses static buffers, so only one process may load a program at a time.

<<arch_thread.c: exec_lock>>=
static lock exec_lock = NULL;
static int exec_locked_enter (void) {
  if (current_task <= 1) return 0;                    // the idle thread never waits
  if (!exec_lock) exec_lock = get_new_lock ("exec");
  mutex_lock (exec_lock);
  return 1;
}
static void exec_locked_leave (int locked) { if (locked) mutex_unlock (exec_lock); }

static int u_execv_loading (char *filename, char *const argv[], memaddress *newstack);
int u_execv (char *filename, char *const argv[], memaddress *newstack) {
  int l = exec_locked_enter ();
  int r = u_execv_loading (filename, argv, newstack);
  exec_locked_leave (l);
  return r;
}

static int u_execv_loading (char *filename, char *const argv[], memaddress *newstack) {
  static char kargs[2048];
  char *kargv[16];
  int argc = 0, pos = 0;
  for (; argv && argv[argc] && argc < 15; argc++) {      // argv lives in the old address space
    int len = strlen (argv[argc]) + 1;
    if (pos + len > (int)sizeof kargs) return -1;
    memcpy (kargs + pos, argv[argc], len);
    kargv[argc] = kargs + pos;
    pos += len;
  }
  unsigned ino = minix_lookup (filename);
  if (!ino || !minix_is_file (ino)) return -1;

  u64 nl0 = new_user_l0 (), entry, image_end;
  if (!nl0) return -1;
  if (elf_load (nl0, ino, &entry, &image_end) != 0) { free_user_space (nl0); return -1; }
  u64 sp = build_user_stack (nl0, argc, kargv, elf_linux);
  if (!sp) { free_user_space (nl0); return -1; }

  arch_swap_wait_evicting (current_as);                  // (the swapper may be writing a page of the old program: its tables must stay until it is done)
  u64 old = as_l0[current_as];                           // from here on there is no way back
  as_l0[current_as] = nl0;
  linux_abi_as[current_as] = elf_linux;                  // the new program may speak the other system call interface
  address_spaces[current_as].stacksize = USER_STACK_PAGES * PAGE;       // a new program starts with a small stack
  address_spaces[current_as].memstart = 0x400000;
  address_spaces[current_as].memend   = image_end;      // the program break starts behind the image
  if (address_spaces[current_as].refcount > 1) smp_stop_others ();   // threads of this program on other CPUs must leave user mode first
  arch_swap_release_as (current_as);                     // the old program's pages in the swap file
  asid_flush (current_as);                               // entries of the old program must not survive
  arch_activate_as (current_as);
  free_user_space (old);
  *newstack = sp;
  return (int)entry;
}

@
\subsection{start a first process from a file (the kernel plays the role of its parent)}

<<arch_thread.c: arch_start_user>>=
static int arch_start_user_loading (const char *path, int argc, char **argv);
int arch_start_user (const char *path, int argc, char **argv) {
  int l = exec_locked_enter ();
  int r = arch_start_user_loading (path, argc, argv);
  exec_locked_leave (l);
  return r;
}

static int arch_start_user_loading (const char *path, int argc, char **argv) {
  unsigned ino = minix_lookup (path);
  if (!ino || !minix_is_file (ino)) { printf ("exec: %s: no such file\n", path); return -1; }
  int as = as_alloc ();
  if (as == -1) return -1;
  u64 l0 = new_user_l0 (), entry, image_end = 0;
  if (!l0) { destroy_address_space (as); return -1; }
  as_l0[as] = l0;
  u64 sp = 0;
  if (elf_load (l0, ino, &entry, &image_end) == 0) sp = build_user_stack (l0, argc, argv, elf_linux);
  address_spaces[as].memstart = 0x400000;
  address_spaces[as].memend   = image_end;
  linux_abi_as[as] = elf_linux;
  if (!sp) { destroy_address_space (as); return -1; }

  thread_id tid = register_new_tcb (as);
  if (tid == -1) { destroy_address_space (as); return -1; }
  tcb_init_process (&thread_table[tid], tid, 1, path + (path[0] == '/'));   // parent: idle, nobody waits
  context_t f;
  memset (&f, 0, sizeof f);
  f.elr = entry;
  f.spsr = 0;                             // EL0t, interrupts enabled
  f.sp_el0 = sp;
  if (kstack_for_process (tid, &f, 1) != 0) { thread_table[tid].used = false; destroy_address_space (as); return -1; }
  u64 flags = irq_save ();
  add_to_ready_queue (tid);
  irq_restore (flags);
  return tid;
}

@
=====================================================================================
POSIX threads: several threads in one address space
A thread is a TCB with its own kernel stack and user stack that shares the address space (same
TTBR0 table and ASID, [[address_spaces]][].refcount counts the threads) and the file table of the
process (its 'pid' is the TID of the main thread; for the main thread pid == tid).  The user stack
is taken from the heap ([[u_sbrk]]), like in the book.  Everything else follows the book, too: the address
space lives until its last thread has gone ([[exit()]] of the main thread does not stop the others).
=====================================================================================

<<arch_thread.c: THREAD_STACK_PAGES>>=
#define THREAD_STACK_PAGES 4

int arch_pthread_create (u64 start) {
  arch_threads_reap ();
  TCB *to = &thread_table[current_task];
  addr_space_id as = current_as;
  void *ustack = u_sbrk (THREAD_STACK_PAGES * PAGE);
  if (ustack == (void *)-1) return -1;
  thread_id nt = register_new_tcb (as);
  if (nt == -1) return -1;
  TCB *tn = &thread_table[nt];
  *tn = *to;                                   // like the book: copy the TCB, then fix it up
  tn->used = true;
  tn->state = TSTATE_FORK;
  tn->tid = nt;
  tn->addr_space = as;
  tn->pid = to->pid;                           // same process
  tn->ppid = to->ppid;
  tn->sig_pending = 0;
  context_t f;
  memset (&f, 0, sizeof f);
  f.elr = start;
  f.spsr = 0;                                  // EL0t
  f.sp_el0 = ((u64)ustack + THREAD_STACK_PAGES * PAGE) & ~15UL;
  if (kstack_for_process (nt, &f, 0) != 0) { tn->used = false; return -1; }
  address_spaces[as].refcount++;
  add_to_ready_queue (nt);
  return nt;
}

void arch_syscall_pthread_create (context_t *r) { r->eax = arch_pthread_create (r->ebx); }

@
as in the book: the last thread of a process ends it like [[exit()]], any other one just disappears

<<arch_thread.c: arch_syscall_pthread_exit>>=
void arch_syscall_pthread_exit (context_t *r) {
  if (address_spaces[current_as].refcount == 1) {
    r->ebx = 0;
    syscall_exit (r);
    return;
  }
  TCB *t = &thread_table[current_task];
  remove_from_ready_queue (current_task);
  t->state = TSTATE_EXIT;
  address_spaces[current_as].refcount--;
  if (address_spaces[current_as].pid == current_task) address_spaces[current_as].pid = -1;   // see arch_threads_reap
  t->used = false;                             // the kernel stack is freed by arch_threads_reap
  scheduler (r, SCHED_SRC_RESIGN);
}

@
\subsection{Threads for programs that use musl: \texttt{clone}, thread exit, \texttt{exit\_group}}
\label{sec:linux-threads}

musl's \texttt{pthread\_create} makes a thread with \texttt{clone (CLONE\_VM | CLONE\_FS | CLONE\_FILES | CLONE\_SIGHAND | CLONE\_THREAD | CLONE\_SETTLS |
CLONE\_PARENT\_SETTID | CLONE\_CHILD\_CLEARTID, stack, \&tid, tls, \&lock)}. For the kernel that is the same thing as the book's
\texttt{pthread\_create} above (a thread control block of its own, a kernel stack of its own, the address space and the descriptors of
the process), with three differences: the new thread starts \emph{in the middle of the system call}, with the registers of its creator
(musl's \texttt{\_\_clone} continues there with a function and an argument that it put on the new stack), only \texttt{x0} is $0$ and the
stack pointer is the one that was given; its thread pointer (\texttt{tpidr\_el0}, where musl keeps \texttt{errno} and the other
thread-local data) is the \texttt{tls} argument; and the kernel has to remember an address, \texttt{clear\_tid}: when the thread ends, the
kernel writes $0$ there and wakes everybody who waits on it (a \texttt{futex}, see \texttt{linux\_abi.c}). \texttt{pthread\_join} and the lock of
the list of threads work through that word. \texttt{set\_tid\_address} sets the same word for the thread that calls it.

<<arch_thread.c: linux threads>>=
extern void futex_wake_address (u64 addr, int n);                  // linux_abi.c
extern void bkl_set_depth (int d);
extern void bkl_lock (void);

// A thread that waits in a loop (nanosleep, futex) calls arch_resign () to let the others run. With several CPUs that is not enough:
// when no other thread is ready on this CPU, the loop would keep the big kernel lock for ever and a thread on the other CPU could
// never enter the kernel to wake it. So the lock is given up for a moment, as the idle loop does.
//
// \emph{Interrupts are let in as well.} Kernel code runs with interrupts masked, and the device interrupts (the disk, the network
// card) are all routed to CPU 0. A thread that waits in a loop on CPU 0 and finds nobody else to run (the other threads wait for the
// disk) would keep every interrupt away from the only CPU that gets it: the disk request never completes, and the thread that waits
// for it never wakes. That is a real hang, found with a TLS handshake between two threads (one spun in \texttt{local\_recv},
// the other waited for a page of a file). So the window in which the lock is free is also a window in which an interrupt can come in;
// the interrupt code takes the lock for itself.
void arch_poll_pause (void) {
  int d = bkl_depth ();
  u64 flags = irq_save ();
  bkl_set_depth (1);
  bkl_unlock ();
  __asm__ volatile ("msr daifclr, #2");
  for (int i = 0; i < 200; i++) __asm__ volatile ("yield");
  __asm__ volatile ("msr daifset, #2");
  bkl_lock ();
  bkl_set_depth (d);
  irq_restore (flags);
}
static u64 clear_tid[MAX_THREADS];                                 // the word that the kernel clears when the thread ends (0: none)
static int as_dying[MAX_ADDR_SPACES], as_exit_code[MAX_ADDR_SPACES];     // exit_group is under way in this address space

void arch_set_clear_tid (thread_id t, u64 addr) { clear_tid[t] = addr; }

int arch_clone_thread (context_t *r, u64 stack, u64 tls, int set_tls) {
  arch_threads_reap ();
  TCB *to = &thread_table[current_task];
  addr_space_id as = current_as;
  thread_id nt = register_new_tcb (as);
  if (nt == -1) return -1;
  TCB *tn = &thread_table[nt];
  *tn = *to;                                   // like the book: copy the TCB, then fix it up
  tn->used = true;
  tn->state = TSTATE_FORK;
  tn->tid = nt;
  tn->addr_space = as;
  tn->pid = to->pid;                           // same process: it shares the descriptors
  tn->ppid = to->ppid;
  tn->sig_pending = 0;
  context_t f = *r;                            // the new thread continues exactly where its creator is ...
  f.eax = 0;                                   // ... and clone () returns 0 there
  f.sp_el0 = stack;
  if (kstack_for_process (nt, &f, 0) != 0) { tn->used = false; return -1; }
  kctx_user_state_copy_live (&kctx[nt]);       // the FP registers of the creator; the thread pointer is the one that was asked for
  if (set_tls) kctx[nt].tpidr = tls;
  clear_tid[nt] = 0;
  address_spaces[as].refcount++;
  add_to_ready_queue (nt);
  return nt;
}

@
\paragraph{Ending.} \texttt{exit} of a thread (not the last one) writes $0$ to its \texttt{clear\_tid} word, wakes the futex and goes away
like \texttt{pthread\_exit} of the book. \texttt{exit\_group} ends the whole process: the caller marks the address space as dying and
leaves; every other thread notices the mark when it returns to user mode (the same place where signals are delivered) and ends itself.
The main thread is the last one to go: it waits until it is alone (at most two seconds; a thread that sleeps in a pipe or a file never
returns to user mode, so after that it is killed like a process), then it ends the process with the exit status, so that the parent's
\texttt{waitpid} finds it where it expects it. \texttt{exit} of the main thread, while other threads run, is treated like
\texttt{exit\_group} (POSIX lets the others go on; no program of this system needs that).

<<arch_thread.c: linux threads>>=
extern u64 user_to_phys (u64 va, int write);

static void thread_clear_tid (void) {
  u64 a = clear_tid[current_task];
  clear_tid[current_task] = 0;
  if (a && user_to_phys (a, 1)) { *(int *) a = 0; futex_wake_address (a, 0x7fffffff); }
}

static unsigned long long counter_now (void) { unsigned long long c; __asm__ volatile ("mrs %0, cntpct_el0" : "=r" (c)); return c; }

// the main thread ends the process once the other threads are gone
static void main_thread_ends_process (context_t *r, int code) {
  unsigned long long freq, start = counter_now ();
  __asm__ volatile ("mrs %0, cntfrq_el0" : "=r" (freq));
  while (address_spaces[current_as].refcount > 1 && counter_now () - start < 2 * freq) { arch_resign ();  arch_poll_pause (); }
  if (address_spaces[current_as].refcount > 1)                       // some thread sleeps in the kernel: it has to be killed
    for (thread_id t = 2; t < MAX_THREADS; t++)
      if (t != current_task && thread_table[t].used && thread_table[t].addr_space == current_as) u_kill (t, SIGKILL);
  as_dying[current_as] = 0;
  r->ebx = code;
  syscall_exit (r);                                                  // does not return
}

void arch_linux_exit (context_t *r, int code, int group) {
  TCB *t = &thread_table[current_task];
  if (address_spaces[current_as].refcount <= 1) { r->ebx = code; syscall_exit (r); return; }
  if (group || t->pid == current_task) { as_dying[current_as] = 1; as_exit_code[current_as] = code; }
  if (t->pid == current_task) { main_thread_ends_process (r, code); return; }
  thread_clear_tid ();
  r->ebx = 0;
  arch_syscall_pthread_exit (r);                                     // does not return
}

// called when a thread returns to user mode (arch_signal_check): if another thread called exit_group, this one ends too
void arch_check_dying (context_t *f) {
  if (!as_dying[current_as] || f->elr >= 0x80000000UL) return;
  TCB *t = &thread_table[current_task];
  if (t->pid == current_task) main_thread_ends_process (f, as_exit_code[current_as]);
  thread_clear_tid ();
  f->ebx = 0;
  arch_syscall_pthread_exit (f);
}

int arch_as_dying (void) { return as_dying[current_as]; }        // a thread that waits in the kernel gives up when it is true

@
\subsection{pthread mutexes: the user mutex is the index of a kernel lock (the book stores the pointer in an int)}

<<arch_thread.c: mutex_of>>=
static lock mutex_of (pthread_mutex_t *m) {
  int i = *m;
  if (i < 1 || i >= MAX_LOCKS || !kernel_locks[i].used) return NULL;
  return &kernel_locks[i];
}

void arch_syscall_mutex_init (context_t *r) {
  lock l = get_new_lock ("pthread");
  if (!l) { thread_table[current_task].error = EAGAIN; r->eax = (unsigned long)-1; return; }
  *(pthread_mutex_t *)r->ebx = (pthread_mutex_t)(l - kernel_locks);
  r->eax = 0;
}
void arch_syscall_mutex_lock (context_t *r) {
  lock l = mutex_of ((pthread_mutex_t *)r->ebx);
  if (!l) { thread_table[current_task].error = EINVAL; r->eax = (unsigned long)-1; return; }
  mutex_lock (l);
  r->eax = 0;
}
void arch_syscall_mutex_trylock (context_t *r) {
  lock l = mutex_of ((pthread_mutex_t *)r->ebx);
  if (!l) { thread_table[current_task].error = EINVAL; r->eax = (unsigned long)-1; return; }
  if (mutex_try_lock (l)) r->eax = 0;
  else { thread_table[current_task].error = EBUSY; r->eax = (unsigned long)-1; }
}
void arch_syscall_mutex_unlock (context_t *r) {
  lock l = mutex_of ((pthread_mutex_t *)r->ebx);
  if (!l) { thread_table[current_task].error = EINVAL; r->eax = (unsigned long)-1; return; }
  mutex_unlock (l);
  r->eax = 0;
}
void arch_syscall_mutex_destroy (context_t *r) {
  lock l = mutex_of ((pthread_mutex_t *)r->ebx);
  if (!l) { thread_table[current_task].error = EINVAL; r->eax = (unsigned long)-1; return; }
  l->used = false;
  r->eax = 0;
}

