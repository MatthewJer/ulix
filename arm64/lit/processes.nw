@
---- signals ----
The book's scheduler delivers a signal by pushing the signal number and the old EIP on the user
stack and jumping to the handler; the handler ``returns'' to the interrupted code and all
registers are lost.  Here the whole interrupted register frame is saved on the user stack, the
handler is called like a C function ([[x0]] = signal number) with the link register pointing to a
small trampoline page that calls sigreturn, which restores the frame.

<<arch_thread.c: arch_signal_check>>=
extern u64 user_to_phys (u64 va, int write);

// What is saved on the user stack for a signal: the interrupted registers, the floating point and SIMD registers (a
// handler written for musl uses them, e.g. in memcpy and printf) and, for a program of musl, a small siginfo.
struct sigframe { context_t ctx; u64 fpcr, fpsr, v[64]; u64 siginfo[16]; };

static void fp_save (struct sigframe *sf) {
  __asm__ volatile ("mrs %0, fpcr" : "=r" (sf->fpcr));
  __asm__ volatile ("mrs %0, fpsr" : "=r" (sf->fpsr));
  u64 *v = sf->v;
  __asm__ volatile ("stp q0, q1, [%0, #0]; stp q2, q3, [%0, #32]; stp q4, q5, [%0, #64]; stp q6, q7, [%0, #96]\n"
                    "stp q8, q9, [%0, #128]; stp q10, q11, [%0, #160]; stp q12, q13, [%0, #192]; stp q14, q15, [%0, #224]\n"
                    "stp q16, q17, [%0, #256]; stp q18, q19, [%0, #288]; stp q20, q21, [%0, #320]; stp q22, q23, [%0, #352]\n"
                    "stp q24, q25, [%0, #384]; stp q26, q27, [%0, #416]; stp q28, q29, [%0, #448]; stp q30, q31, [%0, #480]"
                    :: "r" (v) : "memory");
}

static void fp_load (struct sigframe *sf) {
  u64 *v = sf->v;
  __asm__ volatile ("ldp q0, q1, [%0, #0]; ldp q2, q3, [%0, #32]; ldp q4, q5, [%0, #64]; ldp q6, q7, [%0, #96]\n"
                    "ldp q8, q9, [%0, #128]; ldp q10, q11, [%0, #160]; ldp q12, q13, [%0, #192]; ldp q14, q15, [%0, #224]\n"
                    "ldp q16, q17, [%0, #256]; ldp q18, q19, [%0, #288]; ldp q20, q21, [%0, #320]; ldp q22, q23, [%0, #352]\n"
                    "ldp q24, q25, [%0, #384]; ldp q26, q27, [%0, #416]; ldp q28, q29, [%0, #448]; ldp q30, q31, [%0, #480]"
                    :: "r" (v) : "memory");
  __asm__ volatile ("msr fpcr, %0" :: "r" (sf->fpcr));
  __asm__ volatile ("msr fpsr, %0" :: "r" (sf->fpsr));
}

// linux_abi.c: the signal numbers, the mask and the restorer function of a program for musl
extern int linux_signal_number (int signo);
extern u64 linux_signal_restorer (void);

void arch_check_dying (context_t *f);
void arch_signal_check (context_t *f) {
  arch_check_dying (f);                                             // exit_group of another thread
  TCB *t = &thread_table[current_task];
  if (!t->sig_pending || f->elr >= 0x80000000UL) return;            // nothing pending / not in user mode
  for (int signo = 0; signo < 32; signo++) {
    if (!(t->sig_pending & (1UL @<< signo))) continue;
    if (t->sig_blocked & (1U @<< signo)) continue;                  // blocked (sigprocmask): stays pending until unblocked
    t->sig_pending &= ~(1UL @<< signo);
    sighandler_t h = t->sighandlers[signo];
    if (h == SIG_DFL || h == SIG_IGN) return;                       // cannot happen (u_kill filters them)
    u64 sp = (f->sp_el0 - sizeof (struct sigframe)) & ~15UL;
    u64 ret = linux_abi_as[current_as] ? linux_signal_restorer () : SIGPAGE_VA;
    if (!ret || !user_to_phys (sp, 1) || !user_to_phys (sp + sizeof (struct sigframe) - 1, 1)) {
      printf ("[kernel] no room on the stack of process %d for signal %d\n", t->pid, signo);
      f->ebx = (unsigned long)-1;
      syscall_exit (f);                                             // does not return
    }
    struct sigframe *sf = (struct sigframe *)sp;
    sf->ctx = *f;                                                   // save the interrupted state
    fp_save (sf);
    int no = linux_signal_number (signo);                           // (the number the program knows)
    for (int i = 0; i < 16; i++) sf->siginfo[i] = 0;
    sf->siginfo[0] = no;                                            // si_signo; si_code and the rest stay 0
    f->elr    = (u64)h;
    f->eax    = no;                                                 // x0: argument of the handler
    f->x1     = (u64)sf->siginfo;                                   // x1, x2: for handlers of musl with SA_SIGINFO
    f->x2     = 0;
    f->x30    = ret;                                                // the handler returns to the trampoline
    f->sp_el0 = sp;
    return;                                                         // one signal at a time
  }
}

@
sigreturn: the user stack pointer points to the saved frame

<<arch_thread.c: syscall_sigreturn>>=
void syscall_sigreturn (context_t *r) {
  u64 sp = r->sp_el0;
  if ((sp & 15) || !user_to_phys (sp, 0) || !user_to_phys (sp + sizeof (struct sigframe) - 1, 0)) {
    r->ebx = (unsigned long)-1;
    syscall_exit (r);
  }
  struct sigframe *sf = (struct sigframe *)sp;
  context_t saved = sf->ctx;
  fp_load (sf);
  saved.spsr = r->spsr;                                             // the saved state must stay EL0t
  if (saved.elr >= 0x80000000UL) saved.elr = 0, saved.ebx = (unsigned long)-1;
  *r = saved;
}

@
---- the heap: [[sbrk()]] ----
The book's [[u_sbrk()]] works on [[x86]] page tables.  Here the heap starts at the end of the loaded image
([[address_spaces]][].memend) and grows upwards, one fresh frame per page; it cannot shrink.

<<arch_thread.c: u_sbrk>>=
void *u_sbrk (int incr) {
  addr_space_id as = current_as;
  memaddress old = address_spaces[as].memend;
  if (incr == 0) return (void *)old;
  if (incr < 0) return (void *)-1;                       // shrinking is not supported
  memaddress end = old + incr;
  if (end > SIGPAGE_VA - 0x100000UL) return (void *)-1;      // the heap stays below the trampoline page and the stack (which may grow to 64 MByte)
  for (u64 va = (old + PAGE - 1) & ~(PAGE - 1); va < end; va += PAGE) {
    u64 pa = alloc_frame_try ();                         // (swaps a page out if the RAM is full; 0 if nothing helps)
    if (!pa) return (void *)-1;
    if (map_page_in (as_l0[as], va, pa, PAGE_URW) != 0) { free_frame (pa); return (void *)-1; }
    address_spaces[as].memend = va + PAGE;               // (the pages that were mapped stay, as in the book)
  }
  address_spaces[as].memend = end;
  return (void *)old;
}

