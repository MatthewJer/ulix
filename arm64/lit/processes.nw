long dev_size (int dev) {
  if (dev == DEV_HDA) return (long)(blk_capacity_of (0) * 512);
  if (dev == DEV_HDB) return (long)(blk_capacity_of (1) * 512);
  if (dev == DEV_FD1) return (long)(blk_capacity_of (2) * 512);
  return 0;
}

