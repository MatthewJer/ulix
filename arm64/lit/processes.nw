<<elf.c: includes>>=
#include "ulix.h"

struct ehdr {
  u8 ident[16];
  unsigned short type, machine;
  u32 version;
  u64 entry, phoff, shoff;
  u32 flags;
  unsigned short ehsize, phentsize, phnum, shentsize, shnum, shstrndx;
};

struct phdr {
  u32 type, flags;
  u64 offset, vaddr, paddr, filesz, memsz, align;
};

#define PT_LOAD   1
#define PF_X      1
#define PF_W      2
#define EM_AARCH64 183
#define USER_LOAD_MAX (USER_STACK_TOP - 0x10000)       // keep 64 KByte of room for the stack

static int fail (const char *why) { printf ("exec: %s\n", why); return -1; }

@
What the last [[elf_load]] found out for the process start: a program for musl is marked by [[ELFOSABI_LINUX]] in its header (it
speaks the Linux system call interface, see [[linux_abi.c]]); the start code of such a program also wants to know where its
program headers are in memory (the auxiliary vector entry [[AT_PHDR]]).

<<elf.c: what the loader found>>=
#define ELFOSABI_LINUX 3
int elf_linux;                                         // 1: the program uses the Linux system call interface
u64 elf_phdr_va;                                       // address of the program header table in the loaded image (0: unknown)
int elf_phnum;

@
The loader copies a segment page by page into frames that are far apart in memory, so a request of the device cannot go
straight into them. A window of 64 KByte does the job: [[window_read]] hands out the bytes of the page that is wanted, and
when the page is not in the window (the first page, and then every sixteenth) it fills the window from the file with one
call of [[minix_read]] --- which asks the disk for the whole 64 KByte at once, see [[minix_read]]. Loading the 7 MByte
interpreter takes a bit more than a hundred requests instead of about fourteen thousand. The window is a static
buffer; that is safe because only one program is loaded at a time ([[exec_lock]] in [[arch_thread.c]]; the boot code
starts its programs one after the other), like the static [[eh]] and [[ph]] below. Every [[elf_load]] starts with an
empty window.

<<elf.c: window>>=
#define WINDOW_SIZE 65536
static u8 window[WINDOW_SIZE] __attribute__ ((aligned (64)));
static u32 window_ino, window_start, window_len;

static long window_read (u32 ino, u32 offset, void *dst, u32 n) {
  if (!window_len || window_ino != ino || offset < window_start || offset + n > window_start + window_len) {
    long got = minix_read (ino, offset, window, WINDOW_SIZE);
    if (got < (long)n) { window_len = 0; return -1; }
    window_ino = ino;  window_start = offset;  window_len = got;
  }
  for (u32 i = 0; i < n; i++) ((u8 *)dst)[i] = window[offset - window_start + i];
  return n;
}

@
returns 0 and the entry point on success; on failure the caller frees the address space

<<elf.c: elf_load>>=
int elf_load (u64 l0, u32 ino, u64 *entry, u64 *image_end) {
  static struct ehdr eh __attribute__ ((aligned (16)));
  static struct phdr ph __attribute__ ((aligned (16)));
  u32 fsize = minix_size (ino);
  window_len = 0;

  if (minix_read (ino, 0, &eh, sizeof eh) != sizeof eh)  return fail ("file too short");
  if (eh.ident[0] != 0x7f || eh.ident[1] != 'E' || eh.ident[2] != 'L' || eh.ident[3] != 'F')
                                                         return fail ("not an ELF file");
  if (eh.ident[4] != 2 || eh.ident[5] != 1)              return fail ("not a 64-bit little-endian ELF");
  if (eh.machine != EM_AARCH64)                          return fail ("not an AArch64 executable");
  if (eh.type != 2)                                      return fail ("not a static executable (ET_EXEC)");
  if (eh.phentsize != sizeof ph || eh.phnum == 0 || eh.phnum > 8)
                                                         return fail ("bad program header table");

  int entry_ok = 0;
  u64 end = 0;
  elf_linux = (eh.ident[7] == ELFOSABI_LINUX);
  elf_phdr_va = 0;
  elf_phnum = eh.phnum;
  for (int i = 0; i < eh.phnum; i++) {
    if (minix_read (ino, eh.phoff + i * sizeof ph, &ph, sizeof ph) != sizeof ph)
                                                         return fail ("cannot read program header");
    if (ph.type != PT_LOAD) continue;
    if (ph.memsz == 0) continue;
    if (ph.filesz > ph.memsz || ph.offset + ph.filesz > fsize)
                                                         return fail ("segment exceeds the file");
    if (ph.vaddr < USER_MIN || ph.vaddr + ph.memsz > USER_LOAD_MAX || ph.vaddr + ph.memsz < ph.vaddr)
                                                         return fail ("segment outside the user address range");
    if ((ph.flags & PF_W) && (ph.flags & PF_X))          return fail ("segment is writable and executable");

    if (eh.phoff >= ph.offset && eh.phoff + eh.phnum * sizeof ph <= ph.offset + ph.filesz)
      elf_phdr_va = ph.vaddr + (eh.phoff - ph.offset);   // this segment contains the program header table
    u64 flags = (ph.flags & PF_X) ? PAGE_URX : (ph.flags & PF_W) ? PAGE_URW : PAGE_URO;
    u64 seg_end = ph.vaddr + ph.memsz, file_end = ph.vaddr + ph.filesz;
    if (seg_end > end) end = seg_end;
    for (u64 p = ph.vaddr & ~(PAGE_SIZE - 1); p < seg_end; p += PAGE_SIZE) {
      u64 pa = alloc_frame_try ();                       // comes zeroed: this is the .bss part
      if (!pa) return fail ("out of memory");
      u64 a = p > ph.vaddr ? p : ph.vaddr;               // file bytes that land in this page
      u64 b = p + PAGE_SIZE < file_end ? p + PAGE_SIZE : file_end;
      if (a < b && window_read (ino, ph.offset + (a - ph.vaddr), (u8 *)KVA (pa) + (a - p), b - a) != (long)(b - a)) {
        free_frame (pa);
        return fail ("read error while loading a segment");
      }
      if (map_page_in (l0, p, pa, flags) != 0) { free_frame (pa); return fail ("segments overlap"); }
      if (ph.flags & PF_X) sync_icache (KVA (pa), PAGE_SIZE);
    }
    if ((ph.flags & PF_X) && eh.entry >= ph.vaddr && eh.entry < seg_end) entry_ok = 1;
  }
  if (!entry_ok) return fail ("entry point is not in an executable segment");
  *entry = eh.entry;
  *image_end = end;
  return 0;
}

@
\section{Read-only Minix v2 file system on top of the block driver}
\label{src:minixfs.c}

The same on-disk format as the [[x86]] Ulix images (bin-build/[[minixdata.img]]):
1 KByte zones, 64-byte v2 inodes, 7 direct + 1 indirect + 1 double indirect zone.

@

The complete file is put together from these parts:

<<minixfs.c>>=
<<minixfs.c: includes>>

<<minixfs.c: read_zone>>

<<minixfs.c: file_zone>>

<<minixfs.c: minix_read>>

<<minixfs.c: minix_readdir>>

<<minixfs.c: minix_lookup>>
@

<<minixfs.c: includes>>=
#include "ulix.h"

#define MINIX2_14   0x2468
#define MINIX2_30   0x2478
#define ZONE_SIZE   1024

struct sb {
  unsigned short ninodes, nzones16, imap_blocks, zmap_blocks, firstdatazone, log_zone_size;
  u32 max_size;
  unsigned short magic, state;
  u32 zones;
};

struct inode {
  unsigned short mode, nlinks, uid, gid;
  u32 size, atime, mtime, ctime;
  u32 zone[10];
};

static struct sb sb;
static u64 inode_table_block;
static int dirent_size, name_len;

// The buffers of this reader are local variables, on the stack of the caller. They used to be static, which is only safe as long as two
// threads never read at the same time. But readblock sleeps until the disk interrupt, and another thread that starts a program (every
// exec reads its file with these functions) then ran the same code and overwrote the buffers of the sleeper. With one daemon started
// at boot that happened rarely; with two it showed as garbage in a program or as a failed exec.

@
through the buffer cache of the book, so that blocks that were written but not synced yet are seen

<<minixfs.c: read_zone>>=
extern void readblock (int device, int blockno, char *buffer);
static int read_zone (u32 zone, void *buf) {
  readblock (0x300, zone, buf);                // DEV_HDA; (a failing read is not reported by readblock)
  return 0;
}

int minix_mount (void) {
  u8 b[ZONE_SIZE] __attribute__ ((aligned (16)));
  if (read_zone (1, b)) return -1;
  sb = *(struct sb *)b;
  if (sb.magic == MINIX2_30)      { dirent_size = 32; name_len = 30; }
  else if (sb.magic == MINIX2_14) { dirent_size = 16; name_len = 14; }
  else { printf ("minix: unknown magic 0x%x\n", sb.magic); return -1; }
  inode_table_block = 2 + sb.imap_blocks + sb.zmap_blocks;
  printf ("minix: v2, %u inodes, %u zones, %d-character names\n", sb.ninodes, sb.zones, name_len);
  return 0;
}

static int get_inode (u32 n, struct inode *out) {
  u8 b[ZONE_SIZE] __attribute__ ((aligned (16)));
  if (n == 0 || n > sb.ninodes) return -1;
  u32 idx = n - 1;                          // 16 inodes of 64 bytes per zone
  if (read_zone (inode_table_block + idx / 16, b)) return -1;
  u8 *p = b + (idx % 16) * 64;
  for (int i = 0; i < 64; i++) ((u8 *)out)[i] = p[i];
  return 0;
}

@
A file is read in many steps (one per zone, or per run of zones), and every step needs the same things again: the inode and
the zone numbers that are stored in the indirect zones. The first version looked them up from the disk each time: for a
file in the double indirect range (more than 263 KByte: the Python interpreter) that is the inode, the double indirect
zone, the indirect zone and the data zone for every single KByte, four requests where one would do. A [[struct reader]]
keeps what the call has read so far: the inode and the last single, double and second level indirect zone, each with
its own zone number (0: nothing read yet). It is a local variable of [[minix_read]], like all buffers of this file (see
above): one call, one reader, nothing shared between threads, nothing to invalidate when the file changes.

<<minixfs.c: file_zone>>=
struct reader {
  struct inode ino;
  u32 ind1[ZONE_SIZE / 4], ind1_zone;      // the indirect zone ino.zone[7] (after the first use)
  u32 dind[ZONE_SIZE / 4], dind_zone;      // the double indirect zone ino.zone[8]
  u32 ind2[ZONE_SIZE / 4], ind2_zone;      // the indirect zone that dind points to (the one that was needed last)
};

static void load_indirect (u32 zone, u32 *buf, u32 *have) {      // read an indirect zone unless it is the one that we have
  if (*have == zone) return;
  read_zone (zone, buf);
  *have = zone;
}

@
zone number of the n-th zone of a file (0 = hole)

<<minixfs.c: file_zone>>=
static u32 file_zone (struct reader *rd, u32 n) {
  struct inode *ino = &rd->ino;
  if (n < 7) return ino->zone[n];
  n -= 7;
  if (n < 256) {
    if (!ino->zone[7]) return 0;
    load_indirect (ino->zone[7], rd->ind1, &rd->ind1_zone);
    return rd->ind1[n];
  }
  n -= 256;
  if (!ino->zone[8]) return 0;
  load_indirect (ino->zone[8], rd->dind, &rd->dind_zone);
  u32 l1 = rd->dind[n / 256];
  if (!l1) return 0;
  load_indirect (l1, rd->ind2, &rd->ind2_zone);
  return rd->ind2[n % 256];
}

@
The second change: zones that follow each other on the disk are read with one request. An allocator that fills a file from the
start of a disk (and the program that builds the image does) gives it consecutive zone numbers, so a run of 64 zones
(RUN\_ZONES, 64 KByte) is the normal case. Where the next position is the start of a zone and at least two whole zones are still
wanted, the loop looks at the following zone numbers as far as they continue the run, and asks [[readblocks]] (in
[[glue.c]]) for the whole run. Everything else (the first and last, partial zone, a hole, a run of one) takes the old way:
one zone into a local buffer and a copy. [[readblocks]] falls back to single blocks itself if the device refuses the big
request, so the answer is the same in every case, only the number of requests differs.

<<minixfs.c: minix_read>>=
extern int readblocks (int device, int first, int count, char *dest);
#define RUN_ZONES 64

long minix_read (u32 ino_nr, u32 offset, void *buf, u32 len) {
  u8 z[ZONE_SIZE] __attribute__ ((aligned (16)));
  struct reader rd;
  rd.ind1_zone = rd.dind_zone = rd.ind2_zone = 0;
  if (get_inode (ino_nr, &rd.ino)) return -1;
  if (offset >= rd.ino.size) return 0;
  if (len > rd.ino.size - offset) len = rd.ino.size - offset;
  u32 done = 0;
  while (done < len) {
    u32 pos = offset + done, first = pos / ZONE_SIZE, in = pos % ZONE_SIZE;
    u32 zn = file_zone (&rd, first);
    if (zn && in == 0 && len - done >= 2 * ZONE_SIZE) {          // whole zones: how many follow each other on the disk?
      u32 most = (len - done) / ZONE_SIZE, run = 1;
      if (most > RUN_ZONES) most = RUN_ZONES;
      while (run < most && file_zone (&rd, first + run) == zn + run) run++;
      if (run >= 2) {
        if (readblocks (0x300, zn, run, (char *)buf + done)) return -1;      // DEV_HDA: one request for all of them
        done += run * ZONE_SIZE;
        continue;
      }
    }
    u32 n = ZONE_SIZE - in;
    if (n > len - done) n = len - done;
    if (zn) { if (read_zone (zn, z)) return -1; }
    else    { for (int i = 0; i < ZONE_SIZE; i++) z[i] = 0; }
    for (u32 i = 0; i < n; i++) ((u8 *)buf)[done + i] = z[in + i];
    done += n;
  }
  return len;
}

u32 minix_size (u32 ino_nr) {
  struct inode ino;
  return get_inode (ino_nr, &ino) ? 0 : ino.size;
}

static int streq (const char *a, const char *b, int n) {
  for (int i = 0; i < n; i++) { if (a[i] != b[i]) return 0; if (!a[i]) return 1; }
  return 1;
}

@
iterate over a directory: call fn for every used entry

<<minixfs.c: minix_readdir>>=
int minix_readdir (u32 dir, void (*fn)(u32 ino, const char *name, void *arg), void *arg) {
  u8 ent[64];
  struct inode d;
  if (get_inode (dir, &d) || (d.mode & 0170000) != 0040000) return -1;
  int count = 0;
  for (u32 off = 0; off + dirent_size <= d.size; off += dirent_size) {
    if (minix_read (dir, off, ent, dirent_size) != dirent_size) return -1;
    u32 nr = ent[0] | (ent[1] @<< 8);
    if (!nr) continue;
    char name[32]; int i;
    for (i = 0; i < name_len && ent[2 + i]; i++) name[i] = ent[2 + i];
    name[i] = 0;
    if (fn) fn (nr, name, arg);
    count++;
  }
  return count;
}

struct lookup { const char *name; u32 found; };
static void lookup_cb (u32 ino, const char *name, void *arg) {
  struct lookup *l = arg;
  if (!l->found && streq (name, l->name, name_len + 1)) l->found = ino;
}

@
resolve an absolute path (``/bin/vi'') to an inode number, 0 if not found

<<minixfs.c: minix_lookup>>=
u32 minix_lookup (const char *path) {
  u32 cur = 1;                              // root inode
  char part[32];
  while (*path) {
    while (*path == '/') path++;
    if (!*path) break;
    int n = 0;
    while (*path && *path != '/' && n < 31) part[n++] = *path++;
    part[n] = 0;
    struct lookup l = { part, 0 };
    if (minix_readdir (cur, lookup_cb, &l) < 0 || !l.found) return 0;
    cur = l.found;
  }
  return cur;
}

int minix_is_file (u32 ino_nr) {
  struct inode ino;
  return get_inode (ino_nr, &ino) == 0 && (ino.mode & 0170000) == 0100000;
}

@
\section{Who uses the CPUs? Statistics for the program \texttt{top}}
\label{src:stats.c}

The program [[top]] shows how busy every CPU is and how much of the time each process uses. The kernel only has to count:
at every timer interrupt (every 10 ms, on every CPU) it looks at what the CPU was doing when the interrupt came. If it was
running the idle thread (the CPU waits for an interrupt; in the book that is thread 1 and the process [[[idle]]], which
is what [[init]] turns into), the CPU was idle for 10 ms; otherwise it was busy, and the
process that was running is charged for the 10 ms. The numbers are only counters that grow; [[top]] subtracts two readings to
get the load of the last seconds, as the programs of the BSDs do.

A thread that is created starts with a counter of 0 ([[arch_thread.c]] resets it), because the numbers of the threads are
used again.

<<stats.c>>=
#define hash stats_hash                         // (the book defines hash () in its header: keep this copy private)
#include "ulix-api.h"

extern int smp_cpu (void);
extern int smp_online_cpus (void);
extern unsigned long arch_ram_frames (void);
extern long frames_in_use;                      // mmu.c

unsigned stats_busy[8], stats_idle[8];          // ticks per CPU: busy / idle
unsigned proc_ticks[MAX_THREADS];               // ticks per thread: the time that it has used

void stats_tick (void) {                        // the timer interrupt of a CPU; the kernel lock is ours, current_task is what ran
  int cpu = smp_cpu ();
  if (current_task <= 1 || strncmp (thread_table[current_task].cmdline, "[idle]", 6) == 0) {      // the idle thread
    stats_idle[cpu]++;
  } else {
    stats_busy[cpu]++;
    proc_ticks[current_task]++;
  }
}

@
The system call gives everything to the program in one structure (the same declaration is in [[userland/arm64-extra.h]]).
The user program passes the address of the structure; the kernel writes into it like [[syscall_getpsinfo]] does.

<<stats.c>>=
struct sysinfo {
  unsigned ticks;                               // timer ticks since the system started (100 per second)
  int      cpus;                                // CPUs that run Ulix (the others, if the board has more, are parked by the firmware)
  unsigned busy[8], idle[8];                    // ticks of every CPU in which it ran a process / waited
  int      total_frames, free_frames;           // RAM in frames of 4 KByte
  unsigned proc_ticks[MAX_THREADS];             // ticks that every thread has used
};

void syscall_sysinfo (context_t *r) {
  struct sysinfo *s = (struct sysinfo *)r->ebx;
  s->ticks = (unsigned)system_ticks;
  s->cpus = smp_online_cpus ();
  for (int c = 0; c < 8; c++) { s->busy[c] = stats_busy[c];  s->idle[c] = stats_idle[c]; }
  s->total_frames = (int)arch_ram_frames ();
  s->free_frames = (int)arch_ram_frames () - frames_in_use;     // (as syscall_get_free_frames)
  for (int t = 0; t < MAX_THREADS; t++) s->proc_ticks[t] = proc_ticks[t];
  r->eax = 0;
}
