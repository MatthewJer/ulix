static int map_sigpage (u64 l0) {
  u64 pa = alloc_frame_try ();
  if (!pa) return -1;
  unsigned int *code = KVA (pa);
  code[0] = 0xD2800000 | ((ARCH_NR_SIGRETURN & 0xffff) @<< 5);   // movz x0, #600
  code[1] = 0xD4000001;                      // svc #0
  code[2] = 0xD503201F;                      // nop (never reached: sigreturn does not come back)
  sync_icache (code, PAGE);
  return map_page_in (l0, SIGPAGE_VA, pa, PAGE_URX);
}

extern int random_get (void *buf, int n);             // random.c
static u64 build_linux_stack (byte *page, u64 base, u64 sp, int argc, u64 *ptrs);
static u64 build_user_stack (u64 l0, int argc, char **argv, int musl_abi) {
  u64 top_pa = 0;
  if (map_sigpage (l0) != 0) return 0;
  for (int i = 1; i <= USER_STACK_PAGES; i++) {
    u64 pa = alloc_frame_try ();
    if (!pa) return 0;
    if (i == 1) top_pa = pa;
    if (map_page_in (l0, USER_STACK_TOP - i * PAGE, pa, PAGE_URW) != 0) return 0;
  }
  byte *page = KVA (top_pa);
  // Leave some room above the strings: programs like ls append characters to their argv strings
  // (the x86 kernel puts the arguments 512 bytes below the top of the stack, too).
  u64 base = USER_STACK_TOP - PAGE, sp = USER_STACK_TOP - 512, ptrs[16];
  if (argc > 15) argc = 15;
  for (int i = argc - 1; i >= 0; i--) {
    int len = strlen (argv[i]) + 1;
    sp -= len;
    if (sp < base + 512) return 0;                       // arguments too long
    memcpy (page + (sp - base), argv[i], len);
    ptrs[i] = sp;
  }
  if (musl_abi) return build_linux_stack (page, base, sp, argc, ptrs);
  sp &= ~15UL;
  sp -= ((argc + 1) * 8 + 15) & ~15UL;
  u64 *av = (u64 *)(page + (sp - base));
  for (int i = 0; i < argc; i++) av[i] = ptrs[i];
  av[argc] = 0;
  u64 argv_va = sp;
  sp -= 16;
  u64 *top = (u64 *)(page + (sp - base));
  top[0] = argc;
  top[1] = argv_va;
  return sp;
}

@
\subsection{The stack of a program for musl}

A program that speaks the Linux system call interface finds the same start-up information as on Linux, and musl's [[_start_c]]
reads it from there: at the stack pointer the number of arguments, then the [[argv]] pointers and a null pointer, the
[[environ]] pointers and a null pointer, and then the \emph{auxiliary vector}: pairs of (type, value) that end with a pair of type
zero. musl needs from it the page size, the address of the program headers (to find the thread-local storage segment) and
sixteen random bytes (for the stack protector canary). The random bytes come from the hardware generator (\texttt{random\_get}, issue \#45);
on a machine without one the cycle counter is used, which is enough for a canary but not for cryptography. The environment holds one string, [[PATH]].

<<arch_thread.c: build_linux_stack>>=
#define AT_PHDR    3
#define AT_PHENT   4
#define AT_PHNUM   5
#define AT_PAGESZ  6
#define AT_RANDOM 25

static u64 build_linux_stack (byte *page, u64 base, u64 sp, int argc, u64 *ptrs) {
  static const char env0[] = "PATH=/bin";
  sp -= sizeof env0;
  memcpy (page + (sp - base), env0, sizeof env0);
  u64 env0_va = sp;
  sp -= 16;                                              // sixteen random bytes
  u64 rnd_va = sp, t;
  if (random_get (page + (sp - base), 16) < 0) {         // no generator on this machine: the cycle counter is enough for a canary
    __asm__ volatile ("mrs %0, cntpct_el0" : "=r" (t));
    for (int i = 0; i < 16; i++) { t = t * 6364136223846793005UL + 1442695040888963407UL; page[sp - base + i] = t >> 56; }
  }
  u64 auxv[] = { AT_PHDR, elf_phdr_va, AT_PHENT, 56, AT_PHNUM, elf_phnum, AT_PAGESZ, PAGE, AT_RANDOM, rnd_va, 0, 0 };
  int words = 1 + (argc + 1) + 2 + sizeof auxv / 8;      // argc, argv and its null, environ and its null, auxv
  sp = (sp - words * 8) & ~15UL;
  if (sp < base + 64) return 0;
  u64 *w = (u64 *)(page + (sp - base));
  *w++ = argc;
  for (int i = 0; i < argc; i++) *w++ = ptrs[i];
  *w++ = 0;
  *w++ = env0_va;
  *w++ = 0;
  for (unsigned i = 0; i < sizeof auxv / 8; i++) *w++ = auxv[i];
  return sp;
}

