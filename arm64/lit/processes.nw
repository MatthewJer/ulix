// the boot code (thread 1) waits for a process it has started, at most for the given number of timer ticks
extern void arch_idle (void);
void arch_wait_for_process (int tid, unsigned ticks) {
  unsigned start = (unsigned)system_ticks;
  while (tid > 0 && thread_table[tid].used && thread_table[tid].state != TSTATE_ZOMBIE && thread_table[tid].state != TSTATE_EXIT &&
         (unsigned)system_ticks - start < ticks)
    arch_idle ();
}

