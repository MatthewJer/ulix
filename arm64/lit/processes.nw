struct kctx { u64 x19_x28[10]; u64 x29, x30, sp, sp_el0; int depth;
              u64 tpidr, fpcr, fpsr, v[64]; };           // layout known to cpu_switch (depth: for C only); v = 32 registers of 16 bytes
typedef char assert_kctx_layout[(__builtin_offsetof (struct kctx, v) == 144) ? 1 : -1];   // the offset used by cpu_switch

// A new thread starts with a clean user state; a forked child starts with a copy of its parent's registers, which are still in
// the CPU while the parent is in the kernel (the kernel does not use them).
static void kctx_user_state_clear (struct kctx *c) { c->tpidr = c->fpcr = c->fpsr = 0; for (int i = 0; i < 64; i++) c->v[i] = 0; }
