@
the boot thread becomes thread 1, the idle thread of the book

<<arch_thread.c: arch_threads_init>>=
void arch_threads_init (void) {
  for (int i = 0; i < MAX_THREADS; i++) { thread_table[i].used = false; }
  thread_table[0].prev = 0;
  thread_table[0].next = 0;
  address_spaces[1].status = AS_USED;          // address space 1 = the kernel (no user pages)
  as_l0[1] = empty_l0_pa;
  current_as = 1;
  arch_syscalls_init ();
  TCB *idle = &thread_table[1];
  idle->used = true;
  idle->tid = idle->pid = 1;
  idle->ppid = 0;
  idle->addr_space = 1;
  idle->new = false;
  memcpy (idle->cmdline, "idle", 5);
  add_to_ready_queue (1);
  current_task = 1;
  next_pid = 3;                                // pids 1 (idle) and 2 (init) are protected by the book's kill()
  arch_clock_init ();                          // system_start_time from the real-time clock
  // The book mounts "/" (hda), "/mnt/" (fd1, a floppy), "/tmp/" (hdb) and "/dev/" (the device files).  Here a second and a
  // third virtio disk stand in for hdb and fd1: without them /tmp and /mnt are plain directories of "/"; with them they are
  // mounted like on the x86 (and the swap file /tmp/swap is on the second disk).
  {
    extern int blk_disks;
    mount_table_entry root_e = mount_table[0], mnt_e = mount_table[1], tmp_e = mount_table[2], dev_e = mount_table[3];
    int n = 0;
    mount_table[n++] = root_e;
    if (blk_disks >= 3) mount_table[n++] = mnt_e;
    if (blk_disks >= 2) mount_table[n++] = tmp_e;
    mount_table[n++] = dev_e;
    current_mounts = n;
  }
  arch_buffer_init ();
  scheduler_is_active = true;
  arch_swap_init ();                           // the book opens /tmp/swap when the system starts
  book_scheduler_on = 1;
  smp_start ();                                // the other CPUs
}

@
start a kernel thread running entry (arg); returns the thread ID or -1

<<arch_thread.c: arch_thread_create>>=
static int create_thread (thread_id tid, void (*entry)(void *), void *arg, const char *name);

int arch_thread_create (void (*entry)(void *), void *arg, const char *name) {
  thread_id tid;
  for (tid = 2; tid < MAX_THREADS; tid++) if (!thread_table[tid].used) break;
  if (tid == MAX_THREADS) return -1;
  return create_thread (tid, entry, arg, name);
}

@
A thread with one of the highest numbers, so that the low ones stay for the processes: the book expects /bin/swapper to be process 2,
and nobody should mistake a thread of the kernel for one of the processes that a user can end. Used for the network thread.

<<arch_thread.c: arch_thread_create_high>>=
int arch_thread_create_high (void (*entry)(void *), void *arg, const char *name) {
  thread_id tid;
  for (tid = MAX_THREADS - 1; tid >= 2; tid--) if (!thread_table[tid].used) break;
  if (tid < 2) return -1;
  int r = create_thread (tid, entry, arg, name);
  if (r >= 0) thread_table[tid].terminal = 255;                // (belongs to no terminal: Ctrl-C of a terminal never picks it)
  return r;
}

static int create_thread (thread_id tid, void (*entry)(void *), void *arg, const char *name) {

  if (kstack_pa[tid]) {                        // stack of a finished thread that used this ID before
    kstack_free (kstack_pa[tid]);
    kstack_pa[tid] = 0;
  }
  u64 stack = kstack_alloc ();
  if (!stack) return -1;
  kstack_pa[tid] = stack;
  u64 top = (u64)KVA (kstack_pa[tid]) + KSTACK_PAGES_ARCH * PAGE;
  struct kctx *c = &kctx[tid];
  c->depth = 1;                                // runs with the kernel lock, like the thread that starts it
  kctx_user_state_clear (c);
  proc_ticks[tid] = 0;                         // a new thread has used no time yet
  for (int i = 0; i < 10; i++) c->x19_x28[i] = 0;
  c->x19_x28[0] = (u64)entry;                  // x19
  c->x19_x28[1] = (u64)arg;                    // x20
  c->x29 = 0;
  c->x30 = (u64)thread_trampoline;
  c->sp  = top;
  c->sp_el0 = 0;

  TCB *t = &thread_table[tid];
  memset (t, 0, sizeof (TCB));
  t->used = true;
  t->tid = t->pid = tid;
  t->ppid = 1;                                 // children of the idle thread are not waited for
  t->addr_space = 1;
  t->new = false;
  for (int i = 0; name[i] && i < 10; i++) t->cmdline[i] = name[i];
  u64 flags = irq_save ();
  add_to_ready_queue (tid);
  irq_restore (flags);
  return tid;
}

@
free the kernel stacks of finished threads (the thread cannot do that itself)

<<arch_thread.c: arch_threads_reap>>=
void arch_swap_shrink (void);
void arch_evict_protect (addr_space_id as);
int arch_threads_reap (void) {
  int n = 0;
  arch_swap_shrink ();                         // (reap is called where the process may wait for the disk)
  u64 flags = irq_save ();
  for (thread_id tid = 2; tid < MAX_THREADS; tid++) {
    if (kstack_pa[tid] && !thread_table[tid].used && !smp_running_elsewhere (tid)) {
      // a process killed by another one (u_kill) never ran syscall_exit: free its address space here
      addr_space_id as = kstack_as[tid];
      if (as >= 2 && address_spaces[as].status == AS_USED && address_spaces[as].pid == (int)tid)
        destroy_address_space (as);
      kstack_as[tid] = 0;
      kstack_free (kstack_pa[tid]);
      kstack_pa[tid] = 0;
      n++;
    }
  }
  irq_restore (flags);
  return n;
}

