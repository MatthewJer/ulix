\subsection{Drawing a cell}
A glyph is found by binary search in the sorted table of code points; a code point without glyph is drawn as U+FFFD (the replacement character of the font).

<<fbcon.c: drawing>>=
static const unsigned char *glyph (unsigned c) {
  int lo = 0, hi = font->n - 1;
  for (int pass = 0; pass < 2; pass++, c = 0xfffd) {
    lo = 0; hi = font->n - 1;
    while (lo <= hi) {
      int mid = (lo + hi) / 2;
      if (font->cp[mid] == c) return font->bits + mid * font->h * font->bpr;
      if (font->cp[mid] < c) lo = mid + 1; else hi = mid - 1;
    }
  }
  return font->bits;
}

static void draw_cell (int x, int y, u32 v, int inverse) {
  int f = (v >> 16) & 15, b = (v >> 20) & 15;
  if (inverse) { int t = f; f = b; b = t; }
  u32 fgc = palette[f], bgc = palette[b];
  const unsigned char *g = glyph (v & 0xffff);
  u8 *line = fb.base + (u64) y * font->h * fb.pitch + (u64) x * font->w * 4;
  for (int r = 0; r < font->h; r++, line += fb.pitch) {
    u32 *px = (u32 *) line;
    const unsigned char *bits = g + r * font->bpr;
    for (int i = 0; i < font->w; i++) px[i] = (bits[i >> 3] & (0x80 >> (i & 7))) ? fgc : bgc;
    fb_clean (line, font->w * 4);
  }
  __asm__ volatile ("dsb sy" ::: "memory");
}

static void cursor_hide (void) { if (cursor_drawn) { draw_cell (cx, cy, cell[cy * cols + cx], 0); cursor_drawn = 0; } }
static void cursor_show (void) { if (cursor_on && !cursor_drawn) { draw_cell (cx, cy, cell[cy * cols + cx], 1); cursor_drawn = 1; } }

static u32 blank (void) { return ' ' | (fg << 16) | (bg << 20); }      // an empty cell has the current background colour (as xterm: "back colour erase")

static void put_cell (int x, int y, u32 v) { cell[y * cols + x] = v; draw_cell (x, y, v, 0); }

static void repaint (void) {
  for (int y = 0; y < rows; y++) for (int x = 0; x < cols; x++) draw_cell (x, y, cell[y * cols + x], 0);
  cursor_drawn = 0;
}
@

\subsection{Scrolling and erasing}
Scrolling by one line moves the cells (one [[memmove]]) and the pixels of the region (a second one, then the
cache lines are written back); the line that became free is cleared.

<<fbcon.c: screen operations>>=
static void clear_cells (int y, int x0, int x1) {                // cells x0..x1-1 of line y become empty
  u32 b = blank ();
  for (int x = x0; x < x1; x++) put_cell (x, y, b);
}

static void scroll_up (int n) {                                   // the lines top..bot move up by n, n empty lines appear at the bottom
  int lines = bot - top + 1;
  if (n > lines) n = lines;
  if (n <= 0) return;
  if (n < lines) {
    move (cell + top * cols, cell + (top + n) * cols, (u64) (lines - n) * cols * sizeof (u32));
    u8 *dst = fb.base + (u64) top * font->h * fb.pitch;
    move (dst, dst + (u64) n * font->h * fb.pitch, (u64) (lines - n) * font->h * fb.pitch);
    fb_clean (dst, (u64) (lines - n) * font->h * fb.pitch);
  }
  for (int y = bot - n + 1; y <= bot; y++) clear_cells (y, 0, cols);
}

static void scroll_down (int n) {                                 // the other direction: insert n lines at the cursor line (or the top of the region)
  int lines = bot - top + 1;
  if (n > lines) n = lines;
  if (n <= 0) return;
  if (n < lines) {
    move (cell + (top + n) * cols, cell + top * cols, (u64) (lines - n) * cols * sizeof (u32));
    u8 *src = fb.base + (u64) top * font->h * fb.pitch;
    move (src + (u64) n * font->h * fb.pitch, src, (u64) (lines - n) * font->h * fb.pitch);
    fb_clean (src, (u64) lines * font->h * fb.pitch);
  }
  for (int y = top; y < top + n; y++) clear_cells (y, 0, cols);
}

static void linefeed (void) {
  if (cy == bot) scroll_up (1);
  else if (cy < rows - 1) cy++;
}

static void reverse_linefeed (void) {
  if (cy == top) scroll_down (1);
  else if (cy > 0) cy--;
}

static void clamp (void) {
  if (cx < 0) cx = 0;
  if (cx >= cols) cx = cols - 1;
  if (cy < 0) cy = 0;
  if (cy >= rows) cy = rows - 1;
}

static void screen_clear (void) { for (int y = 0; y < rows; y++) clear_cells (y, 0, cols); }

static void use_alt_screen (int on) {                             // nano and vi draw on a second screen and leave the shell's text behind
  if (on && !alt_screen) {
    move (saved_cell, cell, (u64) rows * cols * sizeof (u32));  saved_cx = cx;  saved_cy = cy;  saved_valid = 1;
    screen_clear ();  cx = cy = 0;
  } else if (!on && alt_screen && saved_valid) {
    move (cell, saved_cell, (u64) rows * cols * sizeof (u32));  cx = saved_cx;  cy = saved_cy;  saved_valid = 0;
    cursor_drawn = 0;  repaint ();
  }
  alt_screen = on;
}
@

\subsection{Escape sequences}
A program that wants more than letters sends the byte 27 (Escape). What follows tells what to do:

\begin{itemize}
\item [[ESC [ ... letter]] is a \emph{control sequence}: up to a few numbers, separated by semicolons, and a letter that says what to do (the table in [[csi]]). A question mark after the bracket (``private'') marks switches such as
  the visible cursor ([[?25]]) and the alternate screen ([[?1049]]);
\item [[ESC ] ... BEL]] (or ending with ESC \textbackslash{}) is an \emph{operating system command} (set the window title): we skip it;
\item [[ESC ( B]] and [[ESC ( 0]] choose the character set: the second one is the ``line drawing'' set in which the letters [[q]], [[x]], [[l]] \ldots{} are the pieces of boxes; [[ESC 7]]/[[ESC 8]] save and restore the cursor, [[ESC M]] moves it up and scrolls if need be.
\end{itemize}
Bytes above 127 are UTF-8: the first one tells how many follow (110xxxxx: one more, 1110xxxx: two, 11110xxx: three). Everything we do not know is skipped, never printed.

<<fbcon.c: escape sequences>>=
static int param[8], nparam, private_mode;

static int par (int i, int dflt) { return (i < nparam && param[i] > 0) ? param[i] : dflt; }

static int nearest16 (int r, int g, int b) {                       // a colour of the 256-colour or true colour modes -> one of our 16
  int v = (r > 127 ? 1 : 0) | (g > 127 ? 2 : 0) | (b > 127 ? 4 : 0);
  static const int ansi[8] = { 0, 1, 2, 3, 4, 5, 6, 7 };
  int bright = (r > 200 || g > 200 || b > 200) && v != 0;
  if (v == 0 && (r > 60 || g > 60 || b > 60)) return 8;
  return ansi[v] + (v == 7 ? (r > 220 && g > 220 && b > 220 ? 8 : 0) : (bright ? 8 : 0));
}

static int color256 (int n) {
  if (n < 16) return n;
  if (n >= 232) return n < 244 ? 8 : 7;
  n -= 16;
  int r = (n / 36) * 51, g = ((n / 6) % 6) * 51, b = (n % 6) * 51;
  return nearest16 (r, g, b);
}

static void sgr (void) {                                           // ESC [ ... m: colours and attributes
  if (nparam == 0) { param[0] = 0; nparam = 1; }
  for (int i = 0; i < nparam; i++) {
    int p = param[i];
    if (p == 0) { fg = 7; bg = 0; bold = 0; reverse = 0; }
    else if (p == 1) bold = 1;
    else if (p == 22) bold = 0;
    else if (p == 7) reverse = 1;
    else if (p == 27) reverse = 0;
    else if (p >= 30 && p <= 37) fg = p - 30;
    else if (p == 39) fg = 7;
    else if (p >= 40 && p <= 47) bg = p - 40;
    else if (p == 49) bg = 0;
    else if (p >= 90 && p <= 97) fg = p - 90 + 8;
    else if (p >= 100 && p <= 107) bg = p - 100 + 8;
    else if ((p == 38 || p == 48) && i + 2 < nparam && param[i + 1] == 5) { int c = color256 (param[i + 2]);  if (p == 38) fg = c; else bg = c;  i += 2; }
    else if ((p == 38 || p == 48) && i + 4 < nparam && param[i + 1] == 2) { int c = nearest16 (param[i + 2], param[i + 3], param[i + 4]);  if (p == 38) fg = c; else bg = c;  i += 4; }
  }
}

static void csi (int c) {                                          // the sequence ESC [ params c is complete
  int n = par (0, 1);
  if (private_mode) {                                              // ESC [ ? n h (on) and l (off)
    if (c == 'h' || c == 'l') for (int i = 0; i < nparam; i++) {
      int on = c == 'h';
      if (param[i] == 25) cursor_on = on;
      else if (param[i] == 1049 || param[i] == 1047 || param[i] == 47) use_alt_screen (on);
    }
    return;
  }
  switch (c) {
    case 'A': cy -= n; clamp (); break;                            // cursor up, down, right, left
    case 'B': case 'e': cy += n; clamp (); break;
    case 'C': case 'a': cx += n; clamp (); break;
    case 'D': cx -= n; clamp (); break;
    case 'E': cy += n; cx = 0; clamp (); break;                    // next and previous line
    case 'F': cy -= n; cx = 0; clamp (); break;
    case 'G': case '`': cx = par (0, 1) - 1; clamp (); break;       // column
    case 'd': cy = par (0, 1) - 1; clamp (); break;                // line
    case 'H': case 'f': cy = par (0, 1) - 1; cx = par (1, 1) - 1; clamp (); break;
    case 'J': {                                                    // erase in the display: 0 cursor to end, 1 start to cursor, 2 all
      int m = nparam ? param[0] : 0;
      if (m == 0) { clear_cells (cy, cx, cols); for (int y = cy + 1; y < rows; y++) clear_cells (y, 0, cols); }
      else if (m == 1) { for (int y = 0; y < cy; y++) clear_cells (y, 0, cols); clear_cells (cy, 0, cx + 1); }
      else screen_clear ();
      break; }
    case 'K': {                                                    // erase in the line
      int m = nparam ? param[0] : 0;
      if (m == 0) clear_cells (cy, cx, cols); else if (m == 1) clear_cells (cy, 0, cx + 1); else clear_cells (cy, 0, cols);
      break; }
    case 'L': { int t = top; if (cy >= top && cy <= bot) { top = cy; scroll_down (n); top = t; } break; }    // insert lines
    case 'M': { int t = top; if (cy >= top && cy <= bot) { top = cy; scroll_up (n); top = t; } break; }      // delete lines
    case '@': {                                                    // insert n blank cells
      if (n > cols - cx) n = cols - cx;
      for (int x = cols - 1; x >= cx + n; x--) put_cell (x, cy, cell[cy * cols + x - n]);
      clear_cells (cy, cx, cx + n);
      break; }
    case 'P': {                                                    // delete n cells
      if (n > cols - cx) n = cols - cx;
      for (int x = cx; x < cols - n; x++) put_cell (x, cy, cell[cy * cols + x + n]);
      clear_cells (cy, cols - n, cols);
      break; }
    case 'X': if (n > cols - cx) n = cols - cx;  clear_cells (cy, cx, cx + n); break;     // erase n cells
    case 'm': sgr (); break;
    case 'r': top = par (0, 1) - 1; bot = par (1, rows) - 1;       // set the scroll region
      if (top < 0 || bot >= rows || top >= bot) { top = 0; bot = rows - 1; }
      cx = 0; cy = 0; break;
    case 's': sx = cx; sy = cy; break;
    case 'u': cx = sx; cy = sy; clamp (); break;
    default: break;                                                // t (window operations), c, n, ... : not for us
  }
  wrapnext = 0;
}

static int state = 0;                                              // 0 text, 1 after ESC, 2 in ESC [, 3 in ESC ] (OSC), 4 after ESC ( or ESC ), 5 after ESC in OSC
static int utf_left = 0;  static unsigned utf_val = 0;

static void show_char (unsigned ch) {
  if (graphics && ch >= 0x6a && ch <= 0x78) {                      // the line drawing set of the DEC terminals
    static const unsigned short line[] = { 0x2518, 0x2510, 0x250c, 0x2514, 0x253c, 0x23ba, 0x23bb, 0x2500, 0x23bc, 0x23bd, 0x251c, 0x2524, 0x2534, 0x252c, 0x2502 };
    ch = line[ch - 0x6a];
    if (ch >= 0x23ba && ch <= 0x23bd) ch = '-';                    // (the scan lines have no glyph in the font)
  }
  if (wrapnext) { cx = 0; linefeed (); wrapnext = 0; }
  int f = fg, b = bg;
  if (bold && f < 8) f += 8;
  if (reverse) { int t = f; f = b; b = t; }
  put_cell (cx, cy, (ch & 0xffff) | (f << 16) | (b << 20));
  if (cx < cols - 1) cx++; else wrapnext = 1;
}
@

<<fbcon.c: fbcon_putch>>=
void fbcon_putch (char ch) {
  unsigned char c = ch;
  if (!fbcon_active) return;
  cursor_hide ();
  if (state == 3 || state == 5) {                                  // inside an operating system command: skip to BEL or ESC \
    if (c == 7) state = 0; else if (c == 27) state = 5; else if (state == 5 && c == '\\') state = 0; else state = 3;
  } else if (state == 1) {                                         // after ESC
    state = 0;
    switch (c) {
      case '[': state = 2; nparam = 0; private_mode = 0; for (int i = 0; i < 8; i++) param[i] = 0; break;
      case ']': state = 3; break;
      case '(': case ')': case '*': case '+': state = 4; graphics = 0; break;
      case '7': sx = cx; sy = cy; break;
      case '8': cx = sx; cy = sy; clamp (); break;
      case 'M': reverse_linefeed (); break;
      case 'D': linefeed (); break;
      case 'E': cx = 0; linefeed (); break;
      case 'c': fg = 7; bg = 0; bold = reverse = 0; top = 0; bot = rows - 1; screen_clear (); cx = cy = 0; break;
      default: break;                                              // ESC = and ESC > (keypad), ...: no effect on the screen
    }
    wrapnext = 0;
  } else if (state == 4) {                                         // ESC ( c: c = 0 selects the line drawing set, B the normal one
    graphics = (c == '0');
    state = 0;
  } else if (state == 2) {                                         // in a control sequence: digits, semicolons, then a letter
    if (c >= '0' && c <= '9') { if (nparam == 0) nparam = 1; if (nparam <= 8) param[nparam - 1] = param[nparam - 1] * 10 + (c - '0'); }
    else if (c == ';') { if (nparam == 0) nparam = 1; if (nparam < 8) nparam++; }
    else if (c == '?') private_mode = 1;
    else if (c >= 0x40 && c <= 0x7e) { state = 0; csi (c); }
    else if (c == 27) state = 1;
  } else if (c == 27) state = 1;
  else if (c < 0x20) {                                             // control characters
    switch (c) {
      case '\n': case 11: case 12: linefeed (); wrapnext = 0; break;        // (the kernel sends CR LF, so a line feed only moves down)
      case '\r': cx = 0; wrapnext = 0; break;
      case '\b': if (cx > 0) cx--; wrapnext = 0; break;
      case '\t': cx = (cx + 8) & ~7; if (cx >= cols) cx = cols - 1; wrapnext = 0; break;
      default: break;                                              // BEL and the rest: nothing
    }
  } else if (c < 0x80) { utf_left = 0; show_char (c); }
  else if (c >= 0xc0) {                                            // first byte of a UTF-8 sequence
    if (c >= 0xf0) { utf_left = 3; utf_val = c & 7; } else if (c >= 0xe0) { utf_left = 2; utf_val = c & 15; } else { utf_left = 1; utf_val = c & 31; }
  } else if (utf_left > 0) {                                       // a following byte: 10xxxxxx
    utf_val = (utf_val << 6) | (c & 63);
    if (--utf_left == 0) show_char (utf_val > 0xffff ? 0xfffd : utf_val);
  }
  cursor_show ();
}
@

\subsection{Start}
[[fbcon_init]] reads the two options of the kernel command line, asks for the screen and chooses the font: at least 80 columns, and the biggest letters for the width: 16$\times$32
from 3000 pixels on (4K), 12$\times$24 from 1800 (full HD), else 8$\times$16. Then it clears the screen, draws a first line and from now on [[putch]] sends every character here, too.

<<fbcon.c: fbcon_init>>=
static int cmdline_number (const char *key, int *a, int *b) {      // "key=123" or "key=123x456" of the command line: returns 1 if it is there
  const char *p = plat_cmdline ();
  int kl = 0;  while (key[kl]) kl++;
  for (; *p; p++) {
    if ((p == plat_cmdline () || p[-1] == ' ') && starts (p, key) && p[kl] == '=') {
      p += kl + 1;
      *a = 0; while (*p >= '0' && *p <= '9') *a = *a * 10 + *p++ - '0';
      if (b) { *b = 0; if (*p == 'x') { p++; while (*p >= '0' && *p <= '9') *b = *b * 10 + *p++ - '0'; } }
      return 1;
    }
  }
  return 0;
}

int fbcon_init (void) {
  if (!plat.mbox) return -1;                                       // no VideoCore (qemu virt): no screen, and no message
  const char *cl = plat_cmdline ();
  for (; *cl; cl++) if ((cl == plat_cmdline () || cl[-1] == ' ') && starts (cl, "video=off")) return -1;
  int w = 0, h = 0, fh = 0;
  cmdline_number ("video", &w, &h);
  cmdline_number ("fbfont", &fh, 0);
  if (fb_init (w, h) < 0) { printf ("Screen: the VideoCore did not give a frame buffer (mailbox at 0x%lx)\n", plat.mbox);  return -1; }
  int k = fb.w >= 3000 ? 2 : fb.w >= 1800 ? 1 : 0;                  // by the width of the screen
  for (int i = 0; fh && i < fb_nfonts; i++) if (fb_fonts[i].h == fh) k = i;
  font = &fb_fonts[k];
  cols = fb.w / font->w;  rows = fb.h / font->h;
  if (cols > MAXCOLS) cols = MAXCOLS;
  if (rows > MAXROWS) rows = MAXROWS;
  fbcon_cols = cols;  fbcon_rows = rows;
  top = 0;  bot = rows - 1;  cx = cy = 0;
  fg = 7; bg = 0;
  u32 b = blank ();
  for (int i = 0; i < rows * cols; i++) cell[i] = b;
  for (u64 *q = (u64 *) fb.base; q < (u64 *) (fb.base + fb.size); q++) *q = 0;
  fb_clean (fb.base, fb.size);       // (also the margin right and below the last cell)
  fbcon_active = 1;
  cursor_show ();
  printf ("Screen: %dx%d pixels, letters %dx%d, %d columns and %d lines\n", (int) fb.w, (int) fb.h, font->w, font->h, cols, rows);
  return 0;
}
@
