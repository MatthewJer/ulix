#include "ulix.h"
#include "plat.h"
#include "fb.h"

#define MAXCOLS 480
#define MAXROWS 150

int fbcon_active = 0, fbcon_cols = 80, fbcon_rows = 24;
static const struct font *font;
static int cols, rows;                                    // the same as fbcon_cols and fbcon_rows
static u32 cell[MAXROWS * MAXCOLS];                       // bits 0..15: code point, 16..19: foreground, 20..23: background
static u32 saved_cell[MAXROWS * MAXCOLS];                 // the main screen while a program uses the alternate screen (nano: ESC [ ? 1049 h)
static int saved_valid = 0, saved_cx, saved_cy;
static int cx, cy, wrapnext;                              // cursor, and "the last column is written, the next letter wraps"
static int top, bot;                                      // the scroll region (lines, both included)
static int fg = 7, bg = 0, bold = 0, reverse = 0;        // the current colours (0..15)
static int sx, sy;                                        // saved cursor (ESC 7 / ESC 8)
static int cursor_on = 1, cursor_drawn = 0, graphics = 0;  // visible? is it on the screen now? DEC graphics set (ESC ( 0) selected?
static int alt_screen = 0;

// the 16 colours as xterm shows them: black, red, green, yellow, blue, magenta, cyan, white; then the bright ones
static int starts (const char *s, const char *prefix) { while (*prefix) if (*s++ != *prefix++) return 0; return 1; }

static void move (void *to, const void *from, u64 n) {            // copy n bytes; the areas may overlap (the kernel has no memmove). 8 bytes at a time: a screen is megabytes
  u8 *d = to;  const u8 *s = from;
  if (d < s) {
    for (; n >= 8 && (((u64) d | (u64) s) & 7) == 0; d += 8, s += 8, n -= 8) *(u64 *) d = *(const u64 *) s;
    for (; n > 0; n--) *d++ = *s++;
  } else {
    d += n;  s += n;
    for (; n >= 8 && (((u64) d | (u64) s) & 7) == 0; n -= 8) { d -= 8;  s -= 8;  *(u64 *) d = *(const u64 *) s; }
    for (; n > 0; n--) *--d = *--s;
  }
}

static const u32 palette[16] = {
  0x000000, 0xcd0000, 0x00cd00, 0xcdcd00, 0x0000ee, 0xcd00cd, 0x00cdcd, 0xe5e5e5,
  0x7f7f7f, 0xff0000, 0x00ff00, 0xffff00, 0x5c5cff, 0xff00ff, 0x00ffff, 0xffffff };
