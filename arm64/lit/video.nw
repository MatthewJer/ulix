<<fb.c>>=
#include "ulix.h"
#include "plat.h"
#include "fb.h"

struct framebuffer fb;

static u32 msg[36] __attribute__ ((aligned (16)));

static u32 *tag (u32 *p, u32 id, u32 size, u32 a, u32 b) {     // one tag with a value buffer of size bytes (of which a and b are filled in)
  p[0] = id;  p[1] = size;  p[2] = 0;  p[3] = a;  p[4] = b;
  return p + 3 + size / 4;
}

void fb_clean (const void *p, u64 len) {
  for (u64 a = (u64) p & ~63UL; a < (u64) p + len; a += 64) __asm__ volatile ("dc cvac, %0" :: "r" (a) : "memory");
}

int fb_init (int want_w, int want_h) {
  if (!plat.mbox) return -1;
  u32 *p = msg + 2;                                            // 1. what does the monitor want?
  p = tag (p, 0x00040003, 8, 0, 0);  *p = 0;
  msg[0] = (u32) ((char *)p + 4 - (char *)msg);
  if (mbox_property (msg) < 0) return -1;
  u32 w = msg[5], h = msg[6];
  if (want_w > 0 && want_h > 0) { w = want_w; h = want_h; }
  if (w < 320 || h < 200 || w > 4096 || h > 2304) { w = 1024; h = 768; }   // nothing sensible announced (no monitor): a usual size

  p = msg + 2;                                                 // 2. a buffer of that size
  p = tag (p, 0x00048003, 8, w, h);                            // physical size
  p = tag (p, 0x00048004, 8, w, h);                            // virtual size
  p = tag (p, 0x00048005, 4, 32, 0);                           // depth
  p = tag (p, 0x00048006, 4, 0, 0);                            // pixel order: 0x00RRGGBB
  u32 *alloc = p;  p = tag (p, 0x00040001, 8, 16, 0);          // allocate (alignment 16)
  u32 *pitch = p;  p = tag (p, 0x00040008, 4, 0, 0);           // bytes per line
  *p = 0;
  msg[0] = (u32) ((char *)p + 4 - (char *)msg);
  if (mbox_property (msg) < 0) return -1;
  u32 bus = alloc[3], size = alloc[4];
  if (!bus || !size || !pitch[3]) return -1;
  fb.pa = bus & 0x3fffffffUL;                                  // the bus address of the VideoCore -> the address of the ARM cores
  fb.pitch = pitch[3];  fb.w = w;  fb.h = h;  fb.size = size;
  fb.base = (u8 *) KVA (fb.pa);
  return 0;
}
