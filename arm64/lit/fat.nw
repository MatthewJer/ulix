<<fat.c: sectors>>=
static struct { int disk; u64 lba; int valid; u8 d[512]; } cache[NCACHE];

static int sec_read (struct vol *v, u64 lba, u8 *out) {         // one sector of the volume (counted from its start) through the cache
  u64 abs = v->start + lba;
  int k = abs % NCACHE;
  if (!cache[k].valid || cache[k].disk != v->disk || cache[k].lba != abs) {
    if (fat_dev_read (v->disk, abs, cache[k].d, 1) != 0) { cache[k].valid = 0; return -1; }
    cache[k].valid = 1;  cache[k].disk = v->disk;  cache[k].lba = abs;
  }
  copy (out, cache[k].d, 512);
  return 0;
}

static int sec_patch (struct vol *v, u64 lba, int off, const void *data, int n) {   // change n bytes of a sector and write it at once
  u8 s[512];
  if (sec_read (v, lba, s) != 0) return -1;
  copy (s + off, data, n);
  u64 abs = v->start + lba;
  int k = abs % NCACHE;
  copy (cache[k].d, s, 512);
  return fat_dev_write (v->disk, abs, s, 1);
}

static void forget (struct vol *v, u64 lba, u32 count) {         // sectors that were written without the cache: drop them
  for (u32 i = 0; i < count; i++) {
    u64 abs = v->start + lba + i;
    int k = abs % NCACHE;
    if (cache[k].valid && cache[k].disk == v->disk && cache[k].lba == abs) cache[k].valid = 0;
  }
}

static u64 cluster_lba (struct vol *v, u32 c) { return v->data_lba + (u64) (c - 2) * v->spc; }

static int data_read (struct vol *v, u64 lba, void *buf, u32 count)  { return fat_dev_read (v->disk, v->start + lba, buf, count); }
static int data_write (struct vol *v, u64 lba, const void *buf, u32 count) { forget (v, lba, count);  return fat_dev_write (v->disk, v->start + lba, buf, count); }
