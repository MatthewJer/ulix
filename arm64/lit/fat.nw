struct file {
  int used, vol, refs;
  struct finfo fi;
  u32 pos;
  u32 cur_idx, cur_cl;                                         // the bookmark: cluster number cur_idx of the chain is cur_cl
  int dirty;
};
static struct file files[MAXFILES];

static u32 clusters_of (struct vol *v, u32 size) { u32 b = v->spc * 512; return (size + b - 1) / b; }

static u32 cluster_for (struct vol *v, struct file *f, u32 idx) {     // the cluster number idx of the file (0: no such cluster)
  if (f->fi.first < 2) return 0;
  u32 k = 0, cl = f->fi.first;
  if (f->cur_cl && idx >= f->cur_idx) { k = f->cur_idx;  cl = f->cur_cl; }
  for (; k < idx; k++) {
    cl = next_cluster (v, cl, f->fi.nofat);
    if (cl < 2 || is_end (v, cl)) return 0;
  }
  f->cur_idx = idx;  f->cur_cl = cl;
  return cl;
}

static void to_chain (struct vol *v, struct file *f) {         // an exFAT file without FAT chain gets one (before it grows or shrinks)
  if (!f->fi.nofat) return;
  u32 n = clusters_of (v, f->fi.size);
  for (u32 i = 0; i < n; i++) fat_set (v, f->fi.first + i, i + 1 < n ? f->fi.first + i + 1 : EOC_EXFAT);
  f->fi.nofat = 0;  f->cur_cl = 0;
}

int fat_read (int fd, void *buf, int n) {
  struct file *f = &files[fd];
  struct vol *v = &vols[f->vol];
  if (fd < 0 || fd >= MAXFILES || !f->used || f->fi.is_dir) return -1;
  if (f->pos >= f->fi.size) return 0;
  if ((u32) n > f->fi.size - f->pos) n = f->fi.size - f->pos;
  u8 *out = buf;  int done = 0;
  static u8 bounce[17 * 512];
  u32 bpc = v->spc * 512;
  while (done < n) {
    u32 cl = cluster_for (v, f, f->pos / bpc);
    if (!cl) break;
    u32 off = f->pos % bpc, chunk = bpc - off;
    if (chunk > (u32) (n - done)) chunk = n - done;
    if (chunk > 8192) chunk = 8192;
    u32 first = off / 512, nsec = (off % 512 + chunk + 511) / 512;
    if (data_read (v, cluster_lba (v, cl) + first, bounce, nsec) != 0) return done > 0 ? done : -1;
    copy (out + done, bounce + off % 512, chunk);
    done += chunk;  f->pos += chunk;
  }
  return done;
}

int fat_write (int fd, const void *buf, int n) {
  if (fd < 0 || fd >= MAXFILES || !files[fd].used) return -1;
  struct file *f = &files[fd];
  if (f->fi.is_dir) return -1;
  struct vol *v = &vols[f->vol];
  const u8 *in = buf;  int done = 0;
  static u8 bounce[17 * 512];
  u32 bpc = v->spc * 512;
  if (f->fi.nofat) to_chain (v, f);
  if (f->pos > f->fi.size) {                                   // a gap: zeros
    u32 want = f->pos;  static u8 zeros[512];
    f->pos = f->fi.size;
    while (f->pos < want) { u32 k = want - f->pos > 512 ? 512 : want - f->pos; if (fat_write (fd, zeros, k) != (int) k) return -1; }
  }
  u32 chain_len = f->fi.first >= 2 ? clusters_of (v, f->fi.size) : 0;      // the clusters that the file has now
  while (done < n) {
    u32 idx = f->pos / bpc;
    while (idx >= chain_len) {                                 // the chain is too short: one more cluster behind the last one
      u32 prev = chain_len ? cluster_for (v, f, chain_len - 1) : 0;
      u32 fresh = alloc_cluster (v, prev, 0);
      if (!fresh) goto save;                                   // the stick is full
      if (f->fi.first < 2) f->fi.first = fresh;
      chain_len++;
    }
    u32 cl = cluster_for (v, f, idx);
    if (!cl) break;
    u32 off = f->pos % bpc, chunk = bpc - off;
    if (chunk > (u32) (n - done)) chunk = n - done;
    if (chunk > 8192) chunk = 8192;
    u32 first = off / 512, nsec = (off % 512 + chunk + 511) / 512;
    if (off % 512 || chunk % 512) { if (data_read (v, cluster_lba (v, cl) + first, bounce, nsec) != 0) break; }
    copy (bounce + off % 512, in + done, chunk);
    if (data_write (v, cluster_lba (v, cl) + first, bounce, nsec) != 0) break;
    done += chunk;  f->pos += chunk;
  }
save:
  if (f->pos > f->fi.size) f->fi.size = f->pos;
  if (done > 0) dir_update (v, &f->fi);                        // size and first cluster go into the directory at once
  return done > 0 || n == 0 ? done : -1;
}

long fat_lseek (int fd, long offset, int whence) {
  if (fd < 0 || fd >= MAXFILES || !files[fd].used) return -1;
  struct file *f = &files[fd];
  long base = whence == 0 ? 0 : whence == 1 ? (long) f->pos : (long) f->fi.size;
  long np = base + offset;
  if (np < 0) return -1;
  f->pos = np;
  return np;
}

int fat_ftruncate (int fd, long length) {                       // shorter: the clusters behind the new end are given back; longer: filled with zeros
  if (fd < 0 || fd >= MAXFILES || !files[fd].used || files[fd].fi.is_dir || length < 0) return -1;
  struct file *f = &files[fd];
  struct vol *v = &vols[f->vol];
  if ((u32) length == f->fi.size) return 0;
  if ((u32) length > f->fi.size) {
    u32 keep = f->pos;  static u8 zeros[512];
    f->pos = f->fi.size;
    while (f->pos < (u32) length) { u32 k = length - f->pos > 512 ? 512 : length - f->pos; if (fat_write (fd, zeros, k) != (int) k) { f->pos = keep; return -1; } }
    f->pos = keep;
    return 0;
  }
  to_chain (v, f);
  u32 keep = clusters_of (v, length);
  if (keep == 0) { free_chain (v, f->fi.first, 0, 0);  f->fi.first = 0; }
  else {
    u32 last = cluster_for (v, f, keep - 1);
    if (last) { u32 rest = fat_get (v, last);  fat_set (v, last, v->exfat ? EOC_EXFAT : EOC_FAT32);  if (!is_end (v, rest)) free_chain (v, rest, 0, 0); }
  }
  f->cur_cl = 0;
  f->fi.size = length;
  if (f->pos > (u32) length) f->pos = length;
  return dir_update (v, &f->fi);
}
