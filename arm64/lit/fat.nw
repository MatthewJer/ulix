#include "../ulixlib.h"
#include "../arm64-extra.h"

int main (int argc, char *argv[]) {
  struct mount_args m;
  if (argc != 2) { printf ("usage: eject usb0   (unmounts the stick and writes its cache: then it can be pulled out)\n");  return 1; }
  mount_args_init (&m, 4, argv[1], 0);
  int r = mount_call (&m);
  if (r != 0) printf ("%s\n", m.out[0] ? m.out : "eject failed");
  else printf ("%s can be removed\n", argv[1]);
  return r != 0;
}
