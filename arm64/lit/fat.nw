\section{Paths and operations}
A path ([[/Docs/letter.txt]], relative to the root of the volume) is looked up component by component: [[dir_find]] reads the entries of a directory until a name matches; [[resolve]] repeats it. [[.]] and [[..]] are handled while walking (a stack of
the directories that were entered).
[[open]] makes a file if it does not exist and the caller asks for it; [[mkdir]] takes a free cluster for the new directory, and (FAT32) writes the entries [[.]] and [[..]] into it; [[unlink]] and [[rmdir]] free the chain and mark the entries deleted;
[[rename]] makes entries with the new name that point to the same clusters and deletes the old ones.

<<fat.c: path operations>>=
static int dir_find (struct vol *v, u32 dir, int nofat, const u16 *name, int nl, struct finfo *out) {
  u32 pos = 0;
  while (dir_next (v, dir, nofat, &pos, out) == 0) {
    static u16 other[260];
    int on = utf8_to_utf16 (out->name, other, 255);
    if (on >= 0 && names_equal (name, nl, other, on)) return 0;
  }
  return -1;
}

static void root_info (struct vol *v, struct finfo *fi) {
  zero (fi, sizeof *fi);
  fi->first = v->root;  fi->is_dir = 1;
}

static int split (const char *path, int *pos, char *comp) {     // the next component of a path: 1, or 0 at the end
  while (path[*pos] == '/') (*pos)++;
  if (!path[*pos]) return 0;
  int n = 0;
  while (path[*pos] && path[*pos] != '/') { if (n < 255) comp[n++] = path[*pos];  (*pos)++; }
  comp[n] = 0;
  return 1;
}

static int resolve_parent (struct vol *v, const char *path, struct finfo *parent, char *leaf) {   // the directory that holds the last component, and its name; 0, or -1
  char comp[256];  int pos = 0;
  static struct { u32 first; int nofat; struct finfo fi; } stack[32];
  int depth = 0;
  root_info (v, &stack[0].fi);  stack[0].first = v->root;  stack[0].nofat = 0;
  leaf[0] = 0;
  while (split (path, &pos, comp)) {
    int more = 0;  { int p2 = pos;  char tmp[256];  more = split (path, &p2, tmp); }
    if (!more) {                                               // the last component: the caller deals with it
      int i;  for (i = 0; comp[i]; i++) leaf[i] = comp[i];
      leaf[i] = 0;
      *parent = stack[depth].fi;
      return 0;
    }
    if (same (comp, ".")) continue;
    if (same (comp, "..")) { if (depth > 0) depth--;  continue; }
    static u16 uni[260];  int nl = utf8_to_utf16 (comp, uni, 255);
    struct finfo fi;
    if (nl <= 0 || dir_find (v, stack[depth].fi.first, stack[depth].fi.nofat, uni, nl, &fi) != 0 || !fi.is_dir) return -1;
    if (depth + 1 >= 32) return -1;
    depth++;  stack[depth].fi = fi;
  }
  *parent = stack[depth].fi;                                   // the path was "/" (or empty): no last component
  return 0;
}

static int resolve (struct vol *v, const char *path, struct finfo *out) {
  struct finfo parent;  char leaf[256];
  if (resolve_parent (v, path, &parent, leaf) != 0) return -1;
  if (!leaf[0] || same (leaf, ".")) { *out = parent;  if (!parent.first) root_info (v, out);  return 0; }
  if (same (leaf, "..")) return -1;                           // (a path that ends in "..": the caller has the shorter path)
  static u16 uni[260];  int nl = utf8_to_utf16 (leaf, uni, 255);
  if (nl <= 0) return -1;
  return dir_find (v, parent.first, parent.nofat, uni, nl, out);
}

static void grew_hook (struct vol *v, struct finfo *dir) {       // an exFAT directory that got a cluster must say so in its own entry
  if (!dir_grew) return;
  dir_grew = 0;
  if (v->exfat && dir->idx != 0 | dir->nent != 0) { dir->size += v->spc * 512;  dir_update (v, dir); }
}

static int new_file (struct vol *v, const char *path, int is_dir, struct finfo *out) {   // makes a file or directory: 0, or -1
  struct finfo parent;  char leaf[256];
  if (resolve_parent (v, path, &parent, leaf) != 0 || !leaf[0] || same (leaf, ".") || same (leaf, "..")) return -1;
  static u16 uni[260];  int nl = utf8_to_utf16 (leaf, uni, 255);
  struct finfo old;
  if (nl <= 0 || dir_find (v, parent.first, parent.nofat, uni, nl, &old) == 0) return -1;      // exists already
  u32 first = 0;
  dir_grew = 0;
  if (is_dir) { first = alloc_cluster (v, 0, 1);  if (!first) return -1; }
  struct finfo fi;
  if (dir_add (v, parent.first, parent.nofat, leaf, is_dir, first, &fi) != 0) { if (first) free_chain (v, first, 0, 0);  return -1; }
  if (is_dir) {
    if (v->exfat) { fi.size = v->spc * 512;  dir_update (v, &fi); }
    else {                                                     // "." and ".." as the first two entries
      u8 e[32];  u32 d, t;
      unix_to_dos (fat_dev_time (), &d, &t);
      zero (e, 32);  for (int i = 0; i < 11; i++) e[i] = ' ';  e[0] = '.';  e[11] = 0x10;
      wr16 (e + 22, t);  wr16 (e + 24, d);  wr16 (e + 20, first >> 16);  wr16 (e + 26, first);
      dir_put (v, first, 0, 0, e);
      e[1] = '.';  wr16 (e + 20, parent.first == v->root ? 0 : parent.first >> 16);  wr16 (e + 26, parent.first == v->root ? 0 : parent.first);
      dir_put (v, first, 0, 1, e);
    }
  }
  grew_hook (v, &parent);
  if (out) *out = fi;
  return 0;
}

int fat_open (int vol, const char *path, int create) {
  if (!fat_vol_used (vol)) return -1;
  struct vol *v = &vols[vol];
  struct finfo fi;
  if (resolve (v, path, &fi) != 0) {
    if (!create || new_file (v, path, 0, &fi) != 0) return -1;
  }
  int k;
  for (k = 0; k < MAXFILES; k++) if (!files[k].used) break;
  if (k == MAXFILES) return -1;
  zero (&files[k], sizeof files[k]);
  files[k].used = 1;  files[k].vol = vol;  files[k].refs = 1;  files[k].fi = fi;
  return k;
}

int fat_close (int fd) {
  if (fd < 0 || fd >= MAXFILES || !files[fd].used) return -1;
  if (--files[fd].refs > 0) return 0;
  files[fd].used = 0;
  return 0;
}

int fat_reopen (int fd) {                                       // a copy with a position of its own
  if (fd < 0 || fd >= MAXFILES || !files[fd].used) return -1;
  int k;
  for (k = 0; k < MAXFILES; k++) if (!files[k].used) break;
  if (k == MAXFILES) return -1;
  files[k] = files[fd];  files[k].refs = 1;
  return k;
}

int fat_share (int fd) {                                        // the same open file again (dup, fork): the position is shared
  if (fd < 0 || fd >= MAXFILES || !files[fd].used) return -1;
  files[fd].refs++;
  return fd;
}

int fat_vol_of (int fd) { return fd >= 0 && fd < MAXFILES && files[fd].used ? files[fd].vol : -1; }

int fat_open_files (int vol) { int n = 0; for (int k = 0; k < MAXFILES; k++) if (files[k].used && files[k].vol == vol) n++; return n; }

static void to_stat (struct finfo *fi, struct fat_stat *st) {
  st->ino = fi->first ? fi->first : 1;  st->size = fi->is_dir ? 0 : fi->size;
  st->mtime = fi->mtime;  st->ctime = fi->ctime;  st->atime = fi->atime;
  st->is_dir = fi->is_dir;  st->readonly = fi->readonly;
}

int fat_fstat (int fd, struct fat_stat *st) {
  if (fd < 0 || fd >= MAXFILES || !files[fd].used) return -1;
  to_stat (&files[fd].fi, st);
  return 0;
}

int fat_stat (int vol, const char *path, struct fat_stat *st) {
  if (!fat_vol_used (vol)) return -1;
  struct finfo fi;
  if (resolve (&vols[vol], path, &fi) != 0) return -1;
  to_stat (&fi, st);
  return 0;
}

int fat_mkdir (int vol, const char *path) { return fat_vol_used (vol) ? new_file (&vols[vol], path, 1, 0) : -1; }

int fat_unlink (int vol, const char *path) {
  if (!fat_vol_used (vol)) return -1;
  struct vol *v = &vols[vol];
  struct finfo fi;
  if (resolve (v, path, &fi) != 0 || fi.is_dir || fi.readonly) return -1;
  for (int k = 0; k < MAXFILES; k++) if (files[k].used && files[k].vol == vol && files[k].fi.first == fi.first && fi.first) return -1;    // still open
  if (fi.first >= 2) free_chain (v, fi.first, fi.nofat, clusters_of (v, fi.size));
  return dir_remove (v, &fi);
}

int fat_rmdir (int vol, const char *path) {
  if (!fat_vol_used (vol)) return -1;
  struct vol *v = &vols[vol];
  struct finfo fi, inner;
  if (resolve (v, path, &fi) != 0 || !fi.is_dir || fi.first == v->root || fi.first < 2) return -1;
  u32 pos = 0;
  if (dir_next (v, fi.first, fi.nofat, &pos, &inner) == 0) return -1;     // not empty
  free_chain (v, fi.first, 0, 0);
  return dir_remove (v, &fi);
}

int fat_rename (int vol, const char *from, const char *to) {
  if (!fat_vol_used (vol)) return -1;
  struct vol *v = &vols[vol];
  struct finfo src, dst, parent;  char leaf[256];
  if (resolve (v, from, &src) != 0 || src.first == v->root) return -1;
  if (resolve (v, to, &dst) == 0) {                            // the target exists: a file is replaced by a file
    if (dst.is_dir || src.is_dir || dst.first == src.first) return dst.first == src.first ? 0 : -1;
    if (fat_unlink (vol, to) != 0) return -1;
  }
  if (resolve_parent (v, to, &parent, leaf) != 0 || !leaf[0]) return -1;
  struct finfo fresh;
  dir_grew = 0;
  if (dir_add (v, parent.first, parent.nofat, leaf, src.is_dir, src.first, &fresh) != 0) return -1;
  fresh.size = src.size;  fresh.nofat = src.nofat;  fresh.mtime = src.mtime;
  dir_update (v, &fresh);
  grew_hook (v, &parent);
  dir_remove (v, &src);
  if (src.is_dir && !v->exfat && src.first >= 2) {             // ".." of a moved directory names its new parent
    u8 e[32];
    if (dir_get (v, src.first, 0, 1, e) == 0) { wr16 (e + 20, parent.first == v->root ? 0 : parent.first >> 16);  wr16 (e + 26, parent.first == v->root ? 0 : parent.first);  dir_put (v, src.first, 0, 1, e); }
  }
  for (int k = 0; k < MAXFILES; k++) if (files[k].used && files[k].vol == vol && files[k].fi.first == src.first) files[k].fi = fresh;
  return 0;
}

static struct { int vol; u32 dir; u32 index; u32 pos; int valid; } listing;      // where the last listing stopped: the next index goes on from there

static int list_dir (int vol, struct finfo *dir, int index, char *name, int namesize, u32 *ino, int *is_dir) {
  struct vol *v = &vols[vol];
  if (index < 2) {
    name[0] = '.';  name[1] = index == 1 ? '.' : 0;  name[2] = 0;
    *ino = dir->first ? dir->first : 1;  *is_dir = 1;
    return 0;
  }
  u32 want = index - 2, have = 0, pos = 0;
  if (listing.valid && listing.vol == vol && listing.dir == dir->first && listing.index <= want) { have = listing.index;  pos = listing.pos; }
  struct finfo fi;
  for (;;) {
    if (dir_next (v, dir->first, dir->nofat, &pos, &fi) != 0) { listing.valid = 0;  return -1; }
    if (have == want) break;
    have++;
  }
  listing.vol = vol;  listing.dir = dir->first;  listing.index = want + 1;  listing.pos = pos;  listing.valid = 1;
  int n = len (fi.name);
  if (n >= namesize) n = namesize - 1;
  copy (name, fi.name, n);  name[n] = 0;
  *ino = fi.first ? fi.first : 1;  *is_dir = fi.is_dir;
  return 0;
}

int fat_getdent (int vol, const char *path, int index, char *name, int namesize, u32 *ino) {
  if (!fat_vol_used (vol) || index < 0) return -1;
  struct finfo dir;  int is_dir;
  if (resolve (&vols[vol], path, &dir) != 0 || !dir.is_dir) return -1;
  return list_dir (vol, &dir, index, name, namesize, ino, &is_dir);
}

int fat_readdir (int fd, int index, char *name, int namesize, u32 *ino, int *is_dir) {      // the same for a directory that is open (getdents64)
  if (fd < 0 || fd >= MAXFILES || !files[fd].used || !files[fd].fi.is_dir || index < 0) return -1;
  if (!files[fd].fi.first) root_info (&vols[files[fd].vol], &files[fd].fi);
  return list_dir (files[fd].vol, &files[fd].fi, index, name, namesize, ino, is_dir);
}

void fat_umount (int vol) {
  if (!fat_vol_used (vol)) return;
  for (int k = 0; k < MAXFILES; k++) if (files[k].used && files[k].vol == vol) files[k].used = 0;      // (a stick that was pulled out: its files are gone)
  fat_dev_sync (vols[vol].disk);
  for (int i = 0; i < NCACHE; i++) cache[i].valid = 0;
  vols[vol].used = 0;
  listing.valid = 0;
}
@

\chapter{Mounting: Sticks under \texttt{/Volumes}}
\label{ch:mount}

The book's file system layer ([[u_open]], [[u_read]] and the others) already has a place for a second kind of file system: every one of its functions has a [[switch]] on the type of the mounted
volume with a case for [[FS_FAT]] that says ``not implemented''. The port fills these cases in: [[tools/fatpatch.py]] changes the generated text of the book's functions so that [[FS_FAT]] calls [[fatfs_open]], [[fatfs_read]] and so on, which are in [[fatvfs.c]] and
translate between the types of the book ([[struct stat]], [[struct dir_entry]]) and [[fat.c]].

A \emph{mount} adds an entry to the mount table of the book: the path of the \emph{mount point} ([[/Volumes/FATSTICK/]]), the file system type [[FS_FAT]] and a device number ([[0x1000]] plus the number of the volume of [[fat.c]]). From then on, the book's [[get_dev_and_path]] sends every path below the mount point to the FAT code,
with the rest of the path (relative to the volume). The directory [[/Volumes/FATSTICK]] on the root disk is made when a volume is mounted and removed when it is unmounted, so that [[ls /Volumes]] shows what is mounted (the way macOS does it).

\paragraph{Plugging in.} When the system starts, [[fatfs_automount]] looks at every USB disk: the disk as one volume, then its partitions 1 to 4; every FAT32 or exFAT volume is mounted at [[/Volumes/]] and its label; if the name is taken, a number is added
(\texttt{LABEL 1}). A stick that was plugged in later is found by [[mount]] without arguments (it asks the USB code to look at the ports first). [[mount usb0p1 /mnt/stick]] mounts one partition at a place of your choice, [[umount]] undoes it, and [[eject usb0]] unmounts everything on the disk
and tells the stick to write its cache, so that it may be pulled out. The system call that the three programs use has the number 640 ([[ARCH_NR_MOUNT]]).

