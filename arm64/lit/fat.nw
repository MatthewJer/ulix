static int dir_grew = 0;                                       // set when a directory got another cluster (exFAT: its own entry must say so)

static int dir_find_free (struct vol *v, u32 dir, int nofat, u32 count, u32 *where) {      // a run of count free entries: 0, or -1 (disk full)
  u32 run = 0, start = 0;
  u8 e[32];
  u32 n;
  for (n = 0; ; n++) {
    if (dir_get (v, dir, nofat, n, e) != 0) break;             // the chain ends: it must grow
    int deleted = v->exfat ? !(e[0] & 0x80) : (e[0] == 0xe5);
    int end = e[0] == 0;
    if (deleted || end) { if (run == 0) start = n;  run++;  if (run >= count) { *where = start;  return 0; } }
    else run = 0;
    if (end) {                                                 // everything after the end mark is free, if the chain is long enough
      u32 per = v->spc * 16, left = per - (n % per);
      if (run + left - 1 >= count) { *where = start;  return 0; }
    }
  }
  u32 last = dir, c;                                           // add a cluster to the directory
  while (!is_end (v, c = next_cluster (v, last, nofat))) last = c;
  u32 fresh = alloc_cluster (v, last, 1);
  if (!fresh) return -1;
  cache_cl = 0;  dir_grew = 1;
  if (run == 0) start = n;
  *where = start;
  return 0;
}

static int valid_short_char (u32 c) {                          // a character that a short name may have besides upper case letters and digits
  const char *ok = "!#$%&'()-@^_`{}~";
  for (; *ok; ok++) if ((u32) *ok == c) return 1;
  return (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9');
}

static void make_short (const char *name, u8 *out11, int *needs_lfn) {      // the short name for a long name (without the tail ~N)
  zero (out11, 11);  for (int i = 0; i < 11; i++) out11[i] = ' ';
  *needs_lfn = 0;
  int dot = -1, n = len (name);
  for (int i = 0; i < n; i++) if (name[i] == '.') dot = i;
  int base_len = dot < 0 ? n : dot, bi = 0, ei = 0;
  for (int i = 0; i < base_len; i++) {
    u32 c = (u8) name[i];
    if (c == ' ' || c == '.') { *needs_lfn = 1;  continue; }
    if (c >= 'a' && c <= 'z') { c -= 32;  *needs_lfn = 1; }
    if (c >= 0x80 || !valid_short_char (c)) { c = '_';  *needs_lfn = 1; }
    if (bi < 8) out11[bi++] = c; else *needs_lfn = 1;
  }
  if (dot >= 0) for (int i = dot + 1; i < n; i++) {
    u32 c = (u8) name[i];
    if (c == ' ') { *needs_lfn = 1;  continue; }
    if (c >= 'a' && c <= 'z') { c -= 32;  *needs_lfn = 1; }
    if (c >= 0x80 || !valid_short_char (c)) { c = '_';  *needs_lfn = 1; }
    if (ei < 3) out11[8 + ei++] = c; else *needs_lfn = 1;
  }
  if (bi == 0) { out11[0] = '_';  *needs_lfn = 1; }
  if (out11[0] == 0xe5) out11[0] = 0x05;
}

static int short_taken (struct vol *v, u32 dir, int nofat, const u8 *out11) {
  u32 pos = 0;
  struct finfo fi;
  u8 e[32];
  while (dir_next (v, dir, nofat, &pos, &fi) == 0) {
    if (dir_get (v, dir, nofat, fi.short_idx, e) == 0) { int eq = 1; for (int i = 0; i < 11; i++) if (e[i] != out11[i]) eq = 0;  if (eq) return 1; }
  }
  return 0;
}

static void fill_times (struct vol *v, u8 *e, u32 now) {
  u32 d, t;
  unix_to_dos (now, &d, &t);
  if (!v->exfat) { wr16 (e + 14, t);  wr16 (e + 16, d);  wr16 (e + 18, d);  wr16 (e + 22, t);  wr16 (e + 24, d); }
  else { wr16 (e + 8, t);  wr16 (e + 10, d);  wr16 (e + 12, t);  wr16 (e + 14, d);  wr16 (e + 16, t);  wr16 (e + 18, d); }
}

static u16 exfat_set_checksum (const u8 *set, int entries) {
  u16 sum = 0;
  for (int i = 0; i < entries * 32; i++) { if (i == 2 || i == 3) continue;  sum = ((sum & 1) ? 0x8000 : 0) + (sum >> 1) + set[i]; }
  return sum;
}

static u16 exfat_name_hash (const u16 *name, int n) {
  u16 h = 0;
  for (int i = 0; i < n; i++) {
    u32 c = upper (name[i]);
    h = ((h & 1) ? 0x8000 : 0) + (h >> 1) + (c & 255);
    h = ((h & 1) ? 0x8000 : 0) + (h >> 1) + (c >> 8);
  }
  return h;
}

static int dir_add (struct vol *v, u32 dir, int nofat, const char *name, int is_dir, u32 first, struct finfo *out) {   // makes the entries of a new file or directory
  static u16 uni[260];                                         // (these arrays are static: the kernel stack of a process has 16 KByte, and the file system code runs one thread at a time)
  int nl = utf8_to_utf16 (name, uni, 255);
  if (nl <= 0) return -1;
  u32 now = fat_dev_time ();
  static u8 set[32 * 22];
  zero (set, sizeof set);
  u32 count, where;
  if (v->exfat) {
    int pieces = (nl + 14) / 15;
    count = 2 + pieces;
    if (count > 19) return -1;
    set[0] = 0x85;  set[1] = 1 + pieces;  wr16 (set + 4, is_dir ? 0x10 : 0x20);
    fill_times (v, set, now);
    u8 *st = set + 32;
    st[0] = 0xc0;  st[1] = 1;  st[3] = nl;  wr16 (st + 4, exfat_name_hash (uni, nl));
    wr32 (st + 20, first);
    for (int k = 0; k < pieces; k++) {
      u8 *ne = set + 64 + 32 * k;
      ne[0] = 0xc1;
      for (int i = 0; i < 15 && k * 15 + i < nl; i++) wr16 (ne + 2 + 2 * i, uni[k * 15 + i]);
    }
    wr16 (set + 2, exfat_set_checksum (set, count));
  } else {
    u8 s11[11];  int lfn;
    make_short (name, s11, &lfn);
    if (lfn) {                                                 // a tail ~1, ~2, ... until the short name is free
      int pos = 0;  while (pos < 8 && s11[pos] != ' ') pos++;
      u8 base[11];  copy (base, s11, 11);
      for (int t = 1; t < 1000000; t++) {
        char digits[8];  int dn = 0, x = t;  while (x) { digits[dn++] = '0' + x % 10;  x /= 10; }
        int cut = pos > 7 - dn ? 7 - dn : pos;  if (cut < 1) cut = 1;
        copy (s11, base, 11);
        s11[cut] = '~';  for (int i = 0; i < dn; i++) s11[cut + 1 + i] = digits[dn - 1 - i];
        for (int i = cut + 1 + dn; i < 8; i++) s11[i] = ' ';
        if (!short_taken (v, dir, nofat, s11)) break;
      }
    } else if (short_taken (v, dir, nofat, s11)) return -1;    // the name exists (in other letters)
    int pieces = lfn ? (nl + 12) / 13 : 0;
    count = pieces + 1;
    for (int k = 0; k < pieces; k++) {                         // the pieces, the last one first
      u8 *e = set + 32 * (pieces - 1 - k);
      static const u8 pos13[13] = { 1, 3, 5, 7, 9, 14, 16, 18, 20, 22, 24, 28, 30 };
      e[0] = (k + 1) | (k == pieces - 1 ? 0x40 : 0);  e[11] = 0x0f;  e[13] = short_checksum (s11);
      for (int i = 0; i < 13; i++) {
        int idx = k * 13 + i;
        u32 c = idx < nl ? uni[idx] : (idx == nl ? 0 : 0xffff);
        wr16 (e + pos13[i], c);
      }
    }
    u8 *e = set + 32 * pieces;
    copy (e, s11, 11);  e[11] = is_dir ? 0x10 : 0x20;
    fill_times (v, e, now);
    wr16 (e + 20, first >> 16);  wr16 (e + 26, first);
  }
  if (dir_find_free (v, dir, nofat, count, &where) != 0) return -1;
  for (u32 i = 0; i < count; i++) if (dir_put (v, dir, nofat, where + i, set + 32 * i) != 0) return -1;
  if (out) {
    zero (out, sizeof *out);
    out->first = first;  out->is_dir = is_dir;  out->dir_first = dir;  out->dir_nofat = nofat;
    out->idx = where;  out->nent = count;  out->short_idx = v->exfat ? where + 1 : where + count - 1;
    out->mtime = out->ctime = out->atime = now;
  }
  return 0;
}

static int dir_update (struct vol *v, struct finfo *fi) {      // writes size, first cluster and times of an entry back
  u8 e[32], st[32];
  u32 d, t;
  unix_to_dos (fat_dev_time (), &d, &t);
  if (!v->exfat) {
    if (dir_get (v, fi->dir_first, fi->dir_nofat, fi->short_idx, e) != 0) return -1;
    wr16 (e + 20, fi->first >> 16);  wr16 (e + 26, fi->first);  wr32 (e + 28, fi->size);
    wr16 (e + 22, t);  wr16 (e + 24, d);  wr16 (e + 18, d);
    return dir_put (v, fi->dir_first, fi->dir_nofat, fi->short_idx, e);
  }
  static u8 set[32 * 22];
  for (u32 i = 0; i < fi->nent; i++) if (dir_get (v, fi->dir_first, fi->dir_nofat, fi->idx + i, set + 32 * i) != 0) return -1;
  copy (e, set, 32);  copy (st, set + 32, 32);
  wr32 (st + 20, fi->first);  wr32 (st + 24, fi->size);  wr32 (st + 28, 0);  wr32 (st + 8, fi->size);  wr32 (st + 12, 0);     // valid data length and data length
  st[1] = 1 | (fi->nofat ? 2 : 0);
  wr16 (e + 12, t);  wr16 (e + 14, d);  wr16 (e + 16, t);  wr16 (e + 18, d);
  copy (set, e, 32);  copy (set + 32, st, 32);
  wr16 (set + 2, exfat_set_checksum (set, fi->nent));
  for (u32 i = 0; i < fi->nent; i++) if (dir_put (v, fi->dir_first, fi->dir_nofat, fi->idx + i, set + 32 * i) != 0) return -1;
  return 0;
}

static int dir_remove (struct vol *v, struct finfo *fi) {      // the entries are marked as deleted (the clusters are not touched here)
  u8 e[32];
  for (u32 i = 0; i < fi->nent; i++) {
    if (dir_get (v, fi->dir_first, fi->dir_nofat, fi->idx + i, e) != 0) return -1;
    e[0] = v->exfat ? (e[0] & 0x7f) : 0xe5;
    if (dir_put (v, fi->dir_first, fi->dir_nofat, fi->idx + i, e) != 0) return -1;
  }
  return 0;
}
