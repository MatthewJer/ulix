\section{Clusters: the table, the chains, free space}
The FAT has 4 bytes per cluster ([[fat_get]], [[fat_set]]; all copies are written). Values from [[0x0ffffff8]] (FAT32) or [[0xfffffff8]] (exFAT) on end a chain. Free clusters:
FAT32 has them as zeros in the FAT; exFAT keeps one bit per cluster in the allocation bitmap (a set bit: in use), and the FAT entry is only written for chains.

A file of exFAT may have the flag \emph{no FAT chain}: its clusters are consecutive and the FAT says nothing about them. [[next_cluster]] knows both.

<<fat.c: clusters>>=
static u32 fat_get (struct vol *v, u32 c) {
  u8 s[512];
  if (c < 2 || c >= v->nclusters + 2) return v->exfat ? EOC_EXFAT : EOC_FAT32;
  if (sec_read (v, v->fat_lba + (c * 4) / 512, s) != 0) return v->exfat ? EOC_EXFAT : EOC_FAT32;
  u32 e = rd32 (s + (c * 4) % 512);
  return v->exfat ? e : (e & 0x0fffffff);
}

static int is_end (struct vol *v, u32 e) { return v->exfat ? e >= 0xfffffff8 : e >= 0x0ffffff8; }

static int fat_set (struct vol *v, u32 c, u32 val) {
  u8 w[4];
  for (u32 f = 0; f < v->nfats; f++) {
    u64 lba = v->fat_lba + (u64) f * v->fat_sectors + (c * 4) / 512;
    int off = (c * 4) % 512;
    if (!v->exfat) {                                           // FAT32: the upper four bits of an entry belong to nobody, keep them
      u8 s[512];
      if (sec_read (v, lba, s) != 0) return -1;
      val = (val & 0x0fffffff) | (rd32 (s + off) & 0xf0000000);
    }
    wr32 (w, val);
    if (sec_patch (v, lba, off, w, 4) != 0) return -1;
  }
  return 0;
}

static u32 next_cluster (struct vol *v, u32 c, int nofat) {      // the cluster after c in its chain (an end mark: the chain ends)
  if (nofat) return c + 1;
  return fat_get (v, c);
}

// exFAT: the allocation bitmap (cluster 2 is bit 0 of byte 0)
static int bm_get (struct vol *v, u32 c) {
  u32 bit = c - 2;
  u8 s[512];
  if (sec_read (v, cluster_lba (v, v->bm_cluster) + bit / 8 / 512, s) != 0) return 1;
  return (s[(bit / 8) % 512] >> (bit % 8)) & 1;
}

static int bm_set (struct vol *v, u32 c, int on) {
  u32 bit = c - 2;
  u8 s[512];
  u64 lba = cluster_lba (v, v->bm_cluster) + bit / 8 / 512;
  if (sec_read (v, lba, s) != 0) return -1;
  u8 b = s[(bit / 8) % 512];
  b = on ? (b | (1 << (bit % 8))) : (b & ~(1 << (bit % 8)));
  return sec_patch (v, lba, (bit / 8) % 512, &b, 1);
}

static u32 alloc_cluster (struct vol *v, u32 prev, int zero_it) {   // a free cluster, linked behind prev (0: none); 0: the disk is full
  u32 c = v->free_hint;
  if (c < 2 || c >= v->nclusters + 2) c = 2;
  for (u32 n = 0; n < v->nclusters; n++, c++) {
    if (c >= v->nclusters + 2) c = 2;
    if (v->exfat ? bm_get (v, c) : fat_get (v, c) != 0) continue;
    if (v->exfat && bm_set (v, c, 1) != 0) return 0;
    if (fat_set (v, c, v->exfat ? EOC_EXFAT : EOC_FAT32) != 0) return 0;
    if (prev && fat_set (v, prev, c) != 0) return 0;
    v->free_hint = c + 1;
    if (zero_it) {                                             // a directory must start empty
      static u8 z[4096];
      for (u32 i = 0; i < v->spc; i += 8) { u32 k = v->spc - i < 8 ? v->spc - i : 8; if (data_write (v, cluster_lba (v, c) + i, z, k) != 0) return 0; }
    } else forget (v, cluster_lba (v, c), v->spc);
    return c;
  }
  return 0;
}

static void free_chain (struct vol *v, u32 c, int nofat, u32 count) {      // gives a chain back (nofat: count clusters from c)
  u32 n = 0;
  while (c >= 2 && c < v->nclusters + 2 && (!nofat || n < count)) {
    u32 next = nofat ? c + 1 : fat_get (v, c);
    if (v->exfat) bm_set (v, c, 0);
    fat_set (v, c, 0);
    if (c < v->free_hint) v->free_hint = c;
    n++;
    if (!nofat && is_end (v, next)) break;
    c = next;
  }
}
