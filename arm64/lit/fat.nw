#include "fat.h"

typedef unsigned short u16;
#define MAXVOL   4
#define MAXFILES 16
#define NCACHE   32

struct vol {
  int used, disk, exfat;
  u64 start;                                   // the first sector of the volume
  u32 spc, nclusters;                          // sectors per cluster, number of clusters (numbered from 2)
  u64 fat_lba, data_lba;
  u32 fat_sectors, nfats, root, free_hint;
  u32 bm_cluster, bm_size;                     // exFAT: the allocation bitmap
  char label[32];
};
static struct vol vols[MAXVOL];

static u16 rd16 (const u8 *p) { return p[0] | p[1] << 8; }
static u32 rd32 (const u8 *p) { return p[0] | p[1] << 8 | p[2] << 16 | (u32) p[3] << 24; }
static void wr16 (u8 *p, u32 v) { p[0] = v; p[1] = v >> 8; }
static void wr32 (u8 *p, u32 v) { p[0] = v; p[1] = v >> 8; p[2] = v >> 16; p[3] = v >> 24; }
static void zero (void *p, u32 n) { u8 *q = p; while (n--) *q++ = 0; }
static void copy (void *d, const void *s, u32 n) { u8 *a = d; const u8 *b = s; while (n--) *a++ = *b++; }
static int  same (const char *a, const char *b) { while (*a && *a == *b) { a++; b++; } return *a == *b; }
static u32  len (const char *s) { u32 n = 0; while (s[n]) n++; return n; }

#define EOC_FAT32  0x0fffffff
#define EOC_EXFAT  0xffffffff
