\subsection{The functions that the book's switches call}
The book's file descriptor of an open file is [[(fs << 8) + number]]: the number is the index of [[fat.c]]'s table of open files. A mode of the book (permissions) does not exist on a FAT volume; every file gets 0777 (0555 if it is write protected)
and belongs to root. A file that was opened with [[O_APPEND]] writes at its end whatever the position says; this is kept in [[append]].

<<fatvfs.c: the functions of the file system layer>>=
static char append[16];

static void to_book_stat (int device, struct fat_stat *fs, struct stat *st) {
  st->st_dev = device;  st->st_ino = fs->ino;  st->st_nlink = 1;  st->st_uid = 0;  st->st_gid = 0;  st->st_rdev = 0;
  st->st_mode = (fs->is_dir ? S_IFDIR : S_IFREG) | (fs->readonly ? 0555 : 0777);
  st->st_size = fs->size;  st->st_atime = fs->atime;  st->st_mtime = fs->mtime;  st->st_ctime = fs->ctime;
}

int fatfs_open (int device, const char *path, int oflag) {
  int fd = fat_open (device - DEV_FAT0, path, (oflag & O_CREAT) != 0);
  if (fd < 0) return -1;
  append[fd] = (oflag & O_APPEND) != 0;
  return fd;
}

int fatfs_read (int fd, void *buf, int n)  { return fat_read (fd, buf, n); }
int fatfs_write (int fd, void *buf, int n) { if (fd >= 0 && fd < 16 && append[fd]) fat_lseek (fd, 0, 2);  return fat_write (fd, buf, n); }
int fatfs_close (int fd)                   { return fat_close (fd); }
int fatfs_lseek (int fd, int off, int whence) { long r = fat_lseek (fd, off, whence);  return r < 0 ? -1 : (int) r; }
int fatfs_ftruncate (int fd, int length)   { return fat_ftruncate (fd, length); }
int fatfs_reopen (int fd)                  { return fat_reopen (fd); }
int fatfs_share (int fd)                   { return fat_share (fd); }

int fatfs_stat (int device, const char *path, struct stat *st) {
  struct fat_stat fs;
  if (fat_stat (device - DEV_FAT0, path, &fs) != 0) return -1;
  to_book_stat (device, &fs, st);
  return 0;
}

int fatfs_fstat (int fd, struct stat *st) {
  struct fat_stat fs;
  if (fat_fstat (fd, &fs) != 0) return -1;
  to_book_stat (DEV_FAT0 + fat_vol_of (fd), &fs, st);
  return 0;
}

int fatfs_mkdir (int device, const char *path)  { return fat_mkdir (device - DEV_FAT0, path); }
int fatfs_rmdir (int device, const char *path)  { return fat_rmdir (device - DEV_FAT0, path); }
int fatfs_unlink (int device, const char *path) { return fat_unlink (device - DEV_FAT0, path); }

int fatfs_getdent (int device, const char *path, int index, struct dir_entry *buf) {
  char name[64];  u32 ino;
  if (fat_getdent (device - DEV_FAT0, path, index, name, sizeof name, &ino) != 0) return -1;
  buf->inode = ino;
  int i = 0;  for (; name[i]; i++) buf->filename[i] = name[i];
  buf->filename[i] = 0;
  return 0;
}

// getdents64 of the Linux interface: entry number index of an open directory (0 on success)
int fatfs_readdir (int fd, int index, char *name, int size, unsigned *ino, int *is_dir) { return fat_readdir (fd, index, name, size, ino, is_dir); }

// rename (the Linux interface): -100 if the two paths are not on one FAT volume, else 0 or -1
int fatfs_rename (const char *from, const char *to) {
  char lp1[256], lp2[256], ab1[256], ab2[256];  short d1, f1, d2, f2;
  if (*from != '/') relpath_to_abspath ((char *) from, ab1); else strncpy (ab1, from, 256);
  if (*to != '/')   relpath_to_abspath ((char *) to, ab2);   else strncpy (ab2, to, 256);
  get_dev_and_path (ab1, &d1, &f1, lp1);  get_dev_and_path (ab2, &d2, &f2, lp2);
  if (f1 != FS_FAT && f2 != FS_FAT) return -100;
  if (f1 != f2 || d1 != d2) return -1;                          // between two file systems a rename cannot work
  return fat_rename (d1 - DEV_FAT0, lp1, lp2);
}

// statfs: size and free space of the volume that a path is on; 0 if the path is on a FAT volume, else -1
int fatfs_space (const char *path, unsigned long *bsize, unsigned long *blocks, unsigned long *bfree) {
  char lp[256], ab[256];  short d, f;
  if (*path != '/') relpath_to_abspath ((char *) path, ab); else strncpy (ab, path, 256);
  get_dev_and_path (ab, &d, &f, lp);
  if (f != FS_FAT) return -1;
  u64 total, free_c;  u32 cb;
  fat_vol_space (d - DEV_FAT0, &total, &free_c, &cb);
  *bsize = cb;  *blocks = total;  *bfree = free_c;
  return 0;
}
@

\subsection{The mount table}
The table of the book has 16 entries; an entry that is added later is searched first ([[get_dev_and_path]] looks from the end), so a mount point inside another mounted volume works. [[add_mount]] and [[remove_mount]] are the
two operations. For every FAT volume the code remembers from which disk and partition it came ([[vinfo]]), to be able to say [[usb0p1]] in the list and to find all volumes of a disk.

<<fatvfs.c: mount table>>=
struct { int used, disk, part; } vinfo[4];

static int mount_index_of_vol (int vol) {
  for (int i = 0; i < current_mounts; i++) if (mount_table[i].fstype == FS_FAT && mount_table[i].device == DEV_FAT0 + vol) return i;
  return -1;
}

static int mount_index_of_path (const char *path) {                // a mount point with or without the slash at the end
  int n = strlen (path);
  while (n > 1 && path[n - 1] == '/') n--;
  for (int i = 0; i < current_mounts; i++) {
    int m = strlen (mount_table[i].mountpoint);
    if (m > 1 && mount_table[i].mountpoint[m - 1] == '/') m--;
    if (m == n && strncmp (mount_table[i].mountpoint, path, n) == 0) return i;
  }
  return -1;
}

static int add_mount (const char *mp, int vol) {                   // mp without the slash at the end; 0, or -1 (the table is full)
  if (current_mounts >= 16 || strlen (mp) > 250) return -1;
  mount_table_entry *e = &mount_table[current_mounts];
  strcpy (e->mountpoint, mp);  strcat (e->mountpoint, "/");
  e->fstype = FS_FAT;  e->device = DEV_FAT0 + vol;  e->mount_flags = 0;
  current_mounts++;
  return 0;
}

static void remove_mount (int index) {
  for (int i = index; i < current_mounts - 1; i++) mount_table[i] = mount_table[i + 1];
  current_mounts--;
  mount_table[current_mounts].mountpoint[0] = 0;  mount_table[current_mounts].fstype = 0;  mount_table[current_mounts].device = 0;
}

static void volume_mount_point (int vol, char *mp) {                 // /Volumes/LABEL, or "/Volumes/LABEL 1" if that one is taken
  int n = 0;
  for (;; n++) {
    strcpy (mp, "/Volumes/");  strcat (mp, fat_vol_label (vol));
    if (n > 0) { int l = strlen (mp);  mp[l] = ' ';  mp[l + 1] = '0' + n % 10;  mp[l + 2] = 0; }
    if (mount_index_of_path (mp) < 0) return;
  }
}

static int mount_volume (int vol, int disk, int part, const char *where, char *msg) {      // where: 0 = /Volumes/LABEL (the directory is made), else the mount point
  char mp[256];
  struct stat st;
  if (where) strcpy (mp, where);
  else {                                                           // the directory under /Volumes is made by the file system code itself (at the start there is no user whose rights could be checked)
    volume_mount_point (vol, mp);
    mx_mkdir (mount_table[0].device, "/Volumes", 0777);
    mx_mkdir (mount_table[0].device, mp, 0777);
  }
  if (u_stat (mp, &st) != 0 || (st.st_mode & S_IFMT) != S_IFDIR) { fat_umount (vol);  strcpy (msg, "mount: no such directory");  return -1; }
  if (add_mount (mp, vol) != 0) { fat_umount (vol);  strcpy (msg, "mount: the mount table is full");  return -1; }
  vinfo[vol].used = 1;  vinfo[vol].disk = disk;  vinfo[vol].part = part;
  return 0;
}

static int unmount_volume (int index, int force, char *msg) {
  int vol = mount_table[index].device - DEV_FAT0;
  if (!force && fat_open_files (vol) > 0) { strcpy (msg, "umount: files are open");  return -16; }
  char mp[256];
  strcpy (mp, mount_table[index].mountpoint);
  fat_umount (vol);
  vinfo[vol].used = 0;
  remove_mount (index);
  int n = strlen (mp);  if (n > 1 && mp[n - 1] == '/') mp[n - 1] = 0;
  if (strncmp (mp, "/Volumes/", 9) == 0) mx_rmdir (mount_table[0].device, mp, mp);      // (the directory that was made for it)
  return 0;
}

static void source_name (int vol, char *out) {                       // "usb0" or "usb0p1"
  strcpy (out, usb_disk_name (vinfo[vol].disk));
  if (vinfo[vol].part > 0) { int l = strlen (out);  out[l] = 'p';  out[l + 1] = '0' + vinfo[vol].part;  out[l + 2] = 0; }
}

static int disk_has_volume (int disk) { for (int v = 0; v < 4; v++) if (vinfo[v].used && vinfo[v].disk == disk) return 1; return 0; }

static int mount_new_disks (char *report) {                          // every USB disk that has no mounted volume yet: the disk itself, then partitions 1 to 4
  int count = 0;
  report[0] = 0;
  for (int disk = 0; disk < usb_disks (); disk++) {
    if (!usb_disk_present (disk) || disk_has_volume (disk)) continue;
    for (int part = 0; part <= 4; part++) {
      int vol = fat_mount (disk, part);
      if (vol == -3) printf ("mount: %s partition %d: FAT12/FAT16 is not supported (only FAT32 and exFAT)\n", usb_disk_name (disk), part);
      if (vol < 0) continue;
      char msg[64];
      if (mount_volume (vol, disk, part, 0, msg) == 0) {
        char src[16];  source_name (vol, src);
        printf ("mount: %s (%s) on %s, %s\n", src, fat_vol_label (vol), mount_table[current_mounts - 1].mountpoint, fat_vol_exfat (vol) ? "exFAT" : "FAT32");
        count++;
      } else printf ("%s\n", msg);
    }
  }
  for (int vol = 0; vol < 4; vol++) {                                // a disk that was taken out: its volumes go away, too
    if (!vinfo[vol].used || usb_disk_present (vinfo[vol].disk)) continue;
    int idx = mount_index_of_vol (vol);
    char msg[64];
    if (idx >= 0) { printf ("mount: %s was taken out\n", mount_table[idx].mountpoint);  unmount_volume (idx, 1, msg); }
  }
  return count;
}

void fatfs_automount (void) {                                        // at the start of the system
  char rep[256];
  fs_lock ();
  mount_new_disks (rep);
  fs_unlock ();
}
@

\subsection{The system call}
One call for all the work of the three programs: the operation, a number and three strings in a structure. The text that [[mount]] prints comes back in [[out]].

<<fatvfs.c: the system call>>=
struct mount_args { int op, index; char a[64], b[256], out[256]; };      // the same as in userland/arm64-extra.h

static void fs_name (int index, char *out) {                          // the source of a mount: usb0p1, hda, ...
  mount_table_entry *e = &mount_table[index];
  if (e->fstype == FS_FAT) { source_name (e->device - DEV_FAT0, out);  return; }
  if (e->fstype == FS_DEV) { strcpy (out, "devfs");  return; }
  switch (e->device) { case DEV_HDA: strcpy (out, "hda"); break;  case DEV_HDB: strcpy (out, "hdb"); break;  case DEV_FD0: strcpy (out, "fd0"); break;  case DEV_FD1: strcpy (out, "fd1"); break;  default: strcpy (out, "disk"); }
}

static int parse_source (const char *a, int *disk, int *part) {         // "usb0", "usb1p2", "/dev/usb0p1"
  if (strncmp (a, "/dev/", 5) == 0) a += 5;
  if (strncmp (a, "usb", 3) != 0 || a[3] < '0' || a[3] > '9') return -1;
  *disk = a[3] - '0';  *part = 0;
  if (a[4] == 'p' && a[5] >= '1' && a[5] <= '4' && a[6] == 0) *part = a[5] - '0';
  else if (a[4] != 0) return -1;
  return 0;
}

void syscall_mount (context_t *r) {
  struct mount_args *m = (struct mount_args *) r->ebx;
  int res = -1;
  m->out[0] = 0;
  fs_lock ();
  switch (m->op) {
    case 0:                                                           // look for new disks and mount them
      usb_rescan ();
      res = mount_new_disks (m->out);
      break;
    case 1:                                                           // entry number index of the mount table, as text
      if (m->index >= 0 && m->index < current_mounts) {
        char src[16];  fs_name (m->index, src);
        int n = 0;
        strcpy (m->out, src);  strcat (m->out, " on ");  strcat (m->out, mount_table[m->index].mountpoint);  strcat (m->out, " type ");
        strcat (m->out, mount_table[m->index].fstype == FS_FAT ? (fat_vol_exfat (mount_table[m->index].device - DEV_FAT0) ? "exfat" : "vfat") : fs_names[mount_table[m->index].fstype]);
        (void) n;
        res = 0;
      }
      break;
    case 2: {                                                         // mount a on b
      int disk, part;
      if (parse_source (m->a, &disk, &part) != 0 || !usb_disk_present (disk)) { strcpy (m->out, "mount: no such disk");  res = -2;  break; }
      for (int v = 0; v < 4; v++) if (vinfo[v].used && vinfo[v].disk == disk && vinfo[v].part == part) { strcpy (m->out, "mount: already mounted");  res = -16;  goto done; }
      int vol = fat_mount (disk, part);
      if (vol < 0) { strcpy (m->out, vol == -3 ? "mount: FAT12 and FAT16 are not supported" : "mount: no FAT32 or exFAT file system there");  res = -22;  break; }
      res = mount_volume (vol, disk, part, m->b[0] ? m->b : 0, m->out);
      break; }
    case 3: {                                                         // umount b
      int idx = mount_index_of_path (m->b);
      if (idx < 0 || mount_table[idx].fstype != FS_FAT) { strcpy (m->out, "umount: not a mounted stick");  res = -22;  break; }
      res = unmount_volume (idx, 0, m->out);
      break; }
    case 4: {                                                         // eject a: unmount everything of the disk and flush the stick
      int disk, part;
      if (parse_source (m->a, &disk, &part) != 0 || !usb_disk_present (disk)) { strcpy (m->out, "eject: no such disk");  res = -2;  break; }
      for (int v = 0; v < 4; v++) if (vinfo[v].used && vinfo[v].disk == disk) { int idx = mount_index_of_vol (v);  if (idx >= 0 && unmount_volume (idx, 0, m->out) != 0) { res = -16;  goto done; } }
      usb_disk_sync (disk);
      res = 0;
      break; }
  }
done:
  fs_unlock ();
  eax_return (res);
}
@

\subsection{The programs: mount, umount, eject}
Three small programs for the system call. [[mount]] without arguments looks for sticks that were plugged in since the last time (and mounts them under [[/Volumes]]), then prints the mount table;
[[mount usb0p1 /mnt]] mounts partition 1 of the first stick on a directory; [[umount /Volumes/FATSTICK]] and [[eject usb0]] undo it (a stick should always be ejected before it is pulled out).

<<userland/arm64-extra.h: mount>>=
// mount, umount and eject (fatvfs.c)
#define __NR_mount_cmd    640
struct mount_args { int op, index; char a[64], b[256], out[256]; };    // op: 0 look for new disks, 1 entry of the mount table, 2 mount a on b, 3 umount b, 4 eject a
static inline int mount_call (struct mount_args *m) { return syscall2 (__NR_mount_cmd, (int)(long)m); }
static inline void mount_args_init (struct mount_args *m, int op, const char *a, const char *b) {
  char *p = (char *) m;
  for (unsigned i = 0; i < sizeof *m; i++) p[i] = 0;
  m->op = op;
  for (int i = 0; a && a[i] && i < 63; i++) m->a[i] = a[i];
  for (int i = 0; b && b[i] && i < 255; i++) m->b[i] = b[i];
}
@

<<userland/mount.c>>=
#include "../ulixlib.h"
#include "../arm64-extra.h"

int main (int argc, char *argv[]) {
  struct mount_args m;
  if (argc == 3) {                                             // mount usb0p1 /mnt
    mount_args_init (&m, 2, argv[1], argv[2]);
    int r = mount_call (&m);
    if (r != 0) printf ("%s\n", m.out[0] ? m.out : "mount failed");
    return r != 0;
  }
  if (argc != 1 && !(argc == 2 && argv[1][0] == '-' && argv[1][1] == 'a')) { printf ("usage: mount [-a]        (look for sticks and list what is mounted)\n       mount usb0p1 /dir  (mount a partition on a directory)\n");  return 1; }
  mount_args_init (&m, 0, 0, 0);
  mount_call (&m);                                             // a stick that was plugged in now is mounted under /Volumes
  for (int i = 0; ; i++) {
    mount_args_init (&m, 1, 0, 0);  m.index = i;
    if (mount_call (&m) != 0) break;
    printf ("%s\n", m.out);
  }
  return 0;
}
