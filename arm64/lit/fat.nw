static void trim_label (char *out, const u8 *in, int n) {
  int e = n;  while (e > 0 && (in[e - 1] == ' ' || in[e - 1] == 0)) e--;
  int o = 0;  for (int i = 0; i < e && o < 30; i++) out[o++] = in[i] >= ' ' && in[i] < 127 && in[i] != '/' ? in[i] : '_';
  out[o] = 0;
}

static void find_label_and_bitmap (struct vol *v, const u8 *vbr) {
  u8 e[32];
  v->label[0] = 0;
  for (u32 n = 0; dir_get (v, v->root, 0, n, e) == 0 && e[0] != 0; n++) {
    if (!v->exfat && e[11] == 0x08) trim_label (v->label, e, 11);
    if (v->exfat && e[0] == 0x83) {
      u16 uni[11];  int nl = e[1] > 11 ? 11 : e[1];
      for (int i = 0; i < nl; i++) uni[i] = rd16 (e + 2 + 2 * i);
      char tmp[40];  utf16_to_utf8 (uni, nl, tmp, sizeof tmp);
      trim_label (v->label, (u8 *) tmp, len (tmp));
    }
    if (v->exfat && e[0] == 0x81) { v->bm_cluster = rd32 (e + 20);  v->bm_size = rd32 (e + 24); }
  }
  if (!v->label[0] && !v->exfat) trim_label (v->label, vbr + 71, 11);
  if (same (v->label, "NO NAME")) v->label[0] = 0;
  if (!v->label[0]) { const char *d = "USBDISK";  for (int i = 0; i < 8; i++) v->label[i] = d[i]; }
}

static int looks_like_vbr (const u8 *s) {
  if (rd16 (s + 510) != 0xaa55) return 0;
  if (s[3] == 'E' && s[4] == 'X' && s[5] == 'F' && s[6] == 'A' && s[7] == 'T') return 1;
  return (s[0] == 0xeb || s[0] == 0xe9) && rd16 (s + 11) == 512 && s[13] != 0;
}

int fat_mount (int disk, int part) {                            // -1: unreadable, -2: not a FAT32/exFAT volume, -3: FAT12/16, -4: no free volume slot
  int k;
  for (k = 0; k < MAXVOL; k++) if (!vols[k].used) break;
  if (k == MAXVOL) return -4;
  struct vol *v = &vols[k];
  zero (v, sizeof *v);
  u8 s[512];
  u64 start = 0;
  if (fat_dev_read (disk, 0, s, 1) != 0) return -1;
  if (part == 0 && !looks_like_vbr (s)) return -2;
  if (part > 0) {
    if (looks_like_vbr (s) || rd16 (s + 510) != 0xaa55) return -2;
    const u8 *pe = s + 446 + 16 * (part - 1);
    u8 type = pe[4];
    if (type != 0x0b && type != 0x0c && type != 0x07 && type != 0x01 && type != 0x04 && type != 0x06 && type != 0x0e) return -2;
    start = rd32 (pe + 8);
    if (fat_dev_read (disk, start, s, 1) != 0) return -1;
    if (!looks_like_vbr (s)) return -2;
  }
  v->disk = disk;  v->start = start;
  if (s[3] == 'E' && s[4] == 'X' && s[5] == 'F' && s[6] == 'A' && s[7] == 'T') {
    if (s[108] != 9) return -2;                                // sectors of 512 bytes only
    v->exfat = 1;  v->nfats = 1;
    v->fat_lba = rd32 (s + 80);  v->fat_sectors = rd32 (s + 84);  v->data_lba = rd32 (s + 88);
    v->nclusters = rd32 (s + 92);  v->root = rd32 (s + 96);  v->spc = 1u << s[109];
  } else {
    if (rd16 (s + 11) != 512 || rd16 (s + 17) != 0 || rd16 (s + 22) != 0) return -3;        // a FAT12 or FAT16 volume has a root directory of its own
    v->spc = s[13];  v->nfats = s[16];
    u32 reserved = rd16 (s + 14), total = rd16 (s + 19) ? rd16 (s + 19) : rd32 (s + 32);
    v->fat_sectors = rd32 (s + 36);  v->root = rd32 (s + 44);
    v->fat_lba = reserved;  v->data_lba = reserved + v->nfats * v->fat_sectors;
    if (v->spc == 0 || (v->spc & (v->spc - 1)) || total <= v->data_lba) return -2;
    v->nclusters = (total - v->data_lba) / v->spc;
    if (v->nclusters < 65525) return -3;
    u32 fsinfo = rd16 (s + 48);
    v->used = 1;
    if (fsinfo > 0 && fsinfo < reserved) {                     // free cluster count and next free cluster: unknown
      u8 unknown[8] = { 255, 255, 255, 255, 255, 255, 255, 255 };
      sec_patch (v, fsinfo, 488, unknown, 8);
    }
  }
  if (v->nclusters < 1 || v->spc > 256) return -2;
  v->used = 1;
  v->free_hint = 2;
  cache_cl = 0;  cache_dir = 0;
  find_label_and_bitmap (v, s);
  if (v->exfat && !v->bm_cluster) { v->used = 0;  return -2; }
  return k;
}

int fat_vol_used (int vol) { return vol >= 0 && vol < MAXVOL && vols[vol].used; }
const char *fat_vol_label (int vol) { return fat_vol_used (vol) ? vols[vol].label : ""; }
int fat_vol_disk (int vol) { return fat_vol_used (vol) ? vols[vol].disk : -1; }
int fat_vol_exfat (int vol) { return fat_vol_used (vol) && vols[vol].exfat; }

void fat_vol_space (int vol, u64 *total, u64 *free_c, u32 *cbytes) {
  struct vol *v = &vols[vol];
  u64 f = 0;
  for (u32 c = 2; c < v->nclusters + 2; c++) { if (v->exfat ? !bm_get (v, c) : fat_get (v, c) == 0) f++; }
  *total = v->nclusters;  *free_c = f;  *cbytes = v->spc * 512;
}
