\section{Names and times}
The kernel works with UTF-8 names; FAT stores UTF-16. [[utf8_to_utf16]] and [[utf16_to_utf8]] convert (only the first plane: no letters outside it are on a stick that matters here). Names are compared without regard to case:
[[upper]] makes ASCII, Latin-1 and Greek and Cyrillic letters (the simple ranges) upper case. exFAT has a table on the disk that says it exactly, and the hash of a name is computed from it; for the plain letters the table agrees with [[upper]], and a name with
exotic letters would just get a different hash than Windows computes, which only hurts if the name has such letters (Windows then cannot find the file by name: it still lists it).

Time: a FAT date has the year (since 1980), month and day in 16 bits, a time has hours, minutes and seconds divided by two. [[dos_to_unix]] and [[unix_to_dos]] use the formulas of Howard Hinnant for the days of the calendar.

<<fat.c: names and times>>=
static u32 upper (u32 c) {
  if (c >= 'a' && c <= 'z') return c - 32;
  if (c >= 0xe0 && c <= 0xfe && c != 0xf7) return c - 32;
  if (c >= 0x3b1 && c <= 0x3c9 && c != 0x3c2) return c - 32;
  if (c >= 0x430 && c <= 0x44f) return c - 32;
  return c;
}

static int utf8_to_utf16 (const char *s, u16 *out, int max) {      // returns the number of UTF-16 units, -1 if it does not fit or is not valid
  int n = 0;
  while (*s) {
    u32 c = (u8) *s++;
    if (c >= 0xf0) return -1;                                  // outside the first plane
    if (c >= 0xe0) { u32 c1 = (u8) *s++, c2 = (u8) *s++; if ((c1 & 0xc0) != 0x80 || (c2 & 0xc0) != 0x80) return -1; c = (c & 15) << 12 | (c1 & 63) << 6 | (c2 & 63); }
    else if (c >= 0xc0) { u32 c1 = (u8) *s++; if ((c1 & 0xc0) != 0x80) return -1; c = (c & 31) << 6 | (c1 & 63); }
    else if (c >= 0x80) return -1;
    if (n >= max) return -1;
    out[n++] = c;
  }
  return n;
}

static void utf16_to_utf8 (const u16 *in, int n, char *out, int size) {
  int o = 0;
  for (int i = 0; i < n; i++) {
    u32 c = in[i];
    int need = c < 0x80 ? 1 : c < 0x800 ? 2 : 3;
    if (o + need + 1 > size) break;
    if (need == 1) out[o++] = c;
    else if (need == 2) { out[o++] = 0xc0 | (c >> 6); out[o++] = 0x80 | (c & 63); }
    else { out[o++] = 0xe0 | (c >> 12); out[o++] = 0x80 | ((c >> 6) & 63); out[o++] = 0x80 | (c & 63); }
  }
  out[o] = 0;
}

static int names_equal (const u16 *a, int na, const u16 *b, int nb) {
  if (na != nb) return 0;
  for (int i = 0; i < na; i++) if (upper (a[i]) != upper (b[i])) return 0;
  return 1;
}

static u32 days_from_civil (int y, int m, int d) {             // days since 1970-01-01
  y -= m <= 2;
  int era = (y >= 0 ? y : y - 399) / 400;
  unsigned yoe = y - era * 400;
  unsigned doy = (153 * (m + (m > 2 ? -3 : 9)) + 2) / 5 + d - 1;
  unsigned doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
  return era * 146097 + (int) doe - 719468;
}

static u32 dos_to_unix (u32 date, u32 time) {
  if (date == 0) return 0;
  return days_from_civil (1980 + (date >> 9), (date >> 5) & 15, date & 31) * 86400 + (time >> 11) * 3600 + ((time >> 5) & 63) * 60 + (time & 31) * 2;
}

static void unix_to_dos (u32 t, u32 *date, u32 *time) {
  u32 days = t / 86400, rest = t % 86400;
  int z = days + 719468;
  int era = (z >= 0 ? z : z - 146096) / 146097;
  unsigned doe = z - era * 146097;
  unsigned yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
  int y = yoe + era * 400;
  unsigned doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
  unsigned mp = (5 * doy + 2) / 153;
  unsigned d = doy - (153 * mp + 2) / 5 + 1;
  unsigned m = mp < 10 ? mp + 3 : mp - 9;
  y += m <= 2;
  if (y < 1980) { *date = (1 << 5) | 1;  *time = 0;  return; }
  *date = ((y - 1980) << 9) | (m << 5) | d;
  *time = (rest / 3600) << 11 | ((rest % 3600) / 60) << 5 | ((rest % 60) / 2);
}
@

\section{Directories}
A directory is a chain of clusters full of 32 byte entries, numbered from 0. [[dir_entry_at]] finds the sector and the offset of entry $n$ by following the chain ([[cache_cl]] remembers the last cluster that was found, so reading a directory from top to bottom is
not quadratic).

[[dir_next]] reads the \emph{logical} entries: for FAT32 it puts the long name together from the pieces before a short entry (checking their checksum against the short name), for exFAT it reads the file entry, the stream extension and the name pieces of a set. The result is a [[struct finfo]]: the name, the first cluster,
the size, the flags, and where the entries are, so that the code can change or delete them later.

FAT32 entries: a first byte of 0 ends the directory, [[0xe5]] marks a deleted entry, the attribute [[0x0f]] marks a piece of a long name, [[0x08]] the volume label, [[0x10]] a directory, [[0x01]] read only. exFAT: type [[0x85]] file, [[0xc0]] stream extension, [[0xc1]] name; deleted entries lose the top bit.

<<fat.c: directories>>=
struct finfo {
  char name[256];
  u32 first, size;                              // first cluster, size in bytes
  int is_dir, readonly, nofat;                  // exFAT: the clusters are consecutive
  u32 mtime, ctime, atime;
  u32 dir_first;  int dir_nofat;                // the directory that holds the entry
  u32 idx, nent;                                // the first entry of the set (the first piece of the long name), and how many entries it has
  u32 short_idx;                                // FAT32: the short entry; exFAT: the stream extension is idx + 1
};

static u32 cache_dir = 0, cache_idx = 0, cache_cl = 0;

static int dir_entry_at (struct vol *v, u32 dir, int nofat, u32 n, u64 *lba, int *off) {   // 0, or -1 if the chain ends before entry n
  u32 per_cluster = v->spc * 16;
  u32 ci = n / per_cluster, cl = dir, k = 0;
  if (cache_dir == dir && cache_cl && ci >= cache_idx) { cl = cache_cl;  k = cache_idx; }
  for (; k < ci; k++) {
    cl = next_cluster (v, cl, nofat);
    if (cl < 2 || is_end (v, cl)) return -1;
  }
  cache_dir = dir;  cache_idx = ci;  cache_cl = cl;
  u32 within = n % per_cluster;
  *lba = cluster_lba (v, cl) + within / 16;
  *off = (within % 16) * 32;
  return 0;
}

static int dir_get (struct vol *v, u32 dir, int nofat, u32 n, u8 *e) {
  u64 lba;  int off;  u8 s[512];
  if (dir_entry_at (v, dir, nofat, n, &lba, &off) != 0) return -1;
  if (sec_read (v, lba, s) != 0) return -1;
  copy (e, s + off, 32);
  return 0;
}

static int dir_put (struct vol *v, u32 dir, int nofat, u32 n, const u8 *e) {
  u64 lba;  int off;
  if (dir_entry_at (v, dir, nofat, n, &lba, &off) != 0) return -1;
  return sec_patch (v, lba, off, e, 32);
}

static u8 short_checksum (const u8 *name11) {
  u8 sum = 0;
  for (int i = 0; i < 11; i++) sum = ((sum & 1) ? 0x80 : 0) + (sum >> 1) + name11[i];
  return sum;
}

static void short_to_name (const u8 *e, char *out) {           // "HELLO   TXT" -> "HELLO.TXT" (lower case if the flags of Windows NT say so)
  int o = 0;
  int low_base = e[12] & 0x08, low_ext = e[12] & 0x10;
  for (int i = 0; i < 8 && e[i] != ' '; i++) { char c = e[i]; if (low_base && c >= 'A' && c <= 'Z') c += 32; out[o++] = c; }
  if (e[8] != ' ') {
    out[o++] = '.';
    for (int i = 8; i < 11 && e[i] != ' '; i++) { char c = e[i]; if (low_ext && c >= 'A' && c <= 'Z') c += 32; out[o++] = c; }
  }
  out[o] = 0;
  if ((u8) out[0] == 0x05) out[0] = (char) 0xe5;
}

static int dir_next (struct vol *v, u32 dir, int nofat, u32 *pos, struct finfo *fi) {    // the next logical entry at or after *pos: 0, or -1 at the end
  u8 e[32];
  static u16 lfn[260];  int lfn_len = 0, lfn_ok = 0;  u8 lfn_sum = 0;  u32 lfn_start = 0;
  for (u32 n = *pos; ; n++) {
    if (dir_get (v, dir, nofat, n, e) != 0) { *pos = n;  return -1; }
    if (!v->exfat) {
      if (e[0] == 0) { *pos = n;  return -1; }
      if (e[0] == 0xe5) { lfn_ok = 0;  continue; }
      if (e[11] == 0x0f) {                                     // a piece of a long name: 13 characters, the last piece comes first
        int ord = e[0] & 0x3f;
        if (e[0] & 0x40) { lfn_ok = 1;  lfn_sum = e[13];  lfn_len = ord * 13;  lfn_start = n;  zero (lfn, sizeof lfn); }
        if (!lfn_ok || e[13] != lfn_sum || ord < 1 || ord * 13 > 255) { lfn_ok = 0;  continue; }
        static const u8 pos13[13] = { 1, 3, 5, 7, 9, 14, 16, 18, 20, 22, 24, 28, 30 };
        for (int i = 0; i < 13; i++) lfn[(ord - 1) * 13 + i] = rd16 (e + pos13[i]);
        continue;
      }
      if (e[11] & 0x08) { lfn_ok = 0;  continue; }             // the volume label
      if (e[0] == '.' && (e[1] == ' ' || (e[1] == '.' && e[2] == ' '))) { lfn_ok = 0;  continue; }   // "." and ".." are made up by the caller
      zero (fi, sizeof *fi);
      if (lfn_ok && short_checksum (e) == lfn_sum) {
        int nl = 0;  while (nl < lfn_len && lfn[nl] != 0 && lfn[nl] != 0xffff) nl++;
        utf16_to_utf8 (lfn, nl, fi->name, sizeof fi->name);
        fi->idx = lfn_start;  fi->nent = n - lfn_start + 1;
      } else { short_to_name (e, fi->name);  fi->idx = n;  fi->nent = 1; }
      fi->short_idx = n;
      fi->first = rd16 (e + 20) << 16 | rd16 (e + 26);
      fi->size = rd32 (e + 28);
      fi->is_dir = (e[11] & 0x10) != 0;  fi->readonly = e[11] & 1;
      fi->mtime = dos_to_unix (rd16 (e + 24), rd16 (e + 22));
      fi->ctime = dos_to_unix (rd16 (e + 16), rd16 (e + 14));
      fi->atime = dos_to_unix (rd16 (e + 18), 0);
      fi->dir_first = dir;  fi->dir_nofat = nofat;
      *pos = n + 1;
      return 0;
    }
    // exFAT
    if (e[0] == 0) { *pos = n;  return -1; }
    if (e[0] != 0x85) continue;                                // (other types, and deleted entries)
    int secondary = e[1];
    u8 st[32];
    if (secondary < 2 || dir_get (v, dir, nofat, n + 1, st) != 0 || st[0] != 0xc0) continue;
    zero (fi, sizeof *fi);
    int nl = st[3];
    static u16 name[256];
    for (int k = 0; k < secondary - 1; k++) {
      u8 ne[32];
      if (dir_get (v, dir, nofat, n + 2 + k, ne) != 0 || ne[0] != 0xc1) break;
      for (int i = 0; i < 15 && k * 15 + i < nl; i++) name[k * 15 + i] = rd16 (ne + 2 + 2 * i);
    }
    utf16_to_utf8 (name, nl, fi->name, sizeof fi->name);
    fi->first = rd32 (st + 20);
    fi->size = rd32 (st + 24);                                 // (the upper half of the 64 bit size is dropped: files above 4 GByte are cut)
    if (rd32 (st + 28)) fi->size = 0xffffffff;
    fi->nofat = (st[1] & 2) != 0;
    fi->is_dir = (rd16 (e + 4) & 0x10) != 0;  fi->readonly = rd16 (e + 4) & 1;
    fi->ctime = dos_to_unix (rd16 (e + 10), rd16 (e + 8));
    fi->mtime = dos_to_unix (rd16 (e + 14), rd16 (e + 12));
    fi->atime = dos_to_unix (rd16 (e + 18), rd16 (e + 16));
    fi->dir_first = dir;  fi->dir_nofat = nofat;
    fi->idx = n;  fi->nent = secondary + 1;  fi->short_idx = n + 1;
    *pos = n + secondary + 1;
    return 0;
  }
}
