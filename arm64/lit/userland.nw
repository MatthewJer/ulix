\section{The screen functions of the book: clrscr, set\_xy, get\_xy, read\_screen, write\_screen, wrapping and scrolling}
\label{src:user:screentest.c}

The checks are made first and printed at the end; the program leaves ``DONE'' at column 2 of line 3.

@

The complete file is put together from these parts:

<<user/screentest.c>>=
<<user/screentest.c: includes>>
@

<<user/screentest.c: includes>>=
#include "ulib.h"

typedef unsigned short word;
#define W 80
#define H 24
static word scr[W * H];

static int results[16], names_n = 0;
static const char *names[16];
static void check (int ok, const char *name) { results[names_n] = ok; names[names_n++] = name; }
static int cell_is (int x, int y, char c) { return (scr[y * W + x] & 0xff) == (unsigned char)c; }

int main (int argc, char **argv) {
  char x, y;

  clrscr ();
  get_xy (&x, &y);
  check (x == 0 && y == 0, "clrscr puts the cursor in the top left corner");

  set_xy (10, 5);
  printf ("HELLO");
  get_xy (&x, &y);
  check (x == 15 && y == 5, "set_xy, printf and get_xy: the cursor is behind the text");
  read_screen ((char *)scr);
  check (cell_is (10, 5, 'H') && cell_is (14, 5, 'O') && cell_is (9, 5, ' ') && cell_is (15, 5, ' '), "read_screen sees the text at the cursor position");
  check ((scr[5 * W + 10] >> 8) == 0x0F, "normal text has the attribute 0x0F");

  clrscr ();
  for (int i = 0; i < W + 5; i++) printf ("a");
  get_xy (&x, &y);
  read_screen ((char *)scr);
  check (x == 5 && y == 1, "after 85 characters the cursor is at column 5 of line 1 (wrapped)");
  check (cell_is (79, 0, 'a') && cell_is (4, 1, 'a') && cell_is (5, 1, ' '), "the text wrapped to the next line");

  clrscr ();
  set_xy (0, 23);
  printf ("X\nY");
  get_xy (&x, &y);
  read_screen ((char *)scr);
  check (x == 1 && y == 23, "a newline in the last line scrolls: the cursor stays in line 23");
  check (cell_is (0, 22, 'X') && cell_is (0, 23, 'Y'), "the screen scrolled by one line");

  for (int i = 0; i < W * H; i++) scr[i] = ' ' | 0x0F00;
  const char *msg = "WRITTEN";
  for (int i = 0; msg[i]; i++) scr[3 * W + 20 + i] = msg[i] | 0x1F00;   // white on blue
  write_screen ((char *)scr);
  for (int i = 0; i < W * H; i++) scr[i] = 0;
  read_screen ((char *)scr);
  check (cell_is (20, 3, 'W') && cell_is (26, 3, 'N') && (scr[3 * W + 20] >> 8) == 0x1F, "write_screen and read_screen: text and color attribute come back");

  clrscr ();
  int bad = 0;
  for (int i = 0; i < names_n; i++) if (!results[i]) bad++;
  for (int i = 0; i < names_n; i++)
    printf ("  %s %s\n", results[i] ? "user ok:  " : "user FAIL:", names[i]);
  clrscr ();
  set_xy (2, 3);
  printf ("DONE");
  exit (bad);
}

@
\section{The user mode stack grows when the program touches the page just below it, but not further down}
\label{src:user:stacktest.c}


@

The complete file is put together from these parts:

<<user/stacktest.c>>=
<<user/stacktest.c: includes>>
@

<<user/stacktest.c: includes>>=
#include "ulib.h"

static int fails = 0;
#define CHECK(c, msg) do { if (c) printf ("  user ok:   %s\n", msg); \
                           else { printf ("  user FAIL: %s\n", msg); fails++; } } while (0)

static int deep (int n) {                  // about 1 KByte of stack per level
  volatile char pad[1000];
  pad[0] = (char)n;  pad[999] = (char)(n + 1);
  if (n == 0) return 0;
  int r = deep (n - 1);
  return r + (pad[0] == (char)n && pad[999] == (char)(n + 1) ? 1 : 1000000);
}

int main (int argc, char **argv) {
  CHECK (deep (600) == 600, "recursion 600 levels deep (about 600 KByte of stack, the start is 16 KByte)");

  int before = get_free_frames ();
  deep (300);
  CHECK (get_free_frames () - before == 0, "the grown stack stays: calling again needs no new frames");

  int pid = fork ();
  if (pid == 0) {                          // touching memory far below the stack ends the process
    volatile char *p = (volatile char *)&pid - 2 * 1024 * 1024;
    *p = 1;
    printf ("  user FAIL: access 2 MByte below the stack was allowed\n");
    exit (0);
  }
  int status = 0;
  waitpid (pid, &status, 0);
  CHECK (status == -1, "an access far below the stack is a fault: the process is killed");

  pid = fork ();
  if (pid == 0) {                          // the child has the grown stack, too
    exit (deep (500) == 500 ? 0 : 1);
  }
  waitpid (pid, &status, 0);
  CHECK (status == 0, "a forked child can use the grown stack");
  exit (fails);
}

@
\section{Memory runs out: sbrk () asks for 1 MByte at a time until it fails.  Pages are swapped out to make room (as in the book),}
\label{src:user:memtest.c}

and when that does not help any more [[sbrk ()]] returns -1 -- the kernel must neither hang nor crash. (Reading everything
back is not possible then: a page that is swapped out needs a free frame, and there is none; swaptest checks the data.)

@

The complete file is put together from these parts:

<<user/memtest.c>>=
<<user/memtest.c: includes>>
@

<<user/memtest.c: includes>>=
#include "ulib.h"

static int fails = 0;
#define CHECK(c, msg) do { if (c) printf ("  user ok:   %s\n", msg); \
                           else { printf ("  user FAIL: %s\n", msg); fails++; } } while (0)

#define MB (1024 * 1024)

int main (int argc, char **argv) {
  char *base = (char *)sbrk (0);
  int n = 0;
  for (;;) {
    char *p = (char *)sbrk (MB);
    if ((long)p == -1) break;
    p[0] = (char)(n + 1);  p[5 * 4096] = (char)(n * 3 + 7);        // two pages of each megabyte get a pattern
    for (int i = 1; i < 256; i++) p[i * 4096] = 0;                  // (the rest of the megabyte is touched, too)
    n++;
    if (n >= 2000) break;
  }
  CHECK (n > 20 && n < 2000, "sbrk () fails when memory is used up; it does not hang or crash the kernel");
  printf ("  info: %d MByte were handed out before sbrk () failed\n", n);

  int pid = fork ();                                                  // no memory left for a copy of everything: fork fails or works, but must not hang
  if (pid == 0) exit (0);
  if (pid > 0) { int st; waitpid (pid, &st, 0); }
  CHECK (1, "fork () returns when memory is short");
  CHECK (n > 0, "the process ends and gives all its memory back");
  exit (fails);
}

