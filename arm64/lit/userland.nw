@
\section{Tests fork, exec and waitpid (system calls of the book's kernel).  Exit status = failed checks}
\label{src:user:forktest.c}


@

The complete file is put together from these parts:

<<user/forktest.c>>=
<<user/forktest.c: includes>>
@

<<user/forktest.c: includes>>=
#include "ulib.h"

static int fails = 0;
#define CHECK(c, msg) do { if (c) printf ("  user ok:   %s\n", msg); \
                           else { printf ("  user FAIL: %s\n", msg); fails++; } } while (0)

static int shared = 5;                      // .data: every process has its own copy

int main (int argc, char **argv) {
  int status = 12345, pid;
  printf ("forktest: pid %d, parent %d\n", getpid (), getppid ());

  // 1. fork, exit status, separate address spaces
  pid = fork ();
  if (pid == 0) {
    shared = 99;
    printf ("child: pid %d, parent %d, shared = %d\n", getpid (), getppid (), shared);
    exit (7);
  }
  CHECK (pid > 0, "fork returns the child's pid in the parent");
  CHECK (waitpid (pid, &status, 0) == pid, "waitpid returns the pid of the child");
  CHECK (status == 7, "exit status 7 of the child arrives");
  CHECK (shared == 5, "a write in the child did not change the parent (separate address spaces)");

  // 2. fork + exec
  pid = fork ();
  if (pid == 0) {
    char *args[] = { "hello64", "foo", "bar", 0 };
    execv ("/hello64", args);
    printf ("exec failed\n");
    exit (99);
  }
  waitpid (pid, &status, 0);
  CHECK (status == 0, "child exec'ed /hello64, which reports 0 failed checks");

  // 3. several children at the same time, they take turns
  int pids[3];
  for (int i = 0; i < 3; i++) {
    pids[i] = fork ();
    if (pids[i] == 0) {
      for (int k = 0; k < 3; k++) { printf ("worker %d round %d\n", i, k); yield (); }
      exit (10 + i);
    }
  }
  int ok = 1;
  for (int i = 0; i < 3; i++) {
    waitpid (pids[i], &status, 0);
    if (status != 10 + i) ok = 0;
  }
  CHECK (ok, "three children ran concurrently, each exit status arrived");

  // 4. a child that crashes is killed, the parent goes on
  pid = fork ();
  if (pid == 0) {
    char *args[] = { "crash64", 0 };
    execv ("/crash64", args);
    exit (99);
  }
  waitpid (pid, &status, 0);
  CHECK (status == -1, "the crashing child was killed by the kernel (exit status -1)");

  // 5. exec of a missing file fails, the process keeps running
  pid = fork ();
  if (pid == 0) {
    char *args[] = { "x", 0 };
    int r = execv ("/nonexistent", args);
    exit (r == -1 ? 42 : 43);
  }
  waitpid (pid, &status, 0);
  CHECK (status == 42, "execv of a missing file returns -1");

  // 6. grandchild
  pid = fork ();
  if (pid == 0) {
    int g = fork ();
    if (g == 0) exit (3);
    int st = 0;
    waitpid (g, &st, 0);
    exit (st + 20);
  }
  waitpid (pid, &status, 0);
  CHECK (status == 23, "grandchild: exit status 3 passed through the child (3 + 20)");

  return fails;
}

@
\section{Tests signals: handlers that interrupt a computation at arbitrary points, SIG\_IGN, the default}
\label{src:user:sigtest.c}

action of [[kill()]], and SIGSTOP / SIGCONT.  Exit status = number of failed checks.

@

The complete file is put together from these parts:

<<user/sigtest.c>>=
<<user/sigtest.c: includes>>

<<user/sigtest.c: __attribute__>>
@

<<user/sigtest.c: includes>>=
#include "ulib.h"

static int fails = 0;
#define CHECK(c, msg) do { if (c) printf ("  user ok:   %s\n", msg); \
                           else { printf ("  user FAIL: %s\n", msg); fails++; } } while (0)

static volatile int got = 0, last_signal = 0;
// (atomic: on several CPUs the signals can arrive faster than a handler runs, so that handlers interrupt each other; a
// plain got++ would then lose counts. An exception return clears the exclusive monitor, so the loop of the atomic add retries.)
static void handler (int sig) { __sync_fetch_and_add (&got, 1); last_signal = sig; }

@
some arithmetic that uses many registers: any register lost across a signal changes the result

<<user/sigtest.c: __attribute__>>=
static unsigned __attribute__ ((noinline)) work (int n) {
  unsigned s = 1, a = 3, b = 5, c = 7;
  for (int i = 0; i < n; i++) {
    s = s * 31 + (unsigned)i * 7 + (s >> 3);
    a += s ^ b;  b += a >> 2;  c ^= a + b + s;
    s += c & 0xff;
  }
  return s ^ a ^ b ^ c;
}

#define N 8000000

static int file_size (int fd) { return lseek (fd, 0, 2); }       // SEEK_END

int main (int argc, char **argv) {
  int status = -12345, pid;

  // 1. a handler interrupts a running computation, which still gets the right result
  signal (SIGUSR1, handler);                       // inherited by the child
  pid = fork ();
  if (pid == 0) {
    unsigned r = work (N);
    int n = got > 63 ? 63 : got;                    // number of handler calls in bits 23..28
    exit ((int)((r & 0x7fffff) | ((unsigned)n @<< 23)));
  }
  for (int i = 0; i < 30; i++) { kill (pid, SIGUSR1); yield (); }
  waitpid (pid, &status, 0);
  unsigned expect = work (N) & 0x7fffff;
  CHECK ((status >> 23) >= 2, "the handler ran several times (before the first instruction and in the middle of the computation)");
  CHECK ((unsigned)(status & 0x7fffff) == expect, "the interrupted computation delivered the exact result");

  // 2. SIG_IGN: the signal is dropped, the process goes on
  signal (SIGUSR2, SIG_IGN);                       // inherited by the child
  pid = fork ();
  if (pid == 0) { work (200000); exit (5); }
  for (int i = 0; i < 5; i++) { kill (pid, SIGUSR2); yield (); }
  waitpid (pid, &status, 0);
  CHECK (status == 5, "an ignored signal does not disturb the child");

  // 3. default action: no handler, so the process is killed
  pid = fork ();
  if (pid == 0) { for (;;) yield (); }
  yield ();
  CHECK (kill (pid, SIGTERM) == 0, "kill (SIGTERM) on a process without handler");
  waitpid (pid, &status, 0);
  CHECK (kill (pid, 0) == -1, "the process is gone afterwards");

  // 4. SIGSTOP / SIGCONT, observed through a file the child appends to
  int log = open ("/progress.txt", 0x202);         // O_CREAT | O_RDWR
  pid = fork ();
  if (pid == 0) {
    int f = open ("/progress.txt", 0x202);
    for (;;) { write (f, "x", 1); yield (); }
  }
  while (file_size (log) < 5) yield ();
  kill (pid, SIGSTOP);
  for (int i = 0; i < 40; i++) yield ();            // (a child on another CPU stops itself at its next entry into the kernel)
  int s1 = file_size (log);
  for (int i = 0; i < 40; i++) yield ();
  int s2 = file_size (log);
  CHECK (s1 >= 5 && s2 == s1, "a stopped process makes no progress");
  kill (pid, SIGCONT);
  for (int i = 0; i < 40; i++) yield ();
  int s3 = file_size (log);
  CHECK (s3 > s2, "after SIGCONT it goes on");
  kill (pid, SIGKILL);
  // (a child that runs on another CPU when the signal arrives ends itself, so the first waitpid () may still return it)
  int w = waitpid (pid, &status, 0);
  if (w == pid) w = waitpid (pid, &status, 0);
  CHECK (w == -1, "SIGKILL removes the process (nothing is left to wait for)");
  close (log);

  return fails;
}

