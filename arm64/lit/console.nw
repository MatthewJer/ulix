#include "ulix-api.h"

extern unsigned long uart_base;
#define UART_BASE   (0xffff000000000000UL + uart_base)
#define UART_DR     (*(volatile unsigned int *)(UART_BASE + 0x00))
#define UART_FR     (*(volatile unsigned int *)(UART_BASE + 0x18))
#define UART_IMSC   (*(volatile unsigned int *)(UART_BASE + 0x38))
#define UART_ICR    (*(volatile unsigned int *)(UART_BASE + 0x44))
#define UART_FR_RXFE (1 @<< 4)

void kernel_shell (void);
extern void irq_uart_to_cpu (int cpu);
extern int smp_cpu (void);
extern void arch_resign (void);

#include "ulix-init.c"                     // arch_setup_keyboard(): the book's @<<setup keyboard>> chunk

void uart_rx_enable (void) {
  arch_setup_keyboard ();                   // empty input buffers (kbd_lastread = -1, ...)
  UART_ICR  = 0x7ff;
  UART_IMSC = (1 @<< 4) | (1 @<< 6);          // receive interrupt and receive timeout interrupt
}

@
the character is complete (already translated): put it where the book's keyboard handler puts it.

The book wakes the process that has waited longest and assumes that only one process per terminal waits for a key.
A program like [[fork2]] breaks that: several of its processes read from the terminal, and after the shell has its
prompt back the ones left over would still take the keys that belong to the shell. So the key goes to the process
that started waiting last: that is the one the user is talking to, normally the shell.

<<arch_console.c: console_enqueue>>=
static void console_enqueue_vt (int vt, char c) {         // a key for terminal vt (the console: the visible one; a telnet session: its own)
  terminal_t *term = &terminals[vt];
  if (term->kbd_count >= SYSTEM_KBD_BUFLEN) return;
  term->kbd[term->kbd_pos] = c;
  term->kbd_pos = (term->kbd_pos + 1) % SYSTEM_KBD_BUFLEN;
  term->kbd_count++;
  if (scheduler_is_active) {                // wake up the process that started waiting for a key on this terminal last
    thread_id search_pid = keyboard_queue.prev;
    while (search_pid != 0) {
      if (thread_table[search_pid].terminal == vt) {
        deblock (search_pid, &keyboard_queue);
        break;
      }
      search_pid = thread_table[search_pid].prev;
    }
  }
}

static void console_enqueue (char c) { console_enqueue_vt (cur_vt, c); }

@
Ctrl-C ends the foreground job with all its processes, as the signal of the terminal goes to the whole foreground process
group on Unix. Ulix has no process groups, so we use what we have: login waits for the shell, the shell waits for the
program it started (waitpid). Following these waits from [[login]] leads to the foreground process [[fg]]; the
processes on the way (login, shell) stay. Everything that was started after login on this terminal belongs to the
job, also processes whose parent has already ended (they are children of process 1 then). Without a login
process (the kernel tests) all processes of the terminal are the job. The running process is
killed last: killing it gives up the CPU.

<<arch_console.c: console_interrupt>>=
static int is_job (int pid, int vt) {                   // a living process of terminal vt
  return pid >= 3 && pid < MAX_THREADS && thread_table[pid].used && thread_table[pid].terminal == vt &&
         thread_table[pid].state != TSTATE_ZOMBIE && thread_table[pid].state != TSTATE_EXIT;
}

static void kill_job (int vt, int whole_session) {
  int login = 3;
  while (login < MAX_THREADS && !(is_job (login, vt) && strncmp (thread_table[login].cmdline, "login", 5) == 0)) login++;
  if (login == MAX_THREADS) login = 2;                  // no login (kernel tests): everything on the terminal is the job
  int fg = login;                                       // follow the waiting: login -> shell -> program
  while (thread_table[fg].state == TSTATE_WAITFOR && is_job (thread_table[fg].waitfor, vt))
    fg = thread_table[fg].waitfor;
  for (int pass = 0; pass < 2; pass++)                  // pass 0: all others, pass 1: the running process
    for (int i = login + 1; i < MAX_THREADS; i++) {
      int in_session = false;                           // login, shell: the processes before fg
      for (int p = login; p != fg && !whole_session; p = thread_table[p].waitfor) if (p == i) in_session = true;
      if (is_job (i, vt) && !in_session && (i == current_task) == pass) u_kill (i, SIGKILL);
    }
}

static void console_interrupt (void) { kill_job (cur_vt, 0); }

@
A telnet session (see [[telnet.c]]) has its own terminal, which is not necessarily the visible one: its keys go into the
buffer of that terminal ([[telnet_input]], translated like the keys of the UART), and Ctrl-C ends the job on that terminal.
When a session begins, [[telnet_attach]] throws away keys that are still in the buffer. When it ends, [[console_hangup]]
ends \emph{all} programs of the terminal, the shell too, as if a modem line had been hung up: [[login]] then asks for a name again.

<<arch_console.c: telnet>>=
void telnet_input (int vt, unsigned char c) {
  if (c == '\r') c = '\n';
  if (c == 0x7f) c = 0x08;
  if (c == 0x03) { kill_job (vt, 0); return; }
  console_enqueue_vt (vt, (char)c);
}

void telnet_attach (int vt) {
  terminal_t *term = &terminals[vt];
  term->kbd_count = 0;  term->kbd_pos = 0;  term->kbd_lastread = -1;
}

void console_hangup (int vt) { kill_job (vt, 1); }

@
The characters of the UART, the console, come here from the receive interrupt: special keys first, then the key goes to the visible terminal.

<<arch_console.c: console_input>>=
void arch_vt_switch (int n);

void arch_console_input (unsigned char c) {
  static int vt_prefix = 0;                  // after Ctrl-T the next digit selects a terminal
  if (vt_prefix) {
    vt_prefix = 0;
    if (c >= '0' && c <= '9') { arch_vt_switch ((c - '0' + 9) % 10); return; }   // like Alt-1..Alt-0 of the book
  }
  if (c == 0x14) { vt_prefix = 1; return; }                                       // Ctrl-T
  if (c == '\r') c = '\n';
  if (c == 0x7f) c = 0x08;
  if (c == 0x03) { console_interrupt (); return; }
  if (c == 0x1d) {                          // Ctrl-]
    if (scheduler_is_active) {
      scheduler_is_active = false;
      printf ("\nGoing to kernel shell\n");
      irq_uart_to_cpu (smp_cpu ());
      kernel_shell ();
      irq_uart_to_cpu (0);
      printf ("returning from kernel shell\n");
    }
    return;
  }
  console_enqueue ((char)c);
}

@
Waiting for a key with a time limit. [[readchar]] of the book waits until a key comes; a program like [[top]] wants to wait
two seconds, and then draw the screen again, unless a key came earlier. [[waitkey (ms)]] puts the process into the same queue
as [[readchar]] ([[keyboard_queue]], so that killing the process and the wake-up by a key work as before) and notes when its time
is over. The timer tick calls [[key_timeouts]], which wakes the processes whose time has come. The system call returns 1 if
a key is waiting in the buffer of the terminal (then [[readchar]] does not wait), and 0 if the time was over.

<<arch_console.c: waitkey>>=
static unsigned key_deadline[MAX_THREADS];      // the tick at which a process that waits for a key wants to be woken (0: it waits for ever)

void key_timeouts (void) {                      // from the timer tick
  thread_id t = keyboard_queue.next;
  while (t != 0) {
    thread_id next = thread_table[t].next;      // (deblock changes the links)
    if (key_deadline[t] != 0 && (unsigned)system_ticks >= key_deadline[t]) deblock (t, &keyboard_queue);
    t = next;
  }
}

void syscall_waitkey (context_t *r) {
  terminal_t *term = &terminals[thread_table[current_task].terminal];
  if (term->kbd_count == 0 && current_task > 1 && scheduler_is_active) {
    key_deadline[current_task] = (unsigned)system_ticks + (unsigned)r->ebx / 10 + 1;
    block (&keyboard_queue, TSTATE_WAITKEY);
    arch_resign ();                             // here the process sleeps
    key_deadline[current_task] = 0;
  }
  eax_return (term->kbd_count > 0);
}

@
called by the interrupt handler

<<arch_console.c: uart_rx_irq>>=
void uart_rx_irq (void) {
  while (!(UART_FR & UART_FR_RXFE)) {
    unsigned char c = UART_DR & 0xff;
    UART_ICR = 0x7ff;
    arch_console_input (c);
  }
  UART_ICR = 0x7ff;
}

@
An exception inside the kernel cannot be fixed (for example a bad user pointer in a system call).  Like the
page fault handler of the book: stop the scheduler, enable interrupts and jump to the kernel shell, which
is never left again.

<<arch_console.c: arch_kernel_fault_shell>>=
void arch_kernel_fault_shell (void) {
  scheduler_is_active = false;
  __asm__ volatile ("msr daifclr, #2");
  printf ("\n");
  irq_uart_to_cpu (smp_cpu ());                  // the keys must come to this CPU
  kernel_shell ();
  for (;;) __asm__ volatile ("wfe");
}

@
\section{Virtual terminals (ulix-book.nw: ``Virtual Terminals'', ``Terminal Output'')}
\label{src:arch_vt.c}

The book keeps for every terminal a screen of 80 x 24 characters, each a 16-bit word (ASCII value and VGA
color attribute), plus a cursor position, and copies the screen of the visible terminal to the VGA text
memory.  The same data structures (vt[], [[term_buffer]]) are used here.  The ``screen'' is the serial console,
a terminal emulator that understands ANSI escape sequences, so
\begin{itemize}
\item [[kputch ()]] updates the model of the terminal it writes to (cursor, wrapping, scrolling: as in the book) and sends the character on if that terminal is the visible one;
\item [[set_xy ()]], [[clrscr ()]], [[write_screen ()]] and switching terminals repaint the visible terminal from its model with cursor positioning and color sequences (``synchronized'' mode: the console has a scroll region of the 24 lines, so that scrolling there is the same as in the model).
\end{itemize}
Until a program uses one of those functions the console just receives the characters. A telnet session (see below, [[telnet.c]]) sees the same terminal
through the same functions.
The status line (line 25) does not exist.

